      "tremolo": { "rate": 1.6, "depth": 0.85, "duty": 0.6, "jitter": 0.6 } },
    { "source": "saw", "frequency": 62, "gain": 0.55,
      "filters": [{ "type": "lowPass", "frequency": 240, "q": 0.9 }],
      "vibrato": { "rate": 0.7, "depth": 0.08 },
      "tremolo": { "rate": 1.6, "depth": 0.7, "duty": 0.6, "jitter": 0.6 } },
    { "source": "impulse", "gain": 0.8, "frequency": 9,
      "filters": [{ "type": "bandPass", "frequency": 210, "q": 2.5 }],
      "tremolo": { "rate": 1.6, "depth": 1, "duty": 0.5, "jitter": 0.6 } }
  ]
