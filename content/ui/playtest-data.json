// Playtest data (queue #625, note 914; the plan, note 907): what the game asks a player before it records anything about
// their nights, and the "what we collect" page in Settings. Off unless the player says yes; anonymous (a random install id,
// nothing that names them); deleted on request. The wording and the retention are the director's to approve (the inbox,
// `n1-N1-playtest-consent`): drafted for Quebec's Law 25, PIPEDA and the GDPR.
{
  // Raised whenever what's collected or why changes: everyone who said yes to an older notice is asked again.
  "version": 1,

  // How long a session's data is kept on the studio's side once it's sent (#626), in months.
  "retentionMonths": 12,

  // Who answers questions about it and acts on deletion requests (Law 25's person in charge of personal information).
  "contact": "nsmith@squidostudio.com",

  // The first-run question: a title, then its lines.
  "question": "HELP US TUNE THE GAME?",
  "ask": [
    "Dark Territory is still being built. With your yes, the game keeps a record of how your nights go (how far the train got, what killed whom, where people got stuck in the menus, how smoothly it ran) so we can make it better.",
    "It's anonymous: a random number for this install, never your name, your Steam or Epic account, your address, your voice or anything you type (but a comment you choose to write in a playtest's questions). Nothing is recorded unless you say yes, and you can turn it off or delete it at any time in Settings."
  ],

  // Shown on that screen in a developer build, where it's on unless the player says no.
  "devBuild": "This is a developer build: playtest data is on unless you say no.",

  // The "what we collect" page: every group of fields the session recorder (#624, note 913) writes, in plain words, each
  // with the schema's fields it covers (a test holds the page to the schema).
  "collect": [
    { "what": "THIS INSTALL", "detail": "A random id made when you said yes (a new one after DELETE), the game's build and edition, whether it's a developer build, your operating system and graphics card, PC or VR, and your display settings (resolution, render scale, vsync, field of view).",
      "fields": "session.session, install, build, commit, edition, dev, os, gpu, vr, resolution, renderScale, vsync, fov" },
    { "what": "THE NIGHT'S SETUP", "detail": "Whether you hosted, joined or played alone, the route and its tier, the cars, and how many people and bots were aboard. Never anyone's name.",
      "fields": "night.role, route, tier, cars, humans, bots" },
    { "what": "HOW THE NIGHT WENT", "detail": "Each minute how far the train had got and how many were alive; at the end, how it ended, how long it ran, the cars and cargo delivered and lost, the scrip it made, who came home, and the deaths and creatures counted.",
      "fields": "minute.km, alive, crew; nightEnd.end, seconds, km, carsDelivered, carsLost, cargoDelivered, net, crewHome, crewLost, deaths, encounters" },
    { "what": "DEATHS", "detail": "When and where along the line someone died, of what, what they were doing (driving, on a gun, walking), and whether it was you.",
      "fields": "death.s, km, cause, post, me" },
    { "what": "WHAT HAPPENED", "detail": "The kinds of incidents and creatures met: where, when they closed in and when it ended, the grabs and how it came out. Never the incident's words, which name people.",
      "fields": "incident.kind, cause; encounter.kind, channel, where, part, afoot, engagedAt, confrontedAt, nearAt, grabs, punishes, end, endedAt" },
    { "what": "LEARNING THE GAME", "detail": "How long it took to first move, take a job, stop and deliver; which prompts were shown and acted on; the menus you opened and for how long; the keys you rebound.",
      "fields": "first.what, s; prompt.name, acted; menu.name, seconds; rebind.control" },
    { "what": "THE FORTRESS", "detail": "What was bought between nights, what it cost, and the scrip left.",
      "fields": "purchase.what, cost, scripAfter" },
    { "what": "HOW IT RAN", "detail": "Each minute the frames drawn, how smooth they were and the stutters, and your connection's ping and loss.",
      "fields": "minute.frames, hitches, p50, p95, p99, pingMs, loss; nightEnd.hitches, p50, p95, p99" },
    { "what": "LEAVING", "detail": "How and when a night or the game was left: from the menu, closed, dropped or put off.",
      "fields": "quit.how, night, s" },
    { "what": "YOUR ANSWERS AFTER A NIGHT", "detail": "In a playtest only: how fun and how frightening the night was and whether you'd play again (1 to 5), a comment if you choose to write one, whether you skipped the questions, and the playtest's code, which groups the testers' nights.",
      "fields": "survey.fun, fear, again, comment, skipped; session.cohort" }
  ],

  // What it never collects, said as plainly.
  "never": "Never: your name or player name, your Steam or Epic id, your IP address, email, hardware serials, voice, chat, or anything you type but a comment you choose to write after a playtest's night.",

  // Where the data goes.
  "where": "Kept on this computer until a night is over, then sent to the studio when sending is switched on; kept there for {months} months, then deleted. Questions, or a deletion you can't do here: {contact}."
}
