// Playtest data (queue #625, note 914; the plan, note 907): what the game says about recording a player's nights, and the "what
// we collect" page in Settings. Anonymous (a random install id, nothing that names them), and deleted on request.
// The director, 21 Oct (`n1-N1-playtest-consent`, note 968): "This is the right idea but it sounds too legalize, remove all the
// legal sounding stuff and keep it indie dev casual. Playtest data is on by default and there's an option in the menu to turn
// it off. Keep it a small line at the bottom of the home menu screen only on first boot up." So it's on by default, the first
// boot says so in firstBootLine, and the page is plain words. firstBootLine "" puts back #625's question (and note 946's
// playtest notice), drafted for Quebec's Law 25, PIPEDA and the GDPR, with the retention and the contact below.
{
  // Raised whenever what's collected or why changes: everyone who said yes to an older notice is asked again (or, with
  // firstBootLine, shown the line again).
  "version": 3,

  // Note 968: the director's own words, small at the foot of the title menu on the first boot only. Set, playtest data is on
  // in every build and nothing asks; "" puts the question back.
  "firstBootLine": "Playtest data is recorded to help me improve game balancing. You can turn this off in the menu if you want.",

  // How long a session's data is kept on the studio's side once it's sent (#626), in months.
  "retentionMonths": 12,

  // Who answers questions about it and acts on deletion requests (Law 25's person in charge of personal information).
  "contact": "nsmith@squidostudio.com",

  // The first-run question: a title, then its lines.
  "question": "HELP US TUNE THE GAME?",
  "ask": [
    "Dark Territory is still being built. With your yes, the game keeps a record of how your nights go (how far the train got, what killed whom, where people got stuck in the menus, how smoothly it ran) so we can make it better.",
    "It's anonymous: a random number for this install, never your name, your Steam or Epic account, your address, your voice or anything you type, except a comment you choose to send after a playtest's night. Nothing is recorded unless you say yes, and you can turn it off or delete it at any time in Settings."
  ],

  // Shown on that screen in a developer build, where it's on unless the player says no.
  "devBuild": "This is a developer build: playtest data is on unless you say no.",

  // A playtest build's first run (note 946; the director, the inbox, 20 Oct: "On by default in playtest builds, with an off
  // switch"): it's on already, so a notice rather than the question, its off switch beside OK. {code} its playtest's code.
  "onByDefaultTitle": "THIS PLAYTEST RECORDS YOUR NIGHTS",
  "onByDefault": [
    "This is a playtest build ({code}). Playtest data is on: the game keeps a record of how your nights go (how far the train got, what killed whom, where people got stuck in the menus, how smoothly it ran), so this playtest can make the game better.",
    "It's anonymous: a random number for this install, never your name, your Steam or Epic account, your address, your voice or anything you type, except a comment you choose to send after a night. TURN IT OFF here, or any time in Settings, PLAYTEST DATA, and nothing more is recorded; DELETE there removes what was."
  ],

  // Who keeps the data for the studio once it's sent (note 946; #637, the PostHog sink).
  "thirdParty": "Sent to PostHog, an analytics service that keeps it for the studio and does nothing else with it. Nothing is sent while playtest data is off.",

  // Shown on that screen in a playtest build (#628, note 916; tools/package.sh --playtest), {code} its playtest's code.
  "playtestBuild": "This is a playtest build ({code}): saying yes is what makes your nights count for it, and no is still fine.",

  // The "what we collect" page: every group of fields the session recorder (#624, note 913) writes, in plain words (note 968), each
  // with the schema's fields it covers (a test holds the page to the schema).
  "collect": [
    { "what": "THIS INSTALL", "detail": "A random id for this copy of the game (a new one if you delete), the game's version, your operating system, graphics card, PC or VR, and your display settings.",
      "fields": "session.session, install, build, commit, edition, dev, os, gpu, vr, resolution, renderScale, vsync, fov" },
    { "what": "THE NIGHT'S SETUP", "detail": "Whether you hosted, joined or played alone, the route, the cars, and how many people and bots came along. No names.",
      "fields": "night.role, route, tier, cars, humans, bots" },
    { "what": "HOW THE NIGHT WENT", "detail": "How far the train got each minute and who was still alive; at the end, how it ended, the cars and cargo delivered, the scrip, who made it home and what killed them.",
      "fields": "minute.km, alive, crew; nightEnd.end, seconds, km, carsDelivered, carsLost, cargoDelivered, net, crewHome, crewLost, deaths, encounters" },
    { "what": "DEATHS", "detail": "When and where someone died, what got them, and what they were doing at the time.",
      "fields": "death.s, km, cause, post, me" },
    { "what": "WHAT HAPPENED", "detail": "Which creatures and trouble showed up, where and when, and how it went.",
      "fields": "incident.kind, cause; encounter.kind, channel, where, part, afoot, engagedAt, confrontedAt, nearAt, grabs, punishes, end, endedAt" },
    { "what": "LEARNING THE GAME", "detail": "How long it took to get moving, take a job, stop and deliver; which tips you saw and used; the menus you opened; the keys you changed.",
      "fields": "first.what, s; prompt.name, acted; menu.name, seconds; rebind.control" },
    { "what": "THE FORTRESS", "detail": "What you bought between nights and what it cost.",
      "fields": "purchase.what, cost, scripAfter" },
    { "what": "HOW IT RAN", "detail": "Your frame rate and stutters each minute, and your ping and packet loss.",
      "fields": "minute.frames, hitches, p50, p95, p99, pingMs, loss; nightEnd.hitches, p50, p95, p99" },
    { "what": "LEAVING", "detail": "How and when you left a night or the game.",
      "fields": "quit.how, night, s" },
    { "what": "YOUR ANSWERS AFTER A NIGHT", "detail": "In a playtest: your 1 to 5 answers after a night (fun, scary, play again) and the playtest's code. A comment only if you write one and tick SEND MY WORDS TOO.",
      "fields": "survey.fun, fear, again, comment, skipped; session.cohort" }
  ],

  // What it never collects, said as plainly.
  "never": "Your name, your Steam or Epic account, your IP address, your voice, chat, or anything you type (except a comment you choose to send).",

  // Where the data goes.
  "where": "Kept on this computer until a night is over, then sent to the studio when sending is switched on; kept there for {months} months, then deleted. Questions, or a deletion you can't do here: {contact}."
}
