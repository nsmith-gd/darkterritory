// Playtest data (queue #625, note 914; the plan, note 907): what the game asks a player before it records anything about
// their nights, and the "what we collect" page in Settings. Off unless the player says yes; anonymous (a random install id,
// nothing that names them); deleted on request. The wording and the retention are the director's to approve (the inbox,
// `n1-N1-playtest-consent`): drafted for Quebec's Law 25, PIPEDA and the GDPR.
{
  // Raised whenever what's collected or why changes: everyone who said yes to an older notice is asked again.
  "version": 1,

  // How long a session's data is kept on the studio's side once it's sent (#626), in months.
  "retentionMonths": 12,

  // Who answers questions about it and acts on deletion requests (Law 25's person in charge of personal information).
  "contact": "nsmith@squidostudio.com",

  // The first-run question: a title, then its lines.
  "question": "HELP US TUNE THE GAME?",
  "ask": [
    "Dark Territory is still being built. With your yes, the game keeps a record of how your nights go (how far the train got, what killed whom, where people got stuck in the menus, how smoothly it ran) so we can make it better.",
    "It's anonymous: a random number for this install, never your name, your Steam or Epic account, your address, your voice or anything you type. Nothing is recorded unless you say yes, and you can turn it off or delete it at any time in Settings."
  ],

  // Shown on that screen in a developer build, where it's on unless the player says no.
  "devBuild": "This is a developer build: playtest data is on unless you say no.",

  // The "what we collect" page: every group of fields the session recorder (#624, note 913) writes, in plain words.
  "collect": [
    { "what": "THIS INSTALL", "detail": "A random id made when you said yes (a new one after DELETE), the game's build and edition, your operating system and graphics card, your graphics settings, and PC or VR." },
    { "what": "THE CREW", "detail": "How many people and bots were aboard, and whether you hosted or joined. Never anyone's name." },
    { "what": "THE NIGHT", "detail": "The route and its tier, the cars, how far the train got, the stops made, who died of what and where along the line, the creatures met, cars lost, cargo delivered, how the night ended, and when anyone left or dropped." },
    { "what": "JOBS AND SCRIP", "detail": "Which jobs you took and for how long, the scrip earned and spent, and what was bought." },
    { "what": "GETTING STARTED", "detail": "How long it took to first move and to take a first job, which prompts were shown and which were acted on, the keys you rebound, and the menus you opened." },
    { "what": "HOW IT RAN", "detail": "Stutters, frame times, and the connection's ping and loss." }
  ],

  // What it never collects, said as plainly.
  "never": "Never: your name or player name, your Steam or Epic id, your IP address, email, hardware serials, voice, chat, or anything you type.",

  // Where the data goes.
  "where": "Kept on this computer until a night is over, then sent to the studio when sending is switched on; kept there for {months} months, then deleted. Questions, or a deletion you can't do here: {contact}."
}
