// CAPTIONS (ARCHITECTURE §8 note 349; GDD §32 "Accessibility"; the director, 8 Oct 2026: "these are all quite important").
// What a sound is, as someone hearing it would say it, never which creature makes it or what to do about it: a hearing
// player learns that tiptoeing means Tippy Toesie, and so does a reader. The silent-by-design creatures (the Gaunt, the
// Passenger, the Followers) have nothing here: there's nothing to hear.
{
  // How loud at the ear (linear gain, after distance and walls) before a sound is captioned: under it, it isn't heard.
  "threshold": 0.03,
  // How long a caption stays up after its sound was last heard (s), and how many are up at once (the newest kept).
  "holdSeconds": 2.5,
  "lines": 3,

  // A playing sound's name (or its name before a '.', "tippy-tiptoe.wood") and its caption.
  "sounds": {
    "tippy-tiptoe": "TIPTOEING",
    "child-call": "A CHILD CALLING",
    "hound-howl": "HOWLING",
    "tell-hounds.howl-near": "HOWLING, CLOSE",
    "dragger-scrape": "A SCRAPE AT THE EDGE",
    "climber-scrabble": "SCRABBLING",
    "hugger-grind": "GRINDING",
    "doll-giggle": "A CHILD GIGGLING",
    "fireflies-buzz": "BUZZING",
    "ribbit-swell": "A BUBBLING CROAK",
    "grumbler-gnaw": "GNAWING",
    "stoker-hiss": "THE FIRE HISSING",
    "drift-rustle": "REEDS RUSTLING",
    "sleepers-writhe": "SOMETHING WET ON THE RAIL",
    "car-fire": "FIRE CRACKLING",
    "choir-voice": "VOICES SINGING",
    "train-whistle": "THE WHISTLE",
    "crew-mishaps.whistle-wheeze": "THE WHISTLE, WHEEZING",
    "toy-squeaker": "A TOY SQUEAKING",
    "toy-musicbox": "A MUSIC BOX",
    "toy-drummer": "A TOY DRUM",
    // Signs (note 327): something moving out there, heard as it is. Since note 342 they're their own sounds (sign.<kind>);
    // the creatures' own movement is what plays where there's none, and when it's on you.
    "sign.ribbits": "SOMETHING HOPPING",
    "sign.sootChildren": "SMALL FEET IN THE CINDERS",
    "sign.whistler": "SOMETHING IN THE BRUSH",
    "sign.grumbler": "SCUTTLING",
    "cs-ribbits.hop-land": "SOMETHING HOPPING",
    "cs-grumbler.scuttle": "SCUTTLING",
    // The tells since (note 391): by the line, and by the cue where a line's cues say different things. The Moose
    // listening is silence, and so is the Gannet hanging over a walker: nothing to hear, nothing to caption.
    "tell-moose-grazing": "CHEWING",
    "tell-moose-warning": "A COUGHING GRUNT",
    "tell-moose-square-up": "STAMPING AND SNORTING",
    "tell-moose-charge": "HOOVES, CHARGING",
    "cs-moose-ram.boom": "A BOOM AGAINST THE CAR",
    "tell-gannet-calls.call": "HARSH CALLS ABOVE",
    "tell-gannet-calls.wings": "WINGBEATS ABOVE",
    "tell-gannet-fold": "AIR WHISTLING, FALLING",
    "tell-gannet-bank.scream": "A SCREAM, COMING IN",
    "tell-gannet-bank.wingbeats": "WINGBEATS, CLOSING",
    // The train's jobs that call for a hand (notes 346, 356): heard, so a reader is called too.
    "lamp-gutter": "A LAMP SPUTTERING",
    "coupling-loose": "KNOCKING AT A COUPLING",
    "state-coupling-loose": "KNOCKING AT A COUPLING",
    "hotbox": "A SQUEAL AT THE WHEELS",
    "heap-groan": "THE HEAP GROANING",
    "boiler-strain": "THE BOILER SHRIEKING",
    "state-strain.groan": "THE BOILER SHRIEKING",
    "safety-valve": "THE SAFETY VALVE",
    "state-valve.blow": "THE SAFETY VALVE",
    // The village houses' doors (note 409): a door shut is the Choir's rule ("behind a closed door"), so a reader is told
    // one's shut or opened as a hearing player is; and shut in anywhere while they besiege it, the beating on its door.
    "crew-house-door.shut": "A DOOR SLAMMING SHUT",
    "crew-house-door.open": "A DOOR CREAKING OPEN",
    "cs-choir.bang-door": "BANGING ON THE DOOR",
    // A truss's Dragger (note 444): its weight landing on the roof of a car with someone on it, before its grab; with
    // nobody up there, its fall onto the track behind.
    "cs-draggers.drop": "SOMETHING HEAVY LANDING ON THE ROOF",
    "cs-draggers.fall": "SOMETHING FALLING ONTO THE TRACK BEHIND",
    // The grain elevator's conveyor (note 466): its engine starting, a jam (the belt bunching, then the drive labouring with
    // the belt squealing on its drum, which goes on out of sight down the belt), and the engine dying under one left.
    "place-conveyor.catch": "AN ENGINE STARTING",
    "place-conveyor.jam": "A BELT JAMMING",
    "place-conveyor.labour": "A BELT SQUEALING, AN ENGINE LABOURING",
    "place-conveyor.stall": "AN ENGINE DYING",
    // The extinguisher on a fire (note 469; the director, 8 Oct: holding it on a fire "doesnt feel like its doing anything"):
    // a reader is told the jet's on the flames, a patch of them going out, and the fire out, as a hearing player is.
    "crew-extinguisher.on-fire": "WATER HISSING ON THE FLAMES",
    "crew-extinguisher.cell-out": "FLAMES HISSING OUT",
    "crew-extinguisher.fire-out": "THE FIRE OUT, STEAM HISSING",
    // A capstan winch's cranks out of rhythm (note 468; D.2's desync): the drum snatched to a stop.
    "place-winch.stall": "A WINCH JARRING TO A STOP"
  }
}
