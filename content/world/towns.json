// The fortress towns' writing (GDD §3.1, App. F.1 T133: "fortress towns are where the world is built ... each town has
// its own odd culture, different from the last ... learn by inference, as in Lethal Company: little notes, and text-only
// lines from the townspeople"; ARCHITECTURE §8 note 278). The numbers (how many people, notices, reach) are in
// tuning/towns.json; this file is only words, read by Sim/Towns/TownGenerator.
//
// How a town is written. GDD §2: "the Corruption exaggerates whatever allows something to survive". A town did the
// same: whatever kept it alive one bad winter, it kept doing, and did harder, until it was the town's custom. So each
// culture is the human answer to one creature's rule (by the names in enemies.json "costs"; "choir" is always about),
// told sideways: the crew hear the custom, and the rule is theirs to infer. A town's people name the creatures in their
// own words ("the little lights", "the thin one"), never the game's. Mystery is seeded, not explained (App. F.1).
//
// Text is written in sentence case and drawn in the HUD's capitals. Keep a person's line under ~150 characters and a
// note under ~420 (TownTests holds both). Placeholders: {town} this town, {other} another town down the line, {name}
// somebody else in this town, {n} a small number.
{
  // Townspeople's given names; their surnames come from linegen/names.json, like the places.
  "firstNames": ["Agnes", "Albin", "Ada", "Bram", "Bettany", "Cass", "Clem", "Dora", "Edda", "Elias", "Enid", "Fen", "Gil",
    "Greta", "Hal", "Hester", "Ida", "Ivo", "Jory", "Juno", "Kit", "Lark", "Lise", "Mags", "Marten", "Nell", "Noll", "Olwen",
    "Orrin", "Pim", "Prue", "Quin", "Ros", "Rufus", "Sal", "Silas", "Tam", "Tilde", "Ulla", "Vesna", "Wat", "Wynn", "Yorick", "Zillah"],

  // What the plaque at the square says under the town's name, one picked a town.
  "founded": ["Walled the winter after the fall.", "Held since the second winter.", "Never taken.", "Built round the old goods yard.",
    "Rebuilt twice. Not a third time.", "Walled by hand, by the people who lived."],

  // The gatekeeper's first words to a crew: the town's law ({law}), the one thing anyone here tells a stranger.
  "welcome": ["Welcome to {town}. {law} That's the only rule you'll need here.", "{town}. {law} Say it back. Good.",
    "{law} That's {town}'s rule. The next town will laugh at you for it. Let them.", "You're in {town} now. {law} Forget it outside if you like."],

  "cultures": [
    {
      "id": "hush", "creature": "choir",
      "law": "Speak low. Shut the door behind you.",
      "hall": "the Quiet House",
      "centrepiece": { "kind": "bell", "name": "the felted bell",
        "text": "A big iron bell in a timber frame, its clapper bound in felt and wire. Chalked on the frame: RUNG ONCE." },
      "lines": [
        "Lower. Lower than that. There. Now you sound like you live here.",
        "You came in with your whistle going. Everyone heard. It's all right. It's the leaving they mind.",
        "We don't shout here. We don't sing. We had a choir once. We don't have a choir.",
        "Shut that door behind you. And the one behind that.",
        "My mother said they take the loudest first. She said it very quietly.",
        "Your engine's the loudest thing for forty miles. I'd keep the rest of you down."
      ],
      "notes": [
        { "title": "Quiet hours", "text": "Quiet hours in {town} are all hours. Boots off on the boards after dark. No whistles inside the walls. Anyone shouting will be asked once." },
        { "title": "To the Quiet House", "text": "Please return the felt for the bell. It was on the clapper on Tuesday. If you have it, leave it on the step and say nothing." },
        { "title": "Found in a coat", "text": "Count the doors before you sleep. If one is open, don't call out to ask who opened it." }
      ]
    },
    {
      "id": "pairs", "creature": "tippyToesie",
      "law": "Never stand alone. Never stand still.",
      "hall": "the Pairing Hall",
      "centrepiece": { "kind": "post", "name": "the waiting post",
        "text": "A post hung with iron rings, short cords knotted to them and worn smooth. Two cords to every ring. Nobody is tied to any of them." },
      "lines": [
        "Where's your other? You don't stand about on your own. Not here.",
        "We're tied at the wrist till we're wed, and after that it's worse.",
        "If you're going to wait, walk while you wait. Little circles. Like this.",
        "{name} stood still by the pump one night. Just for a minute. Just to think.",
        "We don't say alone in {town}. We say short. Don't be short.",
        "Turn round now and then. It doesn't like being seen coming."
      ],
      "notes": [
        { "title": "Lost: one half", "text": "Answers to Edda. Last seen at the pump, standing. If you find her standing, do not come up behind her. Call her name from in front." },
        { "title": "Bench rules", "text": "Two to a bench. One on a bench is one too few. The warden will move you on." },
        { "title": "Pairs for the wall walk", "text": "Tonight's pairs are posted in the Pairing Hall. If your pair is sick, you are sick too." }
      ]
    },
    {
      "id": "count", "creature": "passenger",
      "law": "Say your name when you're counted.",
      "hall": "the Counting House",
      "centrepiece": { "kind": "tally", "name": "the tally board",
        "text": "A black board ruled in chalk: a column of names, and tonight's marks against them. There is one more mark than there are names." },
      "lines": [
        "Say your name. Out loud. Thank you. We had a quiet one once.",
        "We count at every bell. If the count's long, we start again, and nobody leaves the room.",
        "A man who won't say his name isn't shy. Not out there.",
        "We count the crews out and we count them in. Mostly the same number. Mostly.",
        "If one of yours goes quiet tonight, count again. Out loud.",
        "Forty-one at the last bell. Forty-two marks. We're still recounting."
      ],
      "notes": [
        { "title": "The count", "text": "All persons inside the walls will answer at the bell by name. Nods are not answers. Persons who do not answer will be helped to." },
        { "title": "From the night mail's log", "text": "Left {other} with nine. Counted ten at the water stop. Counted nine again at the bridge. Nobody saw anyone get off." },
        { "title": "Chalk", "text": "Chalk is for the board only. Do not write your name on anything you leave behind." }
      ]
    },
    {
      "id": "shutters", "creature": "fireFlies",
      "law": "Light what you need. Shutter the rest.",
      "hall": "the Lamp Store",
      "centrepiece": { "kind": "lamps", "name": "the shuttered lamps",
        "text": "Racks of lanterns, every one with a tin shutter closed over its glass. A sign: OPEN TO SEE. SHUT WHEN SEEN." },
      "lines": [
        "A lamp's for seeing by. It isn't company. Shut it when you've seen.",
        "When the little lights come, you put yours out. Every one. Then you sit in the dark and wait.",
        "Your cars are lit like a fair. Pretty. They'll think so too.",
        "We lost the east row to a lamp left burning in a hayloft. Burned blue, they said.",
        "Our children learn the town in the dark first. Then we show them where the lamps are.",
        "Moving's fine. It's stopping with your lamps lit."
      ],
      "notes": [
        { "title": "Lamp orders", "text": "No lamp to be left lit in an empty room. No lamp in a window. Wardens will shutter any lamp found on its own." },
        { "title": "Lost", "text": "One brass lamp, shutter broken. If found lit, do not carry it in. Leave it where it is and walk away." },
        { "title": "Said at the gate", "text": "The little lights don't come to the dark, and they don't come to a train that's moving. Remember both." }
      ]
    },
    {
      "id": "talkers", "creature": "gaunt",
      "law": "Keep talking. Never let it go quiet.",
      "hall": "the Reading Room",
      "centrepiece": { "kind": "horn", "name": "the reading horn",
        "text": "A loudspeaker horn on a pole, crackling. A voice reads names, the weather and a recipe for turnip soup. It has been reading all night." },
      "lines": [
        "Don't stop talking on my account. Nobody here stops. Tell me about your train. Anything.",
        "The horn reads all night. When it stops, we all start. Doesn't matter what you say.",
        "Quiet's the worst thing you can give it. Give it nonsense. Give it your mother's recipes.",
        "There's a thin one out by the old yards. Follows anyone who goes quiet on it. Keep it company and it's no trouble.",
        "I talk in my sleep. My wife says it's saved us twice.",
        "You're a quiet lot. You'll want to fix that before the villages."
      ],
      "notes": [
        { "title": "Readers wanted", "text": "The horn needs readers for the small hours. Any voice will do. No experience needed. Bring something long." },
        { "title": "Rules of the Reading Room", "text": "One. Read aloud. Two. If you lose your place, keep talking until you find it. Three. Never stop in the middle of a sentence for it." },
        { "title": "Scrawled", "text": "It was fine as long as Pell kept talking. Pell stopped to cough." }
      ]
    },
    {
      "id": "eyes", "creature": "sootChildren",
      "law": "Look them in the eye from five paces.",
      "hall": "the Glass House",
      "centrepiece": { "kind": "mirror", "name": "the looking glass",
        "text": "A tall mirror in an iron frame, a white line painted on the ground five paces in front of it. The glass is very clean." },
      "lines": [
        "Stop there. On the line. Look at me. ... Fine. Come in, then.",
        "You'll hear children out there, calling. Some of them are children.",
        "Check the eyes, then the hands. Black is no. Black is run.",
        "We brought a girl in from {other}. Real as you. She's the baker's now.",
        "Five paces. Not four. Four's too close to run from.",
        "Bring a real one home and they'll pay you more than your train's worth. Get it wrong once."
      ],
      "notes": [
        { "title": "At the gate", "text": "All persons stop at the line and show their eyes. All persons. The gatekeeper has a mother too." },
        { "title": "Reward", "text": "Children found living beyond the walls will be paid for at the gate. Look first. Look properly. Look from the line." },
        { "title": "Pinned to a door", "text": "She called me by my name. I never told her my name." }
      ]
    },
    {
      "id": "offerings", "creature": "trackDoll",
      "law": "Stop for her on the line. Give her the toys.",
      "hall": "the Shelf House",
      "centrepiece": { "kind": "shelf", "name": "the toy shelf",
        "text": "A long shelf nailed up inside the wall, worn pale where things have stood on it. It's empty. There are small prints in the dust." },
      "lines": [
        "We give the toys to the line. She's never once come through the gate. Never once.",
        "If she's on the rails, you stop. You don't ring, you don't slow. You stop.",
        "Our children have no toys. They know why. They don't mind. Mostly.",
        "Hit her and she rides home with you. She likes the cab when nobody's in it.",
        "She likes the noisy ones best. Music boxes. Anything that winds.",
        "You see her face in your lamp, you've about two hundred metres. Use them."
      ],
      "notes": [
        { "title": "Given this month", "text": "One tin drum. One rag rabbit. One music box, wound. One spinning top. One china cup (refused, returned)." },
        { "title": "Notice", "text": "Toys found in the yards go on the shelf, not in pockets. She knows the difference." },
        { "title": "Driver's card", "text": "Doll on the line: stop short. Doll aboard: give her something. Doll at the controls: everyone to the cab." }
      ]
    },
    {
      "id": "rulebook", "creature": "whistler",
      "law": "Rule nine. Never answer a whistle you didn't blow.",
      "hall": "the Rule Hall",
      "centrepiece": { "kind": "lectern", "name": "the rule book",
        "text": "A railway rule book chained to a lectern, thick as a brick and open at RULE 9: A WHISTLE NOT BLOWN BY YOUR CREW IS NOT A WHISTLE. CHECK BETWEEN THE CARS." },
      "lines": [
        "Rule nine. Never answer a whistle you didn't hear blown. Say it back to me.",
        "We read a rule at every meal. Last night was fifty-five. Protect a stopped train.",
        "Your whistle goes on its own while you're stopped, you look between the cars. All of them.",
        "The rule book's older than the comet. It was right about everything but that.",
        "Moving, you're a train. Stopped, you're a larder.",
        "We lost a fireman to rule nine. He went to see who'd pulled the cord."
      ],
      "notes": [
        { "title": "Tonight's rule", "text": "Rule 55. When a train is stopped, a member of the crew shall go back and protect it. He shall not go alone." },
        { "title": "Rule 9 (amended)", "text": "A whistle not blown by your crew is not a whistle. Do not answer it. Check every gap. Then check them again." },
        { "title": "In the margin", "text": "They take you somewhere first. They don't eat you straight off. Somebody could come for you, if they were quick." }
      ]
    },
    {
      "id": "banked", "creature": "stoker",
      "law": "Bank the fires at dark. Keep the gauge cool.",
      "hall": "the Furnace Hall",
      "centrepiece": { "kind": "brazier", "name": "the banked fire",
        "text": "A great iron brazier, its fire banked to a dull red under ash. Tongs and a poker lie across it. The poker is bent nearly double." },
      "lines": [
        "Run hot and you'll have company in your firebox. Ask anyone who used to live on the east street.",
        "It comes up out of the coal, glowing. You'll see it if you're watching the coal.",
        "If it's in, you don't open the door. You starve it. Vent and wait.",
        "We bank every fire at dark. We'd sooner be cold than have it visit.",
        "A cool gauge is a slow train. A slow train gets home.",
        "The bent poker was my uncle's. He opened the door on it."
      ],
      "notes": [
        { "title": "Fire orders", "text": "All fires to be banked at dark. No fire to run above the red mark. A fire found above the mark will be put out by the warden." },
        { "title": "In the firemen's book", "text": "If it's in the box, don't open the door. Starve the fire right down. It goes back the way it came, over the coal. Give it a few minutes before you fire up again." },
        { "title": "Lost", "text": "Water hose, brass nozzle, from the Furnace Hall. Whoever has it: it's the only thing that works on it." }
      ]
    },
    {
      "id": "crown", "creature": "draggers",
      "law": "Keep to the crown of the road.",
      "hall": "the Road House",
      "centrepiece": { "kind": "line", "name": "the white line",
        "text": "A white line painted down the middle of the square, worn deepest along its very centre. Nothing stands within a pace of the edges." },
      "lines": [
        "Keep to the middle. Of the road, of the roof, of everything.",
        "Edges are for falling off. That's what they've always been for. Something helps now.",
        "On your roofs you walk the ridge. Never the edge. Not even to look over.",
        "If something takes you by the ankle, shout. Someone pulls, or you go over. One or the other.",
        "We built the houses back from the road. Not for the light.",
        "Handrails are worth every scrip. Tell your clerk I said so."
      ],
      "notes": [
        { "title": "Road orders", "text": "Walk the crown. Carts the crown. Children the crown. Anyone found at the edges after dark will be fined, if found." },
        { "title": "To the roofers", "text": "Ridge only. Ridge only. RIDGE ONLY." },
        { "title": "In the margin", "text": "Two seconds, maybe three. That's how long you've got to pull somebody back up. Practise." }
      ]
    },
    {
      "id": "backs", "creature": "followers",
      "law": "Check each other's backs.",
      "hall": "the Brushing House",
      "centrepiece": { "kind": "pegs", "name": "the coat pegs",
        "text": "A long row of pegs, every coat on them hung back to front. Each one has been brushed down the back, hard." },
      "lines": [
        "Turn round. ... You're clear. Me? Go on, then. Properly.",
        "You can't see your own back. Nobody can. That's the whole of it.",
        "We brush each other down at the gate. Coats, shoulders, collars. You'd be surprised what rides in.",
        "It's small. Hand-sized. It sits where you can't look. Your friends can.",
        "If one gets aboard, it'll nest in the best you've got. Look in your best car first.",
        "Ask someone to look at your back before you go out. Then ask someone else."
      ],
      "notes": [
        { "title": "At the gate", "text": "All persons coming in will be brushed down the back by the gate warden. All persons going out will brush each other." },
        { "title": "Nailed up", "text": "Rode in on Halloway: one. Rode in on Grieve: one. Rode in on the gate warden: nobody checked." },
        { "title": "Advice to crews", "text": "If your loot car smells of wet hay, don't put your hand in. Take a lamp in first." }
      ]
    },
    {
      "id": "fours", "creature": "ribbits",
      "law": "Go out in fours. Never fewer.",
      "hall": "the Four House",
      "centrepiece": { "kind": "bench", "name": "the four bench",
        "text": "A bench long enough for four, four hooks over it and a lamp on each hook. A sign: FOUR OUT. FOUR BACK." },
      "lines": [
        "Four out, four back. Three's a meal, two's a snack, one's nothing at all.",
        "They come in twos and threes and fours. They leave alone anything as big as they are.",
        "If one gets its tongue on you, you can't move. Your friends can. That's what friends are for.",
        "We had a five once. Five's lovely. Nobody's got a five any more.",
        "They're slow if you run. Nobody runs. Everyone thinks they'll be fine standing.",
        "Count them. Count you. If they've got more, walk away together."
      ],
      "notes": [
        { "title": "Wall walk", "text": "Fours only. A three will be sent back. A two will not be let out." },
        { "title": "Lost", "text": "One boot, left, from a three that went out on the {other} road. No need to return it." },
        { "title": "Chalked on the bench", "text": "they hop" }
      ]
    },
    {
      "id": "lastCar", "creature": "carHugger",
      "law": "Ride nothing in the last car you'd mind losing.",
      "hall": "the Car Shed",
      "centrepiece": { "kind": "carriage", "name": "the bitten van",
        "text": "The front half of an old goods van on blocks. The back half is gone, bitten off in one ragged curve. Someone has painted the bite white, so you can see how big it was." },
      "lines": [
        "Nothing in your last car you'd mind losing. Not cargo, not people. Especially not people.",
        "It takes the back car and eats it, shell and all. You cut it loose, or you go back and kill it.",
        "Your speed drops when it's on. You feel it before you hear it.",
        "Stand in front of its mouth and you're cargo too.",
        "Three of you can kill it quick. One of you can kill it slow.",
        "We cut a last car loose once. Watched it roll off into the dark with the thing still on it, chewing."
      ],
      "notes": [
        { "title": "Loading orders", "text": "Nothing of value in the last car. The last car is for empties, ballast and bad apples." },
        { "title": "Wanted", "text": "Couplings, any condition. Ours keep going." },
        { "title": "From the clerk", "text": "The clerk does not pay out on last cars. Read your contract." }
      ]
    },
    {
      "id": "backGun", "creature": "cinderHounds",
      "law": "Keep a gun on the back road.",
      "hall": "the Gun House",
      "centrepiece": { "kind": "cannon", "name": "the old gun",
        "text": "A short iron cannon on a timber carriage, aimed back up the line the trains come in on. Its brass ring has been polished every night for years." },
      "lines": [
        "They run behind. Always behind. The gun at your back is the only thing they mind.",
        "They gain on the climbs. On the flat you're fine. Uphill, have the back gun crewed.",
        "Any that get aboard don't get off. They eat what you're carrying and set the car going.",
        "Livestock draws them. So does a hot boiler. You've got both, I'd crew the back.",
        "Loud, the gun. That's the price of it.",
        "You'll hear paws on the iron before you see anything."
      ],
      "notes": [
        { "title": "Gun drill", "text": "Back gun loaded before the throat. Back gun crewed past the last light. No exceptions for weather, tiredness or cards." },
        { "title": "Lost", "text": "One dog. Brown. Not ours. Not a dog." },
        { "title": "Tally", "text": "Driven off: {n}. Boarded: 2. Got off again: 0." }
      ]
    }
  ],

  // A town's smaller habits, one or two a town, on top of its culture: what makes the next town with the same culture
  // still a different place. None of them is a creature's rule.
  "quirks": [
    { "id": "names", "habit": "children aren't named till their first winter",
      "lines": ["My name? I've not had it long. Got it when I was nine. We wait, here.", "Don't name a thing till it's lasted a winter. Goes for trains too."],
      "notes": [{ "title": "Named this winter", "text": "Ash. Ivo. The Grieve boy. The girl from the east street. The goat." }] },
    { "id": "coats", "habit": "they wear their dead's coats",
      "lines": ["This was my brother's coat. Fits better than it did on him, he'd say.", "Everyone's coat here was somebody's. Mine was three people's."],
      "notes": [{ "title": "Coats", "text": "Coats of the departed to be brought to the hall for fitting. Pockets to be emptied first. Mostly that's notes." }] },
    { "id": "midnight", "habit": "the whole town eats together at midnight",
      "lines": ["Supper's at midnight. Everyone. That way we know who's missing before we start.", "You'll miss supper. Shame. There's always a place laid for a crew."],
      "notes": [{ "title": "Supper", "text": "Midnight, the long table. Places are laid for everyone on the list. Do not sit at a place that isn't yours, even if it's empty. Especially then." }] },
    { "id": "goats", "habit": "they keep goats on the roofs",
      "lines": ["Goats on the roofs. Up there they see things coming, and they make a fuss about it.", "Don't laugh at the goats. The goats have saved this town more times than the guns."],
      "notes": [{ "title": "Goat watch", "text": "Any goat bleating after dark is to be reported to the wall. Any goat not bleating after dark is also to be reported." }] },
    { "id": "redDoors", "habit": "every door is painted red",
      "lines": ["Red doors. So you can find yours in the dark. Or so something can't. Depends who you ask.", "Paint's the one thing we've never run short of. Funny, that."],
      "notes": [{ "title": "Paint", "text": "Doors to be repainted red by the end of the month. Scrape the old first. Do not look too closely at what's under it." }] },
    { "id": "clocks", "habit": "every clock in town stopped at the same minute",
      "lines": ["Ten past four. Every clock in town. We leave them be. Feels rude to wind them.", "We tell the time by the trains. Yours is the last one tonight."],
      "notes": [{ "title": "Clock repairs", "text": "The clockmaker is no longer taking work. The clockmaker asks that you stop bringing him the clocks." }] },
    { "id": "pigeons", "habit": "they still keep pigeons for the post",
      "lines": ["Pigeons don't fly at night any more. We keep them anyway. They remember the way.", "Last bird back from {other} came in without its message. Came in without its feet."],
      "notes": [{ "title": "Pigeon post", "text": "No birds out till the sky's grey. No birds back from {other} since spring." }] },
    { "id": "owing", "habit": "everyone owes everyone",
      "lines": ["You owe me for that look. Everyone owes everyone here. Keeps people coming back.", "My father died owing {name} a shovel. We're still paying it off."],
      "notes": [{ "title": "Owed", "text": "To {name}: one shovel, one lamp glass, one apology. Interest as agreed." }] },
    { "id": "gateWeddings", "habit": "they marry at the gate, so a crew can witness",
      "lines": ["We marry at the gate, so the train crews can witness. You'd do. Got a tie?", "Crews are lucky at a wedding. Unless they're the last crew out. Then they're very unlucky."],
      "notes": [{ "title": "Banns", "text": "{name} and {name2} will be married at the gate when the next crew is in. Objections to the clerk. Witnesses wanted." }] },
    { "id": "salt", "habit": "salt on every sill",
      "lines": ["Salt on the sill. Doesn't stop anything. Makes us feel better.", "We trade our salt for coal. We'd trade it for anything. Except the sills."],
      "notes": [{ "title": "Salt", "text": "One cup per sill per week. Any more is waste. Any less is your own lookout." }] },
    { "id": "lastWords", "habit": "they write down everyone's last words",
      "lines": ["We write down everyone's last words. Most of them are 'what was that'.", "The book of last words is in the hall. You're welcome to read it. Don't add to it."],
      "notes": [{ "title": "From the book of last words", "text": "'Who left this here?' 'I'll only be a minute.' 'It's fine, it's one of ours.' 'Shh.'" }] }
  ],

  // What the town makes (linegen tiers.json fortress "identities"; GDD §3: "one settlement produces coal ...").
  "industries": {
    "coal": { "hand": "pit hand", "name": "a pit town",
      "stalls": ["Lamp wicks, a tray of pit tallies with names stamped on them, one canary cage with the door open.",
        "Boots, mostly left ones. A card: RIGHT BOOTS FROM THE PIT, ASK AT THE HEADFRAME."],
      "lines": ["Night shift comes up at first light. We don't ask them what they heard down there. They tell us anyway.",
        "Every bit of coal in your tender came up through that headframe. You're welcome.",
        "The seam runs under the wall and out. We follow it as far as the lamps reach. Then we stop."],
      "notes": [{ "title": "Pit notice", "text": "Shift change at the bell. Lamps checked out and checked in. A lamp not checked in is a man not checked in." },
        { "title": "Tonnage", "text": "This week: {n}00 tons up. {n} props lost. Seam C closed until further notice. Do not ask about seam C." }] },
    "farm": { "hand": "grower", "name": "a growing town",
      "stalls": ["Turnips, potatoes, the odd onion under a sack. Nobody minding it. Nobody needs to.",
        "Seed packets, tied in string, each one labelled with the name of the bed it came from and the year it last came up."],
      "lines": ["Grow lamps on every bed. The plants don't know it's dark. We don't tell them.",
        "The cattle sheds are under the wall. They're the safest cows in the territory. Sleep better than me.",
        "Everything on your train that isn't coal was grown in {town}. Mind it on the bends."],
      "notes": [{ "title": "Grow-lamp rota", "text": "Beds to be lit in turn. No bed to go dark for more than an hour. A bed gone dark is a bed lost." },
        { "title": "Market", "text": "Turnips, potatoes, the odd onion. Meat Thursdays. Do not ask what the pigs eat." }] },
    "foundry": { "hand": "foundry hand", "name": "a foundry town",
      "stalls": ["Nails, hinges, a box of cast iron saints. The saints are all facing the wall.",
        "Pans, kettles, a stove door. Everything still warm to the touch."],
      "lines": ["The furnaces never go out. You'll see the glow over the wall from miles off. So will everything else.",
        "Castings for half the line come out of here. Heavy as sin. Mind your feet under the crane.",
        "My hands haven't been cold in eleven years. Nothing else about me has been warm."],
      "notes": [{ "title": "Pour schedule", "text": "Pours at the bell. Nobody under the gantry while the ladle's up. Nobody. That means you, {name}." },
        { "title": "Wanted at the foundry", "text": "Strikers, pourers, a crane hand who can see the ground. Pay in scrip, coal and soup." }] }
  },

  // The jobs people do in the square: who stands where, and what the job makes them say. Each person gets one of these.
  "roles": {
    "gatekeeper": { "title": "gatekeeper", "lines": [
      "Gate opens when your wheels turn. Not before. Not for anyone.",
      "I count them out and I count them in. The numbers don't have to match. They usually do.",
      "Last crew out of this gate didn't come back. Paid up front, though. Fine people." ] },
    "clerk": { "title": "clerk", "lines": [
      "Freight's paid at the far gate, not this one. Bodies at seventy-five. I don't set the rates.",
      "Sign here. And here. That one's your next of kin. Leave it blank if it's each other.",
      "A car's a car whether it's full of coal or full of holes. We pay by what's in it." ] },
    "yardman": { "title": "yardman", "lines": [
      "Couplings greased, brakes bled. That's the last kind thing anyone does for you tonight.",
      "Mind the cars on the left road. Mind the cars on the right road. Mostly mind yourself.",
      "Your points are set for the gate. After that you set your own." ] },
    "fitter": { "title": "fitter", "lines": [
      "Your boiler's sound. Sound as anything round here. Don't let it sit at the red.",
      "The engineering kit lives in the fitter's locker. If it's not there, it's somewhere worse.",
      "Lose the kit and rupture the boiler and you're walking home. Nobody walks home." ] },
    "lampman": { "title": "lampman", "lines": [
      "Every lamp on your train was filled by me. If one goes out, it wasn't the oil.",
      "Smashed lamps I can fix. Smashed lampmen, less so.",
      "Keep a spare lamp in a locker. Keep a spare lampman, if you can find one." ] },
    "storekeeper": { "title": "storekeeper", "lines": [
      "Lamps, extinguishers, powder. Everything's dear. You're welcome to go and fetch it yourself.",
      "Spare engineering kit, little used. Previous owner doesn't need it now.",
      "I'd sell you luck if I had any. I sold the last of it to the crew before you." ] },
    "driver": { "title": "old driver", "lines": [
      "Drove the {other} road nineteen years. Never once stopped for anything on the line. That's the whole trick.",
      "Watch the bends on your map, not the bends in front of you. In front of you is too late.",
      "Driver's the one they blame. Driver's the one who's always in the cab. Think on." ] },
    "widow": { "title": "widow", "lines": [
      "My husband drove the night mail. They paid me seventy-five. I keep wondering what the other twenty-five was.",
      "Bring them home if you can. Even if it's only the coat.",
      "I meet every train. One day it'll be his." ] },
    "guard": { "title": "wall guard", "lines": [
      "We shoot what comes to the wall. Nothing comes to the wall. We still shoot.",
      "From up there you can see your train all the way to the first bend. Then you're the dark's.",
      "There's a lamp out past the last tower nobody lit. We don't go and look." ] },
    "cook": { "title": "cook", "lines": [
      "Eat now. Nobody eats out there. Well. Nobody you'd want to watch eating.",
      "Soup. It's always soup. Don't ask what's in it, and don't ask what's not.",
      "Crews get double. Not because you work harder. Because it's the last meal for some of you." ] },
    "keeper": { "title": "keeper of {hall}", "lines": [
      "You'll have read the board. Do as it says. It's not advice.",
      "We keep {hall} because somebody has to. And because the last keeper can't.",
      "Every custom in this town is a grave somebody didn't need." ] },
    // Not a job: what anyone in any town might say, when the rest has been said.
    "anyone": { "title": "townsman", "lines": [
      "Cold enough for you? It'll be colder out there. It's always colder out there.",
      "First night out? You've got the look. It wears off, one way or another.",
      "I had a cousin on the trains. Had.",
      "Bring us something back. Anything. We're not fussy.",
      "Don't stand there gawping. You'll miss your dawn.",
      "The quiet crews come back more often. Couldn't tell you why.",
      "Did you hear that? No? Good.",
      "If you see my brother out there, tell him the goat died.",
      "I've never been past the gate. I'm told it's much the same, only worse.",
      "Your lamps look low. Everybody's lamps look low. It's the dark, not the oil." ] },
    "porter": { "title": "porter", "lines": [
      "I carry what the crews leave behind. You'd be surprised how much of it is people.",
      "Mind the gap. That's a joke from before. Isn't one now.",
      "Your cars are loaded tight. Something in the third one's knocking. Probably the load." ] }
  },

  // Threads that run through the whole world, a scrap or two in each town (App. F.1: "some interactions give a scrap of
  // story; most is left to inference"). Nothing here is ever explained.
  "threads": [
    { "id": "fall",
      "lines": ["My grandmother saw it come down. She said the sky rang like a struck rail for a week.",
        "Comet glass hums if you hold it. Don't hold it near your teeth."],
      "notes": [{ "title": "Notice", "text": "Comet-derived material is not to be stored inside the walls. It is to be shipped. It is always to be shipped." }] },
    { "id": "lostTrains",
      "lines": ["The night mail left {other} with nine aboard. Dispatch heard it on the radio three nights after. Just the engine.",
        "There's a crew on the board at the station that's been due eleven years. We still leave a lamp in for them."],
      "notes": [{ "title": "Overdue", "text": "No. 41, the night mail. Nine crew. Due at {town} on the fourth. Still due." }] },
    { "id": "deadLines",
      "lines": ["{other} stopped answering in the spring. The line's still open. Somebody still throws the switches out there.",
        "When a town goes quiet, the lights stay on. That's the bit nobody likes."],
      "notes": [{ "title": "From the radio log", "text": "{other}, 02:10: all well. 02:40: all well. 03:10: all well. 03:40: all well, all well, all well." }] },
    { "id": "penal",
      "lines": ["They sent the convicts out to work the far yards. Forty men and two guards a car. It was the guards didn't come back.",
        "If you find a man in greys out there, he's probably fine. Probably."],
      "notes": [{ "title": "Wanted", "text": "Penal labour for the {other} yards. Free passage out. Passage back by arrangement." }] },
    { "id": "dispatch",
      "lines": ["Nobody's met Dispatch. Dispatch has never once been wrong about the line.",
        "Dawn opens the main line. Nobody here's seen the day trains. You only hear them."],
      "notes": [{ "title": "From Dispatch", "text": "Night freight is to clear the main line before first light. Dispatch accepts no responsibility for any train on the main line after first light." }] },
    { "id": "fees",
      "lines": ["The clerk pays seventy-five for a body brought home. It used to be eighty. Nobody asked why.",
        "If you see a lamp in a halt, someone's in there waiting for a train. Could be yours."],
      "notes": [{ "title": "Schedule of fees", "text": "Crew lost: the full fee. Crew lost, body brought home: a quarter of the fee. Crew lost, body brought home, still talking: see the clerk." }] }
  ],

  // A knock at one of the square's doors: the hall (the custom's house), the clerk's office, the stores. One a door, by
  // the town.
  "doors": {
    "hall": ["No answer. Someone inside says, very quietly: not tonight.", "Barred from inside. Through the door, somebody is reading aloud.",
      "A slot opens at eye height, looks at you, and shuts."],
    "office": ["Locked. A card in the glass: FREIGHT PAID AT THE FAR GATE. FEES PAYABLE REGARDLESS.", "Nobody in. Ledgers floor to ceiling, and one chair."],
    "store": ["Shut till the next crew's in. A card in the window: LAMPS. POWDER. EXTINGUISHERS. KITS. ASK THE CLERK.",
      "Locked. Through the window, a whole shelf of engineering kits, every one labelled with a crew's name."]
  },

  // Notices any town's board might carry.
  "notices": [
    { "title": "Rations", "text": "Bread: half. Coal: half. Lamp oil: as before. Complaints to the clerk, in writing." },
    { "title": "Crews wanted", "text": "Freight crews wanted for the {other} road. Must climb, carry and keep calm. Paid on delivery. Fees on non-delivery." },
    { "title": "Lost and found", "text": "Found: one left glove, one lamp glass, one name tag (Vane). Lost: Vane." },
    { "title": "From the wall", "text": "Lamps sighted past the last tower: {n}. Lamps we lit past the last tower: none." }
  ]
}
