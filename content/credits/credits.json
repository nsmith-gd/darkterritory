// The credits (note 390; GDD App. E.6): everyone whose work is in the game. The models, sounds and voices, textures and type
// are read from the content's own provenance (art/textures/index.json and index.models.json, audio/samples/index.json),
// so what ships is what's credited; the opera comes from audio/music/manifest.json. This file holds what those can't say: each
// section's line, the sound packs' names, the licences (a name, where to read it, its text when one has to ship) and the
// code the game is built with. THIRD-PARTY-NOTICES.txt beside it is generated from all of it (`dt credits --write`).
{
  // Under each section's heading, short enough for a row at 150% TEXT SIZE. Changed work says so: CC BY asks that changes
  // be indicated.
  "sections": {
    "models": "Cut up, recombined and rebaked for the game.",
    "sounds": "Cut, layered and processed for the game.",
    "textures": "Graded, tiled and rebaked for the game.",
    "type": "Lettering in textures; no font file ships.",
    "code": "The game and its engine are built on these."
  },
  // The sound packs by the name a source in audio/samples/index.json gives (the part before ':'). Empty is the game's own
  // (earlier: a cue's own earlier take, layered into another).
  "packs": {
    "earlier": "",
    "kenney_impact-sounds": "Impact Sounds, by Kenney (kenney.nl)",
    "kenney_rpg-audio": "RPG Audio, by Kenney (kenney.nl)",
    "kenney_ui-audio": "UI Audio, by Kenney (kenney.nl)",
    "sfx_100_v2": "SFX 100, volume 2"
  },
