// The stretcher (note 1052; upgrades.md §7.3: "carry a body ... up a ladder"): a body taken onto a ladder on it, the ash poles
// creaking and the canvas drawing taut as its weight comes onto the climber. Wood and cloth, close, under any tell (spec
// A.4). Tier 4, player actions. A synth definition; a recorded take can replace it through the audio checklist (AU1's).
{
  "tier": 4, "duration": 0.9, "maxInstances": 4, "minDistance": 1.5, "maxDistance": 25, "gainDb": -2,
  "layers": [
    // The poles' creak: a slow stick-slip through a wooden band.
    { "source": "impulse", "gain": 0.7, "frequency": 34, "filters": [{ "type": "bandPass", "frequency": 620, "q": 2.5 }],
      "envelope": [[0, 0], [0.05, 1], [0.45, 0.7], [0.7, 0]] },
    // The canvas drawing taut: a short soft rasp.
    { "source": "noise", "gain": 0.35, "delay": 0.08, "filters": [{ "type": "bandPass", "frequency": 2600, "q": 1.2 }],
      "envelope": [[0, 0], [0.04, 1], [0.25, 0]] }
  ]
}
