// Tell (tier 1), the Bruin (note 1007; docs/design/creatures/bruin.md §4): a deep chuffing huff with a wet whistle from the
// opened chest in it, 700-900 Hz: told from the Moose's bellow (higher, in the open) by that whistle. A synth stand-in
// until the audio chat builds takes from its line (cues.py "tell-bruin"); the huff's weight kept above the 150 Hz squish
// (the director's rule for one-shots): its body 150-300 Hz, the whistle what carries. Fired again at an uneven pace while it
// comes and feeds (GameAudio.BruinSounds).
{
  "tier": 1, "duration": 1.3, "maxInstances": 2, "minDistance": 4, "maxDistance": 60, "rolloff": 0.8, "gainDb": 7,
  "layers": [
    { "source": "noise", "gain": 1.0,
      "filters": [{ "type": "highPass", "frequency": 140, "q": 0.7 }, { "type": "bandPass", "frequency": 210, "q": 1.4 }],
      "envelope": [[0, 0], [0.05, 1], [0.35, 0.25], [0.5, 0], [0.62, 0], [0.68, 0.8], [0.95, 0.2], [1.1, 0]] },
    { "source": "saw", "frequency": 805, "gain": 0.22,
      "filters": [{ "type": "bandPass", "frequency": 820, "q": 9 }],
      "vibrato": { "rate": 7, "depth": 0.02 }, "pitchEnvelope": [[0, 0.94], [0.3, 1.03], [0.7, 0.97], [1.1, 1.02]],
      "envelope": [[0, 0], [0.1, 0.9], [0.4, 0.3], [0.55, 0], [0.66, 0], [0.75, 1], [1.05, 0.2], [1.2, 0]] },
    { "source": "noise", "gain": 0.25,
      "filters": [{ "type": "bandPass", "frequency": 780, "q": 4 }],
      "envelope": [[0, 0], [0.08, 1], [0.45, 0], [0.7, 0.8], [1.1, 0]] }
  ]
}
