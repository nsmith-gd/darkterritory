// Critical train state (tier 3, T117): steel dragged through ballast and earth while the wreck still moves. A screeching
// scrape that stutters as the car bites and slips, over a heavy rumble of earth. Its volume follows the fastest car still
// sliding, and it's at that car.
{
  "tier": 3, "loop": true, "maxInstances": 1, "minDistance": 8, "maxDistance": 700, "rolloff": 0.6, "gainDb": 4,
  "layers": [
    { "source": "noise", "gain": 0.9,
      "filters": [{ "type": "bandPass", "frequency": 2600, "q": 1.4 }, { "type": "peak", "frequency": 4100, "q": 5, "gainDb": 5 }],
      "tremolo": { "rate": 11, "depth": 0.6, "duty": 0.6, "jitter": 0.8 } },
    { "source": "noise", "gain": 1.2,
      "filters": [{ "type": "lowPass", "frequency": 220, "q": 0.8 }],
      "tremolo": { "rate": 3, "depth": 0.4, "duty": 0.7, "jitter": 0.7 } }
  ]
}
