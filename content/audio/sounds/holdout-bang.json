// GDD v1.4 App. D.7 Call Out (note 179), the other kind: a bout of banging on the Holdout's door from inside, fists on a
// steel door or a boarded window, five blows getting faster. Same rules as holdout-shout: 60 m, through walls, tier 3.
{
  "tier": 3, "duration": 1.4, "maxInstances": 2, "minDistance": 3, "maxDistance": 60, "gainDb": 10,
  "layers": [
    { "source": "impulse", "frequency": 1, "gain": 1.0,
      "filters": [{ "type": "bandPass", "frequency": 180, "q": 5 }, { "type": "bandPass", "frequency": 420, "q": 3 }] },
    { "source": "impulse", "frequency": 1, "gain": 0.9, "delay": 0.32,
      "filters": [{ "type": "bandPass", "frequency": 180, "q": 5 }, { "type": "bandPass", "frequency": 420, "q": 3 }] },
    { "source": "impulse", "frequency": 1, "gain": 0.95, "delay": 0.6,
      "filters": [{ "type": "bandPass", "frequency": 180, "q": 5 }, { "type": "bandPass", "frequency": 420, "q": 3 }] },
    { "source": "impulse", "frequency": 1, "gain": 0.9, "delay": 0.82,
      "filters": [{ "type": "bandPass", "frequency": 180, "q": 5 }, { "type": "bandPass", "frequency": 420, "q": 3 }] },
    { "source": "impulse", "frequency": 1, "gain": 1.0, "delay": 1.0,
      "filters": [{ "type": "bandPass", "frequency": 180, "q": 5 }, { "type": "bandPass", "frequency": 420, "q": 3 }] },
    // The door rattling in its frame after each.
    { "source": "noise", "gain": 0.18, "filters": [{ "type": "bandPass", "frequency": 1100, "q": 2 }],
      "envelope": [[0, 1], [0.12, 0], [0.32, 1], [0.44, 0], [0.6, 1], [0.72, 0], [0.82, 1], [0.94, 0], [1.0, 1], [1.3, 0]] }
  ]
}
