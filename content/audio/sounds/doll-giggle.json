// Tell (tier 1), the Track Doll haunting the train: "it giggles in the cars" (GDD v1.1 App. A.2). T118 playtest: "replace
// the track doll sounds with occasional giggling of a little demon boy". One giggle, played now and then by the game (not
// a loop): five quick breathy "he"s, a little boy's voice (about 500 Hz) through an "ee" vowel's formants, falling as it
// runs out of breath, the last drawn out. The demon is underneath: the same laugh an octave and a bit down, rough, and a
// throat-rattle on each syllable. Its tell band is 3-6 kHz (the vowel's upper formants and the breath), where nothing on the
// train lives, so it's heard through the cab's din.
{
  "tier": 1, "duration": 1.25, "maxInstances": 1, "minDistance": 2, "maxDistance": 40, "gainDb": 12,
  "layers": [
    // The boy: a voiced "hee", each syllable struck and let go.
    { "source": "saw", "gain": 0.5, "frequency": { "param": "pitch", "points": [[0, 0], [2, 1040]] },
      "filters": [{ "type": "peak", "frequency": 420, "q": 3, "gainDb": 6 }, { "type": "peak", "frequency": 2900, "q": 5, "gainDb": 9 },
        { "type": "peak", "frequency": 3900, "q": 5, "gainDb": 15 }, { "type": "highPass", "frequency": 250, "q": 0.7 },
        { "type": "lowPass", "frequency": 6500, "q": 0.7 }],
      "vibrato": { "rate": 9, "depth": 0.025 },
      "pitchEnvelope": [[0, 1.08], [0.12, 1.05], [0.24, 1.0], [0.36, 0.97], [0.5, 0.92], [1.2, 0.82]],
      "envelope": [[0, 0], [0.012, 1], [0.08, 0.15], [0.11, 0], [0.13, 0.95], [0.2, 0.12], [0.23, 0], [0.25, 0.9], [0.32, 0.1],
        [0.35, 0], [0.37, 0.85], [0.45, 0.1], [0.48, 0], [0.51, 0.8], [0.7, 0.45], [1.0, 0.15], [1.2, 0]] },
    // Breath on each "h", ahead of the voice.
    { "source": "noise", "gain": 0.35, "filters": [{ "type": "bandPass", "frequency": 4400, "q": 1.4 }],
      "envelope": [[0, 0.9], [0.03, 0.2], [0.11, 0], [0.12, 0.8], [0.15, 0.15], [0.23, 0], [0.24, 0.75], [0.27, 0.15], [0.35, 0],
        [0.36, 0.7], [0.39, 0.15], [0.48, 0], [0.49, 0.7], [0.6, 0.35], [1.1, 0.1], [1.2, 0]] },
    // The demon under it: the laugh down low, rough, a beat behind.
    { "source": "saw", "gain": 0.22, "delay": 0.015, "frequency": { "param": "pitch", "points": [[0, 0], [2, 420]] },
      "filters": [{ "type": "bandPass", "frequency": 700, "q": 1.2 }],
      "tremolo": { "rate": 31, "depth": 0.7 },
      "pitchEnvelope": [[0, 1.0], [0.5, 0.9], [1.2, 0.7]],
      "envelope": [[0, 0], [0.02, 0.8], [0.09, 0], [0.13, 0.75], [0.21, 0], [0.25, 0.7], [0.33, 0], [0.37, 0.7], [0.46, 0],
        [0.51, 0.8], [0.9, 0.3], [1.2, 0]] }
  ]
}
