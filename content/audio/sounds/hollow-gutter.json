// Tell (tier 1), the Hollow: "fire guttering, soot fall", 100 Hz-1 kHz (spec A.4). The fire's roar
// catching and choking, and soot pattering down from the stack.
{
  "tier": 1, "loop": true, "maxInstances": 1, "minDistance": 2, "maxDistance": 40,
  "layers": [
    { "source": "noise", "gain": 0.8, "filters": [{ "type": "lowPass", "frequency": 620 }, { "type": "peak", "frequency": 240, "q": 1.5, "gainDb": 6 }],
      "tremolo": { "rate": 6.5, "depth": 0.85, "jitter": 0.6 } },
    { "source": "noise", "gain": 0.5, "filters": [{ "type": "bandPass", "frequency": 900, "q": 3 }],
      "tremolo": { "rate": 11, "depth": 1, "duty": 0.08, "jitter": 0.7 } }
  ]
}
