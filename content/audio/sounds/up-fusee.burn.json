// A fusee burning where it was dropped (note 1052): a road flare's steady hiss and sputter, its few minutes long, heard a little
// way down a village street. Under the flare's magnesium roar (up-flare.burn), well under the car fire's tell band (6-9 kHz)
// and with nothing of a creature in it (spec A.4). Tier 4. A synth definition; a recorded take can replace it through the
// audio checklist (AU1's).
{
  "drift": { "semitones": 0.3, "db": 1.5, "seconds": 3 },
  "tier": 4, "loop": true, "maxInstances": 8, "minDistance": 2, "maxDistance": 35, "rolloff": 1.0, "gainDb": -4,
  "layers": [
    { "source": "noise", "gain": 0.5, "filters": [{ "type": "bandPass", "frequency": 2300, "q": 0.6 }, { "type": "lowPass", "frequency": 4800 }],
      "tremolo": { "rate": 9, "depth": 0.45, "jitter": 0.9 } },
    { "source": "impulse", "gain": 0.4, "frequency": 7,
      "filters": [{ "type": "bandPass", "frequency": 1500, "q": 1.4 }] }
  ]
}
