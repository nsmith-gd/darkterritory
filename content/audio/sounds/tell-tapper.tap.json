// Tell (tier 1), the Tapper (note 1011; docs/design/creatures/tapper.md §4): two dry knuckle-knocks on the gun's iron, close
// behind the gunner's head. Moved up from the design's 600-900 Hz to a knock at 900-1400 Hz with a short iron ring at
// 1.25 kHz, clear of the Bruin's chest whistle (~820 Hz) and the gun's own laying (160-500 Hz); told from the hounds' howl
// and the guns' clatter by being two and dry, and from the Hotbox's knock (low, in a truck, a run) by being overhead and
// two. A synth stand-in until the audio chat builds its line's takes.
{
  "tier": 1, "duration": 0.6, "maxInstances": 1, "minDistance": 1, "maxDistance": 20, "rolloff": 1.2, "gainDb": 6,
  "layers": [
    { "source": "noise", "gain": 1.0,
      "filters": [{ "type": "bandPass", "frequency": 1150, "q": 2.2 }, { "type": "highPass", "frequency": 800, "q": 0.7 }],
      "envelope": [[0, 0], [0.004, 1], [0.04, 0.15], [0.07, 0], [0.24, 0], [0.244, 1], [0.28, 0.15], [0.31, 0]] },
    { "source": "saw", "frequency": 1250, "gain": 0.18,
      "filters": [{ "type": "bandPass", "frequency": 1250, "q": 14 }],
      "envelope": [[0, 0], [0.005, 1], [0.12, 0], [0.24, 0], [0.245, 0.9], [0.4, 0]] }
  ]
}
