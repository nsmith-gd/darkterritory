// Tell (tier 1), Gnawers (the in-car incidents): "skittering and chittering in the load", 9-12 kHz, the highest tell there
// is. Fast, uneven, and more of it the more of them there are ("progress").
{
  "tier": 1, "loop": true, "maxInstances": 4, "minDistance": 3, "maxDistance": 40, "gainDb": 8,
  "layers": [
    { "source": "impulse", "gain": 1.2, "frequency": { "param": "progress", "points": [[0, 18], [1, 55]] },
      "filters": [{ "type": "bandPass", "frequency": 10400, "q": 3 }],
      "tremolo": { "rate": 7, "depth": 1, "duty": 0.5, "jitter": 0.95 } },
    { "source": "noise", "gain": 0.2, "filters": [{ "type": "bandPass", "frequency": 10800, "q": 5 }],
      "tremolo": { "rate": 13, "depth": 1, "duty": 0.12, "jitter": 0.8 } }
  ]
}
