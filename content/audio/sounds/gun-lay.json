// Player action (tier 4, T112 "a gun seat with its own controls"; spec C.2 "the turrets run on steam"): the seated gunner
// laying the gun. Its steam motor's hiss and its worm gear clattering, quicker and louder as it turns faster ("speed": 0
// barely moving, 1 its full traverse rate), with the motor's low whirr under them. Held while it turns.
{
  "tier": 4, "loop": true, "maxInstances": 4, "minDistance": 3, "maxDistance": 90,
  "layers": [
    // The gear's teeth.
    { "source": "impulse", "frequency": { "param": "speed", "points": [[0, 6], [1, 28]] }, "gain": { "param": "speed", "points": [[0, 0.25], [1, 0.7]] },
      "filters": [{ "type": "bandPass", "frequency": 1800, "q": 4 }, { "type": "peak", "frequency": 3100, "q": 6, "gainDb": 6 }] },
    // The steam driving it.
    { "source": "noise", "gain": { "param": "speed", "points": [[0, 0.06], [1, 0.3]] },
      "filters": [{ "type": "bandPass", "frequency": 2600, "q": 1.2 }],
      "tremolo": { "rate": { "param": "speed", "points": [[0, 4], [1, 11]] }, "depth": 0.6, "jitter": 0.3 } },
    // The motor.
    { "source": "saw", "frequency": { "param": "speed", "points": [[0, 38], [1, 62]] }, "gain": { "param": "speed", "points": [[0, 0.08], [1, 0.25]] },
      "filters": [{ "type": "lowPass", "frequency": 300, "q": 0.9 }] }
  ]
}
