// The fortress on the radio (GDD §9; note 178), tier 2 like any voice on the set: the dispatcher's manifest and the clerk's
// tally, under the typed lines. There's no speech in the stack, so it's a man's voice reading flat through a cheap set: a
// low buzz pushed through a spoken vowel's formants, broken into syllables at an even, bored pace, over the static. Flat,
// band-limited 300 Hz-3 kHz and crushed, like voice-radio.
{
  "tier": 2, "loop": true, "flat": true, "maxInstances": 1, "gainDb": -4,
  "crush": { "bits": 8, "rate": 11025 },
  "layers": [
    { "source": "saw", "frequency": 118, "gain": 0.5,
      "filters": [{ "type": "peak", "frequency": 600, "q": 2.5, "gainDb": 10 }, { "type": "peak", "frequency": 1150, "q": 3, "gainDb": 8 },
        { "type": "highPass", "frequency": 300 }, { "type": "lowPass", "frequency": 3000 }],
      "vibrato": { "rate": 2.3, "depth": 0.04 },
      "tremolo": { "rate": 4.6, "depth": 0.85, "jitter": 0.6 } },
    { "source": "noise", "gain": 0.07, "filters": [{ "type": "bandPass", "frequency": 1900, "q": 0.7 }],
      "tremolo": { "rate": 0.7, "depth": 0.3, "jitter": 0.9 } }
  ]
}
