// How each space sounds to whoever's in it (spec A.6: "convolution with cheap impulse responses", car
// interiors, tunnels, facility spaces). GameAudio picks the space from where the listener is: inside a car,
// in the cab, in a tunnel (the route's), down the mine spur, in a stop's shed or a small room, at a facility, or outside. The mixer convolves everything
// positioned with the space's response, each tier at its send; flat sounds (the UI, music, the radio)
// stay dry.
//
// reverb: a response synthesised from these numbers (Ballast.Audio ImpulseResponse.Synthesize):
//   decay      seconds for the tail's lows to fall 60 dB; highDecay the highs' share of that
//   length     seconds kept (the cost: one partition per 5.3 ms block); the last 30% eases out
//   predelay   seconds before the diffuse tail; early [seconds, gain] for each wall heard on its own
//   lowcut     Hz highpassed out (a boiler in a steel box is mud, not room)
//   wetDb      the tail's level (at unit energy: as loud, summed, as the sound it's of); width 0..1
// sends: how much of each tier goes in, 0..1, tier 1 first (tells, voice, train state, actions, bed,
//   world, music). Tells go in less than voice, so their rhythm stays crisp; music never.
// muted: sounds the space shuts out, by name or name prefix.
// voice: a compressor on positioned voice at the ear (GDD §22: in a tunnel, compressed and close).
{
  "spaces": {
    // In the open: dry. The night swallows everything.
    "outside": {},

    // The engine's cab: a steel box about 3 m by 2.5 m, open behind to the tender. Short, bright, boxy.
    "cab": {
      "reverb": { "decay": 0.35, "length": 0.3, "highDecay": 0.7, "crossover": 2000, "predelay": 0.004, "lowcut": 220,
                  "early": [[0.0042, 0.32], [0.0068, 0.26], [0.0091, 0.2], [0.0135, 0.12]],
                  "wetDb": -12, "width": 0.7, "seed": 11 },
      "sends": [0.25, 0.7, 0.5, 0.7, 0.35, 0.3, 0]
    },

    // A car's interior: a wooden box 2.8 m wide and 12 m long. The planks eat the highs; the end walls answer late.
    "car": {
      "reverb": { "decay": 0.55, "length": 0.5, "highDecay": 0.45, "crossover": 1200, "predelay": 0.006, "lowcut": 160,
                  "early": [[0.0075, 0.3], [0.0155, 0.24], [0.033, 0.18], [0.067, 0.1]],
                  "wetDb": -10, "width": 0.9, "seed": 23 },
      "sends": [0.3, 0.8, 0.5, 0.8, 0.4, 0.3, 0]
    },

    // A tunnel: a bore 6.2 m wide (StructureKit.TunnelHalf) and hundreds long. A flutter between the walls
    // every 18 ms, then a long dark tail. No outside: the wind, the night and the weather are shut out, and
    // the crew's voices come close and even.
    "tunnel": {
      "reverb": { "decay": 2.6, "length": 1.8, "highDecay": 0.35, "crossover": 1200, "predelay": 0.012, "lowcut": 90,
                  "early": [[0.018, 0.45], [0.036, 0.34], [0.054, 0.26], [0.072, 0.2], [0.09, 0.15], [0.108, 0.11], [0.126, 0.08]],
                  "wetDb": -6, "width": 1, "seed": 37 },
      "sends": [0.35, 0.9, 0.6, 0.9, 0.6, 0.5, 0],
      "muted": ["wind", "bed-wind", "world-night", "world-wind", "world-rain.rain-out", "world-rain.thunder"],
      "voice": { "thresholdDb": -26, "ratio": 3, "attackSeconds": 0.005, "releaseSeconds": 0.2, "makeupDb": 8 }
    },

    // Down the mine spur (spec A.5 "radio range dies in tunnels and mine spurs"; the checklist's place-mine "the space
    // closing in"; note 250): a timbered adit narrower than a tunnel and rough-walled, so its reflections come quicker
    // and the tail's shorter and darker. No outside, as in a tunnel, and the crew's voices close and even.
    "mine": {
      "reverb": { "decay": 1.7, "length": 1.3, "highDecay": 0.28, "crossover": 1000, "predelay": 0.008, "lowcut": 110,
                  "early": [[0.009, 0.5], [0.017, 0.38], [0.026, 0.3], [0.035, 0.22], [0.044, 0.16], [0.061, 0.1]],
                  "wetDb": -5, "width": 1, "seed": 61 },
      "sends": [0.35, 0.9, 0.6, 0.9, 0.6, 0.5, 0],
      "muted": ["wind", "bed-wind", "world-night", "world-wind", "world-rain.rain-out", "world-rain.thunder"],
      "voice": { "thresholdDb": -26, "ratio": 3, "attackSeconds": 0.005, "releaseSeconds": 0.2, "makeupDb": 8 }
    },

    // In a yard's shed or its hero (note 387, queue #129, note 392): an iron-roofed hall 20 to 40 m long and 10 to 15 m
    // across on a concrete floor, its bays open. The walls answer within 20 to 100 ms, then a long, brightish tail off the
    // iron; the night still comes in at the bays, so nothing's shut out.
    "shed": {
      "reverb": { "decay": 1.5, "length": 1.2, "highDecay": 0.45, "crossover": 1400, "predelay": 0.012, "lowcut": 120,
                  "early": [[0.018, 0.34], [0.031, 0.26], [0.047, 0.2], [0.072, 0.14], [0.1, 0.09]],
                  "wetDb": -8, "width": 1, "seed": 71 },
      "sends": [0.3, 0.85, 0.5, 0.85, 0.5, 0.45, 0]
    },

    // A small room (note 392): a Holdout's signal box, lamp room, pump house, prison van or lockup, or an open house. Brick
    // or boards 3 to 6 m across, a step up off the ground: a short, close room, darker than the cab's steel.
    "room": {
      "reverb": { "decay": 0.45, "length": 0.4, "highDecay": 0.55, "crossover": 1600, "predelay": 0.004, "lowcut": 180,
                  "early": [[0.006, 0.3], [0.011, 0.24], [0.017, 0.18], [0.026, 0.11]],
                  "wetDb": -11, "width": 0.8, "seed": 83 },
      "sends": [0.3, 0.8, 0.5, 0.8, 0.4, 0.3, 0]
    },

    // Out in a facility's yard: sheds and walls 15 to 50 m off, so slapback first, then a modest tail.
    "facility": {
      "reverb": { "decay": 1.3, "length": 1.1, "highDecay": 0.5, "crossover": 1500, "predelay": 0.04, "lowcut": 150,
                  "early": [[0.085, 0.22], [0.13, 0.16], [0.21, 0.11], [0.29, 0.07]],
                  "wetDb": -14, "width": 1, "seed": 53 },
      "sends": [0.25, 0.5, 0.4, 0.5, 0.35, 0.4, 0]
    }
  }
}
