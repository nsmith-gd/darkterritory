// What the headlamp shows, and the line's boards (GDD §22 hazards, App. A.2 and A.6: "lamps down" contradicts everything
// that needs forward visibility). Added after the 100-night playtest: running dark has to cost obstacle sight (the
// Sleepers, enemies.json, and the Grease here) and sign sight (the boards). First pass, not in the spec.
{
  // A board is read once the headlamp reaches it; lamps down, only once it's almost alongside.
  "lampSignRange": 350,
  "darkSignRange": 10,
  // Grease's sheen on the rail: seen this far out in the lamp, and this far without it.
  "lampGreaseRange": 150,
  "darkGreaseRange": 15,
  // Boards stand this far short of what they warn of.
  "boardAhead": 450,
  // A curve is posted at the speed that gives this lateral pull (m/s², v = sqrt(a R)), if that's under postBelow (m/s).
  "curveLateral": 0.4,
  "postBelow": 15,
  // On a generated line (note 265) its boards are the plan's: at floor(√(aPost R)) (linegen/tiers.json curves), on every
  // bend whose derailing speed √(aDerail R) is under this (the train's top speed, train.json maxSpeed, as the plan's
  // boardDerailBelow); the bend's derailment there is the plan's (LineGen.TrackRules, warned), not derailRatio's.
  "planPostBelow": 22,
  // A weak bridge (route.json weakBridgeChance) is posted at this.
  "weakBridgeLimit": 7,
  // Over a posted speed by this much (m/s), the cars strain (integrity lost per second per m/s over: strainPerSecond) and
  // the cargo lurches about (cargo integrity, cargoDamagePerSecond); by
  // throwOver, whoever's up on the roofs goes over the side at throwSpeed outward (at speed, that's death); at derailRatio
  // times the board, the train's off the rails.
  "lurchOver": 1.5,
  "throwOver": 3.5,
  "cargoDamagePerSecond": 0.01,
  "strainPerSecond": 0.004,
  "throwSpeed": 3,
  "derailRatio": 1.55,
  // GDD App. A.2 GREASE: "slicks the rail. No traction — can't climb, can't stop." The rail's grip while the engine's on it.
  "greaseTraction": 0.25,
  // Its counter: "sanding from the running boards restores traction over ~8s". Held at a sandbox, the grip comes back to
  // dry over sandSeconds; let go, and it's back to greaseTraction over sandFadeSeconds (the sand's under the wheels only
  // while it's going down: whoever's out there stays out there to the end of it).
  "sandSeconds": 8,
  "sandFadeSeconds": 3,
  // A tunnel's mouth, to anyone standing on a roof going into it.
  "struckDamage": 200,

  // The mail cranes (the playtest's rewards: something to reach for between the threats). One every dropSpacing (m) from
  // dropFrom to the terminus's board, clear of tunnels, bridges, facilities and junctions by dropClear, each with a board
  // dropBoardAhead short of it saying which side. Caught by someone in a cargo car's open side door on that side, within
  // catchReach of the car's side, holding the hook out (Fire) as it goes by. In the bag, by weight: pay (mailScrip, paid
  // at the terminus with the cargo), coal for the tender (coalUnits), rounds for both guns (ammoRounds), or spares for
  // the worst-off car (sparesIntegrity).
  "dropSpacing": [350, 600],
  "dropFrom": 900,
  "dropClear": 80,
  "dropBoardAhead": 400,
  "catchReach": 1.1,
  "dropWeights": { "mail": 0.45, "coal": 0.2, "ammo": 0.2, "spares": 0.15 },
  "mailScrip": [20, 60],
  "coalUnits": 8,
  "ammoRounds": 40,
  "sparesIntegrity": 0.25,
  // The terminus's distant board, its home signal and the platform's board: nothing spawns on the last run in (App. B.1),
  // so these are its moments.
  "terminusBoard": 1400,
  "homeSignal": 600,
  "platformBoard": 100,

  // The roof warning (note 260; GDD App. A.1's fairness contract: "TELEGRAPH always precedes COMMIT", and kills by the line
  // itself are no exception). A tunnel's mouth (struckDamage) and a posted stretch taken over throwOver are both warned of
  // to whoever's up on the roofs, on the HUD and by ear (systems spec A.3 tier 1, A.4: warn-low-clearance's telltale slaps,
  // warn-curve's roof irons chattering), lamp or no lamp, and neither takes anyone until its warning has been up a full
  // leadSeconds. Roof-walker bots get down on the same warning.
  "roofWarning": {
    // Warned this long before the hazard reaches the leading car at the speed now (s): App. A.1's reaction window at its
    // longest (4 s) and about 6 s more to reach an end ladder from mid-roof at a walk (player.json walk 2.4 m/s over a
    // 14 m car) and climb down it (ladderClimb 1.6 m/s).
    "leadSeconds": 10,
    // Plus this far (m), so a train gathering speed is still warned in time; below minSpeed (m/s) it counts as minSpeed.
    "leadMargin": 30,
    "minSpeed": 3,
    // A posted stretch is warned of with the train within this (m/s) of throwing roof riders off it (throwOver over the
    // board, more with handrails): the driver can still brake out of it, and the warning goes again if they do.
    "curveHeadroom": 1.5,
    // The HUD line and the cue only for players up top (on a roof, or an end ladder on the way up or down; not a gun's crew
    // behind its shield). Off: everyone aboard gets it, the cab too.
    "roofOnly": true,
    // While it's up, the cue sounds again this often (s); spec A.4 rule 4, not so often it's tuned out.
    "repeatSeconds": 4,
    // Not in the spec: whether a crouch gets you under a tunnel's mouth. The reading kept is that it doesn't ("anyone
    // standing on a roof", note 71; ARCHITECTURE section 8, note 260). On, a headset rider whose head is down under crouchHead
    // (m over the feet) is clear; the keyboard's body has no crouch.
    "crouchClearsMouth": false,
    "crouchHead": 1.0,
    // Its sounds (content/audio/sounds).
    "lowClearanceSound": "warn-low-clearance",
    "curveSound": "warn-curve"
  }
}
