// The crude cannons (GDD v1.1 App. C.3, spec B.7) and the crew loudness meter that draws the Choir (App. A.7, C.7). First pass.
{
  "guns": {
    // The fastest it fires when loaded; in practice each shot waits on the reload below.
    "roundsPerSecond": 1,
    // Spec B.7. T121 playtest ("I shot the track doll and it did nothing while she was on the track"): 220, not 80. The
    // forward gun sits behind the engine's stack, which masks the rail closer than about 60 m, and the doll shows in the
    // lamp at 200 m; at 80 the shot that saves you had a second or two's window. Now it's from first sight to the stack.
    "range": 220,
    // Total traverse either side of the gun's facing is half of this.
    "traverseDegrees": 200,
    // Spec B.7: no firing within this many degrees of the train's own body axis.
    "deadZoneDegrees": 20,
    "minPitchDegrees": -12,
    "maxPitchDegrees": 45,
    // App. C.3: "powder and shot are stocked at departure" and are rare: a gun's shots for the night.
    "ammo": 24,
    // Stand within this of the gun to work it.
    "reach": 1.0,
    // In blows (App. C.2's unit): a ball is four clubbings' worth. The Switchman dies to "one cannon shot".
    "damagePerRound": 4,
    // Spec C.2: "turret traverse dead (no boiler pressure)". The turrets run on steam; below this they don't move.
    // The same floor where the engine loses its pull (boiler.json powerFloor).
    "minPressure": 20,
    // App. C.3: "a full manual reload (powder, ball, ram, fire)": after each shot, this many steps of Use held at the gun,
    // each this long. Fire is the trigger.
    "reloadSteps": 3,
    "reloadStepSeconds": 1.5,
    // T112 playtest ("a gun seat with its own controls"): Use at a loaded gun sits you in its seat, this far behind the
    // pivot; seated, the mouse lays it and the gun follows at these rates (a heavy carriage on a turntable), the left
    // button fires where the barrel points, Use held loads it, Jump gets up. Only a seated gunner fires it.
    "seatBehind": 0.75,
    "traverseDegreesPerSecond": 70,
    "elevateDegreesPerSecond": 35,
    // Bots fire once the barrel's within this of the mark.
    "laidDegrees": 2.5,
    // T121 playtest ("every cannonball should have an impact explosion and VFX to show where impact was"): a ball's path is
    // searched in steps this long for the ground, water or a stop building's wall it comes down on before what it was
    // aimed at; one that hits nothing comes down where its range runs out.
    "impactStep": 0.5
  },
  // T121 playtest ("all creatures need hit confirm feedback"): a blow or a ball that lands on a creature, and where a ball
  // came down, are kept in the replicated world this long (s), so every client sees the flinch, hears the thud and the
  // boom, and the one who landed it gets the crosshair's marker, through a dropped snapshot or two. The impact's is as
  // long as its smoke hangs.
  "hits": {
    "keepSeconds": 1,
    "impactKeepSeconds": 8
  },
  "choir": {
    // App. C.7: the meter is the crew's combined loudness "measured over a few seconds so single shouts don't count": an
    // average over this window.
    "windowSeconds": 4,
    // One player talking at full voice (their Voice byte 255) adds this much; a normal voice about half.
    "voicePerPlayer": 0.45,
    // "Every cannon shot feeds the loudness meter" (App. A.3): a burst this big per shot.
    "roundLoudness": 1.2,
    // The whistle, blowing (by a player or the Whistler), and machinery (a crane working, the winch).
    "whistleLoudness": 0.9,
    "machineryLoudness": 0.35,
    // Held above this, it gathers: buildSeconds of loudness and the swarm comes (App. A.7's long rising telegraph). Quiet,
    // what's gathered drains at quietDecayPerSecond. DESIGN-TODO: the GDD gives no numbers for the meter; these are a
    // first pass that three players talking normally doesn't trip and three shouting (or cannon fire every few seconds) does.
    // T113 playtest ("they show up WAY TOO OFTEN"): 40 s held loud to gather (was 25), and driven off by quiet it rests
    // restSeconds before it can begin again. (Alone, an open mic no longer counts: it was the train through the speakers.)
    "threshold": 0.6,
    "buildSeconds": 40,
    "restSeconds": 300,
    "quietDecayPerSecond": 0.06,
    "maxLoudness": 3,
    // App. B.9: livestock aboard is never quiet: a floor under the meter.
    "livestockFloor": 0.3,
    // GDD v1.4 App. C item 4, C.7: a noisy toy carried feeds the meter in the carrier's name, this much each (a normal
    // voice is about 0.22). Alone none of them trips the threshold; a squeaker carried by someone shouting does, and they're
    // the one the Choir comes for (A.7 loudest first). DESIGN-TODO: first pass, no GDD numbers.
    "toys": { "squeaker": 0.2, "musicBox": 0.15, "drummer": 0.3 }
  }
}
