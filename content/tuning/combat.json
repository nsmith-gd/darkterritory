// Mounted guns (spec B.7) and The Choir (spec B.7, GDD App. A.6). First pass.
{
  "guns": {
    "roundsPerSecond": 3,
    "range": 80,
    // Total traverse either side of the gun's facing is half of this.
    "traverseDegrees": 200,
    // Spec B.7: no firing within this many degrees of the train's own body axis.
    "deadZoneDegrees": 20,
    "minPitchDegrees": -12,
    "maxPitchDegrees": 45,
    "ammo": 200,
    // Stand within this of the gun to work it.
    "reach": 1.0,
    "damagePerRound": 25,
    // Spec C.2: "turret traverse dead (no boiler pressure)". The turrets run on steam; below this they don't move.
    // The same floor where the engine loses its pull (boiler.json powerFloor).
    "minPressure": 20
  },
  "choir": {
    "aggroPerRound": 1.5,
    // App. A.6: no gunfire for ~45 s and they disperse.
    "quietSecondsBeforeDecay": 45,
    "decayPerSecond": 1.0,
    "approachThreshold": 12,
    "swarmThreshold": 30,
    "maxAggro": 60,
    // App. B.8: livestock raises the floor by 25% of the approach threshold.
    "livestockFloor": 3
  },
  // GDD App. C.7, the crew loudness meter: combined loudness, "measured over a few seconds so single shouts don't count",
  // and what drives the Choir. Each level is Choir aggro a second while it's going on. "cannon" is the guns' own rate
  // (3 rounds a second at 1.5 aggro a round); "machinery" isn't in the GDD, and is a third of it here. App. D.7's breach
  // counts at these levels: smashing a lock at cannon level, prying a barricade at machinery level.
  "loudness": {
    "levels": { "cannon": 4.5, "machinery": 1.5 },
    "windowSeconds": 3
  }
}
