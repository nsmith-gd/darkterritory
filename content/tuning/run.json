// A night as a game (GDD §9 run structure, spec B.8 and F.1). First pass.
{
  // Stopped means slower than this, for pulling up at a facility or the terminus.
  "stopBelowSpeed": 0.5,
  // The terminus gates: the train is home once it's stopped with its front this close to the end of line.
  "terminusZone": 400,
  // GDD §8: at dawn the main line reopens and dispatch can't guarantee it's clear. This long after,
  // traffic is on it: the run is lost.
  "dawnGraceSeconds": 120,
  // Not in the GDD (the director's call after playtesting): a night starts with the engine's front this far short of the
  // fortress's outer gate, ready to depart, rather than a train's length into the yard. The yard is all at yard speed
  // (2.5 m/s), so the crawl to the gate was minutes of nothing; now the run begins as the train moves off. Short of the
  // gate, not on it, so everyone joining boards at the fortress (GDD App. D.3) until it does.
  "departShortOfGateM": 8,

  // Coaling tower (GDD §18, spec D.2 gravity chute): someone on the ground pulls the lever; it pours
  // whether you're ready or not; coal that misses the tender is lost, and overfilling damages the engine.
  "chute": {
    "leverReach": 2.2,
    "leverSeconds": 0.6,
    // How far the tender can be from under the spout and still catch it.
    "spoutTolerance": 2.5,
    "pourPerSecond": 12,
    "capacity": 260,
    "overfillDamagePerUnit": 0.0015
  },

  // Grain elevator (GDD §18 facility roster: "Bulk, cheap. One spout, one car at a time. Endless repositioning and switch
  // calls"): spec D.2's gravity chute over a cargo car, worked like the coaling chute (its lever: chute.leverReach and
  // chute.leverSeconds). Someone on the ground pulls the lever; grain pours into the cargo car under the spout as its
  // load (food, facilities.json "cargo", paid like any load: economy below), onto the ballast and lost with no car there.
  // A full car takes no more and the rest spills over it, damaging it (D.2 "overfill damages car and spills"). It shuts
  // when the train moves off, as the chute does: the crew spot each car under it, one at a time. The crates stay too.
  // Not in the spec: first-pass numbers. "on": false and the grain elevator is crates only, as before.
  "grainSpout": {
    "on": true,
    // Down the elevator's spur, this far back from its buffer stop: over the fourth car behind the engine with the engine
    // up at the stop (engine 20 m, three cars and four gaps 48 m, half a car 7 m, and the metre short of the buffer the
    // driver leaves; train.json geometry). The spur takes the engine and four cars (route.json "junctions"), so every
    // one of them can be backed under it in turn, the first with the train's tail out past the points.
    "fromBuffer": 76,
    // How far a car's middle can be from under the spout and still catch it: the middle 6 m of a 14 m car.
    "spoutTolerance": 3,
    // In loads (a full car is 1) a second: the half a car the night left the fortress with fills in 20 s.
    "pourPerSecond": 0.025,
    // Loads in the bin: the four cars the spur takes topped up from the fortress's half load (run.json departureLoad).
    "capacity": 2,
    // Integrity off the car per load spilt over it: the whole bin over a full car costs it 0.4, as the whole chute over
    // a full tender costs the engine (chute.overfillDamagePerUnit × chute.capacity).
    "overfillDamagePerLoad": 0.2
  },

  // GDD §17-18: cargo is loaded at facilities, and "every facility is optional. Skipping them is safe and poor."
  // Cars leave the fortress this full (a fraction of a load each); filling them is the facilities' work. Not in the
  // spec: F.1's table is the fully loaded train, which is the ceiling.
  "departureLoad": 0.5,

  // Spec F.1: contracts pay on delivered cargo that survives, and nothing else.
  "economy": {
    "perCar": { "local": 450, "frontier": 700, "deadLines": 1100, "deepTerritory": 1700 },
    // Running costs, priced so a competent night averages spec F.1's 15% of gross.
    "coalPerUnit": 2,
    "roundsPerRound": 1,
    "repairPerIntegrity": 150
  }
}
