// A night as a game (GDD §9 run structure, spec B.8 and F.1). First pass.
{
  // Stopped means slower than this, for pulling up at a facility or the terminus.
  "stopBelowSpeed": 0.5,
  // The terminus gates: the train is home once it's stopped with its front this close to the end of line.
  "terminusZone": 400,
  // GDD §8: at dawn the main line reopens and dispatch can't guarantee it's clear. This long after,
  // traffic is on it: the run is lost.
  "dawnGraceSeconds": 120,
  // Not in the GDD (the director's call after playtesting): a night starts with the engine's front this far short of the
  // fortress's outer gate, ready to depart, rather than a train's length into the yard. The yard is all at yard speed
  // (2.5 m/s), so the crawl to the gate was minutes of nothing; now the run begins as the train moves off. Short of the
  // gate, not on it, so everyone joining boards at the fortress (GDD App. D.3) until it does.
  "departShortOfGateM": 8,
  // The director's decision of 6 Oct 2026 (GDD §9, ARCHITECTURE §8 note 263): until the run begins (the train through the
  // gate, above), the fortress yard is a safe space, like the ship in Lethal Company. The crew wait for friends, try on
  // outfits, walk away from the keyboard; nothing of consequence happens. Nothing spawns, the boiler and its fire hold (no
  // overheating, no rupture, no running out), the cold doesn't bite, and the train only moves off when someone in the cab
  // lets the brake off and drives it out.
  "yardIsSafe": true,
  // GDD §9, the director's note on build 1121 (T128, ARCHITECTURE §8 note 273): "forts must be safe spaces that monsters
  // never enter". yardIsSafe only holds before the run begins; this holds all night, for both forts: the departure fortress
  // (the line up to its outer gate) and the terminus (from its gate on; a silent settlement's only if linegen keeps its gate
  // safe), out to halfWidthM either side of the line. The director sends nothing while any of the train is in one, nothing
  // is put down inside one, and a creature that comes into one is driven off (it lets go of whoever it holds, and is gone).
  // A crewmate left behind near the gate can run back inside.
  "forts": { "safe": true, "halfWidthM": 80 },
  // The world is solid (the director, 6 Oct 2026; ARCHITECTURE §8 note 279): a stop's buildings stand as walls nobody walks
  // through and a ball stops at. The houses, barns and outbuildings (T114), and now the powerhouse, signal box, lamp room,
  // water tower, lockup, prison car and well: shut, each its footprint, topM over its ground (a well's kerb wellTopM). A
  // shed and the hero stand as their four walls, wallM thick, with the bay door the art draws (bayDoorM wide, in the middle
  // of each roofed length, to the track it serves), so the crates inside are fetched through the door; where a gantry
  // works the shed, its cut is open, the gantry's legs and its operator's stand in it (the roofed rooms either side keep
  // their four walls). A
  // Holdout stands as its walls with a door personDoorM wide where the crew breaches it: its occupant comes back inside it
  // (GDD App. D.14) and walks out of the door. linesideReachM (note 371): how far out from a generated line its trees,
  // boulders and telegraph poles stand solid (LinesideProps): where the crew and what hunts them go between the stops, whose
  // ground is cleared further out. Past it the woods are the art's alone, as all of them were.
  "walls": { "wallM": 0.3, "bayDoorM": 4, "personDoorM": 1.2, "wellTopM": 0.85, "topM": 9, "linesideReachM": 40 },
  // GDD §9 (note 178): the yard dispatcher's manifest at the gate and the clerk's tally at the terminus, a line every
  // lineSeconds over the radio. Spoken (note 240), each line takes as long as it's said and pauseSeconds after (an even,
  // bored pace), never less than lineSeconds.
  // Note 267 (the director's notes on build 1121: the opening reading is "a bit long... a pain for localization... a bit
  // cheesy"): `manifest` false drops the dispatcher's manifest at the gate, voice and card both. What it read (the crew,
  // the coal, powder and shot, the cars, the freight) is all on the roster, the gauges and the board already. The clerk's
  // tally at the terminus stays.
  // GDD App. E.12 question 5, the director's answer of 7 Oct 2026 (ARCHITECTURE §8 note 308): `kitLost` has the yard say
  // so on the radio, once, when the train's last engineering kit is lost (Radio.KitLost); false, the fitter's empty shelf
  // is the only tell.
  "radio": { "lineSeconds": 1.6, "pauseSeconds": 0.5, "manifest": false, "kitLost": true },

  // GDD v1.4 §23.2, Stranded: a ruptured boiler with the engineering kit lost ends the night once the train is at rest.
  "stranded": {
    // A cut car on the main line is gone (and the kit in it) this far from every living crewmate: D.13's release distance.
    "kitLostBeyond": 400,
    // The dawn freight's tow, billed in the tier's per-car values (E.10: 0.5, range 0.25-1.0).
    "recoveryFee": 0.5,
    // Not in the GDD: lost this long first, so a hand-off between ticks can't strand a night.
    "lostForSeconds": 1
  },

  // GDD v1.4 App. D.12, the run-end screen's bookmarks: a still at every GRAB start and every PUNISH, from the nearest living
  // crewmate who can see the victim (else the victim's own eyes); one per crew member at a derailment; the Stranded outro's
  // last frame; and a dead player's own button. ARCHITECTURE §8 note 176.
  "bookmarks": {
    // D.13: automatic bookmarks kept per run (12, range 8-20), and which survive the cap first (derailment cinematic >
    // PUNISH > GRAB start). Not in D.13: the outro's frame ranks with the derailment (the night's end, one picture).
    "autoCap": 12,
    "priority": ["derail", "stranded", "punish", "grab"],
    // Not in the GDD: a crewmate farther than this from the victim didn't see it, line of sight or not (it's night).
    "witnessRange": 60,
    // The camera's eye over the feet (the game's Eyes.Height), and where on the victim a witness looks (the chest).
    "eyeHeight": 1.65,
    "chestHeight": 1.1,
    // Not in the GDD: a GRAB or PUNISH sits beside the victim's death line if they died within this long of it; otherwise it
    // has a line of its own ("Got away.").
    "lineWindowSeconds": 30,
    // Not in the GDD: GRABs and PUNISHes recorded per run before the host stops taking them (each is a still on every machine).
    "recordLimit": 48,
    // Not in the GDD: manual bookmarks per dead player per run, and on the report in all.
    "manualPerPlayer": 3,
    "manualPerRun": 8
  },

  // Coaling tower (GDD §18, spec D.2 gravity chute): someone on the ground pulls the lever; it pours
  // whether you're ready or not; coal that misses the tender is lost, and overfilling damages the engine.
  "chute": {
    "leverReach": 2.2,
    "leverSeconds": 0.6,
    // How far the tender can be from under the spout and still catch it.
    "spoutTolerance": 2.5,
    "pourPerSecond": 12,
    "capacity": 260,
    "overfillDamagePerUnit": 0.0015
  },

  // GDD §17-18: cargo is loaded at facilities, and "every facility is optional. Skipping them is safe and poor."
  // Cars leave the fortress this full (a fraction of a load each); filling them is the facilities' work. Not in the
  // spec: F.1's table is the fully loaded train, which is the ceiling.
  "departureLoad": 0.5,

  // Spec F.1: contracts pay on delivered cargo that survives, and nothing else.
  "economy": {
    "perCar": { "local": 450, "frontier": 700, "deadLines": 1100, "deepTerritory": 1700 },
    // Running costs, priced so a competent night averages spec F.1's 15% of gross.
    "coalPerUnit": 2,
    "roundsPerRound": 1,
    "repairPerIntegrity": 150,
    // GDD §18-19, App. B.9 (note 182): a delivered car-load of each cargo pays this share of the tier's perCar. Goods pay 1,
    // so F.1's table (the fully loaded train) still holds for a night of goods. §18: the chemical works is "top payout", the
    // military depot "best payout", the wreck yard "high value"; §19's medicine is "high value", machine parts (heavy)
    // "inert, safe", coal and timber bulk. B.9: comet material "is the best freight payout", above them all. Not listed: 1.
    "cargoRates": {
      "goods": 1, "grain": 1, "heavy": 1, "ore": 1, "food": 1, "livestock": 1.1, "salvage": 1.2, "timber": 0.9, "coal": 0.8,
      "medicine": 1.4, "chemicals": 1.4, "ammunition": 1.5, "comet": 1.8
    },
    // GDD §19 "the most valuable cargo there is", B.9 "highest payout": each rescued child brought home (in a car still on
    // the engine, or in someone's arms) pays this many of the tier's perCar: more than any one car-load of anything, the
    // comet's included.
    "childPay": 3
  }
}
