// A night as a game (GDD §9 run structure, spec B.8 and F.1). First pass.
{
  // Stopped means slower than this, for pulling up at a facility or the terminus.
  "stopBelowSpeed": 0.5,
  // The terminus gates: the train is home once it's stopped with its front this close to the end of line.
  "terminusZone": 400,
  // GDD §8: at dawn the main line reopens and dispatch can't guarantee it's clear. This long after,
  // traffic is on it: the run is lost.
  "dawnGraceSeconds": 120,
  // Not in the GDD (the director's call after playtesting): a night starts with the engine's front this far short of the
  // fortress's outer gate, ready to depart, rather than a train's length into the yard. The yard is all at yard speed
  // (2.5 m/s), so the crawl to the gate was minutes of nothing; now the run begins as the train moves off. Short of the
  // gate, not on it, so everyone joining boards at the fortress (GDD App. D.3) until it does.
  "departShortOfGateM": 8,

  // GDD v1.4 §23.2, Stranded: a ruptured boiler with the engineering kit lost ends the night once the train is at rest.
  "stranded": {
    // A cut car on the main line is gone (and the kit in it) this far from every living crewmate: D.13's release distance.
    "kitLostBeyond": 400,
    // The dawn freight's tow, billed in the tier's per-car values (E.10: 0.5, range 0.25-1.0).
    "recoveryFee": 0.5,
    // Not in the GDD: lost this long first, so a hand-off between ticks can't strand a night.
    "lostForSeconds": 1
  },

  // GDD v1.4 App. D.12, the run-end screen's bookmarks: a still at every GRAB start and every PUNISH, from the nearest living
  // crewmate who can see the victim (else the victim's own eyes); one per crew member at a derailment; the Stranded outro's
  // last frame; and a dead player's own button. ARCHITECTURE §8 note 176.
  "bookmarks": {
    // D.13: automatic bookmarks kept per run (12, range 8-20), and which survive the cap first (derailment cinematic >
    // PUNISH > GRAB start). Not in D.13: the outro's frame ranks with the derailment (the night's end, one picture).
    "autoCap": 12,
    "priority": ["derail", "stranded", "punish", "grab"],
    // Not in the GDD: a crewmate farther than this from the victim didn't see it, line of sight or not (it's night).
    "witnessRange": 60,
    // The camera's eye over the feet (the game's Eyes.Height), and where on the victim a witness looks (the chest).
    "eyeHeight": 1.65,
    "chestHeight": 1.1,
    // Not in the GDD: a GRAB or PUNISH sits beside the victim's death line if they died within this long of it; otherwise it
    // has a line of its own ("Got away.").
    "lineWindowSeconds": 30,
    // Not in the GDD: GRABs and PUNISHes recorded per run before the host stops taking them (each is a still on every machine).
    "recordLimit": 48,
    // Not in the GDD: manual bookmarks per dead player per run, and on the report in all.
    "manualPerPlayer": 3,
    "manualPerRun": 8
  },

  // Coaling tower (GDD §18, spec D.2 gravity chute): someone on the ground pulls the lever; it pours
  // whether you're ready or not; coal that misses the tender is lost, and overfilling damages the engine.
  "chute": {
    "leverReach": 2.2,
    "leverSeconds": 0.6,
    // How far the tender can be from under the spout and still catch it.
    "spoutTolerance": 2.5,
    "pourPerSecond": 12,
    "capacity": 260,
    "overfillDamagePerUnit": 0.0015
  },

  // GDD §17-18: cargo is loaded at facilities, and "every facility is optional. Skipping them is safe and poor."
  // Cars leave the fortress this full (a fraction of a load each); filling them is the facilities' work. Not in the
  // spec: F.1's table is the fully loaded train, which is the ceiling.
  "departureLoad": 0.5,

  // Spec F.1: contracts pay on delivered cargo that survives, and nothing else.
  "economy": {
    "perCar": { "local": 450, "frontier": 700, "deadLines": 1100, "deepTerritory": 1700 },
    // Running costs, priced so a competent night averages spec F.1's 15% of gross.
    "coalPerUnit": 2,
    "roundsPerRound": 1,
    "repairPerIntegrity": 150
  }
}
