// The fortress towns (GDD §3.1, App. F.1 T133; ARCHITECTURE §8 note 281): the square inside the departure fortress's
// walls, who's in it, what's posted there, and how close you come to talk or read. The words are content/world/towns.json.
// Nothing here is in the systems spec; the director's direction sets no numbers, so each is a first reading, made to
// fit the yard the line generator already lays (linegen tiers.json "fortress": walls 14.8 m out, houses 10.9 m out
// every 15 m, the home platform right of the line).
{
  // Off, a fortress is the walls and houses of note 107 and nothing to talk to.
  "enabled": true,

  // The director, 7 Oct: "towns should land somewhere between 20 to 350 people", and later the same day "towns can go
  // up to 3000". How many live here now, drawn as min + (max - min) * u^populationPower (2: more small towns than big,
  // half of them under ~770, one in three a hamlet or village of 350 or fewer), how many to a house, and how many more
  // lived here before (the empty, boarded and burnt houses: every town has lost people). The lost families' houses are
  // at most lostShare of the households (past that, a big town's lost are empty lots). People out of doors at night
  // beyond those at their work: one in "outdoors", never more than outdoorsMax (a town of thousands isn't a crowd).
  "population": [20, 3000],
  "populationPower": 2,
  "household": [2, 6],
  "former": [1.3, 3.5],
  "outdoors": 22,
  "outdoorsMax": 16,
  "lostShare": 0.6,
  // Houses with their door open and a household inside to talk to (fully modelled downstairs): one per "per" people,
  // between min and max, the lived-in houses nearest the square. Each household's at home takes one of the custom's
  // lines too, so no more than the town's other talkers can spare (at 8 the street runs out: TownTests); a big town
  // draws its six from world/towns.json's twenty households, so the next big town isn't the same six.
  "explorable": { "per": 70, "min": 2, "max": 6 },
  // The yard's street (note 107's: a house every 15 m, 10.9 m out, fronts to the line, between the line and the wall):
  // each house's width along the street and depth (m), from this far inside the gate, and of the houses nobody lives in,
  // the share burnt and the share standing open.
  // A town of more than "lineRow" houses keeps that many on the line's street, the nearest its square, and takes streets
  // of its own for the rest (note 668; the director, 13 Oct, of frontier:7's: "a long row of houses. It doesn't feel like
  // a town"): a hamlet stays a row by the track.
  "houses": { "every": 15, "out": 10.9, "width": [6.5, 9.0], "gableWidth": [5.4, 7.0], "depth": [5.2, 6.0], "fromGate": 30, "burnt": 0.15, "open": 0.12, "lineRow": 10 },

  // A walled town (the director, 7 Oct: "fortresses aren't just some straight line around the railroad, they should
  // surround towns, towns should be explorable"; queue #74, ARCHITECTURE §8 note 335). A town with more houses than the
  // line's street holds has streets beside the line, as many a side as it needs up to maxStreets: the first's middle
  // "first" m out (past the line's own row's backs), one every "every" m, each "width" wide with a row of houses either
  // side, their fronts "setback" back from it on lots of "lot" frontage; lanes across every "laneEvery" m, "laneWidth"
  // wide, the way from the line to the streets; the rows from "from" m up from the yard's start to "toGate" m inside the
  // gate. The wall stands "margin" past the last row's backs, down both sides, across the front from the gatehouse and
  // across the back "rear" m along from the yard's start, its gate there the way in from the last night (0, at the yard's
  // start: note 692, so an arrival's way out is at the end of its line, a yard's length past the terminus's gate). Linegen levels the ground for it (tiers.json
  // fortress padM). A town whose houses fit the line's street keeps the yard's walls (note 274).
  // The streets bend (note 353; the director, 8 Oct: "Towns dont feel like they have a natural layout to them"): each
  // side's swing out and back on one wave "bendWavelength" m long, the first street "bendBase" m and each further out
  // "bendStep" m more (the rows between them keep their room) up to "bendMax",
  // straight within "bendClear" m of the square's ends; a house stands "setbackJitter" m further back than the setback.
  // A lane runs crooked: where it meets each street it turns "laneJog" m along the line, one way or the other, straight
  // between (never into the square or across its green).
  "walled": { "first": 34.5, "every": 30, "width": 6, "setback": 3.5, "lot": [13, 17], "laneEvery": [90, 130], "laneWidth": 8, "laneJog": [3, 10],
    "from": 22, "toGate": 22, "margin": 7, "rear": 0, "maxStreets": 5,
    "bendBase": 3.0, "bendStep": 0.6, "bendMax": 5.4, "bendWavelength": [220, 320], "bendClear": 30, "setbackJitter": [0, 1.2],
    // The town's works (queue #90, note 353; GDD §3 "furnaces, rail yards and warehouses"): its trade at work across the
    // line from the green, between the far side's first and second streets, from "worksBefore" m before the square's rear
    // end to "worksPast" m past its gate end (no lane crosses them); its pieces "worksMargin" m in from their streets and
    // the works' ends, "worksGap" m apart (world/towns.json "works" says which, in what order); "worksHands" of the town's
    // hands at work there at night.
    "worksBefore": 30, "worksPast": 6, "worksMargin": 1.5, "worksGap": 3, "worksHands": 3,
    // Nothing ruled straight (note 490): "turnChance" of the shut houses on the streets stand "turn" degrees off true one way
    // or the other (their yards keep to their lots); the row across the second street from the green turns to it, up to
    // "crescent" degrees at its ends, a crescent round it. Each turned no further than its lot has room for.
    "turn": [1, 4], "turnChance": 0.75, "crescent": 16,
    // The town's rail yard (queue #239, note 502; GDD §3 "rail yards and warehouses"): behind the home platform, between it
    // and the first street, from "yardBefore" m before the square's rear end to its gate end, where the first street's near
    // row would have stood (no lane crosses it, and that street runs straight beside it). Its siding "yardSiding" m out from
    // the line, its points long lifted: a buffer stop "yardMargin" m in from each end; its pieces (world/towns.json "yard",
    // in order from the gate end) fronting the siding, "yardMargin" m in from their street, "yardGap" m apart; "yardStock"
    // of world/towns.json's "stock" left standing in the siding, "yardLamps" m apart down it; "yardHands" of the town's
    // porters at work there at night. A town of fewer than "yardPeople" has none: its first street's houses are all it has
    // on that side.
    "yardPeople": 400, "yardBefore": 90, "yardSiding": 14, "yardMargin": 1.5, "yardGap": 4, "yardStock": [2, 4], "yardLamps": 28, "yardHands": 2 },

  // The square (GDD §3.1): where the walls step back on the side away from the platform (side -1, left of the way out)
  // for the town's heart, beside the engine as the night starts (run.json departShortOfGateM). fromGate: where it runs
  // along the line, in metres from the outer gate (negative is inside); wallOut: how far from the line its far wall
  // stands, inside the yard's level pad (linegen LongPad, 70 m); buildingDepth: the hall, the clerk's and the store,
  // backed onto that wall, fronts to the line.
  // A small town's green (note 490), in its square's rear end: "greenAlong" m from that end, "greenOut" m out from the line.
  "square": { "side": -1, "fromGate": [-100, -28], "wallOut": 30, "buildingDepth": 6, "hallWidth": 14, "officeWidth": 9,
    "greenAlong": [5, 17], "greenOut": [7, 17] },

  // People. "ring": how many stand round the centrepiece, one for every 30 in the town between these; the rest have
  // their places (the gate, the doors, the board, the engine, the platform), more of them in a bigger town, and the
  // street's folk are "outdoors" above, out in front of the lived-in houses with a lantern.
  "ring": [1, 5],
  // Lines a person has (the first is their job's or their town's, the next the other, then perhaps a scrap of a
  // thread), and the share of people who carry a scrap.
  "linesPerPerson": [2, 3],
  "scrapShare": 0.35,
  // The share of walled towns with one of Dave's murals at a street's end (note 570; the director, 8 Oct: "some towns should
  // have murals on the walls that are recognizably Dave's work"), in place of one of theirs.
  "daveMural": 0.4,
  // The share of towns with Nicki's party in one of their open houses, the only house up and lit late (note 571; the
  // director, 8 Oct: "an NPC you can find some times in one of the houses"), and how many guests she has.
  "nicki": 0.3,
  "nickiGuests": [2, 4],
  // Her wine (note 571; the director, 9 Oct: "when Nicki offers wine to the players they should get extra health for the next
  // run if they take it"; never said in the Wiki): hold Use within "reach" m of her for "holdSeconds", a glass a crewmate a
  // night, and "health" on top of what they have for the night that's about to set out (she's only ever in the departure town).
  "wine": { "reach": 2.6, "holdSeconds": 0.8, "health": 25 },
  // Quirks a town has on top of its culture, and its board: notices pinned up, and notes left lying about the square.
  // Of the board's notices, after the custom's own order, "boardOwn" are the town's own, written for it (note 669).
  "quirks": [1, 2],
  "notices": [3, 4],
  "boardOwn": 2,
  "looseNotes": [1, 2],

  // Talking and reading (Use, looked at, as the cab's controls are picked: train.json "pick"). Reach is from the eye to
  // the person's chest or the paper; lookDegrees the cone it has to be in. A card closes once you're further than
  // closeBeyond from what you're reading or talking to.
  "reach": { "talk": 2.6, "read": 2.0, "lookDegrees": 28, "closeBeyond": 4.0 },
  // A line types out at this many characters a second (the radio card's pace), and stays this long once it's out.
  "typePerSecond": 45,
  "lingerSeconds": 6,

  // Their rounds (ARCHITECTURE §8 note 353; the director, 8 Oct 2026: "There needs to be a behaviour loop for all the
  // NPCs, its weird that so many of them are just standing around doing nothing"): out of doors, everyone's day is
  // "slots" of "slot" seconds, their own post and somewhere about the square in turn (a bench, a fire barrel, the board,
  // a stall, the centrepiece, a neighbour), a pacer "pace" m either way of their post; at home, a household goes round
  // its rooms' places, "homeSlot" seconds at each. They walk between at "walk" m/s, and stop for whoever talks to them.
  "rounds": { "slot": 45, "slots": 4, "homeSlot": 38, "walk": 1.2, "pace": 3.5, "street": [10, 24] },

  // The town types (queue #424, ARCHITECTURE §8 note 692; the director, 13 Oct 2026, with five renders of town layouts:
  // "we want for the world building to have multiple different town types ... interesting culture, interesting looks,
  // interesting development", "the towns don't necessarily need to be this big ... they still need to be able to fit the
  // twenty-car maximum train length for the yard, but it's okay if the towns stretch a little bit more", "a town needs a
  // gate that is the entrance from the previous run, and then it also needs a gate that is the exit to the next run").
  // Off, every town is the street town of note 335. Each town's form is drawn from its trade (byTrade: trade -> form ->
  // weight; "" the street town) on its own stream, so the town arrived at and the town left from are the same.
  // yardM: the longest consist (train.json: an engine of 20 m, 20 cars of 14 m, 1.5 m between: 330 m), which stands in
  // the yard back from shortOfGate m inside the way out (run.json departShortOfGateM) and every form's length holds with
  // room to spare. shapes: each form's length between its two gates, its wall's reach left (the square's side) and right
  // (the platform's), its lots' frontage, depth and setback from their way, its water's level and its terraces' rise
  // (m against the yard's level) and depth (past 0.75 m it's railed off, TownGround.Wade; a marsh's is waded), a
  // quarry's benches; each street band's rise over the last (a terraced town's tiers, stair streets between: note 692's
  // verticality; the director, 13 Oct: "it's lacking some of the verticality ... integrating the layout of the town with
  // the layout of the landscape"), and how far past the wall it shapes the land it stands in (margin: its landform, the
  // headland, the sea, the mesa, the valley, easing into the line's land over the margin's outer 40%), and roll: how far its
  // landforms swell up and down (m, either way; a ridge reads as land, not a plateau; inside the wall stays level). All inside the yard's level pad (linegen fortress padM, 200).
  "forms": {
    // Whether the trades draw their towns' forms (byTrade below); off, every town is the street town but where force
    // says otherwise. (Off from note 692 until note 804 found what took the Game test suite past the CI machine's memory.)
    "enabled": true,
    // Every town this form ("harbour", "dykeland", "quarry", "tidewater", "glasshouse"; "" the street town), to play or
    // look at one type; null, each town its own.
    "force": null,
    "yardM": 330,
    "shortOfGate": 8,
    "byTrade": {
      "coal": { "quarry": 3, "harbour": 1, "crag": 2, "highline": 1, "timber": 1, "": 2 },
      "farm": { "glasshouse": 2, "dykeland": 2, "harbour": 1, "salt": 2, "timber": 2, "highline": 1, "": 2 },
      "foundry": { "tidewater": 2, "harbour": 1, "quarry": 1, "furnace": 3, "crag": 1, "": 2 }
    },
    "shapes": {
      "harbour":    { "length": 560, "left": 150, "right": 175, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -2.4, "terraceLevel": 16, "rise": 4, "margin": 190, "roll": 5, "packed": true },
      "dykeland":   { "length": 540, "left": 160, "right": 160, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -0.6, "waterDepth": 0.5, "terraceLevel": 0, "margin": 110, "packed": true },
      "quarry":     { "length": 600, "left": 190, "right": 120, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -2.0, "terraceLevel": 5, "benches": 3, "margin": 110, "roll": 3, "packed": true },
      "tidewater":  { "length": 560, "left": 160, "right": 180, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -1.4, "terraceLevel": 14, "rise": 4, "margin": 170, "roll": 6, "packed": true },
      "glasshouse": { "length": 450, "left": 120, "right": 130, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -1.8, "terraceLevel": 0, "margin": 170, "roll": 6, "packed": true },
      "furnace":    { "length": 560, "left": 150, "right": 160, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -3.0, "waterDepth": 1.6, "terraceLevel": 6, "rise": 12, "margin": 170, "roll": 4, "packed": true },
      "highline":   { "length": 560, "left": 160, "right": 150, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -2.0, "terraceLevel": 14, "rise": 12, "margin": 170, "roll": 5, "packed": true },
      "timber":     { "length": 540, "left": 160, "right": 160, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -1.0, "terraceLevel": 4, "rise": 4, "margin": 150, "roll": 2, "packed": true, "palisade": true, "wander": 4 },
      "salt":       { "length": 540, "left": 150, "right": 150, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -0.6, "waterDepth": 0.5, "terraceLevel": 0, "margin": 110, "packed": true },
      "crag":       { "length": 560, "left": 160, "right": 160, "lot": [6.5, 9.5], "lotDepth": 7,  "setback": 0.6, "waterLevel": -3.0, "waterDepth": 1.6, "terraceLevel": 16, "rise": 12, "margin": 190, "roll": 5, "packed": true }
    }
  }
}
