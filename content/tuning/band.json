// The band (ARCHITECTURE §8 note 700; docs/design/upgrades.md §8.4; the director, 13 Oct 2026: "We should also add more
// instruments ... all play together should create some sort of public domain song ... synced up by the first person who
// starts playing. It will be the song that is selected from a repertoire. And then as people play different instruments or
// the same instrument, they should sync up to whoever played first. And then that should all stop once the last person
// stops playing"; and "make sure that they are like Celtic folk style songs, because we want to keep in with the East
// Coast folk aesthetic").
{
  // A carried instrument is played with Use held at least holdSeconds (a tap still puts it down, as any hand-carried thing).
  // Played, each feeds the crew loudness meter this much in its player's name, as a noisy toy does (combat.json
  // choir.toys), and draws the night's first threat as a noisy toy (note 287).
  "holdSeconds": 0.4,
  "loudness": 0.25,
  // A tune played out, the band goes into the next of the repertoire after this breath, as a session's set does.
  "gapSeconds": 1.5,
  // The instruments the blacksmith sells (campaign.json: one upgrade each, effect "instrument": its index here), each a
  // part of every tune: the tune (melody), chords and bass (rhythm), or the beat (percussion). "octave": up or down from
  // the tune as written. Two of one instrument play in unison.
  "instruments": [
    { "id": "fiddle",     "name": "the fiddle",          "part": "melody",     "octave": 0 },
    { "id": "whistle",    "name": "the tin whistle",     "part": "melody",     "octave": 1 },
    { "id": "accordion",  "name": "the button accordion", "part": "melody",    "octave": 0 },
    { "id": "banjo",      "name": "the tenor banjo",     "part": "melody",     "octave": 0 },
    { "id": "guitar",     "name": "the guitar",          "part": "rhythm",     "octave": -1 },
    { "id": "bodhran",    "name": "the bodhrán",         "part": "percussion", "octave": 0 },
    { "id": "spoons",     "name": "the spoons",          "part": "percussion", "octave": 0 },
    { "id": "uglyStick",  "name": "the ugly stick",      "part": "percussion", "octave": 0 }
  ],
  // The repertoire, in the order it's played: the first to start playing starts the next tune, and it plays round until the
