    "callOut": 45, "callEvery": 6, "lungeWithin": 5, "drainSeconds": 14, "health": 2, "healthPerSecond": 0.35, "realChance": 0.5,
    // minCrew (note 795, was 2): a crew of one meets them too; held, a lone player can struggle free (grab.soloStruggleChance).
    "ignoredSeconds": 120, "minCrew": 1, "nearFacility": 400
  },

  // DRAGGERS · movement · flank (App. A.4, B.4). A roof-walker within grabRange of the edge (x fastGrabScale at fastAt m/s)
  // gets a limb over the lip telegraphSeconds before the grab; grabbed, they hang hangSeconds for a friend to haul them up.
  "draggers": {
    "grabRange": 1.0, "fastFrom": 14, "fastAt": 22, "fastGrabScale": 1.5, "reachAlong": 1.5, "creepSpeed": 1.2,
    "telegraphSeconds": 1.0, "allyRadius": 4, "freeSeconds": 2, "freeReach": 1.5, "aloneSeconds": 0.4, "pullSpeed": 3,
    "rearmSeconds": 8, "stampDamage": 0.5, "hangSeconds": 8, "lingerSeconds": 180, "minCars": 2, "maxAttached": 2,
    // Boarding-first (GDD App. F.1, note 286): they get under a car only with the train under boardBelow (m/s, 50 km/h: a
    // stop, a slow bend), with or without anyone up top, and wait there lingerSeconds for someone to walk its roof; a train
    // at speed never takes one on. bendWeight: as often again on a tight bend (climbers.tightBendRadius).
    "boardBelow": 14, "bendWeight": 2,
    // Off a truss (note 435; orchestrator.md §5.2 S4, "dropping onto the roofs from an overbridge or a tunnel mouth"): a train
    // run at fromSpeed m/s or more coming up on a through-truss (its top chord is 7 m over the rail) finds a Dragger perched
    // on the chord, chance in each such crossing, put there ahead m before the train reaches it. From tellSeconds before
    // the train's under it, a scraping on the steel above (the tell, never under minReactionSeconds); as each car passes
    // under, it drops on whoever's on that car's roof (the nearest the chord's side) and hangs them over the side, the
    // Dragger's grab (App. A.4: haul them back up, or they're dragged under). Nobody up there as the train passes and it
    // drops onto the ballast behind and is gone. The counter: off the roofs over a truss. Not tunnel mouths: a mouth already
    // takes anyone standing on a roof (the low-clearance board, Lineside). Not from the budget, not on the caps, as the run.
    "drop": { "on": true, "chance": 0.6, "fromSpeed": 14, "ahead": 500, "tellSeconds": 3, "height": 7.2, "lateral": 2.7 }
  },

  // STOKER · heat · interior (App. A.5, B.5; the Hollow merged in). The director's decision of 6 Oct 2026 (build 1121
  // playtest, ARCHITECTURE §8 note 263), in place of the GDD's low fire and open door: "something that looks for heat".
  // - Drawn: a firebox holding heatFirebox or more (of boiler.json's fireboxCapacity, 6) for heatSeconds. A low fire never
  //   draws it. Not in the safe yard (run.json yardIsSafe), and not for breakSeconds after the last one's gone (2.5 min:
  //   "it should stay gone for at least a couple minutes after it's been defeated").
