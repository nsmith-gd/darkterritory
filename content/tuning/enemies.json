// Enemies (GDD Part Six, App. A behaviour trees, App. B spawn rules). Demo roster: one per pressure zone.
// First pass. Speeds in m/s; the GDD's Sleeper thresholds (40 / 20) are km/h, converted here.
{
  // App. A.1: every telegraph gives at least this long before a commit.
  "minReactionSeconds": 1.5,

  // Enemies farther than this from a player aren't sent to that player's machine (ARCHITECTURE §8 note 23).
  // It must cover the farthest tell anyone can hear, the hound howl's 500 m (audio/sounds/hound-howl.json);
  // AudioTests holds it to that.
  "interestRadius": 520,

  "sleepers": {
    // Telegraph: the lamp finds them at 120 m; brace (and the wet writhe you can hear) at 60 m.
    "lampRevealDistance": 120,
    "braceDistance": 60,
    "derailAbove": 11.1,
    "heavyDamageAbove": 5.6,
    "heavyDamage": 0.4,
    "minorDamage": 0.05
  },

  "cinderHounds": {
    "packSize": [3, 5],
    "health": 60,
    "radius": 0.8,
    // Their sustainable speed: a train faster than this outruns them (App. A.3 break off).
    "maxSpeed": 19,
    // How fast they close on the train when they can.
    "closingSpeed": 3,
    "spawnBehind": 180,
    "howlSeconds": 4,
    "leapDistance": 30,
    "biteDamage": 45,
    "biteEverySeconds": 2.5,
    "reach": 4,
    // A boarded hound with nobody near for this long drops off.
    "boredSeconds": 6,
    // App. B.3: needs sustained speed first.
    "minTrainSpeed": 8,
    // App. A.3 break off: "sustained rear gun fire". This many rounds from a gun in range of the pack,
    // inside this window, and a running hound peels away (ARCHITECTURE §8).
    "suppressRounds": 9,
    "suppressWindowSeconds": 4
  },

  "clingers": {
    "drillSeconds": 90,
    "prySeconds": 6,
    "pryReach": 2.0,
    "breachCargoLossPerSecond": 0.01
  },

  "hollow": {
    // App. B.5: firebox below threshold for 45 s.
    "lowFireSeconds": 45,
    "descendSeconds": 3,
    "biteDamage": 35,
    "biteEverySeconds": 3,
    // Temperature restored: firebox back above this fraction and it leaves.
    "retreatFireFraction": 0.4
  },

  // App. A.7 THE SWITCHMAN: "reaches an upcoming junction → throws it to a dead line". Its telegraph is the switch
  // itself (the stand's lamp reads wrong from the cab) and the figure standing at it; the spec gives it no sound (A.4
  // lists none), so it's silent. The commit is the train taking the points; the dead line and its buffer stop do the
  // rest. "Never directly lethal. It costs you the clock."
  "switchman": {
    // It goes to a junction whose points are this far ahead of the engine: far enough that the lamp is seen and the
    // train stopped in time at cruise (the fairness rule), near enough that it's the next one.
    "ahead": [500, 1200],
    // It stands beside the switch stand, this much farther out from the track than the lever.
    "standBeside": 1.2,
    // "Approached on the ground → retreats; will not fight."
    "fleeRadius": 25,
    // Once the train's down the dead line, it lingers this long, then it's gone.
    "lingerSeconds": 20,
    // App. B.7: "route must contain ≥3 junctions" (dead lines, not facility spurs).
    "minJunctions": 3
  },

  // App. A.4 SOOT CHILDREN: "outside in the dark, calling for help in your crewmates' voices". It listens to the crew's
  // proximity voice, then calls from outside a car in the voice of someone who isn't there. The tell (spec A.5): that
  // voice has no distance falloff, the same loudness near or far. Answer it (open the car's door, or go out to it) and
  // it takes whoever came. Ignored, it gives up and moves on. "RULE: never answer a voice from outside."
  "sootChildren": {
    // It crouches this far out from the car's side, in the dark.
    "standOff": 6,
    // Everyone within this of it hears the call, all at the one loudness.
    "callRadius": 40,
    // Each call is the last thing its voice said, up to this long, again every so often.
    "callSeconds": 2.5,
    "callEverySeconds": 7,
    // A door of its car opened, or someone on the ground, this near it: that's who it takes.
    "lureRadius": 7,
    // App. A.4 "DECAY: ignored ~30s → moves on, tries a different voice".
    "ignoredSeconds": 30,
    // App. B.6 gates: "Crew ≥2 (needs a voice to mimic) · requires recent proximity voice activity"; "near facilities".
    "recentVoiceSeconds": 120,
    "minCrew": 2,
    "nearFacility": 250,
    // Whoever answers doesn't come back.
    "takeDamage": 200
  },

  // App. A.4 DRAGGERS: "reach up from beneath the car edges. RULE: stay off the edges." Pre-attached under a car's edge,
  // dormant until someone's on the roofs (App. B.4). A player within "grabRange" of its edge, near it along the car, gets
  // a limb at the lip (the tell: a single scrape, 2-4 kHz, spec A.4) and, a moment later, the grab. Grabbed alone: pulled
  // off the train, which at speed is death. Grabbed with an ally near: they have "freeSeconds" to free them (Use, close by).
  // Never leaves its car; it follows a roof walker along under its edge. "COUNTER: walk the centreline of the roof."
  "draggers": {
    // "player within 1m of a car edge → grab attempt".
    "grabRange": 1.0,
    // Spec B.3 "Max 22 m/s: Draggers +50% grab range": the range grows from cruise to max speed.
    "fastFrom": 14,
    "fastAt": 22,
    "fastGrabScale": 1.5,
    // How near it along the car, and how fast it creeps along under the edge after a walker on its side.
    "reachAlong": 1.5,
    "creepSpeed": 1.2,
    // "a limb visible at the edge lip ~1s prior" (the commit also waits for minReactionSeconds, App. A.1).
    "telegraphSeconds": 1.0,
    // "grabbed with ally near → ally has a 2s window to free them": an ally this near when it grabs, holding Use this
    // near the grabbed one. Alone, the pull comes after a beat.
    "allyRadius": 4,
    "freeSeconds": 2,
    "freeReach": 1.5,
    "aloneSeconds": 0.4,
    // Pulled off over the side: this fast outward, on top of the train's own speed (which is what kills).
    "pullSpeed": 3,
    // Freed, or its reach dodged, it's back under the lip this long before it reaches again.
    "rearmSeconds": 8,
    // App. B.4 "Train length ≥2". At most this many under one train at once.
    "minCars": 2,
    "maxAttached": 2
  },

  // App. A.5 RATTLE: "lives in the couplings. You hear it before you cross. RULE: don't cross between cars rattling."
  // Takes a coupling gap in the engine's rake during a facility stop (App. B.5), mid-train by preference. Silent until
  // someone comes within "armRadius" of it below the roofs; then it rattles (the tell: a dry bone rattle, 2-5 kHz, spec
  // A.3). Step into the gap while it rattles (after minReactionSeconds of it) and you're grabbed and pulled under.
  // "COUNTER: wait it out, or route over the roof." Not shootable.
  "rattle": {
    // "a player approaches the gap → begins rattling".
    "armRadius": 6,
    // "no approach for ~10s → silent again".
    "quietSeconds": 10,
    // "instant grab, pulled under": a kill.
    "grabDamage": 200,
    // Ambiguity (ARCHITECTURE §8): the spawn is at a stop but nothing says when it leaves. It stays in its gap this long
    // (so it's still there as you pull out) and goes the next time it's quiet after that. Cut the cars there and it's gone.
    "lingerSeconds": 300,
    // App. B.5 "Train length ≥2" (cars in the engine's rake), and "weight up on longer consists": this much per car more.
    "minCars": 2,
    "perCarWeight": 0.25
  },

  "choirSwarm": {
    // In the Swarm phase, anyone exposed (roof, ground, ladder) takes this every few seconds.
    "exposedDamage": 10,
    "everySeconds": 2.0
  },

  "director": {
    // App. B.1.
    "baseBudget": { "local": 40, "frontier": 70, "deadLines": 110, "deepTerritory": 160 },
    "lengthPerCarBeyondThird": 0.15,
    "crewBase": 0.7,
    "crewPerPlayer": 0.12,
    "crewCap": 1.6,
    "graceSeconds": 90,
    "facilityLullSeconds": 20,
    "cooldownSeconds": [30, 60],
    "maxConcurrentZone": 2,
    "maxConcurrentSmallCrew": 4,
    "maxConcurrentLargeCrew": 6,
    // Budget share spent before the first facility, across the middle, and in the final approach.
    "phaseShares": [0.15, 0.45, 0.40],
    "costs": { "sleepers": 1, "clingers": 2, "cinderHounds": 3, "hollow": 3, "switchman": 2, "sootChildren": 4, "draggers": 2, "rattle": 1 },
    // App. B.3/B.8 weights.
    "houndsLivestockWeight": 2.5,
    "houndsHotBoilerWeight": 1.5
  }
}
