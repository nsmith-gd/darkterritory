    "feedRate": 4, "swing": 3, "swingSeconds": 3, "eatPerSecond": 0, "runawayRampSeconds": 20,
    "fireDoorShutSeconds": 6, "sootSeconds": 4, "health": 4, "breakSeconds": 150,
    "doorBurn": 60, "doorKill": 1000, "doorReach": 1.8, "starveFirebox": 2, "hoseSeconds": 2, "hoseFireCost": 0.6,
    "cabHose": true
  },

  // CLIMBERS · movement · flank (App. A.4, B.4). A pack of packSize paces paceOut m out for paceSeconds, then mounts any gap
  // held by fewer players (within countRadius) than it has Climbers, scrabbling scrabbleSeconds first. Up, they traverse
  // at traverseSpeed and go into the first unlit or empty car; a lone player in there is taken over takeSeconds. Into an
  // unlit car with every door and its hatch shut, they force their way in through the roof (the hatch torn off, on a cargo
  // car): the car's breached (spec B.9, train.json breach). breachLitCars: a lit car they get into because nobody's in it
  // too (the decision named only the unlit car; ARCHITECTURE §8). Note 272 (App. F.1, no chip damage): inside, a hit every
  // 3 s (were 25 every 1.5 s).
  "climbers": {
    // GDD §23 "lights fail" (note 183): coming over the engine's end into the cab, it smashes the forward lamp for this
