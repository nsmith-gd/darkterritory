// Enemies (GDD v1.1 §21, App. A behaviour, App. B spawn rules, App. C shared systems): the v1.1 roster of sixteen and the
// Choir, plus two hazards (§22: track debris, formerly the Sleepers; marsh, formerly the Drift). First pass. Speeds in m/s; the GDD's Sleeper thresholds (40 / 20) are km/h, converted here.
{
  // App. A.1: every telegraph gives at least this long before a commit.
  "minReactionSeconds": 1.5,

  // Enemies farther than this from a player aren't sent to that player's machine (ARCHITECTURE §8 note 23).
  // It must cover the farthest tell anyone can hear, the hound howl's 500 m (audio/sounds/hound-howl.json);
  // AudioTests holds it to that.
  "interestRadius": 520,

  "sleepers": {
    // Telegraph: the lamp finds them at 120 m; brace (and the wet writhe you can hear) at 60 m.
    "lampRevealDistance": 120,
    "braceDistance": 60,
    "derailAbove": 11.1,
    "heavyDamageAbove": 5.6,
    "heavyDamage": 0.4,
    "minorDamage": 0.05
  },

  "cinderHounds": {
    "packSize": [3, 5],
    // In blows (App. C.2): "each takes several blows". A cannon round is four.
    "health": 3,
    "radius": 0.8,
    // Their sustainable speed: a train faster than this outruns them (App. A.3 break off).
    "maxSpeed": 19,
    // How fast they close on the train when they can.
    "closingSpeed": 3,
    "spawnBehind": 180,
    "howlSeconds": 4,
    "leapDistance": 30,
    "biteDamage": 45,
    "biteEverySeconds": 2.5,
    "reach": 4,
    // A boarded hound with nobody near for this long drops off.
    "boredSeconds": 6,
    // App. B.3: needs sustained speed first.
    "minTrainSpeed": 8,
    // GDD v1.1 App. A.3 break off: "rear cannon hit". A round from a gun in range of the pack inside this window, and a
    // running hound peels away (the v1.0 "sustained fire" was nine; a cannon that reloads by hand fires one).
    "suppressRounds": 1,
    "suppressWindowSeconds": 4,
    // App. A.1 GRAB: a crewmate bitten down to their last is pinned; friends have this long to club it off.
    "maulSeconds": 8
  },

  // App. C.1 GRAB, shared by every enemy that holds someone: a friend pulls a victim free with Use this close (where the
  // enemy allows it) or hits the holder. Alone (a crew of one), holding Use for soloStruggle seconds breaks the hold:
  // the GDD has no solo rule (ARCHITECTURE §8 note 92, a tuning flag).
  "grab": { "pullReach": 1.6, "soloStruggleOn": true, "soloStruggle": 6 },

  // App. C.2 melee with train tools: any tool (shovel, bar, lamp) swings; a blow is 1 health. Enemy health below is in blows.
  // T108: the tools are the shovel, wrench and crowbar (GDD §1322), carried on the hotbar; with nothing in hand, a fist does
  // barehanded of a blow.
  "melee": { "reach": 2.2, "coneDegrees": 70, "swingSeconds": 0.8, "damage": 1, "barehanded": 0.25 },

  // TRACK DOLL · sight · forward (App. A.2, B.2). Revealed in the lamp at lampRevealDistance, or in the dark only this close.
  // Stopped (below stoppedBelow m/s) short of it: gone for the run. Hit: it haunts. Cornered (players within cornerWithin at
  // both ends of its car) it can be clubbed; approached from one side it vanishes when anyone's within vanishNear and moves
  // car every hauntMoveSeconds. An empty cab for tamperAfterEmpty s and it's at the controls. A toy within toyReach: it
  // takes it and leaves. DESIGN-TODO: how much cargo "admiring" costs is unstated; cargoPerSecond is a guess.
  "trackDoll": {
    "lampRevealDistance": 200, "darkRevealDistance": 25, "spawnAhead": 700, "stoppedBelow": 0.3, "health": 2,
    "hauntMoveSeconds": 25, "vanishNear": 3, "cornerWithin": 6, "tamperAfterEmpty": 8, "toyReach": 1.8,
    "cargoPerSecond": 0.001,
    // B.2: needs a straight this long ahead (so the lamp can find it), and weighs this much more with the cab empty.
    "straightNeeded": 250, "emptyCabWeight": 2
  },

  // CAR HUGGER · vibration · rear (App. A.3, B.3). Latched: the train's top speed capped at speedCap m/s (the train drags
  // dragFactor times harder above it), the rear car's shell and loot eaten at these rates; eaten through, the car drops.
  // Anyone in front of its mouth (mouthReach) is swallowed: swallowSeconds for friends to pull them free. It heals
  // regenPerSecond blows a second, so one player can barely out-hit it. Lurks at a marsh or bridge lurkAheadMin-Max ahead
  // on a grade under maxGrade %. B.3: weighs lowSpeedWeight more with the train under lowSpeed m/s.
  "carHugger": {
    "speedCap": 9, "dragFactor": 1.6, "shellPerSecond": 0.004, "lootPerSecond": 0.006, "mouthReach": 1.6,
    "swallowSeconds": 10, "health": 16, "regenPerSecond": 0.15, "lurkAheadMin": 250, "lurkAheadMax": 800, "maxGrade": 0.6,
    "lowSpeed": 8, "lowSpeedWeight": 2, "minCars": 2
  },

  // WHISTLER · absence · flank (App. A.4, B.4). Boards at a stop; whistleAfterStop s into the next stop it blows the
  // whistle for whistleSeconds (it feeds the loudness meter). A player passing within passReach of its gap with nobody
  // else within pairRadius is snatched and carried off at runSpeed to a nest nestDistance m out, eaten nestSeconds after.
  // Two players within spotReach of the gap and it flees. B.4: stopWeight: it's weighted toward routes with stops.
  "whistler": {
    "stoppedBelow": 0.3, "whistleAfterStop": 4, "whistleSeconds": 2.5, "passReach": 1.6, "pairRadius": 3, "spotReach": 2.5,
    "runSpeed": 4.5, "nestDistance": 60, "nestSeconds": 20, "health": 3, "stopWeight": 0.3, "minCars": 2
  },

  // TIPPY TOESIE · absence · interior (App. A.5, B.5). Picks a player idle (moving under idleBelow m/s) for idleSeconds with
  // nobody within aloneRadius; starts startBehind m behind them and creeps at approachSpeed (slower at a crew of two).
  // Looked at (within seenDegrees of their view) it flees, up to maxFlees times, and waits waitAfterSeen s. At reach it
  // covers their mouth: suffocateSeconds for a friend to break it.
  "tippyToesie": {
    "idleSeconds": 5, "idleBelow": 0.3, "aloneRadius": 8, "startBehind": 9, "approachSpeed": 0.6, "approachSpeedCrewOfTwo": 0.4,
    "seenDegrees": 50, "reach": 0.8, "suffocateSeconds": 20, "waitAfterSeen": 20, "maxFlees": 3, "health": 2, "minCrew": 2,
    "perIdleWeight": 1
  },

  // FIRE FLIES · light · interior (App. A.5, B.5). On a lit car lamp in a dark section; left igniteSeconds, the car
  // catches (carFire below). Break off: the lamp out, or the train over pullAwaySpeed m/s for pullAwaySeconds.
  "fireFlies": { "igniteSeconds": 20, "pullAwaySpeed": 15, "pullAwaySeconds": 8, "depthWeight": 2 },

  // RIBBITS · sight · outside (App. A.6, B.6). A pack of packSize (never more than the crew) hops at hopSpeed toward the
  // nearest group smaller than it (players within groupRadius of each other: App. C.6); in tongueReach it freezes one and
  // eats for devourSeconds. They lose interest past giveUpBeyond m.
  "ribbits": {
    "packSize": [2, 4], "hopSpeed": 4, "groupRadius": 8, "tongueReach": 4, "devourSeconds": 8, "giveUpBeyond": 45,
    "spawnOut": 35, "health": 2, "perGroundWeight": 0.5
  },

  // GRUMBLER · sound · corrupted human (App. A.8, B.8). Gnaws the food crates at a facility; hit, it hunts the last to hit
  // it at huntSpeed. It regenerates regenPerSecond blows a second unless two players have hit it within gangSeconds.
  // Aboard with a crate, it eats cargoPerSecond. B.8: foodWeight more with food aboard.
  "grumbler": {
    "health": 6, "regenPerSecond": 1.5, "gangSeconds": 5, "huntSpeed": 3.5, "reach": 1.4, "biteDamage": 15, "biteEvery": 1.5,
    "grabBelowHealth": 30, "maulSeconds": 8, "cargoPerSecond": 0.004, "foodWeight": 2
  },

  // THE CHOIR's swarm (App. A.7): ghosts come when the meter's gathered (combat.json "choir"). Each seizes anyone outside
  // or behind no shut door for seizeSeconds (broken only by killing it); hit, it hits back. It flies flySpeed m/s faster
  // than the train. Quiet for
  // disperseQuietSeconds and they go.
  "choir": { "ghosts": 4, "health": 6, "seizeSeconds": 12, "flySpeed": 6, "hitBackDamage": 15, "disperseQuietSeconds": 10, "around": 12 },

  // THE SWITCHMAN · vibration · corrupted (App. A.8, B.8). At a junction ahead[0]-[1] m out; seen at revealAt m. A
  // derailing one (derailChance) grips the lever at gripAt m, always in time to brake or fire. One cannon round (4 blows)
  // or three blows kills it. B.8: minJunctions on the route, deadLineWeight more with dead lines about.
  "switchman": {
    "ahead": [500, 1200], "standBeside": 1.2, "revealAt": 300, "derailChance": 0.3, "gripAt": 250, "health": 3,
    "lingerSeconds": 20, "minJunctions": 3, "deadLineWeight": 1.5
  },

  // SOOT CHILDREN · sound · outside (App. A.6, B.6). Calling from callOut m every callEvery s. realChance of a real
  // survivor (a host's first-ever call is always real). A Soot Child lunges at anyone within lungeWithin m and drinks for
  // drainSeconds, gaining healthPerSecond blows a second while it does. Ignored for ignoredSeconds, it gives up.
  "sootChildren": {
    "callOut": 45, "callEvery": 6, "lungeWithin": 5, "drainSeconds": 14, "health": 2, "healthPerSecond": 0.35, "realChance": 0.5,
    "ignoredSeconds": 120, "minCrew": 2, "nearFacility": 400
  },

  // DRAGGERS · movement · flank (App. A.4, B.4). A roof-walker within grabRange of the edge (x fastGrabScale at fastAt m/s)
  // gets a limb over the lip telegraphSeconds before the grab; grabbed, they hang hangSeconds for a friend to haul them up.
  "draggers": {
    "grabRange": 1.0, "fastFrom": 14, "fastAt": 22, "fastGrabScale": 1.5, "reachAlong": 1.5, "creepSpeed": 1.2,
    "telegraphSeconds": 1.0, "allyRadius": 4, "freeSeconds": 2, "freeReach": 1.5, "aloneSeconds": 0.4, "pullSpeed": 3,
    "rearmSeconds": 8, "stampDamage": 0.5, "hangSeconds": 8, "lingerSeconds": 180, "minCars": 2, "maxAttached": 2
  },

  // STOKER · heat · interior (App. A.5, B.5; the Hollow merged in). In through the stack when pressure's under
  // lowPressure for lowPressureSeconds, or through the firebox door left open doorOpenSeconds at a stop (weighted
  // openDoorWeight). Soot falls sootSeconds, then it feeds feedRate pressure a second and ramps the regulator open over
  // runawayRampSeconds. Each blow at it burns the swinger burnPerBlow. The door shuts itself fireDoorShutSeconds after a
  // shovel with someone in the cab. DESIGN-TODO: the GDD says only "left open"; read as open doorOpenSeconds at a stop
  // with the cab empty (a fireman shovelling at a stand has it open half the time, and isn't leaving it).
  "stoker": {
    "feedRate": 1.5, "stoppedBelow": 0.5, "lowPressure": 40, "lowPressureSeconds": 45, "doorOpenSeconds": 10,
    "fireDoorShutSeconds": 6, "sootSeconds": 4, "runawayRampSeconds": 40, "health": 4, "burnPerBlow": 12, "openDoorWeight": 3
  },

  // CLIMBERS · movement · flank (App. A.4, B.4). A pack of packSize paces paceOut m out for paceSeconds, then mounts any gap
  // held by fewer players (within countRadius) than it has Climbers, scrabbling scrabbleSeconds first. Up, they traverse
  // at traverseSpeed and go into the first unlit or empty car; a lone player in there is taken over takeSeconds.
  "climbers": {
    "paceOut": 2.5, "paceSeconds": 6, "catch": 1.2, "maxSpeed": 18, "loseBehind": 60, "scrabbleSeconds": 2.5, "holdReach": 2,
    "maxTries": 3, "traverseSpeed": 2.2, "reach": 1.8, "biteDamage": 25, "biteEvery": 1.5, "boredSeconds": 120, "health": 3,
    "minGaps": 2, "minSpeed": 5, "perGapWeight": 0.5, "packSize": [2, 3], "countRadius": 8, "takeSeconds": 10
  },

  // THE GAUNT · sound (silence) · outside (App. A.6, B.6). Asleep; stirs at stirAt m, wakes at wakeAt m and follows its
  // waker at followAt m. Every silenceSeconds with nobody talking (voice above talkingAbove, 0-255) within listenRadius,
  // its anger climbs one; at attackAt it attacks. Led into a car, it takes lootCargo of the best load and leaves.
  // anyVoiceCounts: whose voice holds it off (GDD Part Eleven Q9, open): anyone's (true) or only its waker's.
  "gaunt": {
    "stirAt": 9, "wakeAt": 4, "followAt": 1.2, "followSpeed": 3, "listenRadius": 8, "silenceSeconds": 5, "talkingAbove": 40,
    "anyVoiceCounts": true, "attackAt": 4, "reach": 1.6, "hitDamage": 35, "hitEvery": 2, "grabBelowHealth": 35,
    "crushSeconds": 8, "health": 8, "lootCargo": 0.3, "lingerSeconds": 900, "minCrew": 2, "spawnOut": 25,
    "longStopWeight": 2, "longStopSeconds": 120
  },

  // MARSH (§22 hazard, formerly the Drift): something in the reeds surges toward motion; stand still stillSeconds and it
  // loses you. Level content: placed by linegen at marsh features, never drawn by the director.
  "drift": {
    "startRadius": 4, "maxRadius": 9, "spreadSpeed": 0.15, "stillSpeed": 0.3, "surgeSpeed": 2.2, "contactReach": 1.2,
    "damage": 6, "damageSeconds": 1, "stillSeconds": 4, "exitMargin": 60, "lingerSeconds": 600, "chemicalSpread": 2
  },

  // FOLLOWERS · scent · outside (App. A.6, B.6). Latches onto a player's back over latchSeconds on facility grounds; off
  // the train, it crawls at crawlSpeed to the car with the most loot and nests over nestSeconds, then eats eatPerSecond.
  "followers": {
    "latchSeconds": 3, "crawlSpeed": 0.8, "nestSeconds": 60, "eatPerSecond": 0.003, "health": 1, "nestHealth": 3,
    "lingerSeconds": 900, "maxActive": 2, "perGroundWeight": 1
  },

  // THE PASSENGER · absence · corrupted (App. A.8, B.8). Boards at a facility and walks at walkSpeed; a player alone
  // (nobody within aloneRadius) for stalkSeconds is taken and dragged at dragSpeed to the caboose, uncoupled over
  // uncoupleSeconds. B.8: minCrew, and splitWeight more when the crew is spread over splitPlaces or more places.
  "passenger": {
    "walkSpeed": 1.3, "aloneRadius": 8, "stalkSeconds": 5, "reach": 1.2, "dragSpeed": 1.3, "uncoupleSeconds": 4, "health": 5,
    "lingerSeconds": 1500, "minCrew": 3, "splitPlaces": 3, "splitWeight": 2
  },

  // CAR FIRE (App. C.5, a supporting system: Fire Flies start it, as can a lamp dropped in a car). It grows; past
  // burnFrom it burns anyone within burnReach and the car's cargo and integrity; past spreadFrom for spreadSeconds it
  // takes the next car. Each car has a wall-mounted extinguisher: Fire held within sprayReach knocks it back
  // sprayPerSecond, for chargeSeconds of spray, recharging over rechargeSeconds on its bracket. DESIGN-TODO: the GDD has
  // no numbers; these let one crewmate who gets there in the half minute a fire takes to take hold put it out with one
  // extinguisher, and a fire left longer need two.
  "carFire": {
    "startIntensity": 0.1, "growPerSecond": 0.006, "growWithSize": 0.02, "burnFrom": 0.35, "sprayReach": 2.5,
    "sprayPerSecond": 0.06, "chargeSeconds": 15, "rechargeSeconds": 90, "burnDamage": 10, "burnReach": 4,
    "burnEverySeconds": 2, "cargoPerSecond": 0.003, "integrityPerSecond": 0.0015, "spreadFrom": 0.8, "spreadSeconds": 30,
    "chemicalSpread": 2, "chemicalGrowth": 1.3, "powderGrowth": 1.6, "burnOutPerSecond": 0.05, "maxActive": 3
  },

  "choirSwarm": {
    // Legacy (T9): the Choir's damage to the exposed is now its ghosts' seize (above); kept for old saves' tuning.
    "exposedDamage": 0,
    "everySeconds": 1
  },

  "director": {
    // App. B.1.
    "baseBudget": { "local": 90, "frontier": 150, "deadLines": 230, "deepTerritory": 330 },
    "lengthPerCarBeyondThird": 0.15,
    "crewBase": 0.7,
    "crewPerPlayer": 0.12,
    "crewCap": 1.6,
    // After the 100-night playtest ("a reward or a problem every 30 s at most, 20 s ideally"): out of the gate in 20 s, and
    // quiet for paceSeconds anywhere out on the line, the director sends something whatever its cooldown, overdrawing the
    // budget's curve by up to pacedCost. Budgets are about twice App. B.1's to pay for it. A kind among the last
    // varietyWindow spawns has its weight halved for each.
    "graceSeconds": 20,
    // A generated line's grace stretch (linegen plan §4: gate to 2 km, "covers the GDD 90 s grace period") bans spawns only
    // this far into the run (s); after that, graceSeconds above is the rule. -1 keeps the ban for the whole stretch.
    "lineGraceSeconds": 20,
    "paceSeconds": 18,
    "pacedCost": 3,
    "varietyWindow": 4,
    // The in-car incidents' weight each (the others weigh 1): trouble in the cars is some of the night, not most of it.
    "incidentWeight": 0.5,
    // ...at full weight with this many hands besides the driver, proportionally less with fewer (a crew of two: a third).
    "incidentFullCrew": 3,
    "facilityLullSeconds": 20,
    "cooldownSeconds": [30, 60],
    // T114 playtest ("where are all the monsters"): a threat that goes lingerSeconds with nobody alive within lingerRadius m
    // of it (and has nobody in its grip) gives up and goes, so what nobody's answering doesn't hold the caps below full.
    "lingerSeconds": 120,
    "lingerRadius": 30,
    "maxConcurrentZone": 2,
    "maxConcurrentSmallCrew": 4,
    "maxConcurrentLargeCrew": 6,
    // Budget share spent before the first facility, across the middle, and in the final approach.
    "phaseShares": [0.15, 0.45, 0.40],
    // App. B.1 v1.1's cost table (the Choir costs nothing: it isn't spawned; hazards are level content).
    "costs": { "followers": 2, "draggers": 2, "fireFlies": 2, "switchman": 2, "trackDoll": 3, "cinderHounds": 3, "climbers": 3,
      "whistler": 3, "stoker": 3, "ribbits": 3, "carHugger": 4, "tippyToesie": 4, "gaunt": 4, "sootChildren": 4, "grumbler": 4,
      "passenger": 5 },
    // App. B.3/B.8 weights.
    "houndsLivestockWeight": 2.5,
    "houndsHotBoilerWeight": 1.5,
    // App. B.8, the rest of the table: with this cargo aboard (a loaded car of it in the engine's rake), these weigh this
    // much more; "*" is everything. Livestock's Hounds are houndsLivestockWeight's; chemicals' Drift is the drift's own
    // chemicalSpread (it isn't drawn, it's terrain). The comet cargo also relaxes the
    // Gaunt's and the Passenger's tier gates by one (cometRelaxesGates).
    "cargoWeights": {
      "food": { "cinderHounds": 2, "followers": 1.5, "grumbler": 2 },
      "comet": { "*": 1.4 }
    },
    "cometRelaxesGates": true,
    // App. B.1 "contradiction seeding": the v1.1 conflict table, as the tuning's names (and conditions: "choir", gathering or
    // here; "grade", a climb or fall just ahead; "facilityLoading" and "facilityStop", at a facility). Ambiguity (ARCHITECTURE §8): "draws
    // pairs from a conflict table": read as a spawn that would complete a pair with what's there now weighing this much
    // more, and this much more again past halfway on a run short of its pairs.
    "conflicts": [
      ["choir", "cinderHounds"],
      ["choir", "gaunt"],
      ["fireFlies", "trackDoll"],
      ["trackDoll", "facilityLoading"],
      ["whistler", "facilityStop"],
      ["tippyToesie", "stoker"],
      ["ribbits", "switchman"],
      ["carHugger", "grade"]
    ],
    "pairWeight": 3,
    "behindPairWeight": 3,
    "pairsPerRun": { "frontier": 1, "deadLines": 1, "deepTerritory": 2 },
    // Sleepers "about" for a pair: lying this far ahead (m). A "grade" ahead: this steep (%) within this far (m).
    "sleepersAhead": 1500,
    "gradeAhead": 600,
    "gradePercent": 1.5,
    // Saving up (ARCHITECTURE §8): from this share of the route in, cheaper threats leave enough budget for these rare,
    // expensive ones while the run can still have them, so they come at all.
    "saveFor": ["passenger"],
    "saveFrom": 0.2,
    // The kinds this edition has, by the names in "costs" above; empty is all of them. The demo edition (editions/demo,
    // T79) has GDD §21's five, one per pressure zone (the Choir, structural, is always about), and the trouble in the cars.
    "roster": [],
    // App. B.1 v1.1 want balance: each want's target share of the budget; a want over its share weighs less.
    "wantShares": { "kill": 0.40, "split": 0.25, "trust": 0.20, "cargo": 0.15 },
    // App. B.1 hard caps: corrupted humans, one at a time (the zone cap, maxConcurrentZone, covers the rest).
    "maxCorrupted": 1
  }
}
