// Enemies (GDD v1.1 §21, App. A behaviour, App. B spawn rules, App. C shared systems): the v1.1 roster of sixteen, the Moose (note 339) and the
// Choir, plus two hazards (§22: track debris, formerly the Sleepers; marsh, formerly the Drift). First pass. Speeds in m/s; the GDD's Sleeper thresholds (40 / 20) are km/h, converted here.
{
  // App. A.1: every telegraph gives at least this long before a commit.
  "minReactionSeconds": 1.5,

  // Build 1121 playtest (ARCHITECTURE §8 note 263): may a creature at the controls (the Stoker's runaway, App. A.5; the Track
  // Doll's tampering, A.2) let a standing train off the brake it's held on? false: no. With steam driving (T97) a standing
  // engine off its brake pulls away, so a Stoker took a train left braked in the yard away with nobody in the cab. Under way
  // they still take it off the brake; a train at a stand stays where its driver left it.
  "tamperReleasesStandingBrake": false,

  // The damage model (the director's decision of 6 Oct 2026, GDD App. F.1; ARCHITECTURE §8 note 272): "Lethal Company
  // style. Health exists, but damage comes in a few big hits, never chip damage." Every creature's hit on a player is an
  // int field named ...Damage below, and DamageModelTests holds each to at least minHit (of player.json's 100) and the gap
  // between a creature's hits to at least minGapSeconds: a hit (35) or a heavy hit (60), so a creature on you is two or
  // three hits from death (its grab is the last, App. A.1) and a clean escape costs one. Not held to it: the train's own
  // continuous dangers (a car fire's burn, note 263's "a brush hurts, standing in it kills"; a hose's gas; a landing's
  // knock by its speed). The Stoker's door (stoker.doorBurn, then doorKill; Stoker v3, note 271) is held to minHit too.
  "damage": { "minHit": 30, "minGapSeconds": 2.5 },

  // Driven off by their rules, killed by the crew together (GDD App. F.1: "creatures mostly don't take damage; they're
  // driven off by their rules"; the director's clarification of 7 Oct 2026: "They should be driven off by rules but they
  // should also be able to be killed like in Lethal Company if the team coordinates effectively"; ARCHITECTURE §8 note 288).
  // The Grumbler, the Gaunt, the Passenger, Climbers and the Choir's ghosts (each block's drivenOff; false is the old
  // health fight): following the rule drives one off, a break that can come back; blows wear it down only while gang or
  // more different crewmates have struck it within windowSeconds (and, per creature, the setup its rule asks for). A lone
  // player's swinging never kills one. Killed, it's done for the night (a Climber or a ghost: that one), with a line in the
  // incident report naming the gang.
  "coordinatedKill": { "gang": 2, "windowSeconds": 5 },

  // Enemies farther than this from a player aren't sent to that player's machine (ARCHITECTURE §8 note 23).
  // It must cover the farthest tell anyone can hear, the hound howl's 500 m (audio/sounds/hound-howl.json);
  // AudioTests holds it to that.
  "interestRadius": 520,

  "sleepers": {
    // The director's decision, 2026-10-06 (note 265): the Sleepers go. "A derailment needs to be clearly a mistake by the
    // driver." Off, none are placed on a generated line (no Sleeper country, no "R" boards for it) and none run on any
    // line. The code stays; a mod can set this true to bring them back, with the fairer telegraph below.
    "enabled": false,
    // Telegraph: the lamp finds them at 120 m; brace (and the wet writhe you can hear) at 60 m, or, faster, as far out as
    // the train needs to brake under derailAbove: braceLeadSeconds at its speed plus a service stop (train.json
    // overspeed.brakeShare of its rated brake, plus its marginM). They derail a train only once that telegraph has been
    // up derailLeadSeconds; short of it they're the heavy damage.
    "lampRevealDistance": 120,
    "braceDistance": 60,
    "braceLeadSeconds": 4,
    "derailLeadSeconds": 4,
    "derailAbove": 11.1,
    "heavyDamageAbove": 5.6,
    "heavyDamage": 0.4,
    "minorDamage": 0.05
  },

  "cinderHounds": {
    "packSize": [3, 5],
    // In blows (App. C.2): "each takes several blows". A cannon round is four.
    "health": 3,
    "radius": 0.8,
    // Their sustainable speed: a train faster than this outruns them (App. A.3 break off).
    "maxSpeed": 19,
    // How fast they close on the train when they can.
    "closingSpeed": 3,
    "spawnBehind": 180,
    "howlSeconds": 4,
    "leapDistance": 30,
    // A hit, and a long gap (note 272; were 45 every 2.5 s): bitten twice, they're pinned (maulSeconds).
    "biteDamage": 35,
    "biteEverySeconds": 4,
    "reach": 4,
    // GDD App. F (the director, 6 Oct 2026): "Cinder Hounds that board stay aboard. They keep setting the car alight while
    // they eat the supplies, which forces the crew to confront them" (ARCHITECTURE §8 note 269). Aboard with nobody near,
    // each eats cargoPerSecond of its car's cargo, and sets the car alight (carFire below) every igniteEverySeconds it's
    // left alone. They go only dead, or with their car cut loose. stayAboard false: v1.1's drop-off after boredSeconds.
    "stayAboard": true,
    "cargoPerSecond": 0.002,
    "igniteEverySeconds": 20,
    "boredSeconds": 6,
    // App. B.3: needs sustained speed first.
    "minTrainSpeed": 8,
    // GDD v1.1 App. A.3 break off: "rear cannon hit". A round from a gun in range of the pack inside this window, and a
    // running hound peels away (the v1.0 "sustained fire" was nine; a cannon that reloads by hand fires one).
    "suppressRounds": 1,
    "suppressWindowSeconds": 4,
    // App. A.1 GRAB: a crewmate bitten down to their last is pinned; friends have this long to club it off.
    "maulSeconds": 8
  },

  // App. C.1 GRAB, shared by every enemy that holds someone: a friend pulls a victim free with Use this close (where the
  // enemy allows it) or hits the holder. Alone (a crew of one), holding Use for soloStruggle seconds breaks the hold:
  // the GDD has no solo rule (ARCHITECTURE §8 note 92, a tuning flag).
  "grab": { "pullReach": 1.6, "soloStruggleOn": true, "soloStruggle": 6 },

  // App. C.2 melee with train tools: the shovel, the crowbar and the wrench (GDD §12, §1322) swing; enemy health below is in
  // blows of the crowbar, the tool everyone starts with (player.json kit). App. C.2: "the boiler player's shovel doubling as
  // the crew's best club is intended tension": it's the shovel's blow that's the best (note 275), and there's the one, by the
  // firebox (boiler.json shovelInHand). The wrench in the cab is short in the haft, "nothing but a wrench" (§13). T108: with
  // nothing in hand, a fist does barehanded of a blow. DESIGN-TODO: the GDD gives no numbers; these are a first pass that
  // keeps every creature's health a whole number of crowbar blows and takes a 3-health one in two of the shovel's.
  "melee": { "reach": 2.2, "coneDegrees": 70, "swingSeconds": 0.8, "shovel": 1.5, "crowbar": 1, "wrench": 0.75, "barehanded": 0.25 },

  // Every creature's body as a cannonball finds it (GDD App. F.1, build 1121: "the guns do nothing. Rounds don't collide
  // where they land and have no visible effect on the monsters"; ARCHITECTURE §8 note 290). A stack of spheres, each
  // [radius, height of its centre over where the creature stands] in m, fitted to its model as drawn (content/art/models:
  // the Ribbit at its 1.4 scale; a long, low body, the Whistler's, the Climber's, a hound's, by one sphere round its
  // middle). The body stands while the creature is in the open (Enemy.Exposed: by default wherever a tool's blow can land
  // on it), and a ball that finds it lands on it as a blow of combat.json guns.damagePerRound by the gunner, answered by
  // the creature's own rule for a blow. No body (a ball goes through): the Fire Flies (a swarm) and the Choir's ghosts.
  // A sleeping Gaunt is curled to gauntAsleep of its height.
  "bodies": {
    "cinderHound": [[0.75, 0.4]],
    "switchman": [[0.4, 0.5], [0.4, 1.15], [0.3, 1.6]],
    "climber": [[0.65, 0.3]],
    "trackDoll": [[0.55, 0.7], [0.4, 1.6]],
    "ribbit": [[0.6, 0.55]],
    "gaunt": [[0.5, 0.6], [0.5, 1.5], [0.45, 2.4], [0.35, 3.1]],
    "grumbler": [[0.55, 0.55], [0.55, 1.3], [0.35, 1.8]],
    "whistler": [[0.6, 0.3]],
    "dragger": [[0.45, 0]],
    "follower": [[0.3, 0.05]],
    "sootChildren": [[0.35, 0.4], [0.3, 0.9]],
    "carHugger": [[1.3, 0.6], [1.2, 1.9]],
    "passenger": [[0.4, 0.5], [0.4, 1.15], [0.3, 1.6]],
    "stoker": [[0.45, 0.45], [0.4, 1.1]],
    "tippyToesie": [[0.4, 0.6], [0.4, 1.4], [0.3, 2.0]],
    // The barrel and the hump (note 339); its rack stops nothing, a round in it is a miss.
    "moose": [[0.9, 1.6], [0.9, 2.1], [0.6, 2.6]]
  },
  "gauntAsleep": 0.35,

  // TRACK DOLL · sight · forward (App. A.2, B.2). Revealed in the lamp at lampRevealDistance, or in the dark only this close.
  // Stopped (below stoppedBelow m/s) short of it: gone for the run. Hit: it haunts. Cornered (players within cornerWithin at
  // both ends of its car) it can be clubbed; approached from one side it vanishes when anyone's within vanishNear and moves
  // car every hauntMoveSeconds. Past stage 1 (below), an empty cab for tamperAfterEmpty s and it's at the controls. A toy within toyReach: it
  // takes it and leaves. DESIGN-TODO: how much cargo "admiring" costs is unstated; cargoPerSecond is a guess.
  "trackDoll": {
    "lampRevealDistance": 200, "darkRevealDistance": 25, "spawnAhead": 700, "stoppedBelow": 0.3, "health": 2,
    "hauntMoveSeconds": 25, "vanishNear": 3, "cornerWithin": 6, "tamperAfterEmpty": 8, "toyReach": 1.8,
    "cargoPerSecond": 0.001,
    // B.2: needs a straight this long ahead (so the lamp can find it), and weighs this much more with the cab empty.
    "straightNeeded": 250, "emptyCabWeight": 2,
    // T121 playtest ("I shot the track doll and it did nothing while she was on the track"): a forward cannon's ball that
    // hits her on the rail shatters her, gone for the run, the same outcome as stopping short (App. A.2's VANISH), so the
    // train no longer strikes her. The GDD gives the brakes as the answer and doesn't say a cannon isn't one; it's loud and
    // costs the reload, which keeps it a cost. Her body on the rail is in bodies, above (a large porcelain doll; note 290).
    // cannonShatters off: the ball goes through her (ARCHITECTURE §8 note 171).
    "cannonShatters": true,
    // The director's decision of 6 Oct 2026 (GDD App. F.1, "The Track Doll escalates if ignored"; ARCHITECTURE §8 note
    // 268): aboard, she's no problem at first and gets worse only for being left alone. Her neglect clock runs a second a
    // second while no living crewmate is in her car or within attendRadius m of her, and attended it winds back at
    // attendedEase a second. Stage 1 (from the strike): she haunts the cars, admires the cargo and giggles; she never goes
    // to the cab. Stage 2 at controlsAfter s of neglect: an empty cab (tamperAfterEmpty) and she's at the controls, but
    // only nudging the regulator up to nudgeThrottle on one beat in three; she never touches the brake. Stage 3 at
    // releaseAfter s: the full tampering (the regulator open, the brake on and off), and once she's been at the controls
    // releaseAfterAtControls s at that stage on a visit, a standing train's held brake too (finalStageReleasesBrake; the
    // one exception to tamperReleasesStandingBrake above). A haunting doll is never dismissed for want of company (the
    // director's lingerSeconds). Each stage is telegraphed warnSeconds before it comes (she's restless: replicated,
    // her giggle quickens, and at stage 2 she rattles the brake handle without moving it). Getting her off the train (a
    // toy, or cornered and clubbed) ends it; a new doll starts at stage 1.
    "controlsAfter": 120, "releaseAfter": 300, "warnSeconds": 30, "attendRadius": 8, "attendedEase": 0.5,
    "nudgeThrottle": 0.25, "releaseAfterAtControls": 12, "finalStageReleasesBrake": true
  },

  // CAR HUGGER · vibration · rear (App. A.3, B.3). Latched: the train's top speed capped at speedCap m/s (the train drags
  // dragFactor times harder above it), the rear car's shell and loot eaten at these rates; eaten through, the car drops.
  // Anyone in front of its mouth (mouthReach) is swallowed: swallowSeconds for friends to pull them free. It heals
  // regenPerSecond blows a second, so one player can barely out-hit it. Lurks at a marsh or bridge lurkAheadMin-Max ahead
  // on a grade under maxGrade %. B.3: weighs lowSpeedWeight more with the train under lowSpeed m/s. Every breachEaten of
  // the shell it eats (25 s at shellPerSecond: past the guard van's platform, into the end wall, as the art eats it) it's
  // through the end wall: the car's breached (spec B.9, train.json breach), and boarded up it's through again 25 s on.
  "carHugger": {
    "speedCap": 9, "dragFactor": 1.6, "shellPerSecond": 0.004, "lootPerSecond": 0.006, "mouthReach": 1.6,
    "swallowSeconds": 10, "health": 16, "regenPerSecond": 0.15, "lurkAheadMin": 250, "lurkAheadMax": 800, "maxGrade": 0.6,
    "lowSpeed": 8, "lowSpeedWeight": 2, "minCars": 2, "breachEaten": 0.1
  },

  // WHISTLER · absence · flank (App. A.4, B.4). Boards at a stop; whistleAfterStop s into the next stop it blows the
  // whistle for whistleSeconds (it feeds the loudness meter). A player passing within passReach of its gap with nobody
  // else within pairRadius is snatched and carried off at runSpeed to a nest nestDistance m out, eaten nestSeconds after.
  // Two players within spotReach of the gap and it flees. B.4: stopWeight: it's weighted toward routes with stops.
  // T128 (build 1121: "a creature carried the director up a mountainside"; ARCHITECTURE §8 note 273): the nest is straight
  // out from the gap across the line, on the side they were taken from if it can be, at nestDistance (60 → 30: inside
  // train.json recovery.corridorM, Line Plan §12.6's walkable corridor; it went 60 m out in a straight line at rail height,
  // and wherever the land rose the player was stood up on the hillside when it let go), shorter by nestStep down to
  // nestMinDistance where the land won't have it. Its run there is over the ground, and the way has to be land a person can
  // run: no 2 m of it steeper than nestMaxSlope (rise over run), never more than nestMaxRise m above or below the rail, no
  // water. Neither side has any: the formation's edge. At a generated stop it runs to the nest the layout put out on the
  // stop's emptiest side (level-design H.2; note 314), the nearest within nestSiteReach of its gap that the same rules allow
  // and whose way there misses every building. Nowhere does its run go through a wall.
  "whistler": {
    "stoppedBelow": 0.3, "whistleAfterStop": 4, "whistleSeconds": 2.5, "passReach": 1.6, "pairRadius": 3, "spotReach": 2.5,
    "runSpeed": 4.5, "nestDistance": 30, "nestMinDistance": 8, "nestStep": 4, "nestMaxSlope": 0.4, "nestMaxRise": 6, "nestSiteReach": 110,
    "nestSeconds": 20, "health": 3, "stopWeight": 0.3, "minCars": 2
  },

  // The world is solid (the director, 6 Oct 2026: "creatures, carries and players must respect the terrain and geometry";
  // ARCHITECTURE §8 note 279). Once the creatures have stepped, what's loose in the world is held out of the stops' and the
  // fortresses' buildings and inside a tunnel's lining, by the widest sphere of its body (bodies, above). By kind: "ground"
  // walks on the land (a Ribbit's hop, a Gaunt walking up after its waker, a feral Grumbler), but within climbM of a car it
  // may be up its side; "air" flies, never lower than airClearM over the land (the Choir); "none" goes its own way (the
  // Whistler's run is laid clear of walls, above, a Follower crawls along the cars, the Soot Children answer a voice).
  "solidity": {
    "climbM": 2.5, "airClearM": 0.2,
    "kinds": { "ribbit": "ground", "gaunt": "ground", "grumbler": "ground", "choir": "air", "whistler": "none", "follower": "none", "sootChildren": "none" }
  },

  // TIPPY TOESIE · absence · interior (App. A.5, B.5). Picks a player idle (moving under idleBelow m/s) for idleSeconds with
  // nobody within aloneRadius; starts startBehind m behind them and creeps at approachSpeed (slower at a crew of two).
  // Looked at (within seenDegrees of their view) it flees, up to maxFlees times, and waits waitAfterSeen s. At reach it
  // covers their mouth: suffocateSeconds for a friend to break it.
  "tippyToesie": {
    "idleSeconds": 5, "idleBelow": 0.3, "aloneRadius": 8, "startBehind": 9, "approachSpeed": 0.6, "approachSpeedCrewOfTwo": 0.4,
    "seenDegrees": 50, "reach": 0.8, "suffocateSeconds": 20, "waitAfterSeen": 20, "maxFlees": 3, "health": 2, "minCrew": 2,
    "perIdleWeight": 1,
    // Boarding-first (GDD App. F.1, note 286): "nothing acts inside the train unless it boarded". It slips aboard only with
    // the train under boardBelow (m/s: a stop), and stays hidden aboard after it until it's fled maxFlees times. Shut doors
    // don't stop it: it opens them without a sound.
    "boardBelow": 0.3
  },

  // FIRE FLIES · light · interior (App. A.5, B.5). On a lit car lamp in a dark section; left igniteSeconds, the car
  // catches (carFire below). Break off: the lamp out, or the train over pullAwaySpeed m/s for pullAwaySeconds.
  // GDD App. F (the director, 6 Oct 2026): "Car lamps start lit. Their pull on Fire Flies is rare, and only while the car
  // is stopped." The director sends them only while the train's under stoppedBelow m/s, at stoppedWeight of their B.5
  // weight; and A.5's "pulls away at speed" is getting under way: pullAwaySpeed was 15 (ARCHITECTURE §8 note 269).
  "fireFlies": {
    "igniteSeconds": 20, "pullAwaySpeed": 2, "pullAwaySeconds": 8, "depthWeight": 2, "stoppedBelow": 0.3, "stoppedWeight": 0.5,
    // Boarding-first (GDD App. F.1, note 286): "shut doors stop some boarders". A lit car with every door and its hatch shut
    // (and no breach) keeps them off its lamp: at a stop, it's the cars left open with their lamps lit that draw them.
    "shutCarKeepsOut": true
  },

  // WHERE THE OUTSIDE CREATURES START (level-design H.2; GDD B.6; ARCHITECTURE §8 note 309). A generated stop's layout says
  // where each lives; the director still says when. At the stops within `around` m of the train: Ribbits come out of the
  // warren nearest the ground crew within `warrenReach` (a stop whose warrens are all further has none to send); the Gaunt
  // sleeps in its roost if it's within `roostReach`; a child calls from its call within `callReach`; a Follower takes only a
  // crewmate standing in one of its grounds (its radius and `groundMargin`). Nothing comes out closer than `minOut` m. A
  // hand-laid route's stops have no layouts: there they come from out in the dark round the ground crew, as before.
  "sites": { "around": 300, "minOut": 12, "warrenReach": 70, "roostReach": 400, "callReach": 160, "groundMargin": 4 },

  // RIBBITS · sight · outside (App. A.6, B.6). A pack of packSize (never more than the crew) hops at hopSpeed toward the
  // nearest group smaller than it (players within groupRadius of each other: App. C.6); in tongueReach it freezes one and
  // eats for devourSeconds. They lose interest past giveUpBeyond m.
  "ribbits": {
    "packSize": [2, 4], "hopSpeed": 4, "groupRadius": 8, "tongueReach": 4, "devourSeconds": 8, "giveUpBeyond": 45,
    "spawnOut": 35, "health": 2, "perGroundWeight": 0.5
  },

  // GRUMBLER · sound · corrupted human (App. A.8, B.8). Gnaws the food crates at a facility; hit, it hunts the last to hit
  // it at huntSpeed. It regenerates regenPerSecond blows a second unless two players have hit it within gangSeconds.
  // Aboard with a crate, it eats cargoPerSecond. B.8: foodWeight more with food aboard.
  // Note 272 (App. F.1, no chip damage): a hit every 3 s (were 15 every 1.5 s), and it mauls once it's bitten you twice
  // (grabBelowHealth was 30).
  // Note 288 (drivenOff; "gang up or leave it alone"): feral, with gangOf (coordinatedKill.gang) of the crew within
  // gangRadius m of it and no gang striking it, it breaks off after outnumberedSeconds (letting go of a maul) and scuttles
  // off for fleeSeconds, then back to gnawing, calmed. Only the gang's blows take its health (and it fights them).
  "grumbler": {
    "health": 6, "regenPerSecond": 1.5, "gangSeconds": 5, "huntSpeed": 3.5, "reach": 1.4, "biteDamage": 35, "biteEvery": 3,
    "grabBelowHealth": 35, "maulSeconds": 8, "cargoPerSecond": 0.004, "foodWeight": 2,
    "drivenOff": true, "gangRadius": 3, "outnumberedSeconds": 2, "fleeSeconds": 8
  },

  // THE CHOIR's swarm (App. A.7): ghosts come when the meter's gathered (combat.json "choir"). Each seizes anyone outside
  // or behind no shut door for seizeSeconds (broken only by killing it); hit, it hits back. It flies flySpeed m/s faster
  // than the train. Quiet for disperseQuietSeconds and they go. Note 272 (App. F.1, no chip damage): a ghost's hit back is a
  // hit, at most once every hitBackEvery s however fast it's struck (was 15 for every blow).
  // Note 288 (drivenOff; "hush, and shut every door"): a seize breaks when the meter's under its threshold for
  // hushBreakSeconds (the ghost goes) or its catch is behind a shut door (it goes back to the doors); blows don't break it.
  // Only the gang's blows with the crew holding quiet take a ghost's health; the last of the swarm killed, it's spent.
  "choir": {
    "ghosts": 4, "health": 6, "seizeSeconds": 12, "flySpeed": 6, "hitBackDamage": 35, "hitBackEvery": 3, "disperseQuietSeconds": 10,
    "around": 12, "drivenOff": true, "hushBreakSeconds": 3
  },

  // THE MOOSE · movement (trespass), sound · outside (GDD §21, App. A.6, B.6; the director's decisions of 7 Oct 2026;
  // ARCHITECTURE §8 note 339; docs/design/creatures/moose.md). A hyper-aggressive, territorial moose, too big to get on the
  // train. Grazing beside a stop, its aggro (0-100) rises crowdPerSecond with anyone on the ground within crowdAt m
  // (closePerSecond within closeAt), voicePerSecond at full voice (by the Voice byte, over talkingAbove of 255) with anyone
  // talking within hearVoice m, and by trainPass once as a train goes by within trainPassAt m; a hit fills it. It falls
  // calmPerSecond with nobody crowding or talking. listenAt (head up, ears turning) and warnAt (ears flat, the sac ridge up)
  // are its tells. Full, its target is whoever put the most in (whoever hits it, from then on). In sight (sightRange, no
  // building or car between) it closes at huntSpeed, squares up squareUpSeconds within squareUpAt[1] m (its heading locks
  // at the end) and charges at chargeSpeed, overrunning overrun m, then wheels round in wheelSeconds. Its body is rackSpan
  // across: nothing narrower lets it in. A building in the way snags it snagSeconds; a car or the track's clearance pulls it
  // up; blockedCharges of those without reaching its target and it gives up. A charge through anyone on the ground (within
  // hitReach of its rack) is a hit of chargeDamage; on someone at or under grabBelowHealth it pins them for pinSeconds, and
  // a blow from anyone else takes it off them (they're its target then). Out of sight it searches at searchSpeed where it
  // lost them, searchSeconds; a voice within hearVoice gives anyone away. Lost within lostAtCar m of a car they're aboard,
  // it rams the car every ramEvery s for ramSeconds (a ram is only a sound and a shudder). It gives up past leashRadius from
  // its ground, and when the train pulls away. It can't be killed. Never within trackClearance m of a track's centre
  // (movingClearance while the train moves): it's never on the rail. Gone past goneBeyond m from the train.
  // Spawns (B.6): at a stop, groundAt m out from the consist's middle; every tier, tierWeights by tier; biomeWeights by the
  // line's biome (1 unlisted); perGroundWeight more per player on the ground; minCrew (1: a lone player struggles free, the
  // solo rule, as from every grab). Beside the line on the run, lineside per 10 km by tier (times the biome's weight),
  // linesideAhead m ahead and linesideOut m out: the line's own, not the director's.
  "moose": {
    "crowdAt": 20, "crowdPerSecond": 25, "closeAt": 12, "closePerSecond": 70,
    "hearVoice": 15, "talkingAbove": 40, "voicePerSecond": 40,
    "trainPassAt": 25, "trainPass": 25, "calmPerSecond": 15,
    "listenAt": 20, "warnAt": 50,
    "squareUpAt": [12, 30], "squareUpSeconds": 2.5, "huntSpeed": 4.5,
    "chargeSpeed": 11, "overrun": 8, "wheelSeconds": 2.5, "rackSpan": 3.2, "hitReach": 0.5, "snagSeconds": 4, "blockedCharges": 3,
    "chargeDamage": 60, "grabBelowHealth": 40, "pinSeconds": 12,
    "sightRange": 60, "searchSpeed": 2.5, "searchSeconds": 25, "leashRadius": 80,
    "lostAtCar": 5, "ramEvery": 3, "ramSeconds": 15,
    "trackClearance": 3.2, "movingClearance": 6, "goneBeyond": 600,
    "groundAt": [30, 60], "minCrew": 1, "perGroundWeight": 0.5,
    "tierWeights": { "local": 1, "frontier": 1.5, "deadLines": 2, "deepTerritory": 2.5 },
    "lineside": { "local": 2, "frontier": 3, "deadLines": 4, "deepTerritory": 5 },
    "linesideOut": [8, 22], "linesideAhead": 300,
