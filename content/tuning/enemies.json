  "director": {
    // The encounter telemetry (the director's brief §7, §8; queue #600, note 880): how `dt harness`, `dt playthrough` and
    // `dt director sweep` measure the encounters, never what the night does. A crewmate within nearMetres of a creature is
    // "near" it (a perception proxy: never "seen"); droughtSeconds out on the run with nothing confronting the crew is a
    // drought (§7: 90 s); off the train, within tracksideMetres of a vehicle is trackside, past it afield.
    // Severity and droughts (the brief §4, §6; queue #610, note 893), from world state: level 1, a creature about within
    // presenceMetres of the train or a living crewmate (a proxy: near enough to be noticed); level 2, one threatening or
    // engaging (note 881's states: alert, near someone, working on a train system, at someone); level 3, two harassing at
    // once at least compoundApartMetres apart. A second out with nothing at level 2 is the director's rest when it holds for
    // one of recoveryHolds (prefixes of its held reasons), presence with something at level 1, else a true drought.
    "telemetry": {
      "nearMetres": 25, "droughtSeconds": 90, "tracksideMetres": 30, "presenceMetres": 60, "compoundApartMetres": 15,
      "recoveryHolds": ["grace", "aftermath", "facility lull", "in a fort", "banned", "final stretch", "terrain at its ceiling", "derailed"]
    },
    // GDD v1.4 App. D.11 and D.13, the dead's creature vote (note 180): a ballot of `options` drawn from what the director
    // could send now, each vote ×perVote to its creature's weight, to at most ×cap, within its want tag. A dead bot votes
    // botSeconds after its ballot's offered (note 202: not a GDD number, the bots' deliberation, so harness nights vote).
    "vote": { "perVote": 1.2, "cap": 1.5, "options": 3, "botSeconds": 6 },
    // The draw (ARCHITECTURE §8 note 287; GDD §14 "Noise", §23.1 "Owned", App. B.1, App. F.1 "Run start: nothing makes the
    // player feel they've done something that draws a monster"): the night's first threat answers something the crew did.
    // Every draw is credited to whoever made it on a ledger that halves every halfLifeSeconds (what drew most, lately). After
    // the grace, the first time one crewmate's draw of one kind stands at answerAt or more, the dark answers it out loud (a
    // call from answerDistance m ahead and answerLateral m off the line, at the lamp's edge; eyes there at answerHeight for
    // showSeconds) and the first threat follows leadSeconds later, pressed for (the cooldown and the curve give way as at
    // pressAt). With no draw that big the pressure, past its threshold, waits ("listening") up to holdUntil, and then the
    // biggest draw standing takes the blame: a quiet crew buys itself time (holdFirst false: the pressure model as before).
    // The Stoker is the firebox's own draw (note 263); the Choir the loudest's. Nothing here runs in the safe yard.
    "draw": {
      "enabled": true,
      "halfLifeSeconds": 30, "answerAt": 3, "holdFirst": true, "holdUntil": 16, "leadSeconds": 5,
      "showSeconds": 7, "answerDistance": 60, "answerLateral": 12, "answerHeight": 0.7,
      // Raised voices only: the mic level (0..1) above voiceFloor, scaled to the rest (the bots' working chatter is 0.27).
      // The firebox above fireboxFrom (of 6; the Stoker's heatFirebox). The engine at engineFullSpeed m/s or more.
      "voiceFloor": 0.4, "fireboxFrom": 4.5, "engineFullSpeed": 20,
      // A second of: the whistle 1.5 (a proper blast answers, a toot doesn't), voices 0.5 at full shout, a noisy toy carried
      // 0.15, the firebox 0.25 full, the engine 0.03 at speed (it never answers alone: at most about 1.3 stands). An act of:
      // a cannon round 3 (one shot answers), a car lamp lit 2, cargo aboard 4 a car-load × pressure.cargoValue.
      "weights": { "whistle": 1.5, "voices": 0.5, "toy": 0.15, "firebox": 0.25, "engine": 0.03, "cannon": 3, "lamp": 2, "cargo": 4 },
      // What answers each draw: these kinds weigh this much more for the first threat (only what the night could send anyway).
      "answers": {
        "whistle": { "whistler": 3, "cinderHounds": 2 },
        "cannon": { "cinderHounds": 2, "ribbits": 2, "climbers": 2 },
        "voices": { "sootChildren": 3, "tippyToesie": 2, "followers": 2 },
        "toy": { "trackDoll": 4 },
        "firebox": { "cinderHounds": 2 },
        "lamp": { "fireFlies": 3 },
        "cargo": { "carHugger": 3, "grumbler": 2, "cinderHounds": 2 }
      }
    },
    // App. B.1.
    "baseBudget": { "local": 90, "frontier": 150, "deadLines": 230, "deepTerritory": 330 },
    "lengthPerCarBeyondThird": 0.15,
    "crewBase": 0.7,
    "crewPerPlayer": 0.12,
    "crewCap": 1.6,
    // GDD App. B.1 "Grace period" (design decision, 2026-10): the quiet spell at the start of a night is a range, picked per
    // night from its seed, shorter on the harder tiers (pressure.graceTierScale scales the draw above the minimum).
    "graceMinSeconds": 20,
    "graceMaxSeconds": 90,
    // A generated line's grace stretch (linegen plan §4: gate to 2 km, "covers the GDD 90 s grace period") bans spawns only
    // this far into the run (s), or to the end of the night's own grace if that's later. -1 keeps the ban for the whole stretch.
    "lineGraceSeconds": 0,
    // GDD App. B.1 "Pacing rules" (design decision, 2026-10; ARCHITECTURE §8 note 266): when the director spends is
    // algorithmic, not a timer. Once a second after the grace its pressure builds by
    //   tier × conditions × relief × busy × escalation × (basePerSecond + quiet + loud + cargo)
    // and past threshold it sends what its weights pick (the budget's curve, caps, gates, saving up, pairs, variety, wants
    // and the dead's votes all as before); each spawn takes reliefPerCost × its cost off.
    "pressure": {
      // The level that spends; where it starts when the grace is over; the most it banks (held at the caps or under a ban it
      // doesn't pile up); and pressAt: this high, the cooldown gives way and the budget's curve may be overdrawn by pacedCost.
      "threshold": 10, "start": 4, "max": 18, "pressAt": 16,
      // A cost-3 threat takes 9 off: the trough after a spawn is the pressure building again.
      "reliefPerCost": 3,
      // The night's own rise: everything × (1 + escalation × the night's curve), the curve being how far along the line or
      // toward dawn, whichever is further, to curve.power (note 849; ×4 at the end: fewer threats early, more toward the
      // terminus); and a base that builds whatever else is going on.
      "basePerSecond": 0.03, "escalation": 3,
      // Quiet builds pressure: + quietPerSecond × (seconds since a threat was engaged (telegraphing, committing, grabbing,
      // punishing) or sent / quietRampSeconds, to 1), so no
      // stretch goes much past a minute and a half without something, even at the gate.
      // GDD App. F.1 (the director, 6 Oct 2026; note 270): "quiet stretches are counted in kilometres, not seconds." With
      // quietRampMetres set, the ramp is the line run since then over quietRampMetres (1,260 m: the old 90 s at spec B.3's
      // 14 m/s cruise), or the seconds over quietBackstopSeconds if that's sooner, so a stopped train can't wait it out.
      // quietRampSeconds is the ramp only with quietRampMetres 0.
      "quietPerSecond": 0.1, "quietRampSeconds": 90, "quietRampMetres": 1260, "quietBackstopSeconds": 120,
      // The crew's loudness (App. C.7, the Choir meter): + loudPerSecond × (meter / the Choir's threshold, to at most loudCap).
      "loudPerSecond": 0.1, "loudCap": 1.5,
      // Cargo aboard (App. B.9): + cargoPerLoad per car-load (load × cargo integrity × cargoValue, 1 for what isn't listed).
      // What's lost or spoiled stops drawing them.
      "cargoPerLoad": 0.01,
      "cargoValue": { "comet": 2, "livestock": 1.5, "food": 1.3, "medicine": 1.3, "ammunition": 1.2 },
      // The tier's rate, and how much of the grace range above its minimum the tier keeps.
      "tier": { "local": 0.8, "frontier": 1, "deadLines": 1.2, "deepTerritory": 1.4 },
      "graceTierScale": { "local": 1, "frontier": 0.85, "deadLines": 0.7, "deepTerritory": 0.55 },
      // Conditions (GDD §22, §23): 1 + dark (the forward lamp out) + wet (rain) + wind × the night's wind (0..1). Modest:
      // §22's hazards take tools away, they don't make the rules. (The cold's terms went with the cold, note 852.)
      "dark": 0.15, "wet": 0.05, "wind": 0.05,
      // The relief valve: × (alive / crew)^downPower, and × (1 − hurtRelief × the share of the living under hurtBelow health,
      // the bots' own "too hurt to fight"), so a crew that's losing isn't fed faster; and busy: × 1 / (1 + busy × threats
      // engaged × (1 − busyFade × progress)) while they're fighting: late in the night it stops waiting for them.
      "downPower": 2, "hurtBelow": 35, "hurtRelief": 0.25, "busy": 0.5, "busyFade": 1,
      // By the crew and the train (note 646; the director, the inbox, 9 Oct: "Scale by both, higher numbers on both readings
      // should increase threat level"; orchestrator.md §8 question 1): the rate × (1 + crewScale × (crew − scaleCrew)) ×
      // (1 + lengthScale × (cars − scaleCars)), each at least scaleFloor; 1 at a crew of four and eight cars (a Frontier
      // train). The budget scales by both too (crewPerPlayer, lengthPerCarBeyondThird), but on a 7 km night it never binds:
      // this is what does. 0.18 and 0.06: the director's on the Creature Tweaker (note 652, 13 Oct).
      "crewScale": 0.18, "lengthScale": 0.06, "scaleCrew": 4, "scaleCars": 8, "scaleFloor": 0.5
    },
    // The night's curve and the free spawns on it (note 849; GDD App. B.1 "The night's curve"; spec B.10; the director's
    // playtest of 16 Oct: "I do like the whole Lethal Company. The longer a run goes, the more monsters just spawn in general,
    // forcing you to kind of push towards the end ... I want more monsters to spawn the longer the run goes that don't have a
    // rules system. And then I want the weighting of the likelihood of spawn for monsters with rules that they have to follow
    // ... to increase"). The curve is how far into the night (along the line or toward dawn, whichever is further, the
    // pressure's own progress) to the power: 0 at the gate, 1 at the end. The pressure's escalation climbs by it (above).
    // free: beside the pressure's spends, outside its budget, its cooldown and its holds (the quiet, the census's slack, saving
    // for something new), the director sends a free spawn at atGate an hour at the gate rising to atEnd an hour at the end
    // along the curve, rolled a second at a time on dice of its own (the night's other draws are as they were with it off).
    // By the crew: the whole of that for a crew of crewFadeFrom or fewer, crewFade less an hour for each crewmate alive over
    // it, never under crewFloor of it (a crew of four, half; six and up, 0.35): a bigger crew's pressure already scales with it
    // (pressure.crewScale), and on 4-bot nights the whole curve on top burned the cargo (pack fires 0 to 3.5 a night).
    // What it sends, by one draw among:
    // - kinds: the rule-less, each at this weight: a creature sent without its situational rule, needing only what its
    //   spawn needs (the Cinder Hounds behind a moving train at any speed, Climbers to any gap, the Ribbits, Followers and Soot
    //   Children to whoever's on the ground anywhere, the Moose beside the train wherever it stands; the Gaunt may be named,
    //   its tier, crew and once a night kept). A kind not named never comes free. These are the "monsters that don't have a
    //   rules system": more of them the longer the run goes.
    // - and every kind whose rule is met now (the whole roster, A1's rules kept), at its rule's weight × bound × the curve:
    //   the rule-bound's weight climbs with the night, so what the stop or the speed lets in comes more toward the end.
    // The hard caps hold (a crew of one still meets one thing at a time), each kind's night (nightChance, perNight, slain),
    // the variety rules (unseen, repeats), who's next and the dead's votes; never within spacingSeconds of anything the
    // director sent, and (afterFirst) never before the night's first threat, which is drawn (note 287). A free spawn takes
    // nothing off the pressure: it's beside the pressure, not instead of it. free false: no free spawns of their own.
    // fill: and the rule-less fill the gaps the rules leave: when the pressure would spend and no rule is met (a moving train
    // lets few kinds in; a crew of one or two fewer: "nothing fits" was most of a two-player night), it spends on the
    // rule-less instead of nothing, by their kinds weights, charged, paced and relieving as any spend. fillPressed: only
    // once the pressure presses (pressAt: a long quiet), so the rules keep their rhythm and the fill is the gap's answer, not
    // every threshold's (at every threshold, 3- and 4-bot nights missed dawn, note 849). fill false: as before.
    "curve": {
      "power": 1, "free": true, "fill": true, "fillPressed": true, "atGate": 3, "atEnd": 18, "spacingSeconds": 20,
      "crewFade": 0.25, "crewFadeFrom": 2, "crewFloor": 0.35, "afterFirst": true, "bound": 1,
      // The hounds at half: a free pack boards a slow train at once and lights its cars (4-bot seed 1: 16 pack fires at 1).
      "kinds": { "cinderHounds": 0.5, "climbers": 1, "ribbits": 1.5, "followers": 1, "sootChildren": 1, "moose": 0.7 }
    },
    // The stops' own (note 860; GDD App. B.1 "The stops' own"; the director's playtest of 16 Oct evening, line 7: "Monsters are
    // positioned and ready at yards and abandoned villages, or use those stops to get onto the train"). Before it, what a stop
    // met was whatever the pressure could spend while the train stood there: on 2-bot frontier:7 nights, something within
    // 30 s of arriving at 3 stops in 8. Now, from the first second the train stands at a yard (a facility with a stop laid)
    // or an abandoned village's halt (a village stop, stood on the main line by it), and for trySeconds of standing there,
    // the director sends the stop's own: how many by the tier and the crew in the night (note 868; the director, 19 Oct:
    // "Easy difficulty and low player count means one creature. High difficulty high player count should be at least 4+
    // creatures to deal with per stop"): byTier + perCrew a crewmate over one, rounded half up, 1 to max (local alone 1,
    // frontier 2 for two and 3 for four, deadLines 3 for four, deepTerritory 4 for four and 5 for eight). Of them the
    // `boarding` share, rounded half up and never the only one, are `boarders` whose rule the stop meets, which use it to get
    // aboard, once it's stood there boardingAfterSeconds (while the crew is busy with the stop, not cutting the train at its
    // points: a Whistler in the gap the shunter must uncouple held four bots at frontier:12's first yard for good); the rest
    // wait there: creatures whose rule the stop meets (what lives at its sites, the Moose by it, the Freight Beetle in its
    // freight, the Grumbler on its perch...). Each picked by its rule's weight × weights × the night's variety, under the
    // roster, its night (nightChance, perNight), slain and the engaged cap; a kind needing someone on the ground comes the
    // moment one steps down. Once a stop a night (a crew shunting its yard hasn't arrived again). Beside the pressure's
    // spends: outside its budget, threshold, cooldown and the facility lull (it was there before the train came); the grace,
    // the forts, the final stretch and the line's spawn bans hold. On its own dice (0x5709): the night's other draws are as
    // they were. Logged DirectorSpawn.Stop.
    // The night's floor (note 868; the director: "It should be impossible to have a night with no creatures"): nightChance
    // (below) rolled seed 1 with 22 of 28 kinds out, every creature that lives at a yard among them. After the roll, kinds
    // rolled out are brought back, each drawn by its nightChance on the roll's own stream, until as many `residents` are about
    // as wait at a stop on this tier for this crew, and floorKinds of the 22 kinds the director sends (Spawns.Rules; one
    // nightChance doesn't name is about every night). A chance of 0 is never brought back. Off with `on`.
    "stops": {
      "on": true, "byTier": { "local": 1, "frontier": 1.5, "deadLines": 2, "deepTerritory": 2.5 }, "perCrew": 0.35, "max": 6,
      "boarding": 0.3, "boardingAfterSeconds": 40, "trySeconds": 240,
      "boarders": ["whistler", "draggers", "tippyToesie", "passenger"],
      "residents": ["ribbits", "gaunt", "moose", "sootChildren", "followers", "freightBeetle", "grumbler", "mouseMoose", "towerJaw"],
      "floorKinds": 8
    },
    // T128 (build 1121: "a player left behind by the train should feel the world close in: tension, monsters coming, the
    // difficulty spiking for that player. They needn't die at once"; GDD §7, §23; ARCHITECTURE §8 note 273). Not in the spec.
    // A crewmate alive on the ground, further than behindM (m) along the line from the nearest end of the train and not in a
    // fort (run.json forts), has a pressure of their own, built once a second by
    //   tier × conditions (the night's pressure terms, above) × (perSecond + rampPerSecond × min(1, seconds left / rampSeconds)
    //   + perKm × km from the train)
    // and past threshold the director sends a hunt at them alone: a Ribbit pack (App. A.6: it hops in on whoever it
    // outnumbers on the ground, and can be outrun) of pack[0] the first time, one more each time after to pack[1], and always
    // more than the group they're in; put down spawnOut[0] m from them the first time, closer each time to spawnOut[1]. Each
    // takes relief off; while one's still after them, no other comes. Outside the budget, the caps and the night's own
    // pressure (it's theirs, not the train's): about 45 s left behind to the first, then every half minute or so, bigger.
    // Back aboard (or in a fort), it's gone.
    // Note 296 (T128's caveat, "only the Ribbits hunt so far"): from the hunt numbered gauntFrom (0 the first) on, a Gaunt
    // comes with the pack, woken on them (App. A.6: it follows its waker at arm's length and attacks after enough silence;
    // talking holds it off, and it follows them home onto the train, where the crew deals with it by its rule). One at a time
    // per crewmate, never at a crew under gaunt.minCrew, put down gaunt.spawnOut m off. -1: Ribbits only.
    "abandoned": {
      "on": true, "behindM": 150, "perSecond": 0.05, "rampPerSecond": 0.15, "rampSeconds": 60, "perKm": 0.3,
      "threshold": 6, "relief": 6, "pack": [2, 5], "spawnOut": [35, 18], "gauntFrom": 2
    },
    // The orchestrator's live crew (ARCHITECTURE §8 note 336; docs/design/orchestrator.md §3.2 1, 3 and 5; GDD App. F.3, the
    // director, 7 Oct 2026: "a threat orchestrator that takes into account how many players are on and then orchestrates
    // threats based on the number of active players in the game currently"). Not in the spec; first pass. Active is the crew
    // alive now, counted each second. liveCrew: App. B.1's crew multiplier (crewBase + crewPerPlayer × crew, to crewCap) takes
    // the crew active now, not the crew the night started with, so a crew that's lost players spends like the smaller crew
    // it is (the relief valve's alive-share squared still applies on top). on: the engaged cap is the least of App. B.1's flat
    // cap (maxConcurrentSmallCrew / LargeCrew), ceil(active × engagedPerActive) and perPlayer × active, and at least 1: 1 at
    // crew 1, 2 at crew 2, 3 at crew 3 and 4, 6 at crew 8 (on a train shorter than longTrainCars; from it, two each, below:
    // a crew of one on 8 cars or more can meet two things at once, note 647). The hound run (below) waits while the crew is
    // at the cap. The left-behind's hunts and the Stoker stay outside it, as before.
    "orchestrator": {
      "on": true, "liveCrew": true, "engagedPerActive": 0.75, "perPlayer": 1,
      // A longer train has more of the crew under a threat at once (note 646; the director, 9 Oct: "Scale by both"):
      // engagedPerActive + engagedPerCar a car over pressure.scaleCars (8), up to perPlayer: one each from 13 cars.
      "engagedPerCar": 0.05,
      // A long train, two threats each (note 647; the director, the inbox, 12 Oct: "b"): from longTrainCars cars a crewmate
      // may have perPlayerLong threats on them at once, perTarget's rule with it, and the hard caps (maxConcurrent*) grow
      // in step. 8, a Frontier train and longer: the director's roster on the Creature Tweaker (note 652, 13 Oct).
      "longTrainCars": 8, "perPlayerLong": 2,
      // The census of posts and slack (ARCHITECTURE §8 note 345; orchestrator.md §3.1, §3.2 items 2–4). Once a second, each
      // crewmate alive: their post (cab, gunner, walker on the roofs, a ladder or a gap, rider inside a car, ground off the
      // train near it, or left behind past abandoned.behindM, whose own hunt answers them); which engaged threats are on whom
      // (holding them; else the nearest crewmate within onRadius m; else the nearest at a post that answers it below: a pack
      // running behind is the gunner's); and their slack, the seconds on the run between stops (the train moving faster than
      // drivingAbove, past the grace, out of the forts and facilities, short of the final approach) since they last had something to
      // answer (a threat on them; an upkeep job on their car: an open hot box, note 331, or a guttering lamp, note 346; a hot box
      // anywhere for a walker, a guttering lamp anywhere for a rider; or, in the
      // cab, the train moving faster than drivingAbove m/s: the line and the fire are the driver's to answer). It
      // counts whenever "on" is (the harness reports it); with census on too and minCrew or more alive it steers (a crew of
      // one is App. B.1's as it was):
      // - who's next: the free crewmate with the most slack, minSlack s or more; a kind answered at their post weighs
      //   ×slackWeight; a kind answered only at posts nobody holds ×emptyPostWeight (not those in emptyPostExempt, whose
      //   rule is the empty post: the Track Doll's cab);
      // - slack presses: + slackPerSecond to the pressure each second for each crewmate at slackPress s or more;
      // - perTarget: one threat on any one player: a kind whose every answering crewmate (at a post that answers it) has a
      //   threat on them already weighs nothing (with all of them so, nothing comes that second).
      "census": true, "minCrew": 2, "onRadius": 20, "drivingAbove": 0.5, "slackWeight": 2, "emptyPostWeight": 0.5, "emptyPostExempt": ["trackDoll"],
      "minSlack": 30, "slackPress": 150, "slackPerSecond": 0.05, "perTarget": true,
      // Which post answers what (orchestrator.md §3.1's table), by the names in "costs" (carFire: the trouble in the cars).
      // Note 753 filled in the seven App. A's later creatures had no row for: the Gannet dives on whoever walks the roofs, the
      // Brakeman is chased along them, the Knotter is the coupling (walked, and killed at a stand), all the walkers'; Hotbox
      // is the walkers' on the run and the ground's at a stand (prised out of its truck from beside it); the Moose, Tower Jaw
      // and the Freight Beetle are met on the ground.
      "answers": {
        "cab": ["trackDoll", "stoker"],
        "gunner": ["cinderHounds", "climbers", "trackDoll"],
        "walker": ["climbers", "draggers", "fireFlies", "whistler", "carHugger", "cinderHounds", "carFire", "gannet", "brakeman", "knotter", "hotbox"],
        "rider": ["tippyToesie", "fireFlies", "passenger", "carHugger", "carFire"],
        "ground": ["ribbits", "gaunt", "followers", "sootChildren", "grumbler", "moose", "towerJaw", "freightBeetle", "hotbox"]
      },
      // The census reads commitment (note 753; the audit's R5 and §7; orchestrator.md §3.1 4, §3.2 6; GDD App. B.1 "The
      // orchestrator"). commitment: each crewmate counted is committed while their hands hold them to a job: at a crane's
      // controls, carrying something heavy, a timed Use job under way (grease, a coupling tightened, a breach boarded, a mend,
      // the shovel), seated at a gun mid-reload or clearing its bore, on one of a stop's modules (a winch handle, a lever, the
      // herd, a crane's rigging), or breaking into a Holdout; read at stops as on the run (the census counts there; only slack
      // waits for the run). And "facilityLoading" in the conflict table is then the loading going on (the machinery running,
      // or a crewmate on a module), not only stood at the facility. With census steering (minCrew 2 or more): a kind that
      // would come at or near a committed crewmate with nothing on them yet (their own post answers it, or it comes to a post
      // that does within committedNearM m of them) and that a free crewmate's post answers within collisionReachM m of them
      // weighs ×collisionWeight: the free one chooses between their post and their friend's job. Free: nothing on them, not
      // committed, not left behind. Never with nobody free in reach. Only which kind, never when or how many. false: as
      // before (collisionWeight 1 turns only the weight off).
      // pairRepeat: a conflict pair made tonight weighs ÷pairRepeat for each time it's been made, when it would be made again
      // (seed 2 frontier drew whistler+facilityStop three times); 1: off.
      // pairFree (note 867; the director, 19 Oct, on note 861's call 2: "Yes"): one of a pair on one job (a jackpot's two
      // ends, the winch's two handles, the crane's operator and rigger) counts as free for the other's collision, so a crew
      // of two both at the winch can meet one: a grab on one, and the other lets go of their handle to come. false: a pair is
      // two busy and nobody free (note 753).
      "commitment": true, "collisionWeight": 1.75, "committedNearM": 20, "collisionReachM": 60, "pairRepeat": 2, "pairFree": true
    },
    // Note 327 (GDD App. F.3, the director, 7 Oct 2026: "ideally, we want people to be feeling like when they leave, there is
    // this presence of threat at all times"). Not in the spec. A crewmate alive on the ground further than fromTrainM (m) from
    // the train, and not in a fort, is afoot. While anyone is, the night's pressure builds by + perSecond × the share of the
    // living afoot (inside the pressure model's other factors: tier, conditions, relief, busy, escalation), so encounters come
    // sooner off the train; and what it sends then is more often met out there: the outside creatures, and whatever lives at
    // the stops' sites, weigh × (1 + (outsideWeight − 1) × that share). And the crew is watched: firstSign s after someone
    // first steps off, and every signEvery [min, max] s after while anyone's afoot, one of them (in turn) is shown a sign: a
    // pair of eyes for signSeconds out at signOut [min, max] m (the hand lamp's edge; nearer if a wall's in the way), within
    // signSpread degrees of the bearing of a creature that lives at this stop (one kind drawn from those with a site, note
    // 309's lairs, within signReach m; its nearest site), at that creature's eye height (signHeight by its tuning name, else
    // signHeightDefault), and its sound from there. Honest: only what lives here and the night could send; with no site in
    // reach, a Ribbit's (they come for whoever's on the ground anywhere), from away from the train. A sign is never a spawn:
    // nothing's there when you walk up to it.
    "afoot": {
      "on": true, "fromTrainM": 20, "perSecond": 0.08, "outsideWeight": 2.5,
      "signEvery": [12, 24], "firstSign": 6, "signOut": [14, 22], "signReach": 160, "signSeconds": 3.5, "signSpread": 35,
      "signHeight": { "ribbits": 0.35, "gaunt": 2.3, "followers": 1.6, "sootChildren": 1.0, "grumbler": 1.5, "whistler": 2.0 },
      "signHeightDefault": 0.7,
      // Dread at the stops (queue #646, note 944; the director's playtest of 20 Oct evening, line 15: "You start safely
      // collecting loot and then suddenly it doesn't feel so safe. You've been in there just long enough"). An outing is the
      // seconds anyone's been afoot (as above) since the crew was last all back aboard for forgetSeconds. As it goes on, the
      // signs come more often (the wait to the next one × 1 falling to signEveryAtScare by scareAt s) and nearer (the
      // distance × 1 falling to signOutAtScare); from scareAt, a scare: the signs at scareOut × their distance, close by
      // (still never a spawn: nothing's there when you walk up to it). From threatAt, once an outing, a real threat: the
      // encounter clock (director.encounters.drive) is brought up to due, so the director's own channels send one, met out
      // there by outsideWeight, under the placement, the caps and every kind's own rules and telegraph. Not a channel of its
      // own. Off until the director confirms ("test creature spawn first").
      "dread": {
        "on": false, "scareAt": 90, "threatAt": 180, "signEveryAtScare": 0.5, "signOutAtScare": 0.7, "scareOut": 0.45,
        "forgetSeconds": 30
      }
    },
    // The hound run (ARCHITECTURE §8 note 328; docs/design/orchestrator.md §5.3 and §6.1; GDD App. F.3, the director, 7 Oct
    // 2026: "more threats that can board the train at speed ... tower defense style that gives our gunners things to do").
    // Not in the spec; first pass. fromSpeed is the director's packs' own maxSpeed: under it they can board, and outrunning
    // them is their counter (App. F.1, Decided; note 286); the run is what answers a train run faster than that (App. F.1:
    // "a fast ... class may come later to answer the top-speed strategy"). A train that has run afterMetres at fromSpeed m/s or more (×hotShorter with the boiler
    // over its working band: the heat draws them, App. B.3) since it last slowed under stopSpeed, since the last run, or
    // since the grace, draws a run: round(base + perActive × the crew alive) Cinder Hounds, to between size[0] and size[1],
    // in pairs spacing s apart, alternating flanks, put down spawnBehind m behind the rear car and lateral m off the line.
    // A runner closes at the train's speed + closing m/s, whatever the train's speed (they are faster than it: a hot train
    // can't outrun them), and leaps aboard the rear car from the pack's leapDistance as the director's hounds do (App.
    // A.3; then they stay aboard, note 269). Answered one at a time: a ball landing within scatter m of a runner sends it
    // off (one landing between a pair takes both); a ball on it kills it (note 290). A round fired anywhere near doesn't
    // send a runner off (the director's packs keep suppressRounds). Not from the budget, not on the caps (it's the fast
    // train's, as the left-behind's hunts are theirs); never in the grace, a fort, the final approach or at a stop, and
    // one run at a time. Its own dice, so the night's other draws are as they were.
    "run": {
      "on": true, "fromSpeed": 19, "stopSpeed": 2, "afterMetres": 2400, "hotShorter": 0.75,
      // A trial (note 915, #612; the director, 20 Oct 2026, to note 875's question 2: "lastStop"): on, the metres count at the
      // tier's fromSpeed (its line speed, linegen tiers.json lineSpeed, − 4) and start again only at a stop (a facility, a
      // village halt), not whenever the train slows under stopSpeed: in 24 ordinary nights the run never came (the stops are
      // 1.1 km apart). Off, the run answers only a train run hot over the boards (note 328). Off until measured and confirmed.
      "fromLastStop": { "on": false, "fromSpeed": { "local": 16, "frontier": 14, "deadLines": 12, "deepTerritory": 10 } },
      "base": 1.4, "perActive": 0.6, "size": [2, 6], "spacing": 6, "spawnBehind": 200, "lateral": [4, 8],
      "closing": 5, "scatter": 5,
      // The lane ahead (note 405; orchestrator.md §5.3 6, "lanes ahead: runners crossing the line in the lamp, for the forward
      // gun"): of a run's pairs, every aheadEvery-th from the second on comes from in front instead, to a train with a gun laid
      // forward on the engine's rake. Put down aheadMetres in front of the engine and aheadLateral m out to a flank, they howl
      // in the lamp, then run in at aheadSpeed m/s to meet the train, across the line to aheadCross m out on its other side,
      // and leap aboard the first car behind the engine as it comes alongside. The forward gun has them from its range (220 m)
      // in to the stack's mask (about 60 m): at 21 m/s, about seven seconds, one shot laid early or two quick. A ball landing
      // within scatter m sends them off, as the run's; aboard, they're the pack fight at the front of the train.
      "aheadEvery": 3, "aheadMetres": 330, "aheadLateral": [12, 16], "aheadSpeed": 3, "aheadCross": 3,
      // The flank lanes (note 418; orchestrator.md §5.3 6, "lanes on the flanks from the open country's sides"): of a run's
      // pairs, every flankEvery-th (the third; a pair that's the lane ahead's stays ahead) comes in from the open country
      // instead, to a train whose last car has its gun, where the line runs through one of flankBiomes (all but the forests,
      // blackForest and forestEdge, in linegen's biomes.json) and the land's open that far out. Put down flankOut m off to its
      // side, abeam the guard van's gun (flankAbeam m ahead of the train's rear end: a gun traverses 100 degrees either side of
      // its facing, so abeam its own car is the flank it has; abeam the middle of the train, neither gun reaches) and keeping
      // pace with the train, it howls, then runs in at flankSpeed m/s across the open ground and leaps onto the car it comes
      // alongside. The guard van's gun has it for about fifteen seconds from the howl.
      // Of the night's flank pairs, every flankEngineEvery-th (the second of each two; note 443) comes abeam the engine's gun
      // instead, to a train with a gun laid forward (with none laid back, every one does): the forward gun's flank, as abeam
      // the guard van is the guard gun's. It runs in falling back along the engine, and leaps onto the first car behind it.
      "flankEvery": 3, "flankOut": 70, "flankAbeam": 4, "flankSpeed": 6, "flankEngineEvery": 2,
      "flankBiomes": ["farmland", "plains", "hills", "mountain", "coast", "marsh", "dykeland", "contaminatedMarsh", "slag",
        "deadTown", "industrialRuin"]
    },
    // A spawn pressed for (pressure at pressAt) may overdraw the budget's curve by up to pacedCost. Budgets are about twice
    // App. B.1's to pay for it. A kind among the last varietyWindow spawns has its weight halved for each.
    "pacedCost": 3,
    "varietyWindow": 4,
    // And across the whole night (note 742; the director's second playtest, 14 Oct: "not enough variety of monsters ... I saw
    // the cinder hounds like three times"): a kind about tonight that hasn't been sent yet weighs unseenWeight times as
    // much, and each one of a kind sent tonight (the director's or come its own way) multiplies it by nightRepeat.
    "unseenWeight": 2.5,
    "nightRepeat": 0.6,
    // And a kind come repeatHold times tonight waits (unless the director's pressed: a long quiet) while one about tonight
    // hasn't come yet: the moving train lets few kinds in, the stops and towns most, so it saves up for those.
    "repeatHold": 2,
    // The most of a kind the director sends a night, and the chance it's about at all tonight (drawn from the seed), by the
    // names in "costs"; a kind not named has no cap and is always about. Note 635, the director, the inbox, 12 Oct 2026, of
    // the Knotter: "They should show up once or twice a run. Sometimes never. We need more monster variety." Every kind's
    // chance is the director's roster on the Creature Tweaker (note 652, 13 Oct).
    "perNight": { "knotter": 2 },
    // The most of any kind perNight doesn't name (note 654): null, no cap. For the director's D1-roster-piles-up: with few
    // kinds about on a night (nightChance), those about come again and again (note 652); this holds each to a few.
    "perNightDefault": null,
    // A trial (note 915, porting #590's 3-a-night cap, note 863, #1285; the director's call on it is open): on, perNightDefault
    // stands at nightCap.perNightDefault (a kind's own perNight still wins). Off until measured and decided.
    "nightCap": { "on": false, "perNightDefault": 3 },
    // A pack the director sends (Cinder Hounds, Ribbits, Climbers) counts once toward its kind's cap (note 863; the spec
    // doesn't say); false counts each of its members.
    "packCountsOnce": true,
    // Fresh kinds when the night's run dry (note 863, ported off in note 915; the director, 19 Oct 2026: "I don't want the
    // night to run into a soft ending but I dont want repeats of the same monsters over and over"): when the director would
    // send something and nothing fits, and a kind about tonight has had its cap, one kind nightChance rolled out comes in,
    // drawn by its chance among those whose rule is met now or whose free gate is open; a chance of 0 is never brought. At most
    // one every everySeconds, maxPerNight a night; on its own dice. A trial: off until measured with the cap.
    "fresh": { "on": false, "everySeconds": 30, "maxPerNight": 10 },
    "nightChance": { "knotter": 0.66, "hotbox": 0.4, "brakeman": 0.6, "climbers": 0.35, "draggers": 0.65,
      "cinderHounds": 0.7, "fireFlies": 0.42, "carHugger": 0.51, "whistler": 0.65, "trackDoll": 0.22,
      "tippyToesie": 0.7, "stoker": 0.4, "followers": 0.66, "ribbits": 0.66, "gaunt": 0.21,
      "sootChildren": 0.36, "grumbler": 0.11, "passenger": 0.1, "moose": 0.19, "gannet": 0.72, "freightBeetle": 0.63,
      "towerJaw": 0.53, "pickers": 0.28, "lodger": 0.06, "householder": 0.68, "hollowHouse": 0.13, "hanger": 0.53,
      "mouseMoose": 0.5 },
    // A trial (note 915, #612; the director, 20 Oct 2026, to note 875's question 3: "raise", 30–40%): on, these stand in for
    // nightChance's (same order, same stream). Their gates hold 6–46% of an ordinary night; their chances kept them out four
    // nights in five. Measured (note 915: the Grumbler joins nights, deaths and delivery as they were) and on, the director
    // having chosen "raise"; the Creature Tweaker's game column carries these.
    "nightChanceTrial": { "on": true, "chances": { "grumbler": 0.35, "passenger": 0.3, "moose": 0.4, "gaunt": 0.35, "trackDoll": 0.35 } },
    // How often each kind comes against the rest: its weight among what could come, times this (×1 not named).
    "weights": {},
    // The in-car incidents' weight each (the others weigh 1): trouble in the cars is some of the night, not most of it.
    "incidentWeight": 0.5,
    // ...at full weight with this many hands besides the driver, proportionally less with fewer (a crew of two: a third).
    "incidentFullCrew": 3,
    // (incidentWeight and incidentFullCrew are v1.1's in-car incidents' and are read by nothing yet: note 751.)
    // GDD App. B.1 "Facility lull" (note 751): the first facilityLullSeconds the train stands at a facility, the director
    // sends nothing of its own (calm on arrival; the pressure builds through it). Once a facility: shunting its yard doesn't
    // start it again. 0: none.
    "facilityLullSeconds": 20,
    // GDD App. B.1 "Aftermath" (note 751; the director, 14 Oct 2026: "The breathing room is good. Don't necessarily want a
    // lot of it though"): after one of events the director sends nothing of its own for seconds, pressed or not (the
    // pressure builds through it). death: a crewmate who was alive is dead; carLost: cars the engine lost that the crew are
    // told of (note 663's news; a cut at a stand isn't one); rescue: a grab let go with the one held alive and not punished
    // (a friend's pull or blow, or their own struggle); holdoutFreed: someone broken out of a Holdout. Short on purpose.
    // on false: none, as before.
    // specials (note 912; note 887 found the aftermath held only the director's decisions): the hound run (a new one, or its
    // next pair) and the truss drops wait it out too; a left-behind crewmate's hunts are theirs and don't. The director's call
    // (the inbox): true, the default taken.
    "aftermath": { "on": true, "seconds": 12, "events": ["death", "carLost", "rescue", "holdoutFreed"], "specials": true },
    // The encounter pacing (the spawn director overhaul, docs/design/spawn-director-overhaul.md §3; the plan, note 874).
    "encounters": {
      // The encounter rate (spec B.10 "The encounter rate"; the director's brief, docs/design/spawn-director-overhaul.md §1 and
      // §3; note 877): encounter opportunities a minute, time × crew × train length × tier, every factor rising and none
      // falling (the brief's six requirements, EncounterPacingTests):
      //   λ = (base + (ramp + rampPerCrew × (P − 1)) × p^power) × (1 + perCrew × (P − 1)) × (1 + perCar × max(0, C − carsFrom))
      //       × tier, to at most max
      // p: how far into the night, the clock toward dawn or the train along the line, whichever is further, never going back
      // (standing still doesn't stop it). P: the crew alive in the night, bots and players alike (never one who's left; at
      // least 1). C: the cars. base is the solo floor at the gate (a solo night is never just the clock); ramp what the night
      // adds by its end, steeper by rampPerCrew a crewmate over one, so a bigger crew's night worsens faster as well as
      // starting higher; perCar is gradual, no breakpoint at eight cars. The tier is its own factor (Local to Deep Territory).
      // The defaults are the brief's prototype. A 20-minute night's opportunities at Frontier (EncounterPacing.Night): solo
      // 2 cars 5.4, two 5 cars 6.7, four 8 cars 9.6, eight 12 cars 16.5. Not yet driving the director: #608 wires it in, and
      // takes the pressure's own crewScale/lengthScale and the free spawns' crewFade out with it.
      "base": 0.12, "ramp": 0.33, "rampPerCrew": 0.035, "power": 1.2, "perCrew": 0.07, "perCar": 0.05, "carsFrom": 3,
      "tier": { "local": 0.8, "frontier": 1, "deadLines": 1.2, "deepTerritory": 1.4 },
      "max": 3,
      // Concurrency and overlap by crew and train length (the brief §1 B–C, §6; note 906; Concurrency, ConcurrencyTests). With
      // `on` the director reads it: the engaged cap and the census's perTarget below, the pairs a night, the pairs refused a
      // small crew (every channel's choices), and the relief on the encounter rate (drive). on false: the director as before
      // (maxConcurrentSmallCrew / LargeCrew, orchestrator.engagedPerActive ... perPlayerLong, pairsPerRun as it stands).
      // Off by default (note 906's quick sweep, 21 Oct, against the same head with it off): on, four crew on 8 cars lost the
      // late half's band (+0.75 → −0.5), died 1 a night (0.25) and delivered 75 % (100 %); solo and two crew no better. Its
      // likeliest cost is pairsPerCrew (two pairs a night for four, not one): untried, #612/#613's to measure.
      // The engaged cap: the living × share, share rising by sharePerCar a car past carsFrom to at most shareMax, rounded half
      // up, at least 1 while anyone's alive, at most max: solo 1 to 6 cars and 2 from 7; two crew 2 on 4 cars, 3 on 6, 4 on 8;
      // four 4 on 4 cars, 7 on 8; eight 11 on 6 cars, 12 from 7. Gradual, where App. B.1's flat 4 / 6 (maxConcurrentSmallCrew /
      // LargeCrew) and note 647's two each at 8 cars (orchestrator.longTrainCars) were steps. perCrewmateMax: the most on one
      // crewmate at once (share rounded half up: two each from 7 cars). ambientRoom (#604's, off the cap) + ambientPerCar a
      // car past carsFrom, rounded down.
      // Contradiction pairs (App. B.1 "contradiction seeding", the conflicts table): a night seeds pairsPerRun (its tier's)
      // × (1 + pairsPerCrew a living crewmate over one), rounded half up (frontier: 1 for one or two, 2 for three to six, 3 for
      // seven or eight). pairMinCrew: the pairs whose two answers need two people at once, never made for a smaller living crew
      // (whoever the Moose chases ends up alone vs. never be outnumbered by Ribbits; the loading needs everyone vs. someone
      // keeps the Moose busy; run fast for the hounds vs. stop to pull the Hotbox, or to kill the Knotter, or to climb after
      // the Brakeman): a crew of one isn't set a problem only two can answer (§6). Named pairs only; the rest need one.
      // Relief when crew are lost (§1 B, §6): × (alive ÷ the crew in the night)^reliefPower × (1 − hurtRelief × the share of
      // the living under hurtBelow health), on the encounter rate (which counts only the living already).
      "concurrency": {
        "on": false,
        "share": 0.75, "sharePerCar": 0.2, "carsFrom": 3, "shareMax": 2, "max": 12, "perCrewmateMax": 2,
        "ambientRoom": 1, "ambientPerCar": 0.1,
        "pairsPerCrew": 0.25,
        // soloCap (n1-A3's trial for #613, note 906): with one crewmate alive, at least this many threats at once and on
        // them (a solo crew's share rounds to 1, which held its nights at the cap ~540 s each). 0: by the share, as before.
        "soloCap": 0,
        "pairMinCrew": { "ribbits+moose": 2, "moose+facilityLoading": 2, "cinderHounds+hotbox": 2, "cinderHounds+knotter": 2, "cinderHounds+brakeman": 2 },
        "reliefPower": 1, "hurtBelow": 35, "hurtRelief": 0.25,
        // What holds the cap (n1-A1's measure, 20 Oct: a solo crew's one place filled 168–691 s a night by a Knotter at its
        // coupling 34–50 m off, a car fire and a Whistler watching its gap). A threat holding nobody that's had no living
        // crewmate within farMetres for farHoldSeconds is off the cap: danger still (the pacing counts it), but no longer the
        // reason nothing else comes (the brief §2 issue 4, §6). 0: off. One at work on the train (a pack feeding aboard, a
        // Hotbox, a Brakeman at the brakes: a harm that grows) holds it however far, but for farWorkers, whose work is a state
        // the train's left in (the Knotter that's the coupling); so a hound aboard still holds back a hound run (§9). incidentsHoldCap false: a car fire (App. C.5) is the
        // train's harm with its own counterplay, never a creature's place on the cap. (The Knotter's and the Whistler's waits
        // read as threatening, not engaging: director.threats.waitsEngage.)
        "farMetres": 30, "farHoldSeconds": 60, "farWorkers": ["knotter"], "incidentsHoldCap": false
      },
      // Bounded encounter debt (§3 "Encounter debt"; note 876): part of the encounter rate the director wanted but couldn't
      // place, remembered and paid back gradually, so a spell with nothing eligible doesn't erase the night's escalation.
      // share: of each unmet opportunity, what's owed, by why it went unmet: noPlacement (a kind picked, nowhere legal to put
      // it) and ineligible (nothing about tonight fitting here and now). Nothing else ever owes, whatever's named here: a
      // safe zone, the grace, recovery, the terminus and full engagement caps are quiet the game means (§1.A, §6).
      // cap: encounters owed at most. meanLifeSeconds: the debt forgets itself over this (a debt from an hour ago is no
      // reason for a monster now). releasePerMinute: at most this many owed encounters repaid a minute, on top of the
      // night's own rate; releaseBurst: the most the release allowance holds. While the director is held (a safe zone,
      // the grace, recovery) the allowance empties, so a backlog comes back at the release rate after the yard, never as a
      // burst (§3). on false: no debt, as before.
      "debt": {
        "on": true,
        "share": { "noPlacement": 0.6, "ineligible": 0.4 },
        "cap": 2,
        "meanLifeSeconds": 240,
        "releasePerMinute": 0.5,
        "releaseBurst": 1
      },
      // The spawn transaction (note 885; the brief §2 issue 3): a spawn the director chose that placed nothing commits nothing
      // (no pressure, budget, cooldown, log line or cap). The pressure tries again the next second; the kind that failed sits
      // out failHoldSeconds of the pressure's, the curve's and the stops' choices, so another is chosen rather than the same
      // one into the same wall. A free spawn that fired and failed stays owed for freeRetrySeconds (fires again on the next
      // seconds' choices without a new roll; the roll is still made, so the curve's dice don't move).
      "attempts": { "failHoldSeconds": 10, "freeRetrySeconds": 20 },
      // One pacing model (§2 issues 1 and 2, §3; note 908): the encounter rate and the debt drive the director's channels.
      // Each director second the night isn't held for a quiet it means (the grace, a fort, the final stretch and the line's
      // bans, the aftermath, a facility's lull, the terrain at its ceiling, the engaged caps full), the night owes the crew
      // λ/60 more encounters; every encounter placed by any channel (the pressure's spend and fill, the stops' own, a free
      // spawn, the Stoker) pays one off, a pack as one, so no channel adds to another's rate. Owed past a threshold drawn
      // about 1 (± jitter) at each payment, the free channel sends one (its spacing, the caps and each kind's night hold):
      // the night meets λ's encounters even when the pressure's rules find nothing, and not by a roll that may never land.
      // dueCap: the most owed at once; what λ would add past it goes to the debt (why: nothing fitting, or what was chosen
      // finding nowhere). dueFloor: the least (a stop's several residents don't buy minutes of silence after it).
      // pressureByLambda: the crew and the train scale the night once, in λ: the pressure (the director's answer to what
      // the crew does) is the same for any crew and train, not pressure.crewScale/lengthScale about a crew of four on eight
      // cars (issue 1: a solo crew's was a third of a four's; issue 2: no double scaling). With `on` the free spawns'
      // curve.atGate/atEnd roll and its crewFade are no longer read; on false, the director as before.
      // pressureGate: the pressure's spends (and its fill) wait until the clock owes at least this, pressed or not (an
      // answered draw, the night's first threat, goes ahead): λ says how many, the pressure when and what. Without it the
      // pressure spent past λ, the free channel never fired, and 2, 4 and 8 crew ran over §7's bands in bursts (note 908).
      // null (as shipped): the pressure spends as it would alone. Measured at 0.5 (note 908): 8 of 20 cells in §7's bands
      // against 12 without it (λ counts placements, many of which never come on), so it waits for #613's calibration.
      "drive": { "on": true, "dueCap": 1.5, "dueFloor": -1, "jitter": 0.35, "pressureByLambda": true, "pressureGate": null,
        // The final surge (#663, note 960; #613): the terminus approach is a kept quiet in the late half, so the raw late
        // half read quieter. Over rampMetres before the first kept quiet ahead (the final stretch or terminus_safe), λ rises
        // linearly to peak × itself, and the pressure's build with it (the pressure is what spends), so that window's
        // encounters come before it, never in it. Off until measured and asked. crewFull: the gentler surge (note 960; at
        // peak 2 an eight's deaths went 0.8 → 2.7 a night): above that many crew alive, the peak's rise over 1 scales by
        // crewFull / alive (4: an eight's peak 1.5). null: every crew the full peak.
        "finalSurge": { "on": false, "rampMetres": 2500, "peak": 2, "crewFull": null } },
      // Selection and placement (note 895; the brief §3 "Encounter selection" 6, §4 level 3, §5). selection: a kind whose zone
      // (Enemy.Zone: forward, rear, flank, interior, structural, outside) already has engaged threats weighs ×zoneRepeatWeight
      // for each, in the pressure's and the curve's choices, so the next threat is a problem somewhere else (the conflict
      // table's pairs still weigh their combinations up). placement: where along the train a rule puts what it sends, among
      // the cars, gaps or couplings its rule allows (Climbers, Draggers waiting under the rake, Whistler, Fire Flies, Hotbox,
      // Knotter): a place within threatSpreadM (m along the line) of a threat already about weighs down to nearThreatWeight
      // (right at it; 1 at threatSpreadM), one within onTopM of a crewmate ×onTopWeight. The rule's own draw, so with nothing
      // about and nobody near it picks as it did. on: false for either is the director before note 895.
      "selection": { "on": true, "zoneRepeatWeight": 0.5 },
      "placement": { "on": true, "threatSpreadM": 40, "nearThreatWeight": 0.2, "onTopM": 6, "onTopWeight": 0.3 },
      // A halt's own (note 895; GDD D.15 question 3, the director 9 Oct: "Needs a dedicated response"; 20 Oct: "What's best
      // for gameplay?"): stood on the main line at an abandoned village's halt, lullSeconds after stopping there, one
      // encounter (whatever the night's curve could send, rule-met or free) if the stop's own haven't put one there; counted
      // as the stop's. Off until measured ("test creature spawn first").
      "halt": { "on": false, "lullSeconds": 15 }
    },
    // GDD App. B.1 "Post-event cooldown" (design decision, 2026-10): the least trough after a spawn; the pressure's relief
    // makes the rest of it, and well past the threshold (pressAt) it gives way.
    "cooldownSeconds": [25, 45],
    // T114 playtest ("where are all the monsters"): a threat that goes lingerSeconds with nobody alive within lingerRadius m
    // of it (and has nobody in its grip) gives up and goes, so what nobody's answering doesn't hold the caps below full.
    "lingerSeconds": 120,
    // Near enough to be met: a car's length (a Climber settled in the car behind the cab is 15-25 m from the driver).
    "lingerRadius": 12,
    // Note 945 (line 19, "it just disappeared"): the stuck rule above (telegraphing or committing lingerSeconds × 1.5) took a
    // Gaunt following its waker, talked to and so held in its telegraph, from right beside them. stuckSparesTheMet: what has
    // a living crewmate within lingerRadius isn't stuck. Off until the director's said (a despawn rule of the director's).
    "stuckSparesTheMet": false,
    // The Gaunt-only ask (note 945: n1-C1's 30-seed sweep had the rule for every kind cost two-crew deliveries, .73 -> .47):
    // the same spare for the kinds listed only (["gaunt"]). Empty: off, until measured and the director's said.
    "stuckSparesKinds": [],
    // Note 957 (frontier:4 4x8, the crew lost one by one to the hounds and the Ribbits): the crew the director's gates
    // (minCrew) and pack sizes (the Ribbits' "never more than the crew") go by counts the living only. false: everyone in
    // the night, the dead included, as before. Off until measured and the director's said (spawns are the director's).
    "crewIsTheLiving": false,
    // Note 795 (the director, 15 Oct: "Even when testing alone I'm not running into monsters in yards or abandoned villages"):
    // with every living crewmate off the train, afoot in a yard or a village, what none of them is within capNear m of (and
    // that has nobody in its grip) holds no cap: a hound pack aboard or a Knotter in a coupling left behind held a crew of
    // one's single place all night. 0: off.
    "capNear": 60,
    // Note 881 (the director overhaul's B2, queue #604; docs/design/spawn-director-overhaul.md §2 issue 4): each enemy's
    // engagement state, from what it's doing (Threats.Of): dormant (lying in wait), ambient (about, nobody near, nothing of
    // the train's in its teeth), threatening (alert, near a crewmate within nearMetres, or doing a train system harm with
    // nobody near: a Hotbox, a pack feeding aboard, a Knotter, a Brakeman at the brakes), engaging (at someone), resolved.
    // leftMetres: loose, holding nobody and this far from every car and crewmate, it's ambient whatever it's doing (a yard's
    // Freight Beetle or Mouse Moose the train left behind held a solo crew's one place for 500-1,000 s of a night; note 881).
    // on: the engaged cap counts threatening and engaging, not bodies, and ambientRoom more may be about off it (the cap plus
    // ambientRoom in all, so what paces cars nobody's in can't pile up into a wave); false: as before (everything
    // Director.Engaged holds the caps).
    // waitsEngage false (note 906): a Knotter that's the coupling and a Whistler watching its gap are at their work or waiting,
    // threatening, not engaging; only a grab or a coil round someone is. True (the default, as #604 had it): on, with the far
    // and car-fire readings (concurrency), two crew lost the late half's band in note 906's sweep (+1 → −0.25).
    "threats": { "on": true, "nearMetres": 20, "ambientRoom": 2, "leftMetres": 150, "waitsEngage": true },
    "maxConcurrentZone": 2,
    "maxConcurrentSmallCrew": 4,
    "maxConcurrentLargeCrew": 6,
    // Budget share spent before the first facility, across the middle, and in the final approach.
    "phaseShares": [0.15, 0.45, 0.40],
    // App. B.1 v1.1's cost table (the Choir costs nothing: it isn't spawned; hazards are level content).
    "costs": { "followers": 2, "draggers": 2, "fireFlies": 2, "trackDoll": 3, "cinderHounds": 3, "climbers": 3,
      "whistler": 3, "stoker": 3, "ribbits": 3, "carHugger": 4, "tippyToesie": 4, "gaunt": 4, "sootChildren": 4, "grumbler": 4,
      "passenger": 5, "moose": 3, "gannet": 4, "freightBeetle": 1, "towerJaw": 3, "brakeman": 3, "hotbox": 2, "knotter": 3,
      "mouseMoose": 2 },
    // App. B.3/B.8 weights.
    "houndsLivestockWeight": 2.5,
    "houndsHotBoilerWeight": 1.5,
    // App. B.8, the rest of the table: with this cargo aboard (a loaded car of it in the engine's rake), these weigh this
    // much more; "*" is everything. Livestock's Hounds are houndsLivestockWeight's; chemicals' Drift is the drift's own
    // chemicalSpread (it isn't drawn, it's terrain). The comet cargo also relaxes the
    // Gaunt's and the Passenger's tier gates by one (cometRelaxesGates).
    "cargoWeights": {
      "food": { "cinderHounds": 2, "followers": 1.5, "grumbler": 2 },
      "comet": { "*": 1.4 }
    },
    "cometRelaxesGates": true,
    // GDD §18 "Slaughterhouse: animals are loud, and something already lives here" (note 185): while the train's stopped at a
    // facility of this kind, these come on this many times as often. The Gaunt sleeps in yards (App. B.6); in a
    // slaughterhouse it's the resident.
    "residents": {
      "slaughterhouse": { "gaunt": 4, "followers": 1.5 },
      // GDD §18 "Wreck yard: unstable, unlit, already occupied" (note 187): Draggers under the cars on their sides.
      "wreckYard": { "draggers": 3, "gaunt": 2 }
    },
    // App. B.1 "contradiction seeding": the v1.1 conflict table, as the tuning's names (and conditions: "choir", gathering or
    // here; "grade", a climb or fall just ahead; "facilityStop", at a facility; "facilityLoading", at one with its loading
    // going on, the machinery running or a crewmate on a module, with orchestrator.commitment, note 753). Ambiguity (ARCHITECTURE §8): "draws
    // pairs from a conflict table": read as a spawn that would complete a pair with what's there now weighing this much
    // more, and this much more again past halfway on a run short of its pairs.
    "conflicts": [
      // The Moose (note 339): talk to the Gaunt vs. the moose hears every word; never be outnumbered vs. whoever it chases
      // ends up alone; the coupling gaps hide you from it and hold the Whistler; the loading needs everyone vs. someone
      // keeps it busy.
      ["gaunt", "moose"],
      ["ribbits", "moose"],
      ["whistler", "moose"],
      ["moose", "facilityLoading"],
      // The Gannet (note 340): outrun the hounds by running fast vs. a fast train brings it; walk the centreline (the
      // Draggers) vs. step aside when it folds; the gun is the quick answer vs. every ball feeds the Choir and marks the gunner.
      ["cinderHounds", "gannet"],
      ["draggers", "gannet"],
      ["choir", "gannet"],
      // The Freight Beetle (note 366): load fast vs. it pushes the freight off; steer it to the car vs. the crane's castings
      // overhead.
      ["freightBeetle", "facilityLoading"],
      ["grumbler", "freightBeetle"],
      // Tower Jaw (note 363): crowd the beaver to drive it off vs. crowding is what the Moose minds; load and go vs. the
      // coaling tower's coming down.
      ["moose", "towerJaw"],
      ["towerJaw", "facilityLoading"],
      // The Brakeman (note 364): up on the roofs after him vs. walking the roofs is what the Gannet dives at; run the roofs vs.
      // the edges the Draggers hold; keep the speed up for the hounds vs. he's winding the brakes on.
      ["brakeman", "gannet"],
      ["draggers", "brakeman"],
      ["cinderHounds", "brakeman"],
      // Hotbox (note 367): run fast for the hounds vs. stop to pull it before it seizes.
      ["cinderHounds", "hotbox"],
      // The Knotter (note 365): never stop with the pack behind vs. it's killed only at a stand; cut the Car Hugger's car vs.
      // the coupling you'd cut across is the Knotter.
      ["cinderHounds", "knotter"],
      ["carHugger", "knotter"],
      ["choir", "cinderHounds"],
      ["choir", "gaunt"],
      ["fireFlies", "trackDoll"],
      ["trackDoll", "facilityLoading"],
      ["whistler", "facilityStop"],
      ["tippyToesie", "stoker"],
      ["carHugger", "grade"]
    ],
    "pairWeight": 3,
    "behindPairWeight": 3,
    "pairsPerRun": { "frontier": 1, "deadLines": 1, "deepTerritory": 2 },
    // Sleepers "about" for a pair: lying this far ahead (m). A "grade" ahead: this steep (%) within this far (m).
    "sleepersAhead": 1500,
    "gradeAhead": 600,
    "gradePercent": 1.5,
    // Saving up (ARCHITECTURE §8): from this share of the route in, cheaper threats leave enough budget for these rare,
    // expensive ones while the run can still have them, so they come at all.
    "saveFor": ["passenger"],
    "saveFrom": 0.2,
    // The kinds this edition has, by the names in "costs" above; empty is all of them. The demo edition (editions/demo,
    // T79) has GDD §21's five, one per pressure zone (the Choir, structural, is always about), and the trouble in the cars.
    "roster": [],
    // App. B.1 v1.1 want balance: each want's target share of the budget; a want over its share weighs less.
    "wantShares": { "kill": 0.40, "split": 0.25, "trust": 0.20, "cargo": 0.15 },
    // App. B.1 hard caps: corrupted humans, one at a time (the zone cap, maxConcurrentZone, covers the rest).
    "maxCorrupted": 1
  }
}
