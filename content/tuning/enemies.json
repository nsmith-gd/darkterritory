  },


  // CAR FIRE (App. C.5, a supporting system: Fire Flies start it, as can a lamp dropped in a car). It grows; past
  // burnFrom it burns anyone within burnReach and the car's cargo and integrity; past spreadFrom for spreadSeconds it
  // takes the next car. Each car has a wall-mounted extinguisher: Fire held within sprayReach knocks it back
  // sprayPerSecond, for chargeSeconds of spray, recharging over rechargeSeconds on its bracket. DESIGN-TODO: the GDD has
  // no numbers; these let one crewmate who gets there in the half minute a fire takes to take hold put it out with one
  // extinguisher, and a fire left longer need two.
  // App. B.9 (note 182): coal and timber "burn" (§19) and "fire cascades escalate faster": a car of either grows fuelGrowth
  // times as fast and runs its spread clock fuelSpread times as fast. Gunpowder and shot "explodes" (§19): a powder car with
  // cargo left in it at explodeAt (full blaze) goes up once, the car and its cargo gone; everyone within explodeKillRadius m
  // takes explodeDamage (killed), less with distance out to explodeRadius; the cars either side catch. DESIGN-TODO: not in
  // the GDD's numbers: the kill radius is the powder car's own length and its neighbours' near ends.
  "carFire": {
    "startIntensity": 0.1, "growPerSecond": 0.006, "growWithSize": 0.02, "burnFrom": 0.35, "sprayReach": 3.5,
    "sprayPerSecond": 0.35, "chargeSeconds": 15, "rechargeSeconds": 90, "burnReach": 1.6,
    // App. C.5: it burns "whoever's in it", and says no more. The director's decision of 6 Oct 2026 (note 263: "if I stay in
    // the fire too long, then yeah, I die, but I just barely touched it"): it burns by the second, not in lumps. Within
    // burnReach of it you take burnPerSecond x its intensity, at burnBrushShare of that the moment you're in it, rising to the
    // whole over burnRampSeconds; step out and it starts again from a brush. At full blaze a second in it is about 6 health,
    // and standing in it kills in about 11 s.
    "burnPerSecond": 10, "burnBrushShare": 0.5, "burnRampSeconds": 3,
    "cargoPerSecond": 0.003, "integrityPerSecond": 0.0015, "spreadFrom": 0.8, "spreadSeconds": 15,
    "chemicalSpread": 2, "chemicalGrowth": 1.3, "powderGrowth": 1.6, "fuelGrowth": 1.4, "fuelSpread": 2,
    "explodeAt": 0.6, "explodeRadius": 14, "explodeKillRadius": 5, "explodeDamage": 150,
    "burnOutPerSecond": 0.05, "maxActive": 3,
    // The director's decision of 6 Oct 2026 (App. F.1, note 267): "Fire is a grid". Each car's floor, walls and roof are cut
    // into cells of cellSize m; each has its own heat, 0..1. A cell starts at startIntensity, grows at growPerSecond +
    // growWithSize x its heat (the floor's cells x the cargo's growth: it's the cargo that's burning there), and burns up
    // charPerSecond x its heat of itself, charring; burnt out, it dies down at burnOutPerSecond. A cell at catchFrom or more
    // heats each cell sharing an edge with it at catchPerSecond x its heat, climb x that upward (up the walls, onto the roof).
    // The extinguisher (sprayReach from the eye, along the look) cools the cell it's aimed at by sprayPerSecond, and the cells
    // round it by sprayShare of that, and wets it for dampSeconds: it won't catch again from round it until it dries. It's
    // alight (the commit) when a cell's at burnFrom; the car's fire, for the explosion, damage and the sound, is the mean of
    // its cells (explodeAt: more than half the powder car well alight). It jumps the coupling from a cell against an end
    // wall at spreadFrom for spreadSeconds. It burns whoever's within burnReach m of a burning cell's patch (half a cell
    // round its centre; from their feet to bodyHeight up), by that cell's heat less with distance, the roof's at
    // ceilingBurnShare. A cell below outBelow is embers: it doesn't grow on its own, and goes out unless a cell round it
    // is heating it (a sprayed cell doesn't creep back from a spark). DESIGN-TODO: the GDD has no numbers; these keep
    // one crewmate who gets to a fire in its first half minute able to put it out with one extinguisher, a fire left a
    // minute needing two, and a car left alone taking the next in about a minute and a half.
    "cellSize": 1.5, "catchFrom": 0.5, "catchPerSecond": 0.04, "climb": 2, "charPerSecond": 0.01,
    "sprayShare": 0.4, "dampSeconds": 3, "ceilingBurnShare": 0.5, "bodyHeight": 1.8, "outBelow": 0.05
  },

  "choirSwarm": {
    // Legacy (T9): the Choir's damage to the exposed is now its ghosts' seize (above); kept for old saves' tuning.
    "exposedDamage": 0,
    "everySeconds": 1
  },

  "director": {
    // GDD v1.4 App. D.11 and D.13, the dead's creature vote (note 180): a ballot of `options` drawn from what the director
    // could send now, each vote ×perVote to its creature's weight, to at most ×cap, within its want tag. A dead bot votes
    // botSeconds after its ballot's offered (note 202: not a GDD number, the bots' deliberation, so harness nights vote).
    "vote": { "perVote": 1.2, "cap": 1.5, "options": 3, "botSeconds": 6 },
    // The draw (ARCHITECTURE §8 note 287; GDD §14 "Noise", §23.1 "Owned", App. B.1, App. F.1 "Run start: nothing makes the
    // player feel they've done something that draws a monster"): the night's first threat answers something the crew did.
    // Every draw is credited to whoever made it on a ledger that halves every halfLifeSeconds (what drew most, lately). After
    // the grace, the first time one crewmate's draw of one kind stands at answerAt or more, the dark answers it out loud (a
    // call from answerDistance m ahead and answerLateral m off the line, at the lamp's edge; eyes there at answerHeight for
    // showSeconds) and the first threat follows leadSeconds later, pressed for (the cooldown and the curve give way as at
    // pressAt). With no draw that big the pressure, past its threshold, waits ("listening") up to holdUntil, and then the
    // biggest draw standing takes the blame: a quiet crew buys itself time (holdFirst false: the pressure model as before).
    // The Stoker is the firebox's own draw (note 263); the Choir the loudest's. Nothing here runs in the safe yard.
    "draw": {
      "enabled": true,
      "halfLifeSeconds": 30, "answerAt": 3, "holdFirst": true, "holdUntil": 16, "leadSeconds": 5,
      "showSeconds": 7, "answerDistance": 60, "answerLateral": 12, "answerHeight": 0.7,
      // Raised voices only: the mic level (0..1) above voiceFloor, scaled to the rest (the bots' working chatter is 0.27).
      // The firebox above fireboxFrom (of 6; the Stoker's heatFirebox). The engine at engineFullSpeed m/s or more.
      "voiceFloor": 0.4, "fireboxFrom": 4.5, "engineFullSpeed": 20,
      // A second of: the whistle 1.5 (a proper blast answers, a toot doesn't), voices 0.5 at full shout, a noisy toy carried
      // 0.15, the firebox 0.25 full, the engine 0.03 at speed (it never answers alone: at most about 1.3 stands). An act of:
      // a cannon round 3 (one shot answers), a car lamp lit 2, cargo aboard 4 a car-load × pressure.cargoValue.
      "weights": { "whistle": 1.5, "voices": 0.5, "toy": 0.15, "firebox": 0.25, "engine": 0.03, "cannon": 3, "lamp": 2, "cargo": 4 },
      // What answers each draw: these kinds weigh this much more for the first threat (only what the night could send anyway).
      "answers": {
        "whistle": { "whistler": 3, "cinderHounds": 2 },
        "cannon": { "cinderHounds": 2, "ribbits": 2, "climbers": 2 },
        "voices": { "sootChildren": 3, "tippyToesie": 2, "followers": 2 },
        "toy": { "trackDoll": 4 },
        "firebox": { "cinderHounds": 2 },
        "lamp": { "fireFlies": 3 },
        "cargo": { "carHugger": 3, "grumbler": 2, "cinderHounds": 2 }
      }
    },
    // App. B.1.
    "baseBudget": { "local": 90, "frontier": 150, "deadLines": 230, "deepTerritory": 330 },
    "lengthPerCarBeyondThird": 0.15,
    "crewBase": 0.7,
    "crewPerPlayer": 0.12,
    "crewCap": 1.6,
    // GDD App. B.1 "Grace period" (design decision, 2026-10): the quiet spell at the start of a night is a range, picked per
    // night from its seed, shorter on the harder tiers (pressure.graceTierScale scales the draw above the minimum).
    "graceMinSeconds": 20,
    "graceMaxSeconds": 90,
    // A generated line's grace stretch (linegen plan §4: gate to 2 km, "covers the GDD 90 s grace period") bans spawns only
    // this far into the run (s), or to the end of the night's own grace if that's later. -1 keeps the ban for the whole stretch.
    "lineGraceSeconds": 0,
    // GDD App. B.1 "Pacing rules" (design decision, 2026-10; ARCHITECTURE §8 note 266): when the director spends is
    // algorithmic, not a timer. Once a second after the grace its pressure builds by
    //   tier × conditions × relief × busy × escalation × (basePerSecond + quiet + loud + cargo)
    // and past threshold it sends what its weights pick (the budget's curve, caps, gates, saving up, pairs, variety, wants
    // and the dead's votes all as before); each spawn takes reliefPerCost × its cost off.
    "pressure": {
      // The level that spends; where it starts when the grace is over; the most it banks (held at the caps or under a ban it
      // doesn't pile up); and pressAt: this high, the cooldown gives way and the budget's curve may be overdrawn by pacedCost.
      "threshold": 10, "start": 4, "max": 18, "pressAt": 16,
      // A cost-3 threat takes 9 off: the trough after a spawn is the pressure building again.
      "reliefPerCost": 3,
      // The night's own rise: everything × (1 + escalation × progress^escalationPower), progress being how far along the line
      // or toward dawn, whichever is further (×4 at the end: fewer threats early, more toward the terminus); and a base
      // that builds whatever else is going on.
      "basePerSecond": 0.03, "escalation": 3, "escalationPower": 1,
      // Quiet builds pressure: + quietPerSecond × (seconds since a threat was engaged (telegraphing, committing, grabbing,
      // punishing) or sent / quietRampSeconds, to 1), so no
      // stretch goes much past a minute and a half without something, even at the gate.
      // GDD App. F.1 (the director, 6 Oct 2026; note 270): "quiet stretches are counted in kilometres, not seconds." With
      // quietRampMetres set, the ramp is the line run since then over quietRampMetres (1,260 m: the old 90 s at spec B.3's
      // 14 m/s cruise), or the seconds over quietBackstopSeconds if that's sooner, so a stopped train can't wait it out.
      // quietRampSeconds is the ramp only with quietRampMetres 0.
      "quietPerSecond": 0.1, "quietRampSeconds": 90, "quietRampMetres": 1260, "quietBackstopSeconds": 120,
      // The crew's loudness (App. C.7, the Choir meter): + loudPerSecond × (meter / the Choir's threshold, to at most loudCap).
      "loudPerSecond": 0.1, "loudCap": 1.5,
      // Cargo aboard (App. B.9): + cargoPerLoad per car-load (load × cargo integrity × cargoValue, 1 for what isn't listed).
      // What's lost or spoiled stops drawing them.
      "cargoPerLoad": 0.01,
      "cargoValue": { "comet": 2, "livestock": 1.5, "food": 1.3, "medicine": 1.3, "ammunition": 1.2 },
      // The tier's rate, and how much of the grace range above its minimum the tier keeps.
      "tier": { "local": 0.8, "frontier": 1, "deadLines": 1.2, "deepTerritory": 1.4 },
      "graceTierScale": { "local": 1, "frontier": 0.85, "deadLines": 0.7, "deepTerritory": 0.55 },
      // Conditions (GDD §22, §23): 1 + dark (the forward lamp out) + cold × the night's cold (0..1) + coldPerStep per deep-cold
      // step + wet (rain) + wind × the night's wind (0..1). Modest: §22's hazards take tools away, they don't make the rules.
      "dark": 0.15, "cold": 0.1, "coldPerStep": 0.05, "wet": 0.05, "wind": 0.05,
      // The relief valve: × (alive / crew)^downPower, and × (1 − hurtRelief × the share of the living under hurtBelow health,
      // the bots' own "too hurt to fight"), so a crew that's losing isn't fed faster; and busy: × 1 / (1 + busy × threats
      // engaged × (1 − busyFade × progress)) while they're fighting: late in the night it stops waiting for them.
      "downPower": 2, "hurtBelow": 35, "hurtRelief": 0.25, "busy": 0.5, "busyFade": 1
    },
    // T128 (build 1121: "a player left behind by the train should feel the world close in: tension, monsters coming, the
    // difficulty spiking for that player. They needn't die at once"; GDD §7, §23; ARCHITECTURE §8 note 273). Not in the spec.
    // A crewmate alive on the ground, further than behindM (m) along the line from the nearest end of the train and not in a
    // fort (run.json forts), has a pressure of their own, built once a second by
    //   tier × conditions (the night's pressure terms, above) × (perSecond + rampPerSecond × min(1, seconds left / rampSeconds)
    //   + perKm × km from the train)
    // and past threshold the director sends a hunt at them alone: a Ribbit pack (App. A.6: it hops in on whoever it
    // outnumbers on the ground, and can be outrun) of pack[0] the first time, one more each time after to pack[1], and always
    // more than the group they're in; put down spawnOut[0] m from them the first time, closer each time to spawnOut[1]. Each
    // takes relief off; while one's still after them, no other comes. Outside the budget, the caps and the night's own
    // pressure (it's theirs, not the train's): about 45 s left behind to the first, then every half minute or so, bigger.
    // Back aboard (or in a fort), it's gone.
    // Note 296 (T128's caveat, "only the Ribbits hunt so far"): from the hunt numbered gauntFrom (0 the first) on, a Gaunt
    // comes with the pack, woken on them (App. A.6: it follows its waker at arm's length and attacks after enough silence;
    // talking holds it off, and it follows them home onto the train, where the crew deals with it by its rule). One at a time
    // per crewmate, never at a crew under gaunt.minCrew, put down gaunt.spawnOut m off. -1: Ribbits only.
    "abandoned": {
      "on": true, "behindM": 150, "perSecond": 0.05, "rampPerSecond": 0.15, "rampSeconds": 60, "perKm": 0.3,
      "threshold": 6, "relief": 6, "pack": [2, 5], "spawnOut": [35, 18], "gauntFrom": 2
    },
    // The orchestrator's live crew (ARCHITECTURE §8 note 336; docs/design/orchestrator.md §3.2 1, 3 and 5; GDD App. F.3, the
    // director, 7 Oct 2026: "a threat orchestrator that takes into account how many players are on and then orchestrates
    // threats based on the number of active players in the game currently"). Not in the spec; first pass. Active is the crew
    // alive now, counted each second. liveCrew: App. B.1's crew multiplier (crewBase + crewPerPlayer × crew, to crewCap) takes
    // the crew active now, not the crew the night started with, so a crew that's lost players spends like the smaller crew
    // it is (the relief valve's alive-share squared still applies on top). on: the engaged cap is the least of App. B.1's flat
    // cap (maxConcurrentSmallCrew / LargeCrew), ceil(active × engagedPerActive) and perPlayer × active, and at least 1: 1 at
    // crew 1, 2 at crew 2, 3 at crew 3 and 4, 6 at crew 8. The hound run (below) waits while the crew is at it, so a crew of
    // one never meets two things at once. The left-behind's hunts and the Stoker stay outside it, as before.
    "orchestrator": {
      "on": true, "liveCrew": true, "engagedPerActive": 0.75, "perPlayer": 1,
      // The census of posts and slack (ARCHITECTURE §8 note 345; orchestrator.md §3.1, §3.2 items 2–4). Once a second, each
      // crewmate alive: their post (cab, gunner, walker on the roofs, a ladder or a gap, rider inside a car, ground off the
      // train near it, or left behind past abandoned.behindM, whose own hunt answers them); which engaged threats are on whom
      // (holding them; else the nearest crewmate within onRadius m; else the nearest at a post that answers it below: a pack
      // running behind is the gunner's); and their slack, the seconds on the run between stops (the train moving faster than
      // drivingAbove, past the grace, out of the forts and facilities, short of the final approach) since they last had something to
      // answer (a threat on them; an upkeep job on their car: an open hot box, note 331, or a guttering lamp, note 346; a hot box
      // anywhere for a walker, a guttering lamp anywhere for a rider; or, in the
      // cab, the train moving faster than drivingAbove m/s: the line and the fire are the driver's to answer). It
      // counts whenever "on" is (the harness reports it); with census on too and minCrew or more alive it steers (a crew of
      // one is App. B.1's as it was):
      // - who's next: the free crewmate with the most slack, minSlack s or more; a kind answered at their post weighs
      //   ×slackWeight; a kind answered only at posts nobody holds ×emptyPostWeight (not those in emptyPostExempt, whose
      //   rule is the empty post: the Track Doll's cab);
      // - slack presses: + slackPerSecond to the pressure each second for each crewmate at slackPress s or more;
      // - perTarget: one threat on any one player: a kind whose every answering crewmate (at a post that answers it) has a
      //   threat on them already weighs nothing (with all of them so, nothing comes that second).
      "census": true, "minCrew": 2, "onRadius": 20, "drivingAbove": 0.5, "slackWeight": 2, "emptyPostWeight": 0.5, "emptyPostExempt": ["trackDoll"],
      "minSlack": 30, "slackPress": 150, "slackPerSecond": 0.05, "perTarget": true,
      // Which post answers what (orchestrator.md §3.1's table), by the names in "costs" (carFire: the trouble in the cars).
      "answers": {
        "cab": ["trackDoll", "switchman", "stoker"],
        "gunner": ["cinderHounds", "climbers", "trackDoll", "switchman"],
        "walker": ["climbers", "draggers", "fireFlies", "whistler", "carHugger", "cinderHounds", "carFire"],
        "rider": ["tippyToesie", "fireFlies", "passenger", "carHugger", "carFire"],
        "ground": ["ribbits", "gaunt", "followers", "sootChildren", "grumbler"]
      }
    },
    // Note 327 (GDD App. F.3, the director, 7 Oct 2026: "ideally, we want people to be feeling like when they leave, there is
    // this presence of threat at all times"). Not in the spec. A crewmate alive on the ground further than fromTrainM (m) from
    // the train, and not in a fort, is afoot. While anyone is, the night's pressure builds by + perSecond × the share of the
    // living afoot (inside the pressure model's other factors: tier, conditions, relief, busy, escalation), so encounters come
    // sooner off the train; and what it sends then is more often met out there: the outside creatures, and whatever lives at
    // the stops' sites, weigh × (1 + (outsideWeight − 1) × that share). And the crew is watched: firstSign s after someone
    // first steps off, and every signEvery [min, max] s after while anyone's afoot, one of them (in turn) is shown a sign: a
    // pair of eyes for signSeconds out at signOut [min, max] m (the hand lamp's edge; nearer if a wall's in the way), within
    // signSpread degrees of the bearing of a creature that lives at this stop (one kind drawn from those with a site, note
    // 309's lairs, within signReach m; its nearest site), at that creature's eye height (signHeight by its tuning name, else
    // signHeightDefault), and its sound from there. Honest: only what lives here and the night could send; with no site in
    // reach, a Ribbit's (they come for whoever's on the ground anywhere), from away from the train. A sign is never a spawn:
    // nothing's there when you walk up to it.
    "afoot": {
      "on": true, "fromTrainM": 20, "perSecond": 0.08, "outsideWeight": 2.5,
      "signEvery": [12, 24], "firstSign": 6, "signOut": [14, 22], "signReach": 160, "signSeconds": 3.5, "signSpread": 35,
      "signHeight": { "ribbits": 0.35, "gaunt": 2.3, "followers": 1.6, "sootChildren": 1.0, "grumbler": 1.5, "whistler": 2.0 },
      "signHeightDefault": 0.7
    },
    // The hound run (ARCHITECTURE §8 note 328; docs/design/orchestrator.md §5.3 and §6.1; GDD App. F.3, the director, 7 Oct
    // 2026: "more threats that can board the train at speed ... tower defense style that gives our gunners things to do").
    // Not in the spec; first pass. fromSpeed is the director's packs' own maxSpeed: under it they can board, and outrunning
    // them is their counter (App. F.1, Decided; note 286); the run is what answers a train run faster than that (App. F.1:
    // "a fast ... class may come later to answer the top-speed strategy"). A train that has run afterMetres at fromSpeed m/s or more (×hotShorter with the boiler
    // over its working band: the heat draws them, App. B.3) since it last slowed under stopSpeed, since the last run, or
    // since the grace, draws a run: round(base + perActive × the crew alive) Cinder Hounds, to between size[0] and size[1],
    // in pairs spacing s apart, alternating flanks, put down spawnBehind m behind the rear car and lateral m off the line.
    // A runner closes at the train's speed + closing m/s, whatever the train's speed (they are faster than it: a hot train
    // can't outrun them), and leaps aboard the rear car from the pack's leapDistance as the director's hounds do (App.
    // A.3; then they stay aboard, note 269). Answered one at a time: a ball landing within scatter m of a runner sends it
    // off (one landing between a pair takes both); a ball on it kills it (note 290). A round fired anywhere near doesn't
    // send a runner off (the director's packs keep suppressRounds). Not from the budget, not on the caps (it's the fast
    // train's, as the left-behind's hunts are theirs); never in the grace, a fort, the final approach or at a stop, and
    // one run at a time. Its own dice, so the night's other draws are as they were.
    "run": {
      "on": true, "fromSpeed": 19, "stopSpeed": 2, "afterMetres": 2400, "hotShorter": 0.75,
      "base": 1.4, "perActive": 0.6, "size": [2, 6], "spacing": 6, "spawnBehind": 200, "lateral": [4, 8],
      "closing": 5, "scatter": 5
    },
    // A spawn pressed for (pressure at pressAt) may overdraw the budget's curve by up to pacedCost. Budgets are about twice
    // App. B.1's to pay for it. A kind among the last varietyWindow spawns has its weight halved for each.
    "pacedCost": 3,
    "varietyWindow": 4,
    // The in-car incidents' weight each (the others weigh 1): trouble in the cars is some of the night, not most of it.
    "incidentWeight": 0.5,
    // ...at full weight with this many hands besides the driver, proportionally less with fewer (a crew of two: a third).
    "incidentFullCrew": 3,
    "facilityLullSeconds": 20,
    // GDD App. B.1 "Post-event cooldown" (design decision, 2026-10): the least trough after a spawn; the pressure's relief
    // makes the rest of it, and well past the threshold (pressAt) it gives way.
    "cooldownSeconds": [25, 45],
    // T114 playtest ("where are all the monsters"): a threat that goes lingerSeconds with nobody alive within lingerRadius m
    // of it (and has nobody in its grip) gives up and goes, so what nobody's answering doesn't hold the caps below full.
    "lingerSeconds": 120,
    // Near enough to be met: a car's length (a Climber settled in the car behind the cab is 15-25 m from the driver).
    "lingerRadius": 12,
    "maxConcurrentZone": 2,
    "maxConcurrentSmallCrew": 4,
    "maxConcurrentLargeCrew": 6,
    // Budget share spent before the first facility, across the middle, and in the final approach.
    "phaseShares": [0.15, 0.45, 0.40],
    // App. B.1 v1.1's cost table (the Choir costs nothing: it isn't spawned; hazards are level content).
    "costs": { "followers": 2, "draggers": 2, "fireFlies": 2, "switchman": 2, "trackDoll": 3, "cinderHounds": 3, "climbers": 3,
      "whistler": 3, "stoker": 3, "ribbits": 3, "carHugger": 4, "tippyToesie": 4, "gaunt": 4, "sootChildren": 4, "grumbler": 4,
      "passenger": 5, "moose": 3 },
    // App. B.3/B.8 weights.
    "houndsLivestockWeight": 2.5,
    "houndsHotBoilerWeight": 1.5,
    // App. B.8, the rest of the table: with this cargo aboard (a loaded car of it in the engine's rake), these weigh this
    // much more; "*" is everything. Livestock's Hounds are houndsLivestockWeight's; chemicals' Drift is the drift's own
    // chemicalSpread (it isn't drawn, it's terrain). The comet cargo also relaxes the
    // Gaunt's and the Passenger's tier gates by one (cometRelaxesGates).
    "cargoWeights": {
      "food": { "cinderHounds": 2, "followers": 1.5, "grumbler": 2 },
      "comet": { "*": 1.4 }
    },
    "cometRelaxesGates": true,
    // GDD §18 "Slaughterhouse: animals are loud, and something already lives here" (note 185): while the train's stopped at a
    // facility of this kind, these come on this many times as often. The Gaunt sleeps in yards (App. B.6); in a
    // slaughterhouse it's the resident.
    "residents": {
      "slaughterhouse": { "gaunt": 4, "followers": 1.5 },
      // GDD §18 "Wreck yard: unstable, unlit, already occupied" (note 187): Draggers under the cars on their sides.
      "wreckYard": { "draggers": 3, "gaunt": 2 }
    },
    // App. B.1 "contradiction seeding": the v1.1 conflict table, as the tuning's names (and conditions: "choir", gathering or
    // here; "grade", a climb or fall just ahead; "facilityLoading" and "facilityStop", at a facility). Ambiguity (ARCHITECTURE §8): "draws
    // pairs from a conflict table": read as a spawn that would complete a pair with what's there now weighing this much
    // more, and this much more again past halfway on a run short of its pairs.
    "conflicts": [
      // The Moose (note 339): talk to the Gaunt vs. the moose hears every word; never be outnumbered vs. whoever it chases
      // ends up alone; the coupling gaps hide you from it and hold the Whistler; the loading needs everyone vs. someone
      // keeps it busy.
      ["gaunt", "moose"],
      ["ribbits", "moose"],
      ["whistler", "moose"],
      ["moose", "facilityLoading"],
      ["choir", "cinderHounds"],
      ["choir", "gaunt"],
      ["fireFlies", "trackDoll"],
      ["trackDoll", "facilityLoading"],
      ["whistler", "facilityStop"],
      ["tippyToesie", "stoker"],
      ["ribbits", "switchman"],
      ["carHugger", "grade"]
    ],
    "pairWeight": 3,
    "behindPairWeight": 3,
    "pairsPerRun": { "frontier": 1, "deadLines": 1, "deepTerritory": 2 },
    // Sleepers "about" for a pair: lying this far ahead (m). A "grade" ahead: this steep (%) within this far (m).
    "sleepersAhead": 1500,
    "gradeAhead": 600,
    "gradePercent": 1.5,
    // Saving up (ARCHITECTURE §8): from this share of the route in, cheaper threats leave enough budget for these rare,
    // expensive ones while the run can still have them, so they come at all.
    "saveFor": ["passenger"],
    "saveFrom": 0.2,
    // The kinds this edition has, by the names in "costs" above; empty is all of them. The demo edition (editions/demo,
    // T79) has GDD §21's five, one per pressure zone (the Choir, structural, is always about), and the trouble in the cars.
    "roster": [],
    // App. B.1 v1.1 want balance: each want's target share of the budget; a want over its share weighs less.
    "wantShares": { "kill": 0.40, "split": 0.25, "trust": 0.20, "cargo": 0.15 },
    // App. B.1 hard caps: corrupted humans, one at a time (the zone cap, maxConcurrentZone, covers the rest).
    "maxCorrupted": 1
  }
}
