// Train tuning. Source of truth: docs/design/systems-spec.md, Part B (first-pass numbers).
// Every value here is first pass, built for feel-testing. Edit freely; the game hot-reloads it.
// `dt train table` prints what these numbers actually produce in the sim.
{
  "maxSpeed": 22.0,
  "playerRunSpeed": 5.5,
  "gravity": 9.81,

  "geometry": {
    "carLength": 14.0,
    "couplingGap": 1.5,
    "engineLength": 20.0,
    "roofWidth": 3.0,
    "roofSafeCentreline": 1.4,
    // Greybox body heights above the rail. Not in the spec yet; tune by feel.
    "carHeight": 4.0,
    "engineHeight": 4.4,
    // The plate you can stand on in the coupling gap (Rattle's home, Climbers' mount point). It bridges end door to end
    // door, so it lies on the doors' line (interior.doorX) and is a hand wider than the doorway.
    "couplerHeight": 1.1,
    "couplerWidth": 1.0,
    // The guard van's rear platform, when it's last: across the car's back end at plate height, this deep (GDD §24 THE
    // WEIGHT: "melee from the rear platform"). Deep enough to land on and stand clear of the rear door's swing.
    "platformDepth": 1.2,
    // THE doorway (ARCHITECTURE §8 note 110): every door a person goes through, on the train and off it, is this tall and
    // (on the train) this wide: the cars' end and side doors (the side doors are wider, for crates: interior.sideDoorWidth),
    // the cab's doorways, and the doors the art draws on every building. Big doors (sheds, barns, churches) are all
    // bayHeight. A crewmate is 1.8 m (player.json height): 0.3 m over their head. A Tippy Toesie, 2.45 m on its points,
    // ducks (Art/CreatureArt).
    "doorway": { "height": 2.1, "width": 0.9, "bayHeight": 3.5 },
    // Ladders sit on both sides at the rear end of every car.
    "ladderInset": 0.6,
    // Engine + tender unit: boiler forward, walkable cab, coal tender behind (heights above rail).
    "engine": {
      "deckHeight": 1.4,
      // A 1.4 m boiler (T101: at 1.9 m it hid the line from the driver; past it from the cab window, the near rail's in
      // sight from 30 m and the middle of the track from 40 m). T110 playtest ("have both sides be a gap we can get
      // through"): at 1.6 m the way past it out of the cab's front was 0.6 m, a player's width exactly; at 1.4 it's 0.7.
      "boilerHalfWidth": 0.7,
      "boilerTop": 3.6,
      "cabLength": 4.0,
      "tenderLength": 4.0,
      "tenderTop": 3.4,
      // The running boards out past the cab sides (App. A.2 GREASE: "sanding from the running boards"), this wide, and the
      // sandbox on each this far ahead of the cab front.
      "runningBoardWidth": 0.6,
      "sandboxAhead": 2.5,
      // A walkway this wide down the tender's left side at deck height, from the coupler behind it into the back of the
      // cab (T90 playtest: there was no way into the cab from the train). A short ladder up the tender's front, beside the
      // coal, reaches the cab roof and its gun.
      "tenderGangway": 0.9
    },
    // Cars are walk-in (GDD §10: "the back door"; §26: warm interior, hostile exterior). The floor is
    // level with the coupler plate, so you step from the gap through the end door. The roof slab keeps
    // the full-length roof walk (spec B.4 traverse times are unchanged).
    "interior": {
      "floorHeight": 1.1,
      "wallThickness": 0.1,
      "roofThickness": 0.15,
      // End doors sit left of centre, the coupler plates in line with them, and the end ladders right of the plates.
      "doorX": -0.45,
      // Holding Use at a door this long opens or shuts it.
      "doorSeconds": 0.4,
      // Cargo is stacked down the right-hand side, leaving an aisle to the doors.
      "cargoDepth": 1.1,
      "cargoHeight": 1.3,
      // Cargo cars also have a sliding door in the middle of each side, wide enough to carry a crate through (spec D.2
      // manual crates: a 0.9 m crate won't go through a 0.9 m end door), and a short flight of steps up to it along the
      // side: nobody climbs a ladder with freight in their arms. The steps stand this far out from the car side and each
      // tread is this long; the rise is the floor height in steps you can walk up (player.json stepUp).
      "sideDoorWidth": 1.8,
      "stepWidth": 0.6,
      "stepDepth": 0.4,
      // A cargo car's roof hatch (T99, spec D.2 crane): a lid across the roof between the walls, centred this far back
      // (over the aisle and the load behind the side doors) and this long. Opened from the roof by holding Use at its
      // edge; the crane lowers a casting in through it. Long enough for a casting (facilities.json castingSize) whichever
      // way it hangs.
      "hatchZ": 3.2,
      "hatchLength": 2.4
    }
  },

  "mass": {
    "engineTonnes": 90.0,
    "emptyCarTonnes": 12.0,
    "loadedCarTonnes": 40.0
  },

  // Accel/brake per consist length, measured with every car loaded (spec B.5).
  // The sim turns these into tractive/brake force at loaded mass, so lighter trains
  // accelerate harder. Lengths between rows are interpolated linearly.
  "performance": [
    // T97 playtest: brakes twice the spec's first pass ("braking needs to reduce speed significantly faster"); T121 playtest
    // ("brakes are maybe a bit too strong, lets reduce their efficiency by 30%"): 0.7 of that. With steam driving the engine
    // pulls against them, so venting as well is the quickest stop.
    { "cars": 3,  "accel": 0.90, "brake": 2.24 },
    { "cars": 6,  "accel": 0.62, "brake": 1.47 },
    { "cars": 10, "accel": 0.42, "brake": 1.01 },
    { "cars": 15, "accel": 0.27, "brake": 0.67 },
    { "cars": 20, "accel": 0.18, "brake": 0.49 }
  ],

  "brakeFade": {
    // Spec B.5: "brakes fade at 8% per 10s of continuous application, recovering at 4% per 10s released".
    "fadePerSecond": 0.008,
    "recoverPerSecond": 0.004,
    "minEfficiency": 0.25,
    // The spec states fade in the context of descending grades. If fade applied on the flat,
    // the spec's own 20-car stop (63s / 690m) would be impossible, so default to descent only.
    "onlyOnDescent": true
  },


  // Not in the spec. The accel/brake table above is net performance; this is what slows a train
  // with the regulator shut: about 0.019 m/s² at max speed, so a dead boiler coasts for kilometres.
  "resistance": {
    "rolling": 0.004,
    "air": 0.00003
  },

  // Couplings (GDD §17, §24). Not in the spec; first pass.
  "couplings": {
    // Rakes that touch closing slower than this couple automatically (buckeye couplers).
    "coupleMaxSpeed": 1.5,
    // Contact above this closing speed damages the two end vehicles: (closing - safe)^2 x this, per hit.
    "safeContactSpeed": 1.0,
    "damagePerSpeedSquared": 0.06,
    // Fraction of structural damage that also spoils cargo in every vehicle of both rakes.
    "cargoDamageShare": 0.5,
    // Hold Uncouple on the coupler plate, looking down at it (at least uncoupleLookDownDegrees below level), this long to
    // cut. Longer while the train is working (under load). T91 playtest: a deliberate act, not a press of Use.
    "uncoupleSeconds": 3.0,
    "uncoupleUnderLoadSeconds": 6.0,
    "uncoupleLookDownDegrees": 55,
    // Deceleration handbrakes give a parked rake, and the speed below which a cut rake is parked for you.
    "handbrakeDecel": 0.3,
    "parkBelowSpeed": 0.5,
    // Hold Use at a car's brake wheel this long to wind handbrakes on or off.
    "handbrakeSeconds": 1.0
  },

  "speedBands": {
    "yard": 2.5,
    "jumpOffLethal": 4.0,
    "slow": 6.0,
    "workingMin": 10.0,
    "cruise": 14.0
  },
  // What the train leaves the fortress with (T41). Radios are things you wear (spec A.5's radio channel): only someone
  // wearing one talks or hears on it, so a crew that loses them is shouting down the train (GDD §24 "radio breaks").
  // One rides in the cab, the rest in the guard van.
  // Line Plan §12.6 (note 181): a body or a repair kit at rest further than corridorM from the track, or more than dropM below
  // the rails (off a bridge, into a ravine), is put back on the formation's edge, edgeM out, the side it went off.
  "recovery": { "corridorM": 40, "dropM": 15, "edgeM": 3.5 },
  // The consist's make-up and fittings (GDD §10, §26, spec F.3; ARCHITECTURE §8 note 184). The counts and the handrails are
  // what the fortress sells: campaign.json's upgrades add to them, and every machine builds the same train. Converted cars
  // come out of the cargo cars, never leaving fewer than minCargoCars: extra guard cars first (each with a gun, in the
  // middle of the cargo), then crew cars (right behind the engine: the first is the kit's car, its lockers its stores).
  // Armour goes on from the rear forward, the guard van first.
  "composition": {
    "guardCars": 1,
    "utilityCars": 0,
    "armouredCars": 0,
    "minCargoCars": 1,
    // An armoured car's plate: this much heavier (a quarter of a loaded car; the train's slower for it), and it takes this
    // much of what's done to its shell (a Car Hugger eats it half as fast; a hard knock at the couplers does half).
    "armourTonnes": 10,
    "armourDamage": 0.5,
    // A crew car's stove: shut in, the whole car is warm, steam or none (spec B.2's recovery); with a door open, within
    // this of the stove.
    "stoveReach": 2.5,
    // How fast the cold comes on in a car without heat (player.json cold.indoorsRate, times this): car insulation halves it.
    "insulation": 1,
    // Roof handrails (F.3 "Dragger resistance"): fitted, a Dragger's grab range is draggerGrab of what it was (0.6 m off the
    // edge at a crawl, not 1), it hangs on draggerHang times as long before it has you (12 s, not 8: friends' time), and
    // a bend has to be taken throwOver times as far over its limit to throw you off the roof (5.25 m/s, not 3.5).
    "handrails": false,
    "rails": { "draggerGrab": 0.6, "draggerHang": 1.5, "throwOver": 1.5 },
    // The powered switch thrower (F.3 "removes the ground excursion at junctions", ARCHITECTURE §8 note 196): fitted, a lever
    // in the cab, on the driver's side behind the reverser. Held there for route.json junctions.throwSeconds, it throws the
    // nearest points within thrower.reach m ahead of the engine's front, with the train no faster than maxSpeed (m/s, 18
    // km/h: slowed for the junction as the crew would for a ground throw, but nobody steps down). The points still won't
    // move with a wheel on them.
    "switchThrower": false,
    "thrower": { "reach": 200, "maxSpeed": 5 }
  },
  // GDD §19 "medicine: fragile, high value" (note 182). A car of medicine takes the knocks the rest of the train shrugs off:
  // any contact (coupling, a collision, a buffer stop) closing faster than safeContactSpeed spoils it by
  // (closing - safeContactSpeed)^2 x couplings.damagePerSpeedSquared x couplings.cargoDamageShare x shockShare (where the
  // other cars only feel it over couplings.safeContactSpeed); and braking harder than brakeShockDecel m/s^2 spoils it
  // brakeShockPerSecond a second for every m/s^2 over. Not in the GDD's numbers: a gentle coupling (under 1.5 m/s) costs a
  // few percent, a full brake on a short train (2.2 m/s^2) about a fifth of the load from line speed to a stand.
  "fragile": { "safeContactSpeed": 0.3, "shockShare": 3, "brakeShockDecel": 1.2, "brakeShockPerSecond": 0.02 },
  "kit": {
    "radios": 2,
    // Spec A.5: the radio "dies in tunnels and mine spurs". It still carries this far in, from a tunnel's mouth or a mine
    // spur's points (m): none, until the campaign's radio range adds to it (campaign.json, F.3; note 196).
    "radioReach": 0,
    // GDD v1.1 App. C.4 hand loot: toys in the guard van, for the Track Doll (it steals one and leaves for the run).
    // GDD v1.4 App. C item 4: "some toys are noisy": four now, and three of them make a noise while carried (a squeaker, a
    // music box, a wind-up drummer), in the carrier's name on the loudness meter (combat.json choir.toys; note 175).
    "toys": 4,
    "toyNoises": ["squeaker", "musicBox", "drummer"],
    // GDD §12 "the repair kit is an item, not a station": one toolbox, in its locker (lockers.kitLocker) in car
    // `repairKitCar` (counted back from the engine). It's what mends a ruptured boiler (boiler.json repairSeconds), so
    // someone has to leave the footplate for it, and whoever carries it opens a Holdout's lock silently (holdouts.json
    // "open"). When they die it's lying where they fell.
    "repairKits": 1,
    "repairKitCar": 1,
    // Spare kits bought at the fortress (GDD App. E.12 question 4, answered: campaign.json spareKit). Always 0 here: the
    // campaign adds what the save has (SessionSetup.SpareKits), and each starts the night in a locker beside the first.
    "spareKits": 0,
    // The crew lockers (GDD §12, ARCHITECTURE §8 note 173): a row of tall iron lockers along the left wall of the kit's car,
    // ahead of its side door, each lettered with a crew grade in the railway's own words. Hold Use at one to open or shut
    // its door; a tap of Use puts what's in your hands on its first free shelf, or takes the top thing off its shelves.
    // What's inside is held by the locker, not lying in the car: it can't fall, slide, or go through a wall.
    "lockers": {
      // One locker a name, front to back: the grades as a depot would paint them on its lockers (the wheeltapper is the
      // carriage-and-wagon examiner, whose hammer rang the wheels).
      "names": ["DRIVER", "FIREMAN", "GUARD", "SHUNTER", "SIGNALMAN", "BRAKESMAN", "LAMPMAN", "FITTER", "GANGER", "WHEELTAPPER", "PORTER", "YARDMASTER"],
      // The repair kit's locker. A fitter is the shed's mechanic, the one who mends engines, boilers included: the toolbox
      // that mends a ruptured boiler is his. Spare kits go on his other shelf, then into the lockers after his.
      "kitLocker": "FITTER",
      // Shelves in each: the locker's floor, and one at chest height.
      "slots": 2,
      // What goes in: hand-sized things. Freight, the train's crates, the heavy, the dead and the living don't.
      "holds": ["lamp", "radio", "toy", "loot", "extinguisher", "repairKit"],
      // Each locker's size (m): along the row, out from the wall, and tall. The row starts this far behind the front end
      // wall (the car's extinguisher board goes in the gap) and stops short of the side door.
      "width": 0.42,
      "depth": 0.5,
      "height": 1.9,
      "fromFront": 0.7,
      // Holding Use this long at one opens or shuts its door (a tap is shorter: it stows or takes).
      "doorSeconds": 0.4
    }
  }
}
