// Train tuning. Source of truth: docs/design/systems-spec.md, Part B (first-pass numbers).
// Every value here is first pass, built for feel-testing. Edit freely; the game hot-reloads it.
// `dt train table` prints what these numbers actually produce in the sim.
{
  "maxSpeed": 22.0,
  "playerRunSpeed": 5.5,
  "gravity": 9.81,
  // How far the engine's headlamp reaches, over the night's own ranges (queue #243, note 506): the boards read
  // (sight.json lampSignRange), the grease and debris on the rail (lampGreaseRange), the Track Doll's face (enemies.json
  // lampRevealDistance), the wreck yard's beam (facilities.json wreck.beamLength) and the drawn beam. 1 as the fortress
  // issues it; spec F.3's lamp brightness upgrade (campaign.json lampBrightness) raises it.
  "headlampReach": 1.0,

  "geometry": {
    "carLength": 14.0,
    "couplingGap": 1.5,
    "engineLength": 20.0,
    "roofWidth": 3.0,
    "roofSafeCentreline": 1.4,
    // Greybox body heights above the rail. Not in the spec yet; tune by feel.
    "carHeight": 4.0,
    "engineHeight": 4.4,
    // The plate you can stand on in the coupling gap (Rattle's home, Climbers' mount point). It bridges end door to end
    // door, so it lies on the doors' line (interior.doorX) and is a hand wider than the doorway.
    "couplerHeight": 1.1,
    "couplerWidth": 1.0,
    // The guard van's rear platform, when it's last: across the car's back end at plate height, this deep (GDD §24 THE
    // WEIGHT: "melee from the rear platform"). Deep enough to land on and stand clear of the rear door's swing.
    "platformDepth": 1.2,
    // THE doorway (ARCHITECTURE §8 note 110): every door a person goes through, on the train and off it, is this tall and
    // (on the train) this wide: the cars' end and side doors (the side doors are wider, for crates: interior.sideDoorWidth),
    // the cab's doorways, and the doors the art draws on every building. Big doors (sheds, barns, churches) are all
    // bayHeight. A crewmate is 1.8 m (player.json height): 0.3 m over their head. A Tippy Toesie, 2.45 m on its points,
    // ducks (Art/CreatureArt).
    "doorway": { "height": 2.1, "width": 0.9, "bayHeight": 3.5 },
    // Ladders sit on both sides at the rear end of every car.
    "ladderInset": 0.6,
    // The engine, cab forward (ARCHITECTURE §8 note 276, the director's sketch: "controls at the front with full vis of the
    // rail"), front to back: the pilot, the cab with the driver's controls at its front windows and the firebox in its back
    // wall, the coal in a bunker in the cab beside the firebox, then the boiler with the smokebox and stack at the rear,
    // where car 1 couples on. Heights above rail.
    "engine": {
      "deckHeight": 1.4,
      // The pilot ahead of the cab: the buffer beam, the plough and the headlamp, this long.
      "pilotLength": 0.6,
      // The boiler's 1.4 m (T110: a 0.7 m way past it on each side), now behind the cab, so it hides nothing ahead.
      "boilerHalfWidth": 0.7,
      "boilerTop": 3.6,
      // The cab (note 280, the director: "the controls and firebox need to be in front ... no need to turn around for coal,
      // the whole cab being operable by one person"): everything at its front, facing forward. Across it under the windows,
      // left to right: the coal bunker in the front left corner, the firebox against the front wall beside it, the
      // driver's console under the right-hand window. One person stood behind them reaches all three without turning round.
      // Note 716 (the director, 14 Oct 2026: "big cab, 11 meters, smaller boiler ... the cab itself becomes the crew car"):
      // 11 m of the engine's 20 (was 5), the boiler about 8 behind it (was about 14). Its front 2.5 m, the footplate, is as it
      // was; behind it crewCar's chart table, gallery and back wall.
      "cabLength": 11.0,
      // The coal bunker: in the front left corner, back along the left wall this long, this deep in from the wall and this
      // high over the floor.
      "bunkerLength": 1.8,
      "bunkerDepth": 0.62,
      "bunkerHeight": 1.0,
      // The firebox, standing against the front wall beside the bunker under the window sill (out of the line's view), its
      // door facing back into the cab: this wide, this deep from the wall and this high.
      "fireboxWidth": 0.96,
      "fireboxDepth": 0.7,
      "fireboxHeight": 1.05,
      // The running boards out past the body's sides (App. A.2 GREASE: "sanding from the running boards"), this wide, from
      // this far ahead of the cab's doorways back along the boiler, and the sandbox on each this far behind the cab, over
      // the drivers. Note 559 (the director, 9 Oct: "the platform on the outer edge of the train really should extend to be
      // in front of the cab doors and extend a bit wider"): 0.6 m wide from partway across the doorway, now 0.85 m from a
      // metre ahead of it, the cab steps hung off its outer edge. Its edge is 2.35 m off the centreline and the steps 2.5:
      // inside the truss spans' posts and a bridge deck's edge (2.6, note 552), and over the girder spans' handrails and the
      // viaducts' parapets, clear above them. Any wider and the steps' foot is off a bridge's deck.
      "runningBoardWidth": 0.85,
      "runningBoardAhead": 1.0,
      "sandboxBehind": 2.5,
      // The cab's side doors at its front (note 856; the director, 16 Oct 2026: "I think we want one that's more next to the
      // coal ... a door near where the coal is, and I guess on the other side of the front of the cab as well"), beside the
      // back wall's doorways: a sliding door the standard doorway's size (doorway above) in each side, its opening from this
      // far behind the cab's front. The left one (coalDoorFrom) just behind the bunker and the hatch ladder up to the gun,
      // the coal a step and a turn from it; the right one (frontDoorFrom) behind the points lever, its back jamb at the
      // gallery's front tread. Outside each, a landing at the running boards' height, this far past the opening either side,
      // the cab steps hung off its edge. 0 is no door.
      "coalDoorFrom": 2.55,
      "frontDoorFrom": 3.75,
      "sideDoorLanding": 0.3,
      // The cab as the crew car (note 716; the director, 14 Oct 2026: "the place where players hang out together ... where
      // coordinated driving happens ... the captain's quarters, shared by all"). Every place is metres behind the cab's front.
      "crewCar": {
        // The footplate, the work at the front exactly as note 280 has it (bunker, firebox, console, levers, cord): nothing of
        // the crew car's stands in its first footplateLength.
        "footplateLength": 2.5,
        // The chart table behind it, in the middle (the director: "I'm okay with moving the cab map behind the controls. On a
        // table and as long as it's tracking where the train still is and giving our route"): from tableFrom, this long,
        // this wide and this high (standing height). Either side of it a way 0.95 m wide down the cab. Its front clear by a
        // body's breadth of the floor a crewmate's put on behind the bunker (PlayerMotor.CabFloorZ, 2.5 m back).
        "tableFrom": 2.9,
        "tableLength": 1.75,
        "tableWidth": 0.9,
        "tableHeight": 1.0,
        // The gallery ("the gallery and the raised benches, this is a good spot"): a floor galleryRise up from galleryFrom to
        // galleryTo, a tread galleryStep deep at its front and its back, half way up (player.json stepUp walks it, with
        // arms full; deeper than a body's radius, so the foot's on it before the riser behind it is in the way), so whoever
        // stands there sees the line out of the front windows over the heads at the footplate. The cab's sides stand
        // galleryWaist over its floor the whole way from the front pillar to the doorways (a waist, not a sill to jump out
        // over; and no corner where the gallery starts), under the footplate's slits as ever.
        "galleryFrom": 5.1,
        "galleryTo": 8.4,
        "galleryRise": 0.45,
        "galleryStep": 0.45,
        "galleryWaist": 1.1,
        // The benches on it (the director, 16 Oct 2026: "move them to like side benches so that we keep the middle clear. And
        // then let's have them be really thin. And if we're going to have benches at all, we need players to be able to
        // actually sit down on them"; note 905): one along each side wall, from benchFrom to benchTo (m behind the cab's
        // front), benchDepth out from the wall (a perch: its edge where the way down the cab past the chart table ends, a
        // body's radius out from it, so nobody walking the cab meets it), its seat benchHeight up, facing across the cab;
        // the gallery's middle clear between them. benchSeats places to sit on each, seatEvery apart from its back end (its front end left for the
        // logbook, note 721): the Seat press at one sits you on it, as in a Muskoka chair.
        "benchFrom": 5.15,
        "benchTo": 8.35,
        "benchDepth": 0.175,
        "benchHeight": 0.45,
        "benchSeats": 4,
        "seatEvery": 0.7,
        // The back wall's kettle on the warm backhead sings from kettleFrom under boiler.json's redline, full at it: the
        // cab's own sign the gauge is climbing. The cuckoo clock's bird comes out every cuckooEvery seconds over the last
        // enemies.json wakers.stirSeconds before dawn, for cuckooOutSeconds each time.
        "kettleFrom": 10,
        "cuckooEvery": 60,
        "cuckooOutSeconds": 3
      }
    },
    // Cars are walk-in (GDD §10: "the back door"; §26: warm interior, hostile exterior). The floor is
    // level with the coupler plate, so you step from the gap through the end door. The roof slab keeps
    // the full-length roof walk (spec B.4 traverse times are unchanged).
    "interior": {
      "floorHeight": 1.1,
      "wallThickness": 0.1,
      "roofThickness": 0.15,
      // End doors sit left of centre, the coupler plates in line with them, and the end ladders right of the plates.
      "doorX": -0.45,
      // Holding Use at a door this long opens or shuts it.
      "doorSeconds": 0.4,
      // Cargo is stacked down the right-hand side, leaving an aisle to the doors.
      "cargoDepth": 1.1,
      "cargoHeight": 1.3,
      // Cargo cars also have a sliding door in the middle of each side, wide enough to carry a crate through (spec D.2
      // manual crates: a 0.9 m crate won't go through a 0.9 m end door), and a short flight of steps up to it along the
      // side: nobody climbs a ladder with freight in their arms. The steps stand this far out from the car side and each
      // tread is this long; the rise is the floor height in steps you can walk up (player.json stepUp).
      "sideDoorWidth": 1.8,
      "stepWidth": 0.6,
      "stepDepth": 0.4,
      // A cargo car's roof hatch (T99, spec D.2 crane): a lid across the roof between the walls, centred this far back
      // (over the aisle and the load behind the side doors) and this long. Opened from the roof by holding Use at its
      // edge; the crane lowers a casting in through it. Long enough for a casting (facilities.json castingSize) whichever
      // way it hangs.
      "hatchZ": 3.2,
      "hatchLength": 2.4
    }
  },

  "mass": {
    "engineTonnes": 90.0,
    "emptyCarTonnes": 12.0,
    "loadedCarTonnes": 40.0
  },

  // Accel/brake per consist length, measured with every car loaded (spec B.5).
  // The sim turns these into tractive/brake force at loaded mass, so lighter trains
  // accelerate harder. Lengths between rows are interpolated linearly.
  "performance": [
    // T97 playtest: brakes twice the spec's first pass ("braking needs to reduce speed significantly faster"); T121 playtest
    // ("brakes are maybe a bit too strong, lets reduce their efficiency by 30%"): 0.7 of that. With steam driving the engine
    // pulls against them, so venting as well is the quickest stop.
    { "cars": 3,  "accel": 0.90, "brake": 2.24 },
    { "cars": 6,  "accel": 0.62, "brake": 1.47 },
    { "cars": 10, "accel": 0.42, "brake": 1.01 },
    { "cars": 15, "accel": 0.27, "brake": 0.67 },
    { "cars": 20, "accel": 0.18, "brake": 0.49 }
  ],

  "brakeFade": {
    // Spec B.5: "brakes fade at 8% per 10s of continuous application, recovering at 4% per 10s released".
    "fadePerSecond": 0.008,
    "recoverPerSecond": 0.004,
    "minEfficiency": 0.25,
    // The spec states fade in the context of descending grades. If fade applied on the flat,
    // the spec's own 20-car stop (63s / 690m) would be impossible, so default to descent only.
    "onlyOnDescent": true
  },


  // Not in the spec. The accel/brake table above is net performance; this is what slows a train
  // with the regulator shut: about 0.019 m/s² at max speed, so a dead boiler coasts for kilometres.
  "resistance": {
    "rolling": 0.004,
    "air": 0.00003
  },

  // Couplings (GDD §17, §24). Not in the spec; first pass.
  "couplings": {
    // Rakes that touch closing slower than this couple automatically (buckeye couplers).
    "coupleMaxSpeed": 1.5,
    // Contact above this closing speed damages the two end vehicles: (closing - safe)^2 x this, per hit.
    "safeContactSpeed": 1.0,
    "damagePerSpeedSquared": 0.06,
    // Fraction of structural damage that also spoils cargo in every vehicle of both rakes.
    "cargoDamageShare": 0.5,
    // Hold Uncouple on the coupler plate, looking down at it (at least uncoupleLookDownDegrees below level), this long to
    // cut. Longer while the train is working (under load). T91 playtest: a deliberate act, not a press of Use.
    "uncoupleSeconds": 3.0,
    "uncoupleUnderLoadSeconds": 6.0,
    "uncoupleLookDownDegrees": 55,
    // Deceleration handbrakes give a parked rake, and the speed below which a cut rake is parked for you.
    "handbrakeDecel": 0.3,
    "parkBelowSpeed": 0.5,
    // Hold Use at a car's brake wheel this long to wind handbrakes on or off.
    "handbrakeSeconds": 1.0
  },

  // A breach (decided 1 Oct; spec B.9): a car's shell given way to the outside, the Car Hugger through its end wall
  // (enemies.json carHugger.breachEaten) or Climbers in through its roof (climbers.breachLitCars). Until it's boarded up it
  // shuts nobody in, whatever its doors: the cold, the night's sound and the Choir come in as through an open door. Boarded
  // up from inside by holding Use within boardReach m (across the floor) of the hole for boardSeconds; let go and that
  // board's started again. needsKit: only by someone carrying the repair kit (note 150: it's an item); false, anyone's hands
  // and what's lying about the car.
  "breach": {
    "boardSeconds": 8,
    "boardReach": 1.5,
    "needsKit": false
  },

  // Note 301 (queue #39; the director, 7 Oct, GDD App. F.3: "the wrench doesn't seem to be repairing things in the Sea of
  // Thieves style"): the wrench is the repair tool, and everyone carries one (player.json kit). wrench: with it in hand,
  // Use at a break mends it: the burst boiler at its firebox (boiler.json repairSeconds; the repair kit no longer does),
  // a breach at its hole (breach.boardSeconds; bare hands no longer do), and a car battered below dentedBelow of its
  // shell (what it ran into, or what ran into it) at its dent, the left wall three quarters back, where it comes back
  // integrityPerSecond while it's worked, never past what a Car Hugger ate. dentReach: how near the dent (m, across the
  // floor). A mend half done is kept while you stay at it with the wrench, so a few presses do it as well as a hold.
  // Every break shows where it is (the callout, Effects.Repairs). Slice 2: the wrench also mends a broken radio
  // (kit.radioMendSeconds) and opens a Holdout's lock quietly (holdouts.json open), and the kit's gone: none stowed
  // (kit.repairKits, spareKits), none found at the stops (loot.json repairKitChance). false: the kit and hands, as before
  // note 301.
  "repair": {
    "wrench": true,
    "dentedBelow": 0.9,
    "integrityPerSecond": 0.04,
    "dentReach": 1.3,
    // Slice 2: the engine's dent (what it ran into hits the front) is on the boiler's left flank, this far (m) behind the
    // left running board's sandbox, worked from the board.
    "engineDentBehind": 2.5,
    // Slice 2, the director (8 Oct): a smashed headlamp (enemies.json climbers.lampOutSeconds) no longer comes back by
    // itself; it's mended with the wrench from the cab's front windows, behind it, each second worked taking this many
    // off what's left (45 s of glass is 7.5 s with the wrench; lamp armour halves it again).
    "lampMendRate": 6,
    // GDD §12, one can, two do it faster (note 752; the social collision audit's R4, the director, 14 Oct 2026: "absolutely
    // the right direction"): a crewmate boarding up the same breach (breach.boardSeconds, spec B.9's 8 s), or mending the
    // same burst boiler (boiler.json repairSeconds), beside you each works it pairRate times as fast (two: 8 s is 4.4 s);
    // a third adds nothing. Alone, as ever. A dent, the smashed lamp and a fire (each extinguisher cools its cell) are worked
    // on the car itself, so two hands there already do twice as much. 1: each alone, as before.
    "pairRate": 1.8
  },

  // Damage with consequences, Sea of Thieves style (the director, 9 Oct 2026, ARCHITECTURE §8 note 576: "If players dont fix
  // the ship in sea of thieves the ship goes down and you lose everything. If players dont fix the train here seemingly
  // nothing happens"). Not in the spec. A car or the engine battered under `below` of its shell (fire, the line's knocks, a
  // bend taken too hard, a collision, what boards it) works itself apart as it runs: `workPerSecond` of its shell a second
  // at `atSpeed` m/s, by the speed (to `mostFactor` times it; nothing standing, the engine only while it pulls). A failing car
  // spills `spillPerSecond` of a load a second the same way (a full one's empty in about 200 s at line speed). Under
  // `breakingBelow`, the last warning. At nothing a car comes apart: it's off its rails and the train's parted ahead of it, it
  // and what's behind it left on the line; the engine breaks down (no power) and, at a stand, the night ends stranded
  // (GDD §23.2). Failing, the engine's pull falls from all of it to `powerAtBreak` and its brake to `brakeAtBreak` (kept
  // broken down, to stop on). From `below` to nothing is about 200 s at line speed. The wrench at its dent mends it (repair
  // `integrityPerSecond`: 0.5 back in 12.5 s).
  "failing": {
    "enabled": true,
    "below": 0.5,
    "breakingBelow": 0.2,
    "workPerSecond": 0.0025,
    "spillPerSecond": 0.005,
    "atSpeed": 15,
    "mostFactor": 1.5,
    "powerAtBreak": 0.35,
    "brakeAtBreak": 0.4
  },

  "speedBands": {
    "yard": 2.5,
    "jumpOffLethal": 4.0,
    "slow": 6.0,
    "workingMin": 10.0,
    "cruise": 14.0
  },
  // What the train leaves the fortress with (T41). Radios are things you wear (spec A.5's radio channel): only someone
  // wearing one talks or hears on it, so a crew that loses them is shouting down the train (GDD §24 "radio breaks").
  // One rides in the cab, the rest in the guard van.
  // Line Plan §12.6 (note 181): a body or a repair kit at rest further than corridorM from the track, or more than dropM below
  // the rails (off a bridge, into a ravine), is put back on the formation's edge, edgeM out, the side it went off.
  "recovery": { "corridorM": 40, "dropM": 15, "edgeM": 3.5 },
  // A branch's buffer stop run into (note 661; not in the spec: GDD App. A.7's "a hit short of the lead is the buffer stop's
  // damage alone"). Over safeSpeed (m/s; the yard's 2.5, a crawl up to the stop) the front vehicle takes
  // (speed - safeSpeed)^2 x damagePerSpeedSquared of its shell, and the cargo couplings.cargoDamageShare of that. It was the
  // collision's (from 1 m/s, 0.06: 5 m/s took 0.96 of the engine, 5.3 m/s all of it), and the director's run into Voss
  // Green's broke the engine down at the stop and stranded the night (13 Oct). Now 5 m/s is 0.125 and a dead line's
  // 25 km/h (overspeed.deadEndDerailAbove) 0.39: a dent the wrench mends, short of failing (failing.below).
  "bufferStop": { "safeSpeed": 2.5, "damagePerSpeedSquared": 0.02 },
  // The whistle on the cord (GDD §12; the director, 16 Oct 2026, note 839: "while I'm holding the key, I am holding the whistle
  // pull ... when I let go of the key, it immediately stops the whistle"): held, it blows; let go, it blows on tailSeconds (s).
  // It was a second, so the codes' shorts ran together.
  "whistle": { "tailSeconds": 0.12 },

  // The handcar (GDD §24.1; the director, 14 Oct 2026, App. F.6; ARCHITECTURE §8 note 729): a pump trolley hung on its end on
  // the back of the guard van, bought at the fortress (campaign.json's "handcar"; `always` gives every night one, for the
  // tests and the views). At a stand, held Use beside it lifts it down onto the rails setBehind metres behind the van's
  // platform (two lifters in liftSeconds, one alone soloLiftScale times as long), and back from within stowReach. On the
  // rails it's a rake of its own: through the points as they're set, coupling to nothing, never past the train.
  // - The handle's a see-saw geared to the wheels, a full swing every strokeMetres. At an end of it (Use takes it, within
  //   handleReach), W pushes your end down and S pulls it up: in time with the swing it drives the car on, against it it
  //   brakes or fights your mate. Each pumper pushes pumpAccel at a walk, falling off past pumpPower / pumpAccel m/s (their
  //   power): two in time make about 8 m/s on the level, one about 6, two out of time less; a 2% bank takes two down to
  //   about 6.5, and down one it runs on to maxSpeed with nobody on the brake (brakeDecel, the brake key).
  // - floor: a stroke's least purchase, at the top and bottom of the swing, so a car stopped at dead centre still starts.
  // - parked: with nobody aboard its brake's latched on, so one left standing stays where it was left.
  "handcar": {
    "always": false,
    "length": 3.0, "width": 1.7, "deckHeight": 0.55, "stepHeight": 0.28, "massTonnes": 0.5,
    "strokeMetres": 5.0, "pumpAccel": 0.9, "pumpPower": 1.8, "pumpers": 2, "floor": 0.3,
    "rolling": 0.04, "air": 0.005, "maxSpeed": 14.0, "brakeDecel": 3.0, "parked": true,
    "liftSeconds": 4.0, "soloLiftScale": 3.0, "liftReach": 2.5, "setBehind": 1.5, "standBelow": 0.3, "stowReach": 6.0,
    "handleReach": 1.0
  },

  // A bend taken too fast (ARCHITECTURE §8 note 265; build 1121: "we'll want to telegraph using sound design that the train
  // is going under stress and it's getting close to derailment"). Linegen plan §8.5's numbers stand: a bend derails above
  // √(aDerail R) and is boarded at √(aPost R) (linegen/tiers.json "curves"). What's here is how it's told and when it may
  // commit (GDD App. A.1: "TELEGRAPH always precedes COMMIT"; whole-train events "carry their own telegraph").
  // - The warning: a bend under or ahead of the train that the speed now would derail it on, within the distance to brake
  //   below it: leadSeconds at the speed now, plus a service stop from it at brakeShare of the consist's rated brake (spec
  //   B.5; steam pulls against the brake, T97), plus marginM.
  // - Stress, the bend's own sound under the train: 0 at its board's speed, 1 at its derailing speed. The flanges squeal
  //   and the couplings creak from 0, the lurch runs down the train as it crosses lurchAt, and the scream is the last half.
  // - No commit without it: a bend derails the train only once the warning has been up leadSeconds (spared otherwise, and
  //   counted). 4 s is App. A.1's reaction window at its longest.
  // - The cab's cue (warningSound, the cab's bell, tier 3) every repeatSeconds while it's up, and the HUD's line.
  // - deadEndDerailAbove (m/s, 25 km/h; the director's decision of 7 Oct 2026, ARCHITECTURE §8 note 286): a dead line's
  //   buffers (a dead line's end) run into over this, and the train goes through them and off the
  //   end. The same warning and lead: the cab is told while there's still room to stop, and a hit short of the lead is the
  //   buffer stop's damage alone.
  // - The lean (note 370; App. F.1's telegraph: "the cars straining and leaning"): each car rolls out about its outer rail
  //   by its own stress, as stress^1.5 of leanDegrees, so its inner wheels lift; it settles into it over leanSeconds, and
  //   past half way to derailing rocks on its springs by leanRock of it. Drawn only: the sim's cars never lean.
  "overspeed": { "leadSeconds": 4, "brakeShare": 0.6, "marginM": 30, "lurchAt": 0.5, "repeatSeconds": 1.5, "warningSound": "warn-overspeed",
    "deadEndDerailAbove": 6.9, "leanDegrees": 4, "leanSeconds": 0.35, "leanRock": 0.18 },
  // The consist's make-up and fittings (GDD §10, §26, spec F.3; ARCHITECTURE §8 note 184). The counts and the handrails are
  // what the fortress sells: campaign.json's upgrades add to them, and every machine builds the same train. Converted cars
  // come out of the cargo cars, never leaving fewer than minCargoCars: extra guard cars first (each with a gun, in the
  // middle of the cargo), then crew cars (right behind the engine: the first is the kit's car, its lockers its stores).
  // Armour goes on from the rear forward, the guard van first.
  "composition": {
    "guardCars": 1,
    "utilityCars": 0,
    "armouredCars": 0,
    "minCargoCars": 1,
    // An armoured car's plate: this much heavier (a quarter of a loaded car; the train's slower for it), and it takes this
    // much of what's done to its shell (a Car Hugger eats it half as fast; a hard knock at the couplers does half).
    "armourTonnes": 10,
    "armourDamage": 0.5,
    // Roof handrails (F.3 "Dragger resistance"): fitted, a Dragger's grab range is draggerGrab of what it was (0.6 m off the
    // edge at a crawl, not 1), it hangs on draggerHang times as long before it has you (12 s, not 8: friends' time), and
    // a bend has to be taken throwOver times as far over its limit to throw you off the roof (5.25 m/s, not 3.5), and the
    // wind's push on the roofs (GDD §22, player.json wind; note 201) is wind times what it was: a hand on the rail.
    "handrails": false,
    "rails": { "draggerGrab": 0.6, "draggerHang": 1.5, "throwOver": 1.5, "wind": 0.4 },
    // The powered switch thrower (F.3 "removes the ground excursion at junctions", ARCHITECTURE §8 note 196): fitted, a lever
    // in the cab, on the driver's side behind the reverser. Held there for route.json junctions.throwSeconds, it throws the
    // nearest points within thrower.reach m ahead of the engine's front, with the train no faster than maxSpeed (m/s, 18
    // km/h: slowed for the junction as the crew would for a ground throw, but nobody steps down). The points still won't
    // move with a wheel on them.
    "switchThrower": false,
    "thrower": { "reach": 200, "maxSpeed": 5 },
    // The BBQ deck (ARCHITECTURE §8 note 698; the director, 13 Oct 2026: "an extended front car cow catcher that has a deck, a
    // couple muskoka chairs that can be sat in, a plastic cooler with beers, and a BBQ mounted on a stand on the deck ... its
    // the BBQ Dads at the end of the world"): fitted (campaign.json bbqDeck), a plank deck deckLength m long on a cowcatcher
    // ahead of the engine's pilot, railed railHeight m high, as wide as the running boards, which run on forward along the
    // cab's sides onto it. On it, two Muskoka chairs (sat in with Use, got up from with Jump or Use), a cooler with `beers`
    // in it a night (Use takes one; Use held drinks it, as a healing find's used, for beerHeals; it took the edge off the cold
    // until note 852 cut the cold), and a BBQ on a stand: Use held lightSeconds lights it, and it burns burnSeconds of charcoal; Use held
    // at it lit cooks for grillSeconds and a sausage comes off into your hands (eaten the same way: sausageHeals). Lit, it
    // warms whoever's within grillReach m (the cold recovers as at the firebox), and its heat and smell are a hot boiler's
    // to the Cinder Hounds (enemies.json director.houndsHotBoilerWeight).
    "bbqDeck": false,
    // The tiny caboose (note 713; campaign.json tinyCaboose, composition.dress): a toy body of two particles `radius` m round,
    // `length` m apart, towed on a string `rope` m long from the guard van's platform at couplerHeight. It's a body like any
    // other (it lands on the ground, stops at a wall, is pushed by the cars it touches); the string only ever pulls, across
    // the ground. On the rails it keeps to the line's middle; a bend taken with more than derailAccel m/s² of sideways pull at
    // its speed throws it off, over on its side to the outside, and it's dragged (friction draggedFriction, against its
    // rolling friction's) until a crewmate within reach m puts it back with Use.
    "caboose": { "rope": 1.4, "length": 0.36, "radius": 0.1, "couplerHeight": 1.0, "derailAccel": 0.8, "friction": 0.15, "draggedFriction": 0.6,
      "reach": 2.0 },
    // The dining car (upgrades.md §8.5; note 959): the drinks its bar pours a night ("what the fortress's cellar sold the
    // crew", U1's call: eight), taken one at a time at the counter (Use, empty hands) and drunk as a beer (held Use); what one
    // gives back drunk (drinkHeals: none, it's a drink). What a drink does to the drinker's view is look.json tipsy's.
    // Note 1016 (the director's Look Review verdict, 23 Oct: "More like a fancy bar with bar stools to sit on. The players can
    // go behind the bar and pour drinks ... a cool classic wooden english pub bar. Place it at the back of the car clearly not
    // obstructing the doors. Needs to be away from the lockers"): the bar runs down the right of the car's rear half. Its
    // counter stands counterX m right of the car's middle (clear of the aisle and the end doors, which stand left of it),
    // counterDepth deep and counterHeight high, counterLength long, ending fromRear m short of the rear end wall, where the
    // barman's walkway behind it opens (a return closes its front end to the wall); the back bar along the wall behind the
    // walkway is backBarDepth deep (the walkway between them a crewmate's width); the table stops tableGap short of it.
    // A drink is poured from behind it (Use, empty hands, within pourReach m of the pumps at the counter's middle: from the
    // stools that's the counter's depth and more away). Its stools (stools of them, sat on with Use from the aisle standOff m
    // in front of each: SIT AT THE BAR) stand down its front, stoolOut m out, their seats stoolHeight high.
    // The roof gangplanks (note 1052; upgrades.md §7.3: "plates over the first two couplings back from the cab: walked, not
    // jumped"; the gaps, GDD §13): this many couplings, from the cab back, have an iron plate over them, `width` m wide along
    // the roofs' middle, `thickness` deep, reaching `overlap` m under the roof ahead. Walked off the front of car 1 or 2 there's
    // footing to the roof ahead. Up to a taller roof ahead (the engine's, 0.4 m over car 1's) it ends in treads, none more
    // than `tread` m over the last and `treadDepth` m deep, so each is a step (player.json stepUp, 0.35). The rest of the
    // train's gaps are jumped as ever. 0 as built: campaign.json roofGangplanks.
    "gangplanks": 0,
    "gangplank": { "width": 0.8, "thickness": 0.06, "overlap": 0.3, "tread": 0.2, "treadDepth": 0.35 },
    "dining": { "drinks": 8, "drinkHeals": 0,
      "bar": { "counterX": 0.1, "counterDepth": 0.5, "backBarDepth": 0.15, "counterHeight": 1.08, "counterLength": 4.8, "fromRear": 1.3, "tableGap": 1.2,
        "pourReach": 0.6, "stools": 5, "stoolHeight": 0.76, "stoolOut": 0.32, "standOff": 0.4 } },
    "bbq": { "deckLength": 3.0, "railHeight": 1.0, "beers": 24, "beerHeals": 0, "lightSeconds": 0.6, "burnSeconds": 300,
      "grillSeconds": 6, "sausageHeals": 20, "grillReach": 2.0 },
    // The whimsies (note 715; docs/design/upgrades.md §8.2). Gerald on the guard van's roof and the garden gnomes along the
    // cars' (gnomes of them) are what the Gannet dives on now and then (enemies.json gannet.decoyPull). The canary in car one
    // goes quiet while an interior creature's aboard its car or a car either side of it (canaryCars), and dies in fumes: the
    // chemicals' gas set off within canaryGasM of its cage, or the train stood at a chemical works canaryFumesSeconds. The
    // gramophone in the guard van, wound with Use: a Gaunt within gramophoneHears m hears it as talk (gaunt.bandCalms), a
    // Moose stops to listen (moose.bandHears), and the Choir hears it as a music box (gramophoneLoudness on its meter). The
    // calliope's notes are the whistle's: a Moose within calliopeHears m of the engine stops for it.
    // Note 744: the hammock in the guard van (it slowed the cold until note 852 cut the cold); the hot tub on the engine's
    // hood steams while the boiler has steam, and each bather draws tubSteam of its pressure a second. The
    // fishing rod: stood on dry ground, a line in water within fishReach m ahead, a bite comes in fishSeconds (from the first
    // to the second, by when it's cast), and a fish grilled on the BBQ deck's grill heals fishHeals.
    // Note 745: the yard cat walks at catSpeed m/s and the dog at dogSpeed, each staying put wander s (from the first to the
    // second) between strolls. The cat hisses at a creature aboard its car or within catWarnCars of it; the dog barks at one
    // aboard anywhere, or in the open within dogHears m and coming. The dog takes a toy within fetch m and drops it within drop
    // m of whoever it's bringing it to. The launcher fires a ball at launchSpeed m/s, at most every launchEvery s; a Cinder
    // Hound chasing the train goes for a ball on the ground within ballSeen m, has it within ballTake m, and stands worrying it
    // ballWorry s before it comes on again.
    "whimsy": { "gnomes": 5, "canaryCars": 1, "canaryGasM": 10, "canaryFumesSeconds": 20, "gramophoneHears": 22,
      "gramophoneLoudness": 0.25, "calliopeHears": 80, "tubSteam": 0.15, "fishReach": 4, "fishSeconds": [12, 30],
      "fishHeals": 40, "catSpeed": 1.1, "dogSpeed": 1.8, "wander": [4, 10], "catWarnCars": 1, "dogHears": 40, "fetch": 0.45,
      "drop": 1.2, "launchSpeed": 14, "launchEvery": 2, "ballSeen": 70, "ballTake": 1.5, "ballWorry": 4 }
  },
  // GDD §19 "medicine: fragile, high value" (note 182). A car of medicine takes the knocks the rest of the train shrugs off:
  // any contact (coupling, a collision, a buffer stop) closing faster than safeContactSpeed spoils it by
  // (closing - safeContactSpeed)^2 x couplings.damagePerSpeedSquared x couplings.cargoDamageShare x shockShare (where the
  // other cars only feel it over couplings.safeContactSpeed); and braking harder than brakeShockDecel m/s^2 spoils it
  // brakeShockPerSecond a second for every m/s^2 over. Not in the GDD's numbers: a gentle coupling (under 1.5 m/s) costs a
  // few percent, a full brake on a short train (2.2 m/s^2) about a fifth of the load from line speed to a stand.
  "fragile": { "safeContactSpeed": 0.3, "shockShare": 3, "brakeShockDecel": 1.2, "brakeShockPerSecond": 0.02 },
  // Note 267 (the director's notes on build 1121): Use works the thing looked at. Where several are in reach (a row of
  // lockers a hand wide; the firebox, the vent, the tool rack and the whistle cord in the cab), the one within
  // lookDegrees of the view's centre, taken from eyeHeight over the feet, wins; none looked at, the nearest, as before.
  // The whistle cord is only ever pulled looked at. Crouched (note 664), from crouchedEyeHeight: eyeHeight less player.json's
  // crouch.eyeDrop.
  "pick": { "eyeHeight": 1.6, "lookDegrees": 30, "crouchedEyeHeight": 1.05 },
  "kit": {
    // The loose radio sets (T41) when radioEach is off: one on the cab floor, the rest in the guard van.
    "radios": 2,
    // GDD §12, note 749 (the director, 14 Oct 2026: "make the radios part of the default kit ... Hold down right click to use
    // the radio since communication is so important"; "Radio is part of uniform and doesnt take inventory space"): every
    // living crewmate wears a radio from the start of the night, joiners and those back from a Holdout too (bots as well),
    // and it never comes off the belt: no slot, not put down, not stowed. A broken one is mended on the belt. The loose sets
    // above aren't placed; the dead's goes with them, and they come back with a working one. False: the loose sets, as before.
    "radioEach": true,
    // Note 266 (build 1121, solo: "there's no lanterns. The lights are completely off"): the forward lamp a Climber smashed
    // (enemies.json climbers.lampOutSeconds, the spare glass going in) comes back lit as the driver had it, not dark till
    // someone thinks to press [L]. One the driver switched off stays off.
    "relightSmashedLamp": true,
    // Spec A.5: the radio "dies in tunnels and mine spurs". It still carries this far in, from a tunnel's mouth or a mine
    // spur's points (m): none, until the campaign's radio range adds to it (campaign.json, F.3; note 196).
    "radioReach": 0,
    // Note 678's grab irons (campaign.json): the multiple of player.json ladder.grabMaxRelativeSpeed a ladder is caught at.
    "grabIrons": 1,
    // GDD §23 "radio breaks" (note 183): a radio on your belt smashes with this chance per point of damage you take, plus
    // radioBreakOnGrab when something grabs you (note 749, App. C.8: 0, a grab never breaks the set; the broadcast is the
    // point. It was 0.25). Broken, it's still worn but off the air. Note 200: the repair kit mends
    // it (GDD §12's engineer, whoever has the kit): the kit in hand, Use held radioMendSeconds, standing, with the broken
    // radio on your own belt or lying in reach (a crewmate takes theirs off to hand it over). A tap still puts the kit
    // down. Not in the GDD's numbers: a third of the boiler's 25 s, long enough to be a decision under attack.
    "radioBreakPerDamage": 0.006,
    "radioBreakOnGrab": 0,
    "radioMendSeconds": 8,
    // The crew's tools (note 1052; docs/design/upgrades.md §7.3, the director, 14 Oct 2026 §8.2: "all of §7.3's"). Each a share
    // of a trouble, never all of it (§2); the campaign fits them (campaign.json commCord, trainTelltale; stores.fusees).
    // The communication cord: "a cord the length of the train: pulled anywhere, the cab's bell rings with the car's number"
    // (§15, "half the crew can't hear the other half"). The whistle's key [H] aboard any car of the engine's rake pulls it (in
    // the cab that key is still the whistle); the cab's bell strikes the car's number of times, `strokes` at most, and the
    // HUD names the car for `showSeconds`. One pull a crewmate every `every` s. It's a bell in the cab, not a voice: it says
    // which car and nothing more, and a car cut off the train has no cord to the cab.
    "cord": false,
    "cordBell": { "every": 3, "strokes": 9, "strokeSeconds": 0.55, "showSeconds": 8 },
    // The end-of-train telltale (§7.3: "a lamp in the cab that goes out when the train parts behind it"; the Passenger, the
    // Knotter, a coupling let go): lit while the train's tail (its last car) is coupled to the engine, out the moment it isn't,
    // lit again once it is. It doesn't say where it parted, or stop it.
    "telltale": false,
    // Fusees (§7.3, stores: "red flares dropped on the line: the way back to the train glows for a few minutes"): a box of them
    // in the guard van, each struck with Fire [LMB] in hand and dropped at the feet, burning red `burnSeconds` (a few minutes);
    // one a crewmate every `every` s. How far each is seen and what it lights is senses.json "fusee": a light, so a creature
    // that answers light answers it too. The stores set how many boxes and fusees (campaign.json stores.fusees).
    "fusee": { "burnSeconds": 180, "every": 1 },
    // The stretcher (§7.3: "carry a body at walking pace, and up a ladder"; bodies home pay 75%, App. D): with it fitted, anyone
    // carrying a body climbs a ladder with it at `climb` m/s, not only the last one alive (player.json soloBodyClimb, 0.4).
    // Half a free climber's 1.6: a body up a ladder is still slow, and two hands on it. On the ground a body already goes at
    // player.json carryHeavy (2.8 m/s, over the walk's 2.4), so the walking pace is had; the ladder is the stretcher's share.
    "stretcher": false,
    "stretcherCarry": { "climb": 0.8 },
    // The band's instruments (note 700): band.json ids, each the blacksmith sold the crew (campaign.json, effect
    // "instrument:<id>"), stocked in the guard van. None until bought.
    "instruments": [],
    // GDD v1.1 App. C.4 hand loot: toys, for the Track Doll (it steals one and leaves for the run). Note 267 (the director's
    // notes on build 1121: "things that we should definitely find out in the world"): none ride from the fortress now;
    // they're found at the stops (loot.json "toys"). A count here would put that many back in the guard van, quiet past
    // the noises listed (App. C item 4; combat.json choir.toys, note 175).
    "toys": 0,
    "toyNoises": [],
    // GDD §12 "the repair kit is an item, not a station": one toolbox, in its locker (lockers.kitLocker) in car
    // `repairKitCar` (counted back from the engine). It's what mends a ruptured boiler (boiler.json repairSeconds), so
    // someone has to leave the footplate for it, and whoever carries it opens a Holdout's lock silently (holdouts.json
    // "open"). When they die it's lying where they fell.
    "repairKits": 1,
    "repairKitCar": 1,
    // Spare kits bought at the fortress (GDD App. E.12 question 4, answered: campaign.json spareKit). Always 0 here: the
    // campaign adds what the save has (SessionSetup.SpareKits), and each starts the night in a locker beside the first.
    "spareKits": 0,
    // The crew lockers (GDD §12, ARCHITECTURE §8 note 173): a row of tall iron lockers along the left wall of the kit's car,
    // ahead of its side door, each numbered on its enamel plate (note 280: no role names; the crew is the driver, gunners
    // and labourers). Hold Use at one to open or shut
    // its door; a tap of Use puts what's in your hands on its first free shelf, or takes the top thing off its shelves.
    // What's inside is held by the locker, not lying in the car: it can't fall, slide, or go through a wall.
    "lockers": {
      // One locker a number, front to back, painted on its plate. Eight (note 1016; the director's Look Review verdict on the
      // dining car, 23 Oct: "reduce the locker count to 8"; it was twelve).
      "names": ["1", "2", "3", "4", "5", "6", "7", "8"],
      // The repair kit's locker. Spare kits go on its other shelf, then into the lockers after it.
      "kitLocker": "8",
      // Shelves in each: the locker's floor, and three more up to a hand under its top, about 0.4 m apart (note 659; the director,
      // 13 Oct: "we really should be able to put multiple things in lockers": two filled one with tinned food).
      "slots": 4,
      // What goes in: hand-sized things, and a tool left to free its slot (note 649). Freight, the train's crates, the heavy,
      // the dead and the living don't.
      "holds": ["lamp", "radio", "toy", "loot", "extinguisher", "repairKit", "tool"],
      // Each locker's size (m): along the row, out from the wall, and tall. The row starts this far behind the front end
      // wall (the car's extinguisher board goes in the gap) and stops short of the side door.
      "width": 0.42,
      "depth": 0.5,
      "height": 1.9,
      "fromFront": 0.7,
      // Holding Use this long at one opens or shuts its door (a tap is shorter: it stows or takes).
      "doorSeconds": 0.4,
      // Note 267 (the director's notes on build 1121: "all of these seem empty"): what each locker starts with besides the
      // kit. Not in the GDD, which names only the kit; GDD §10's "where emergency lamps are kept, where fire extinguishers
      // hang". The rest stand empty for what the crew finds and stows.
      "stock": {
        "1": ["lamp"],
        "2": ["extinguisher"],
        "3": ["lamp"],
        "6": ["extinguisher"],
        "7": ["lamp", "lamp"]
      }
    }
  }
}
