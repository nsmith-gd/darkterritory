// Loading modules (systems spec D). First pass: two of the D.2 roster, manual crates and the capstan winch.
// Every facility but the coaling tower is on a spur (GDD §17, route.json "junctions"). A yard's power is its stop's
// (stops.json tiers "power").
{
  // On a spur the modules are laid out from this far back from the buffer stop: beside the first cars behind the
  // engine when it's run up to the end. "along" below is from here.
  "spurLayout": 45,
  // D.2 "Manual crates: carry by hand. Slow, but works when everything else is dead." Carrying one holds you to
  // spec B.2's heavy-cargo speed and off ladders, so you take it up a cargo car's side steps and in by its sliding door
  // (train.json "interior"). Put one down inside a cargo car and it's loaded.
  "crates": {
    "count": [6, 10],
    "loadPerCrate": 0.25,
    // How long a crate lies still inside a car before it counts as stowed.
    "settleSeconds": 1.0,
    // The stack: this far from the track centreline, this far along from the facility's middle.
    "lateral": 6,
    "along": -15,
    // D.2 "heavy items need two" (T43): on top of the stack, a few crates nobody lifts alone. One of you takes an end
    // (a reaching hand needs both hands on it) and it stays put; the other takes the other end and it comes up between
    // you, at the heavy-cargo pace. Either lets go, or you get more than "span" apart, and it's down.
    "heavy": {
      "count": [1, 2],
      "loadPerCrate": 0.5,
      "radius": 0.55,
      "span": 2.4,
      // Set apart from the stack, back along the track from it, so nobody reaching for a light one gets a heavy one.
      "along": -6
    }
  },
  // D.2 "Capstan winch: two players hand-crank in rhythm to drag cargo from distance. 2 mandatory. Desync stalls
  // it; sustained, slow, both players fully exposed." Both handles held or it doesn't move.
  "winch": {
    "haulMetres": 40,
    "speed": 0.5,
    "loadPerSled": 0.5,
    "sleds": 2,
    "handleReach": 1.1,
    // The sled's cargo goes into the nearest cargo car with room within this of where it comes to rest (it rests 3.6 m
    // out from the track, so both cars either side of it are about 8.5 m away).
    "carReach": 10,
    // Where the capstan stands along the track from the layout point (ours, not the spec's). The sled comes to rest
    // between the first two cars behind the engine at the buffer stop, in reach of both, so a half-full train (the
    // run's departure load) takes both sleds: one in each. The engine can't pull further forward to spot another car.
    "along": 8,
    // The crank at each end of the drum (T43). Holding E turns yours at the crank's pace; a reaching hand (VR) turns it
    // by going round with it, over the top towards the track, and no faster than that pace. The drum goes at the slower
    // crank's pace, and not at all when one's slower than "inRhythm" of the other: D.2's desync stall. A hand's pace is
    // smoothed over "smoothSeconds" so one tick's jitter isn't a stall.
    "crank": {
      "revsPerSecond": 0.5,
      "radius": 0.3,
      "inRhythm": 0.6,
      "smoothSeconds": 0.25
    }
  },
  // D.2 "Gantry crane: one player in an elevated cab drives X/Y/Z; ground crew rigs the load and calls position. 2
  // mandatory. Crane operator cannot see the ground crew. Dropped loads kill." (T48). A gantry astride the track, its
  // castings stacked on the far side. The operator holds E in the cab to drive it: WASD the bridge along the track and
  // the trolley across, Space and B the hook up and down, left mouse to let go. Someone on the ground holds E at the hook
  // beside a casting to rig it. Set down on a cargo car's roof it's lashed there, and loaded. Let go of it high, and it
  // falls: anyone under it is crushed.
  // A yard's power (level-design D.2; spec D.1 "the dead-facility restart excursion"): at low power its cranes run at
  // this fraction of their speed, dead they don't run at all. Hold Use at the powerhouse door this long to restart it
  // (as loud as `restartRounds` cannon rounds a second, like any machinery), from within `reach`.
  "power": { "lowSpeed": 0.5, "restartSeconds": 8, "restartRounds": 0.25, "reach": 2.0 },
  "crane": {
    // The gantry: centred this far along from the layout point, running this long, spanning from this far out on the
    // near side of the track to the far side, its hook's highest point.
    // Over the first cars behind the engine at the buffer stop, clear of the crate stack and the winch.
    "along": -4,
    "length": 20,
    "span": [-3.5, 9],
    "height": 8,
    // The castings stand on the far side, this far out, this far apart along the track.
    "stackLateral": 7.5,
    "castings": 2,
    "spacing": 3,
    "loadPerCasting": 0.5,
    "castingSize": [1.4, 0.9, 1.0],
    // How fast it moves, metres a second: the bridge along the rails, the trolley across the bridge, the hook.
    "bridgeSpeed": 1.2,
    "trolleySpeed": 1.0,
    "hoistSpeed": 0.8,
    // At the controls: within this of the cab's control stand. The cab's at the gantry's near end, up at the top.
    "controlsReach": 1.2,
    // Rigging: on the ground, within this of the hook, the hook low enough to reach, for this long.
    "rigReach": 1.5,
    "rigHeight": 2.2,
    "rigSeconds": 2,
    // A casting let go more than this above what's under it falls, and kills anyone within this of where it lands.
    "dropAbove": 0.6,
    "crushRadius": 1.4
  },
  // GDD §18's set pieces (WP15, ARCHITECTURE §8 note 185).
  // The grain elevator: "one spout, one car at a time. Endless repositioning and switch calls" (spec D.2's gravity chute,
  // read for grain). The spout hangs over the track this far back from its buffer stop (or as far back as the standing track
  // allows, short of 4 m from its start), this high; the lever stands "leverAlong" on from it, "leverLateral" out on the
  // site's side. Grain comes down while someone holds the lever (within "leverReach"), "pourPerSecond" car-loads a second
  // out of a bin of "bin" car-loads, into the cargo car whose middle is within "tolerance" of it. No car there, it's on the
  // ballast; a full one there overflows, and each car-load over strains the car by "overfillDamagePerLoad" (spec D.2:
  // "overfill damages car and spills"). The machinery's loud while it runs (combat.json machineryLoudness).
  "spout": {
    "back": 80,
    "height": 5.2,
    "leverAlong": 2.0,
    "leverLateral": 3.4,
    "leverReach": 1.2,
    "tolerance": 1.5,
    "pourPerSecond": 0.05,
    "bin": 3.0,
    "overfillDamagePerLoad": 0.6
  },
  // The mine head's steam lift (spec D.2: "requires the locomotive coupled nearby and venting pressure to power it. 2 crew. Ties
  // loading directly to the boiler; you're at zero pressure while it runs"; the Wiki's Loading table; ARCHITECTURE §8 note 368).
  // A headframe over its shaft "frameLateral" out on the site's side, "along" from the layout point (where the mine head's
  // buildings put their headframe: StructureKit's, centred 25 m back and 4 + 12 m out), its chute reaching over the track
  // "chuteHeight" up, so the cars are walked under it one at a time as under the spout; its lever "leverAlong" on from the chute,
  // "leverLateral" out, worked within "leverReach". The engine's steam line reaches it with the engine's middle within
  // "steamReach" of the chute (the first three cars behind it come under the chute in reach; the rest are the winch's and the
  // crates'). With someone holding the lever, the engine in reach and its vent held open in the cab, the vented steam winds the
  // skip up the shaft instead of into the air: each point of pressure vented (boiler.json ventRate, 12 a second) is
  // 1/"steamPerSkip" of a wind. Wound, the skip tips "perSkip" of a car-load of ore down the chute, into the cargo car whose middle
  // is within "tolerance" of it (none there, it's on the ballast; a full one overflows and strains, "overfillDamagePerLoad" a
  // car-load, as the spout's), out of "ore" car-loads down the shaft. A full boiler winds about four skips (a car); then the fire
  // has to make the steam again (a standing engine's full firebox about 1.8 a second, so a skip in about 11 s), and the engine
  // pulls nothing till it's back over boiler.json powerFloor. The winding engine's loud while it runs (combat.json
  // machineryLoudness), as the other machinery is.
  "lift": {
    "along": -25,
    "chuteHeight": 4.6,
    "frameLateral": 16,
    "leverAlong": -3,
    "leverLateral": 3.4,
    "leverReach": 1.2,
    "steamReach": 56,
    "steamPerSkip": 20,
    "perSkip": 0.25,
    "tolerance": 1.5,
    "ore": 3.0,
    "overfillDamagePerLoad": 0.6
  },
  // The grain elevator's conveyor line (spec D.2: "start machinery at a powerhouse, then clear jams as they occur. 1 + 1 roaming.
  // Jams every 30–60s; unattended jam stops the line"; D.3: "conveyor fails through attention split — someone has to roam";
  // ARCHITECTURE §8 note 400). Its head hangs over the track "headHeight" up, "ahead" of the spout toward the buffer stop: one
  // car's pitch (train.json carLength 14 and couplingGap 1.5), so with a car under the spout the one ahead of it is under the
  // head and the two load at once (without a spout, "back" from the buffer stop, or as far back as the standing track allows).
  // From the head a riser comes down to a knee "kneeLateral" out, and the belt runs on low ("beltHeight") on trestles "run"
  // along the track toward the elevator's bins, out to its tail "tailLateral" out, where its drive
  // house is: the starter "starterAlong" on past the tail and "starterLateral" out, held within "starterReach" for
  // "startSeconds" to start it (loud: "startRounds" a second while it's held, as the powerhouse restart is). Running, it
  // carries grain into the cargo car whose middle is within "tolerance" of the head at "perSecond" car-loads a second (the
  // head's gate opens only over a car with room), out of "grain" car-loads; Low power runs it at power.lowSpeed, and a dead
  // yard's powerhouse has to be restarted before it'll start. Every "jamEvery" seconds of carrying (drawn from the night's
  // seed) the belt jams somewhere along its low run ("jamFrom".."jamTo" of the way from the tail to the knee) and carries
  // nothing; held within "clearReach" of the jam (on the ground beside it) for "clearSeconds", it's free. A jam left
  // "stallSeconds" stalls the drive, and it's back to the drive house to start it again. Within "nearBelt" of its low run the
  // HUD says how far off a jam is, or that it's stalled. The machinery's loud while it runs (combat.json machineryLoudness), as
  // the other machinery is.
  "conveyor": {
    "ahead": 15.5,
    "back": 64.5,
    "headHeight": 4.8,
    "kneeLateral": 4.6,
    "beltHeight": 1.0,
    "run": 26,
    "tailLateral": 9,
    "starterAlong": 2.5,
    "starterLateral": 6.5,
    "starterReach": 1.4,
    "startSeconds": 4,
    "startRounds": 0.25,
    "tolerance": 1.5,
    "perSecond": 0.04,
    "grain": 3.0,
    "jamEvery": [30, 60],
    "jamFrom": 0.1,
    "jamTo": 1.0,
    "clearReach": 1.6,
    "clearSeconds": 2.5,
    "stallSeconds": 20,
    "nearBelt": 25
  },
  // The slaughterhouse's livestock ramp (spec D.2: "herd animals up a ramp into a stock car. 2–3 crew. Constant noise. Raises
  // Choir floor while active"). The ramp's top is "rampLateral" out from the track at "along"; the pen "penLateral" out,
  // "penRadius" across, with "head" animals in it. With "herders" or more in the pen holding Use and a cargo car with room
  // within "carReach" of the ramp's top, one goes up every "secondsPerHead" (each herder past the needed ones quickens it by
  // "extraHerder"), each "loadPerHead" of a car-load. From the first one up until the last, the herd's stirred: the Choir's
  // floor is "choirFloor" (combat.json choir livestockFloor is the stock car's own, once they're aboard). GDD §18 "something
  // already lives here": enemies.json director "residents".
  "ramp": {
    "along": -10,
    "rampLateral": 2.6,
    "penLateral": 10,
    "penRadius": 4,
    "head": [4, 6],
    "loadPerHead": 0.2,
    "secondsPerHead": 6,
    "herders": 2,
    "extraHerder": 0.25,
    "carReach": 9,
    "choirFloor": 0.35
  },
  // The chemical works' fluid gantry (spec D.2: "connect hoses, monitor pressure, disconnect cleanly. 1–2. Leaks if unattended.
  // Chemical spill contaminates the car"; GDD §18 "Leaks. Do not fire indoors"). The stand is "lateral" out at "along". Hold
  // Use at it (within "reach") for "connectSeconds" to put the hose on the cargo car with room within "carReach", and again to
  // take it off. On, it fills the car at "flowPerSecond" a second, and its pressure climbs "pressureRise" a second, falling
  // "bleed" a second while anyone stands at the stand. At 1 it leaks: everyone within "leakRadius" of the stand takes
  // "leakDamagePerSecond", and the car's load spoils "spoilPerSecond". The car moving more than "tearSlack" past "carReach"
  // tears it off: it sprays for "tornSeconds" and the car's load spoils "tornSpoil" at once.
  // "Indoors" is within "indoorsM" of the stand: in among the works' tanks and pipe racks, which takes in every car down its
  // spur. A cannon fired there gasses as one beside a chemicals car does (combat.json fumes; note 182).
  "hose": {
    "along": 4,
    "lateral": 4.2,
    "reach": 1.4,
    "carReach": 9,
    "tearSlack": 2,
    "connectSeconds": 2.5,
    "flowPerSecond": 0.04,
    "pressureRise": 0.05,
    "bleed": 0.15,
    "leakRadius": 6,
    "leakDamagePerSecond": 12,
    "spoilPerSecond": 0.02,
    "tornSeconds": 20,
    "tornSpoil": 0.25,
    "indoorsM": 60
  },
  // The military depot's powder (GDD §18 "best payout, worst cargo"; §19 "explodes"). Its crates are kegs (cargo
  // "ammunition" below). One brought up short by more than "blowSpeed" m/s (thrown, or dropped off a roof: set down by hand
  // it falls a hand's height, about 3.7 m/s) goes up: everyone within "killRadius" takes "damage", less out to "radius";
  // cars within "killRadius" of it lose "carDamage" integrity; and every keg within "chain" goes up the tick after.
  "kegs": {
    "blowSpeed": 6,
    "killRadius": 3,
    "radius": 9,
    "damage": 150,
    "chain": 3,
    "carDamage": 0.3
  },
  // GDD §18's switchyard and wreck yard (WP15b, ARCHITECTURE §8 note 187).
  // The switchyard: "mixed. Cars scattered across six sidings. A live track puzzle solved by shouting." Its cars stand on every
  // track of its yard but its own (on its own, if that's all it has), "cars" to a siding, "back" metres short of the buffer
  // stop, handbrakes on, each loaded somewhere in "load" with one of "cargoes" (mixed: the run's cargo rates pay each by its
  // own). Couple up to them and bring them away, and they're the crew's. The sidings' points all face up the line, so they come
  // away ahead of the engine, and the crew go in for each siding's with every car already picked up still in front: so never
  // more in all than the shortest of those sidings takes with the engine and "spare" of the train's own cars behind it.
  "rakes": {
    "cars": [1, 2],
    "load": [0.5, 1.0],
    "cargoes": ["goods", "food", "timber", "heavy", "medicine", "coal"],
    "back": 1.0,
    "spare": 1
  },
  // Blocked sidings (level-design D.1, D.2; ARCHITECTURE §8 note 294): the derelicts a yard's layout stands on some of its
  // sidings (stops.json derelict, and the tier's blocked), "back" metres short of the buffer stop, handbrakes on, empty, their
  // shells at "integrity" (they look it). They're bad-order stock: anything loaded into one pays only "pays" of itself, and
  // wherever the crew put them away they're not cars lost. To use the siding, couple up, pull them out and leave them on a
  // track already worked; or keep them, ahead of the engine, for the rest of the night.
  "derelicts": {
    "back": 1.0,
    "integrity": 0.4,
    "pays": 0.3
  },
  // The wreck yard: "salvage, high value. Pull cargo off derailed trains. Unstable, unlit, already occupied" (the occupants are
  // enemies.json director "residents"). The last train came off at the end of the yard's line: "heaps" of its cars lie where
  // "layout" puts them, metres along from its buffer stop (on beyond it, positive) and out on the site's side, each with
  // "salvage" pieces in it (cargo "salvage" below, carried out by hand as crates are, each crates.loadPerCrate of a car). There
  // are no lamps: a heap's salvage is only found (comes out onto the ground beside it) once a hand lamp is within "lampReach"
  // of it, carried or set down, or it's in the engine's headlamp (within "beamLength" ahead, "beamSpread" metres wider for each
  // metre on, from 2 m either side). Every piece picked up costs its heap "strainPerPiece" of its stability; at none it groans
  // for "warnSeconds" (the tell) and shifts: everyone within "crushRadius" of it takes "damage", and it settles at "settle".
  // It shifts at most "shifts" times.
  "wreck": {
    "heaps": [3, 4],
    "layout": [[8, 1.5], [20, 4.5], [-24, 12], [16, 15]],
    "salvage": [2, 3],
    "lampReach": 6,
    "beamLength": 40,
    "beamSpread": 0.2,
    "strainPerPiece": 0.4,
    "warnSeconds": 3,
    "crushRadius": 3.5,
    "damage": 45,
    "settle": 0.6,
    "shifts": 2
  },
  // Who works a stop (note 261; spec D.2's "Crew" column, which counts people at a module, not who they are). The shunter
  // is free once the train's in, and takes a pair module's missing place (or carries, where fewer than two do).
  "crew": {
    // D.2 doesn't say whether the driver is one of a module's crew. Read so that a crew of two can work a winch ("2
    // mandatory") at all: with too few others, the driver leaves the train standing on its brake and gets down to it.
    "driverWorks": true,
    // People playing are hands at a stop: the bots stop for what the crew, people and bots together, can load.
    "peopleAreHands": true,
    // A pair module only people playing can make up (one bot at the winch, someone playing for the other handle) is waited
    // on while the loading's getting somewhere: this long with nothing loading, and the bots leave it (seconds).
    "peopleWait": 45,
    // Note 326 (GDD App. F.3: "crews decide whether to split up for more loot, or work the yard together, or the village
    // together"): once the yard's crates are in, this share of the crate hands go to search the village's open houses
    // (the rest shut the doors), each to the nearest hiding spot nobody else has taken within villageReach (m) of where it
    // stands, and bring back what they find. The driver waits for them, up to its give-ups; nobody goes with less than
    // villageDawnSpare (s) of the night left. Not in the spec: half, so the yard's still minded.
    "villageShare": 0.5,
    "villageReach": 150,
    "villageDawnSpare": 900,
    // Note 403 (GDD App. F.3's "work the yard together"; since queue #89 every siding has loot beside it): the crates by the
    // site's own stack in, a crate hand fetches the nearest crate lying loose elsewhere in the yard, either side of the
    // train, within yardReach (m) of where it stands, on foot round the sheds and the train, before anyone goes to the village. The same
    // dawn spare. Not in the spec: a crate's carried at 2.8 m/s, so 120 m is a minute and a half there and back.
    "yardReach": 120,
    // Note 413 (GDD §21: the Choir takes "anyone ... not behind a closed door"; App. A.7): the Choir gathered this far (0 to 1;
    // the walkers' own 0.5, about 20 s off) or here, a hand on foot at a stop gets behind a door: the nearest open house with a
    // single door, if its door's within shelterReach (m) and no further than shelterOverTrain times the train's nearest car
    // (a car's a climb, the roofs and an end door away), shut in; else aboard, the walkers' way. Gathered less than
    // shelterOutAt and gone, it comes out. Not in the spec: 60 m is about 12 s at a run.
    "shelterAt": 0.5,
    "shelterOutAt": 0.25,
    "shelterReach": 60,
    "shelterOverTrain": 2
  },
  // Which modules each facility offers (spec D.1: 2–4 per POI once the roster is built; the coaling tower is its chute). The
  // first is the kind's signature, the one every stop of it has; with "draw" on, the rest are drawn per stop (note 449).
  "kinds": {
    // The conveyor line (note 400) behind the spout: two modules (spec D.1), the spout's lever and the belt's roaming.
    "grainElevator": ["spout", "conveyor"],
    "switchyard": ["rakes", "crates"],
    "foundry": ["crane", "winch", "crates"],
    "slaughterhouse": ["ramp", "crates"],
    "wreckYard": ["wreck", "winch"],
    // The mine head's steam lift (note 368) beside its winch: two 2-person modules (spec D.3, "someone is alone somewhere").
    "mineHead": ["lift", "winch", "crates"],
    "chemicalWorks": ["hose", "crates"],
    "militaryDepot": ["crates", "winch"]
  },
  // Each stop's own modules (spec D.1: "POIs are procedurally assembled from a module grammar, so no two facilities operate
  // identically", "2–4 loading modules"; ARCHITECTURE §8 note 449). With "enabled", a stop has its kind's signature (the first
  // in "kinds") and each of the rest of its kind's list and its "extras" with "chance", from the night's seed and the stop's
  // place in the night: filled up to the fewest of "count" and cut to the most, in that order (the kind's own first). Off,
  // every stop has its kind's whole list. A route's own modules (dt edit, T44) are kept either way.
  "draw": { "enabled": true, "chance": 0.6, "count": [2, 4] },
  // What a kind can draw beyond its own list, laid out clear of what it already has (note 449): a winch beside the switchyard's
  // crates and the slaughterhouse's pen, crates beside the wreck yard's heaps. Not the grain elevator (the stack and the sled
  // run would stand on its conveyor's belt) or the chemical works (the capstan beside the hose stand).
  "extras": {
    "switchyard": ["winch"],
    "slaughterhouse": ["winch"],
    "wreckYard": ["crates"]
  },
  // What each facility puts in a car (GDD §18-19; App. B.8's modifiers go by it). A car takes the cargo of the last one that
  // loaded it. Not listed: goods.
  "cargo": {
    "grainElevator": "food",
    "switchyard": "goods",
    "foundry": "heavy",
    "slaughterhouse": "livestock",
    "wreckYard": "salvage",
    "mineHead": "ore",
    "chemicalWorks": "chemicals",
    "militaryDepot": "ammunition"
  }
}
