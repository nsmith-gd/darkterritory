// Loading modules (systems spec D). First pass: two of the D.2 roster, manual crates and the capstan winch.
// Every facility but the coaling tower is on a spur (GDD §17, route.json "junctions"). A yard's power is its stop's
// (stops.json tiers "power").
{
  // On a spur the modules are laid out from this far back from the buffer stop: beside the first cars behind the
  // engine when it's run up to the end. "along" below is from here.
  "spurLayout": 45,
  // D.2 "Manual crates: carry by hand. Slow, but works when everything else is dead." Carrying one holds you to
  // spec B.2's heavy-cargo speed and off ladders, so you take it up a cargo car's side steps and in by its sliding door
  // (train.json "interior"). Put one down inside a cargo car and it's loaded.
  "crates": {
    "count": [6, 10],
    "loadPerCrate": 0.25,
    // How long a crate lies still inside a car before it counts as stowed.
    "settleSeconds": 1.0,
    // The stack: this far from the track centreline, this far along from the facility's middle.
    "lateral": 6,
    "along": -15,
    // D.2 "heavy items need two" (T43): on top of the stack, a few crates nobody lifts alone. One of you takes an end
    // (a reaching hand needs both hands on it) and it stays put; the other takes the other end and it comes up between
    // you, at the heavy-cargo pace. Either lets go, or you get more than "span" apart, and it's down.
    "heavy": {
      "count": [1, 2],
      "loadPerCrate": 0.5,
      "radius": 0.55,
      "span": 2.4,
      // Set apart from the stack, back along the track from it, so nobody reaching for a light one gets a heavy one.
      "along": -6
    }
  },
  // D.2 "Capstan winch: two players hand-crank in rhythm to drag cargo from distance. 2 mandatory. Desync stalls
  // it; sustained, slow, both players fully exposed." Both handles held or it doesn't move.
  "winch": {
    "haulMetres": 40,
    "speed": 0.5,
    "loadPerSled": 0.5,
    "sleds": 2,
    "handleReach": 1.1,
    // The sled's cargo goes into the nearest cargo car with room within this of where it comes to rest (it rests 3.6 m
    // out from the track, so both cars either side of it are about 8.5 m away).
    "carReach": 10,
    // Where the capstan stands along the track from the layout point (ours, not the spec's). The sled comes to rest
    // between the first two cars behind the engine at the buffer stop, in reach of both, so a half-full train (the
    // run's departure load) takes both sleds: one in each. The engine can't pull further forward to spot another car.
    "along": 8,
    // The crank at each end of the drum (T43). Holding E turns yours at the crank's pace; a reaching hand (VR) turns it
    // by going round with it, over the top towards the track, and no faster than that pace. The drum goes at the slower
    // crank's pace, and not at all when one's slower than "inRhythm" of the other: D.2's desync stall. A hand's pace is
    // smoothed over "smoothSeconds" so one tick's jitter isn't a stall.
    "crank": {
      "revsPerSecond": 0.5,
      "radius": 0.3,
      "inRhythm": 0.6,
      "smoothSeconds": 0.25
    }
  },
  // D.2 "Gantry crane: one player in an elevated cab drives X/Y/Z; ground crew rigs the load and calls position. 2
  // mandatory. Crane operator cannot see the ground crew. Dropped loads kill." (T48). A gantry astride the track, its
  // castings stacked on the far side. The operator holds E in the cab to drive it: WASD the bridge along the track and
  // the trolley across, Space and B the hook up and down, left mouse to let go. Someone on the ground holds E at the hook
  // beside a casting to rig it. Set down on a cargo car's roof it's lashed there, and loaded. Let go of it high, and it
  // falls: anyone under it is crushed.
  // A yard's power (level-design D.2; spec D.1 "the dead-facility restart excursion"): at low power its cranes run at
  // this fraction of their speed, dead they don't run at all. Hold Use at the powerhouse door this long to restart it
  // (as loud as `restartRounds` cannon rounds a second, like any machinery), from within `reach`.
  "power": { "lowSpeed": 0.5, "restartSeconds": 8, "restartRounds": 0.25, "reach": 2.0 },
  "crane": {
    // The gantry: centred this far along from the layout point, running this long, spanning from this far out on the
    // near side of the track to the far side, its hook's highest point.
    // Over the first cars behind the engine at the buffer stop, clear of the crate stack and the winch.
    "along": -4,
    "length": 20,
    "span": [-3.5, 9],
    "height": 8,
    // The castings stand on the far side, this far out, this far apart along the track.
    "stackLateral": 7.5,
    "castings": 2,
    "spacing": 3,
    "loadPerCasting": 0.5,
    "castingSize": [1.4, 0.9, 1.0],
    // How fast it moves, metres a second: the bridge along the rails, the trolley across the bridge, the hook.
    "bridgeSpeed": 1.2,
    "trolleySpeed": 1.0,
    "hoistSpeed": 0.8,
    // At the controls: within this of the cab's control stand. The cab's at the gantry's near end, up at the top.
    "controlsReach": 1.2,
    // Rigging: on the ground, within this of the hook, the hook low enough to reach, for this long.
    "rigReach": 1.5,
    "rigHeight": 2.2,
    "rigSeconds": 2,
    // A casting let go more than this above what's under it falls, and kills anyone within this of where it lands.
    "dropAbove": 0.6,
    "crushRadius": 1.4
  },
  // Which modules each facility offers (spec D.1: 2–4 per POI once the roster is built; the coaling tower is its chute).
  "kinds": {
    "grainElevator": ["crates"],
    "switchyard": ["crates"],
    "foundry": ["crane", "winch", "crates"],
    "slaughterhouse": ["crates"],
    "wreckYard": ["winch"],
    "mineHead": ["winch", "crates"],
    "chemicalWorks": ["crates"],
    "militaryDepot": ["crates", "winch"]
  }
}
