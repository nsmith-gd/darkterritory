// GDD §34 "Agent verification harness": the balance sweep's targets, as `dt balance` judges a sweep of bot nights.
// Bots are not people (they don't talk, and they keep to a plan), so these are floors for the harness, not the design's
// numbers for players: a sweep that fails one has found a night the bots can't play, or one nothing happens in.
{
  // "Crew-size sweep: survivable at 2": at least this share of a two-crew's nights get home.
  "survivableCrew": 2,
  "survivableDelivered": 0.5,
  // "...non-trivial at 8": an eight-crew's night sees at least this many punishes (a threat landing) on average.
  "nonTrivialCrew": 8,
  "nonTrivialPunishes": 5,
  // The pace: no night quiet out on the line longer than this, and quiet stretches no longer than meanQuietSeconds on
  // average. The 100-night playtest's "a reward or a problem every 30 s at most, ideally 20" gave way to the director's
  // decision of 6 Oct 2026 (note 266): a quiet spell is 20–90 s (enemies.json director.graceMaxSeconds).
  "maxQuietSeconds": 90,
  "meanQuietSeconds": 20,

  // GDD §34 "Combination fairness: every pair and triple in the roster against every hazard set. Flag unwinnable or
  // trivially solved" (dt balance --pairs / --triples; note 186). Each combination is insisted on (only those kinds, sent
  // whenever their spawn can place them, again insistEvery s after one's gone) for a short night of seconds s: crew bots on
  // route's line with a train of cars, starting on the first stretch clear of stops and tunnels from which every kind that
  // needs the line (the Car Hugger's marsh or bridge, the Switchman's dead line) can be placed, leadM short of it. A night
  // is lost if the train's derailed or stranded, or unwinnableLost of the crew are dead. Unwinnable: lost every seed.
  // Trivial: every kind came on, and in every seed nothing landed (no grab, no punish, nobody dead, under trivialCargoLoss
  // of the cargo gone). Kinds that never came on are reported (unplaced: their spawn found nowhere; dormant: put there,
  // they lay in wait all night), not judged. By default each combination meets one hazard set, the sets in turn down the
  // list (--every-hazard for the whole cross, the nightly's), and --triples runs tripleSample of the 680 (--sample 0 for
  // all of them), so a default run takes minutes.
  // The grid (§34 "every hazard set"; B.10 "at every crew size"; note 204): each combination is run on every one of routes
  // with every one of crews, seeds nights a (route, crew) cell. Unwinnable is lost every night in some cell; trivial is
  // nothing landed in any night anywhere. The default is one cell, quick; wide is the nightly's (dt balance --wide): a
  // Frontier line and a Dead Lines one (its dead lines and marsh are other places to stage from), B.10's smallest and
  // largest crews, and two seeds, so an unwinnable verdict is two lost nights, not one. --routes, --crews, --seeds override.
  "combinations": {
    "routes": ["frontier:7"], "crews": [4], "seeds": 1,
    "wide": { "routes": ["frontier:7", "deadLines:2"], "crews": [2, 8], "seeds": 2 },
    "cars": 6, "seconds": 90, "tripleSample": 136, "insistEvery": 10, "leadM": 20,
    // With --at-stops (the nightly's: a stop's night costs several times a line's), a combination with something that comes
    // at a stop (the Whistler, Ribbits, the Gaunt, Followers, Soot Children, the Passenger, the Grumbler) starts approachM
    // short of the first facility's spur the crew can work (one with a crane for the Grumbler), and runs stopSeconds: time
    // to get there, cut the train and get down on the ground to load. Without, they're sent at the crew boarding from the
    // ballast at the start.
    "approachM": 350, "stopSeconds": 150,
    "unwinnableLost": 0.5, "trivialCargoLoss": 0.02,
    // GDD §34 "every pair and triple": a meeting the bots never give its chance can't be judged (note 186's "dormant"). On
    // these nights only, the last walker is the look-out (note 212): off the ballast at the start it waits up to waitSeconds
    // for what's sent at a crew on foot, then walks to within gauntM of a sleeping Gaunt (it wakes at enemies.json wakeAt 4)
    // or ribbitM of a Ribbit pack (away from the others: outnumbered), if it's within seekM; up on the roofs it stays out
    // there (not in for a bag) and stands edgeM in from the lip over a Dragger (it reaches draggers.grabRange 1.0 in). Once
    // each, then back to its post. A Moose (note 339) it walks up to mooseM of, inside its crowding, and stands gawking
    // (a curious player who won't give it room). DESIGN-TODO: first pass; a curious player, roughly.
    "look": { "waitSeconds": 12, "seekM": 80, "gauntM": 3, "ribbitM": 5, "mooseM": 10, "edgeM": 0.6 },
    // §22: "hazards remove your tools. They never change enemy rules." What each set takes away, laid over the line:
    // adhesion (wet rail; 0.75 is the generator's wettest, linegen tiers.json wetBiasAdhesion), coldStep (deep cold, added
    // to the line's), wind (gunfire carries; 1 is Deep Territory's worst night), lampsOut (§23 "lights fail": the forward
    // lamp smashed and every car's out).
    "hazardSets": [
      { "name": "clear" },
      { "name": "wet", "adhesion": 0.75 },
      { "name": "cold", "coldStep": 2, "wind": 1 },
      { "name": "dark", "lampsOut": true }
    ]
  },

  // GDD §34 "Degraded comms: agents on lossy, laggy, restricted voice — simulating people shouting over each other"
  // (dt harness --comms poor; note 186). The crew's calls (who's where, which part, "that's it, all aboard") go over this:
  // each call or repeat lost with chance loss, heard latencySeconds later (±jitterSeconds), and a new call lost with
  // chance talkOver for each other crewmate who started a call in the last talkOverSeconds. DESIGN-TODO: first pass; a
  // shouted call down a moving train, roughly.
  "comms": {
    "poor": { "loss": 0.2, "latencySeconds": 0.8, "jitterSeconds": 0.4, "talkOver": 0.25, "talkOverSeconds": 1.5 },
    "awful": { "loss": 0.45, "latencySeconds": 2.0, "jitterSeconds": 1.0, "talkOver": 0.4, "talkOverSeconds": 2.5 }
  },

  // GDD §34 "Cascade audit: no failure chain is unrecoverable" (dt audit cascades; note 186): §23's chains scripted
  // failAtSeconds into a night of crew bots on a train of cars, and the time each may take to come back. Each is well over
  // the GDD's own: the 25 s repair at the firebox (§23) plus the fetch from car 1 or car 4, the restart "40s at three cars,
  // over three minutes at twenty", a fire out before it takes the car, a fouled gun cleared (4 s at it, note 183), the
  // Stoker clubbed out before the boiler goes. The cut car: the train runs cutRunM on and sets back onto it.
  "cascades": {
    "crew": 6, "cars": 6, "failAtSeconds": 30,
    "repairWithinSeconds": 120, "restartWithinSeconds": 240, "refireWithinSeconds": 120, "fireOutWithinSeconds": 120,
    "clearedWithinSeconds": 60, "stokerWithinSeconds": 60, "recoupleWithinSeconds": 90, "cutRunM": 40
  },

  // GDD App. A.9 "every GRAB is interruptible by the crew actually present" and B.10 "at every crew size" (dt audit grabs;
  // note 186): each creature's grab at each of crews, the friends standing standOffM off, or beyondAloneM past the
  // creature's own "alone" radius where it has one (so it still takes the victim), with what players carry. The grab has to
  // begin within grabWithinSeconds of the rig being set.
  "grabs": { "crews": [2, 3, 4, 5, 6, 7, 8], "standOffM": 4, "beyondAloneM": 1, "grabWithinSeconds": 75 },

  // GDD App. F.1 (the director, 6 Oct 2026): "a solo player can finish one to three runs before it gets seriously hard and
  // they realise they need friends ... you can't really advance solo" (note 300; dt balance --crews 1). Judged on a sweep's
  // crew-of-one nights: the first runs' line and train (Systems Spec F.4 "Early": startTier, startCars) get home at least
  // startDelivered of the time; where a crew advances to (F.4 "Establishing": hardTier, hardCars) at most hardDelivered.
  // DESIGN-TODO: first pass, and the bot's a diligent solo player (it never forgets the fire); people will find it harder.
  "solo": { "startTier": "local", "startCars": 3, "startDelivered": 0.66, "hardTier": "frontier", "hardCars": 6, "hardDelivered": 0.34 },

  // The orchestrator's pacing targets (docs/design/orchestrator.md §4; ARCHITECTURE §8 note 379), first pass, advisory: flagged
  // in the report, never failing the sweep, until the director sets them. P1: no crewmate spends more than slackOverSeconds
  // a night at or past the census's slackPress (enemies.json director.orchestrator; note 345), on the run between stops. P3:
  // something engaged for engaged[0]..engaged[1] of the night out on the line (1 - the harness's pacing quietShare).
  "pacing": { "advisory": true, "slackOverSeconds": 30, "engaged": [0.45, 0.60] }
}
