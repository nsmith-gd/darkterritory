// What's found at a stop (level-design P2, P12, P14). The layout (stops.json) places containers, each of a kind, and
// never items: at the start of a run the economy fills them from these tables and the run's seed. First pass; not in
// the spec.
{
  // Yard containers become things you load: a crate stack is cargo crates to carry into a car, a crane bay a casting
  // for a crane to lift onto one, a strongroom a heavy crate that needs two (facilities.json). They pay as cargo does
  // (spec F.1), so they carry no value here.
  "yard": {
    "crateStack": { "crates": [1, 2] },
    "craneBay": { "castings": 1 },
    "strongroom": { "heavy": 1 }
  },

  // When a stop's loot comes out (ARCHITECTURE §8 note 352). The director, 8 Oct 2026: "[I] watched the loot spawn in the
  // yard after I'd already stopped the train." It's out once the engine is on the main line within this many metres of the
  // stop's zone, whatever its speed: further than enemies.json interestRadius (520), the furthest a client is sent a body
  // from, and the lamp and the fog, so nobody sees it appear. A facility's own crates (facilities.json) come out with it.
  // 0: when the train first stops there (the old rule). Stops passed at speed keep theirs lying out, asleep and unsent.
  "stockAhead": 800,

  // Village finds are small things a player carries aboard by hand, and they pay on the spot (GDD §19's medicine,
  // tools and treats).
  // Note 718 (queue #452; the director, 14 Oct 2026: "I don't want to have a price shown on every single thing that we find.
  // I want players to eventually understand that certain objects are more valuable than others, and that as they play the
  // game more often, they learn what those objects are"): a find is worth what its kind is worth, always, never a share of a
  // stop's budget split by its container (which made a box of candles and a pocket watch from the same cupboard worth the
  // same, and either worth something different at the next stop). `worth` is each kind's, in the tier's value per car
  // (run.json economy.perCar), rounded to fives: on a frontier night (900) candles 20, a pocket watch 110, a comet fragment
  // 1,080. The commonest are cheapest; what a cabinet or the boards keep one time in several is worth four or five boxes of
  // candles. Nothing shows a price: the clerk's tally names the night's best finds with what they paid (`tally`), so a crew
  // learns over nights what's worth carrying. Sized so a night's village finds come to about what the old budgets dealt
  // (about 3 car-loads' worth a frontier night; the deep tiers' with `findsByTier`).
  "worth": {
    "candles": 0.025, "treats": 0.035, "tinnedFood": 0.04, "preserves": 0.05, "rope": 0.05, "lampParts": 0.05,
    "tools": 0.06, "lampOil": 0.06, "bandages": 0.07, "medicine": 0.1, "valuableTools": 0.1, "pocketWatch": 0.12,
    "morphine": 0.14,
    // A comet fragment (`comet`): more than a car-load of goods in one pair of arms. (The trophies' are in `trophies`.)
    "cometFragment": 1.2
  },
  // The village finds' `worth` times this on a tier's nights (unlisted: 1): the deep tiers' villages are fewer and their houses
  // keep worthier things, so a night's finds there come to what the old budgets dealt (about 2 and 3 car-loads a night).
  "findsByTier": { "deadLines": 1.3, "deepTerritory": 1.75 },
  // Level-design P11, an outlier house keeps better things: its container's find is drawn twice and the worthier kept (on a
  // stream of its own, so every other find a seed deals is as it was). Note 718: it used to draw this many times more of
  // the stop's budget.
  "outlierDraws": 2,
  // Note 738 (B4; the director, 14 Oct: "smaller bits of loot"): the small things lying on a village's floors
  // (stops.json village.loose, `kinds.loose`) are finds like any other, worth what their kind is (note 718), on top of the
  // village's kept finds. Taken at once: they aren't searched.
  // Stowed: lying still inside any car for this long.
  "settleSeconds": 1.0,
  "radius": 0.15,
  // GDD v1.4 App. E.12 question 4, answered: repair kits turn up as loot, not just in the fortress's stores. Each container
  // at a stop (a village's cupboards and cellars, a yard's crate stacks and strongroom) has this chance of a kit lying
  // beside what it holds: rare, about one a night on a long line. Brought home, a found kit is kept as a spare.
  // Note 301: where the wrench is the repair tool (train.json repair.wrench), no kit is found: this is read as 0.
  "repairKitChance": 0.03,
  // Note 267 (the director's notes on build 1121: the guard van's toys "are things that we should definitely find out in
  // the world"): GDD §19's hand-carried loot, found at the stops, not stocked from the fortress. Each village container of
  // these kinds has this chance of a toy lying with what it holds (rolled on its own stream, so the finds are the same
  // with or without), and each toy is drawn from `noises`: GDD v1.4 App. C item 4's quiet ones and its squeaker, music box
  // and wind-up drummer, which feed the loudness meter while carried (combat.json choir.toys). Not in the GDD's numbers:
  // about two a village, so most nights have a toy for the Track Doll by the second stop.
  "toys": {
    "chance": 0.4,
    "kinds": ["cupboard", "cellar", "hayloft", "underFloor"],
    "noises": ["none", "none", "squeaker", "musicBox", "drummer"]
  },

  // Searching an open house (GDD App. F.3, "searchable for finds"; level-design P14 "hiding spots ... that take time to
  // search"; ARCHITECTURE §8 note 326): what a plain village house keeps in a cupboard, a cabinet, its cellar or under its
  // boards (and a toy with it) isn't there to see until a crewmate on foot, empty-handed and within `reach` of the spot,
  // holds Use there for that kind's `seconds`; let go and it starts again. A shut house's finds stay out on its step. An
  // open barn's hayloft (up the ladder, through the hay) and an open shed's workbench (its drawers, its tool rack) are
  // searched the same way (note 417). Not in the spec's numbers: a cupboard or a cabinet is opened and
  // gone through, a cellar's hatch lifted and the steps gone down, boards prised up one by one; a house's few spots take a
  // crewmate about ten seconds, a village a few minutes alone, which is what splitting up buys back. Unset, no search:
  // the finds lie out.
  "search": {
    "reach": 1.0,
    "seconds": { "cupboard": 2.5, "cabinet": 2, "cellar": 4, "underFloor": 5, "hayloft": 4, "bench": 2.5 }
  },

  // The damage model (the director's decision of 6 Oct 2026, GDD App. F.1; ARCHITECTURE §8 note 272): "Healing items are
  // rare loot." A find in `heals` is used, not just sold: carried, with Use held standing for useSeconds (a tap still puts
  // it down), it gives its carrier that much health back, up to full (player.json health), and it's gone, its scrip with
  // it. A bot uses one it's carrying below botBelow. Not in the spec's numbers: a bandage is about a hit (enemies.json
  // damage), medicine more, morphine near the whole bar.
  "healing": {
    "useSeconds": 2,
    "heals": { "bandages": 30, "medicine": 50, "morphine": 80 },
    "botBelow": 50
  },

  // What each kind of container can hold (drawn evenly from the list, so an item named twice is twice as likely). Note 718:
  // what it's worth is the item's (`worth`), not a share of the stop's budget by the container's weight. Note 272 ("healing
  // items are rare loot"): a cabinet was all medicine, bandages and morphine and a floor's cache a third medicine, about six
  // on a frontier night, a quarter of every find. Now a cabinet holds them one time in four, bandages the likeliest, and
  // nothing else does: about one a frontier night (the DamageModelTests pin it). Note 593, with about twice the village
  // finds: one cabinet in eight (6 of its 48), so still about one a frontier night.
  "kinds": {
    "cupboard":   { "items": ["treats", "tinnedFood", "candles"] },
    "cabinet":    { "items": ["bandages", "bandages", "bandages", "medicine", "medicine", "morphine", "candles", "candles",
      "candles", "candles", "candles", "candles", "candles", "candles", "candles", "candles", "lampOil",
      "lampOil", "lampOil", "lampOil", "lampOil", "lampOil", "lampOil", "lampOil", "pocketWatch",
      "pocketWatch", "pocketWatch", "pocketWatch", "pocketWatch", "pocketWatch", "treats", "treats",
      "treats", "treats", "treats", "treats", "treats", "treats", "tinnedFood", "tinnedFood", "tinnedFood",
      "tinnedFood", "rope", "rope", "rope", "rope", "lampParts", "lampParts"] },
    "cellar":     { "items": ["preserves", "treats", "tools"] },
    "underFloor": { "items": ["valuableTools", "pocketWatch", "preserves"] },
    "bench":      { "items": ["tools", "lampParts"] },
    "hayloft":    { "items": ["tools", "lampOil", "rope"] },
    "loose":      { "items": ["candles", "candles", "treats", "tinnedFood", "lampOil"] }
  },

  // A creature's trophy when it's killed (note 340; the director, 7 Oct 2026: "a dead Gannet can be worth a good deal"):
  // the find it drops where it falls, what it pays stowed aboard (in the tier's car-loads, run.json economy.perCar; a
  // rescued child pays 3), and the chance it's left (unset: always).
  // Note 718 (queue #452; the director, 14 Oct 2026: team-killable creatures "can sometimes leave trophies"): every creature
  // the crew can kill together (enemies.json coordinatedKill) has one, left about one kill in three, a piece of it a crew
  // would want to show the town: the Grumbler's jaw, the Gaunt's long hand, a Climber's claw, the Passenger's cap with its
  // dead railway's badge, the Brakeman's brake wheel, a Knotter's claw, a Hotbox's plate, the Freight Beetle's shovel head,
  // Tower Jaw's tooth. The Choir's ghosts leave nothing (there's no body). Those that come several to a night (a pack's
  // Climbers, a Knotter, a Hotbox) are worth less each. Keyed by the kind's tuning name (enemies.json). The Gannet's head
  // stays as it was, every time: one bird, rare, at speed, the director's "good deal".
  "trophies": {
    "gannet": { "item": "gannetHead", "perCar": 1.5 },
    "grumbler": { "item": "grumblerJaw", "perCar": 0.4, "chance": 0.35 },
    "gaunt": { "item": "gauntHand", "perCar": 0.6, "chance": 0.35 },
    "climbers": { "item": "climberClaw", "perCar": 0.15, "chance": 0.25 },
    "passenger": { "item": "passengerCap", "perCar": 0.5, "chance": 0.35 },
    "brakeman": { "item": "brakemanWheel", "perCar": 0.5, "chance": 0.35 },
    "knotter": { "item": "knotterClaw", "perCar": 0.25, "chance": 0.35 },
    "hotbox": { "item": "hotboxPlate", "perCar": 0.25, "chance": 0.35 },
    "freightBeetle": { "item": "beetleShovel", "perCar": 0.35, "chance": 0.35 },
    "towerJaw": { "item": "towerJawTooth", "perCar": 0.4, "chance": 0.35 }
  },

  // Note 718 (queue #452; the director, 14 Oct 2026: comet cargo "needs to be at actual stops and needs to be extra valuable
  // loot that players get excited for when they see"): on some nights a stop holds a comet fragment or two, lumps of the
  // comet glowing a sick green in the dark (GDD §19), lying out in the open beside the stop's other things (a yard's crate
  // stack or strongroom where it stands; outside a shed or a house, off its side nearest the line), with no building between
  // it and the main line, so a crew sees them as the train comes in. Each stop's chance by tier (deeper is likelier: about
  // one local night in six has one, two frontier nights in five, most deep nights), and how many when it does. One person
  // carries one; it pays worth.cometFragment (more than a car of goods, five times any find), and while one's aboard (lying
  // in a car on the engine, or in the hands of someone aboard) the comet's director weights are on (enemies.json
  // cargoWeights.comet, cometRelaxesGates: "attracts everything").
  "comet": {
    "item": "cometFragment",
    "chance": { "local": 0.06, "frontier": 0.1, "deadLines": 0.15, "deepTerritory": 0.22 },
    "count": [1, 2]
  },

  // Note 718: the clerk's tally (GDD §9) names the night's best finds by what they're worth, this many kinds of them, and the
  // crewmate who brought the most worth aboard ("Light fingers"; the wallet stays shared, §11).
  "tally": { "best": 3, "finder": true },

  // Names for the HUD.
  "items": {
    "treats": "Treats", "tinnedFood": "Tinned food", "candles": "Candles", "medicine": "Medicine", "bandages": "Bandages",
    "morphine": "Morphine", "preserves": "Preserves", "tools": "Tools", "valuableTools": "Valuable tools",
    "pocketWatch": "Pocket watch", "lampParts": "Lamp parts", "lampOil": "Lamp oil", "rope": "Rope",
    "gannetHead": "The Gannet's head", "cometFragment": "Comet fragment", "grumblerJaw": "The Grumbler's jaw",
    "gauntHand": "The Gaunt's hand", "climberClaw": "A Climber's claw", "passengerCap": "The Passenger's cap",
    "brakemanWheel": "The Brakeman's wheel", "knotterClaw": "A Knotter's claw", "hotboxPlate": "A Hotbox plate",
    "beetleShovel": "The Beetle's shovel", "towerJawTooth": "Tower Jaw's tooth"
  }
}
