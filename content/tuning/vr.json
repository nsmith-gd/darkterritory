// VR controls and comfort (roadmap M4). Not in the GDD or the spec: these are defaults a player changes in settings,
// picked from what headset players expect (snap turn and a locomotion vignette on by default, both switchable).
{
  // "snap" turns in steps (the comfortable default), "smooth" turns continuously.
  "turn": "snap",
  "snapDegrees": 45,
  "smoothDegreesPerSecond": 120,
  // Snap once the right stick is pushed past `snapEngage`; it has to come back inside `snapRelease` to snap again.
  "snapEngage": 0.7,
  "snapRelease": 0.35,
  // Stick travel ignored at the centre (worn sticks drift).
  "stickDeadzone": 0.2,

  // Darkens the edge of view while the stick moves you: artificial motion is what makes people sick, and the
  // periphery is where it's felt. The train carrying you isn't artificial (you're riding it), so it doesn't count.
  "vignette": {
    "enabled": true,
    // How dark the edge gets (0..1) at full stick walking, at full smooth turn, and for a moment on a snap.
    "moving": 0.55,
    "turning": 0.8,
    "snap": 0.9,
    // The clear middle, as a fraction of the eye's half-size.
    "inner": 0.5,
    // Seconds to close in, and to open up again.
    "riseSeconds": 0.12,
    "fallSeconds": 0.35
  },

  // The HUD and the menus in the headset (T36): the flat screen's own drawing, on a panel floating `distance` metres
  // ahead of the head, `width` metres across and `drop` below the eyes. It moves with the head, but only turns once
  // the head's looked `followDegrees` off it, then eases round over about `followSeconds`: a panel pinned to the face
  // makes people sick, one that waits can be glanced at. The HUD's is lower and nearer; the menus' is straight ahead.
  "hud": {
    "distance": 1.6,
    "width": 1.8,
    "drop": 0.2,
    "followDegrees": 25,
    "followSeconds": 0.4
  },
  "menu": {
    "distance": 2.0,
    "width": 2.0,
    "drop": 0.0,
    "followDegrees": 35,
    "followSeconds": 0.6
  },

  // A headset player's body as the rest of the crew see it (T82, roadmap M4 "VR body IK"; ARCHITECTURE §8 note 208). Not
  // in the GDD or the spec (note 40): our reading, from how people stand and shift. It's drawn from what the snapshot
  // already has (the head's yaw and pitch, the hands) and the head's height over the feet, which rides with the hands.
  "body": {
    // A head up to `leanDrop` m under standing height (Eyes.Height, where the headset's room hangs from) leans the torso
    // over from the hips, `leanDegrees` at most; past it the knees bend, the hips going down by the rest, `crouchMost` m at most.
    "leanDrop": 0.25,
    "leanDegrees": 35,
    "crouchMost": 0.5,
    // The head turns `yawDeadzoneDegrees` from the hips before the hips come round after it; the torso takes `twistShare`
    // of the turn between them, the neck the rest. The neck tips the head to the headset's pitch, `nodDegrees` at most.
    "yawDeadzoneDegrees": 35,
    "twistShare": 0.6,
    "nodDegrees": 50,
    // The feet stand `stanceHalfWidth` m either side of the hips and stay planted until the hips have moved a foot's place
    // `stepDistance` m off it, or turned `stepTurnDegrees` from it; then it steps (one foot at a time), in `stepSeconds`,
    // lifted `stepHeight` m at the middle, landing `stepOvershoot` of the step past its place so slow hips aren't chased.
    "stanceHalfWidth": 0.12,
    "stepDistance": 0.2,
    "stepTurnDegrees": 30,
    "stepSeconds": 0.28,
    "stepHeight": 0.09,
    "stepOvershoot": 0.25
  }
}
