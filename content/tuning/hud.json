// The flat-screen HUD's timings and thresholds (GDD §32 "The HUD: your hands and the dark"; ARCHITECTURE §8 note 285).
// The director, 7 Oct: "There's too much UI on screen. I like the way Repo and Lethal Company do their UI/UX designs."
// Only the crosshair and your hands are always there; everything else comes up when it matters and fades when it doesn't.
// Not in the systems spec: these are presentation, not rules.
{
  // How long anything that comes and goes takes to fade in or out (s).
  "fadeSeconds": 0.35,

  // After you change what's in your hand, how long its name stays over the hotbar (s), as Lethal Company's slots do.
  "toolNameSeconds": 1.6,

  // A place coming up (a stop, a junction, a bridge): its name fades in at the top of the screen once the train is this
  // close to it (m), and stays this long (s). The route card (C) has the whole night, with where you are on it.
  "placeAheadMetres": 1200,
  "placeSeconds": 4.5,

  // Going out into a deeper step of the cold (GDD §22, note 201): its line, for this long (s). Getting chilled says how
  // long you've got for as long as it lasts.
  "coldSeconds": 5,

  // The dawn clock (GDD §11) comes up at the top of the screen in the night's last stretch (s before dawn), as Lethal
  // Company's clock does when it matters. Before that, the route card has it.
  "dawnClockSeconds": 600,

  // Spec E: ping is shown prominently in the lobby (the yard). Out on the line, only once it's this bad (ms), or lost.
  "pingWarnMs": 150,

  // The link's loss (note 534; netcode-audit.md gap 3): the share of the host's snapshots (a joiner's) or a crewmate's
  // inputs (the host's lobby panel) lost or stale over the last this many seconds. Under lossGood it's fine (good ink);
  // at lossWarn it's bad (danger ink), and shown out on the line as a bad ping is; between, a warning.
  "lossWindowSeconds": 10,
  "lossGood": 0.02,
  "lossWarn": 0.08,

  // The crew's noise meter (T113) shows once the crew's this loud, as a share of the Choir's threshold, or the Choir's
  // gathering or here; quiet, it's gone.
  "noiseShowAt": 0.5,

  // The colours that mean something (note 348; GDD §32 "Accessibility"), sRGB 0..1: good (heard, a good ping, a rescue),
  // a warning (a heading, a ping going bad, a bend to slow for) and danger (dead, a grab, an alarm). The settings' COLOURS
  // picks the palette. Standard is as the game was drawn: its good and warning are 15 apart (CIELAB) to a protanope, where
  // under 20 reads as one colour. Colourblind keeps every pair 40 or more apart under protanopia, deuteranopia and
  // tritanopia (Machado 2009, full severity): HudPaletteTests holds it there.
  "standard": { "good": [0.55, 0.82, 0.45], "warn": [1.00, 0.70, 0.30], "danger": [0.95, 0.26, 0.18] },
  "colourblind": { "good": [0.40, 0.75, 1.00], "warn": [0.98, 0.85, 0.25], "danger": [0.80, 0.25, 0.15] },

  // TEXT BACKING (note 404; GDD §32 "Accessibility"), a setting off by default: a black band this opaque (0..1) behind the
  // HUD's print in play, a line at a time, as a subtitle's background. Dark enough that the cream print reads over a car
  // fire's glare and the fog's brightest; light enough that the night still shows through.
  "textBacking": 0.6
}
