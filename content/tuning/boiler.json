// Boiler, firebox and tender. Source: systems spec B.6 (and B.5 rebuild times at a standstill).
// The model: coal in the firebox burns at (coal / fireTimeConstant) x draft, each unit burned
// raises pressure by steamPerUnit, and the train draws steam for the cylinders (throttle), for
// auxiliaries, and for heating every car. Draft comes from the exhaust, so a standing engine's
// fire burns slower: that is why rebuilding pressure at a stop is slow, and slower for long trains.
// These constants are fitted so the spec's own tables fall out; `dt boiler table` shows the result.
{
  "pressureMax": 100,
  "workingBandMin": 60,
  "workingBandMax": 90,
  "redline": 95,
  // Spec B.6: rupture at 100 held for 20 s.
  "ruptureHoldSeconds": 20,
  // Not in the spec: a safety valve lifts at the redline and sheds up to this much pressure per second, and the lifting
  // valve is itself a loud tell. T109 playtest ("if I red line for too long the boiler should rupture"): at 2.5 it shed
  // whatever any fire could make, and nothing but the Stoker ever reached 100. At 0.6 a hot fire beats it: in the red,
  // vent (or let the fire burn down), or the gauge climbs to 100 and the spec's 20 s there ruptures it.
  "safetyValveLift": 95,
  "safetyValveCapacity": 0.6,
  // Tractive effort fades out below workingBandMin and is gone at this pressure.
  "powerFloor": 20,
  // GDD §22 deep cold (note 183): each cold step where the engine is takes coldEfficiencyPerStep off what a shovelful makes,
  // to no less than coldEfficiencyFloor.
  "coldEfficiencyPerStep": 0.06,
  "coldEfficiencyFloor": 0.7,

  "tenderCapacity": 400,
  "fireboxCapacity": 6,
  "shovelSeconds": 1.2,
  // App. C.2 "the boiler player's shovel doubling as the crew's best club is intended tension", GDD §12 (note 191): coal
  // goes on with the shovel in hand. There's the one, on the cab's tool rack beside the wrench; Use at the firebox takes it
  // into hand (from your kit, or off the rack if it's there), and Use at the rack with it in hand hangs it back. Taken out
  // to fight with, the fire waits. False: coal goes on by hand, as before.
  "shovelInHand": true,

  "fireTimeConstant": 30,
  // Draft with the regulator shut (blower only), as a fraction of working draft.
  "idleDraft": 0.6,
  "steamPerUnit": 15,
  "auxiliaryDrain": 0.05,
  "heatingPerCar": 0.0675,
  "fullThrottleDemand": 0.5,

  // Holding the vent valve open dumps pressure at this rate. T97: it's how the crew slows the train (steam sets the
  // speed). T109 playtest: in the cab, on its left side, so one player can drive it all from the footplate.
  "ventRate": 12,
  // T109: a rupture (spec B.6, GDD §23) seizes the cylinders: the train sheds speed at ruptureDecel (m/s²) down to
  // ruptureCoastBelow (m/s), then coasts, to a stop unless braked. The repair kit (GDD §12; train.json kit, it rides in
  // car 1) held at the firebox for repairSeconds makes the boiler good again, cold and empty: fire it back up from nothing.
  "ruptureDecel": 1.5,
  "ruptureCoastBelow": 4,
  "repairSeconds": 25,
  // T97 playtest: no regulator. Pressure sets the speed the engine can make: none at powerFloor, the line's top speed at
  // safetyValveLift. Coal for more speed, the vent (or the brake) for less. The engine pulls at full effort until it's
  // within driveSpeedBand m/s of that speed. Its cylinders draw with the effort of pulling away or with speed, whichever
  // is more, drawing fullThrottleDemand from fullDemandAt of top speed: running flat out is the spec's "full throttle".
  "steamDrive": true,
  "driveSpeedBand": 3,
  "fullDemandAt": 0.85,
  // Firebox below this fraction of capacity counts as a low fire (Hollow's trigger, GDD App. A.5).
  "lowFireFraction": 0.2,
  "startPressure": 75,
  "startFirebox": 4
}
