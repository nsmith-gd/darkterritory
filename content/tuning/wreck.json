// The derailment (T117 playtest: "a derailment needs to be a full on dramatic cinematic derailment ... the full physics
// carnage"): the moment a train comes off the rails every car is a rigid box on its own, carrying what it had (GDD §23
// "loud, spectacular, run-changing"). They plough into the ground, drag and snap their couplings, jackknife and roll, and
// pile into each other, until they lie still. Host-simulated; clients are sent the poses. Numbers are a first pass, tuned
// by eye on `dt screenshot --wreck` and `dt wreck`.
{
  // Steps of the wreck per sim tick (contacts at 30 Hz are too coarse for a car digging in).
  "substeps": 6,
  "gravity": 9.81,
  // Ground contact: bounce, and friction (steel dragged through ballast and earth; a car on its side slides less far).
  "restitution": 0.12,
  "friction": 0.8,
  // ... but a car still upright dragged sideways digs its bogies in, and trips over them (this, not the kick, rolls a car
  // that came off on the straight).
  "digIn": 1.0,
  // Car against car.
  "carRestitution": 0.08,
  "carFriction": 0.35,
  // A coupling holds this much slack, then pulls; it snaps once a single pull takes more than this (tonne-metres per second,
  // the impulse). High, so the leading cars drag the rest round before they part.
  "couplingSlack": 0.4,
  "couplingBreak": 320,
  // The car that comes off first is thrown off its curve: sideways at this share of its speed, slewing and rolling outward.
  "kickLateral": 0.3,
  "kickYaw": 0.9,
  "kickRoll": 1.6,
  // The rest come off one after another down the train, this many seconds apart: until then each rolls on, held to the
  // rails (with this rolling friction), and shoves into the cars ploughing ahead of it. That's what buckles the train.
  "dropInterval": 0.3,
  "rollingFriction": 0.03,
  // As its wheels drop each car jostles: a little sideways each way.
  "jostle": 0.35,
  // ... and slew (rad/s), so the cars behind, still pushing, fold the train about them: it buckles.
  "jostleYaw": 1.5,
  // The first seconds play slowed (the cinematic beat), then real time.
  "slowSeconds": 2.5,
  "slowRate": 0.35,
  // Done when every car's under this (m/s and rad/s) for settleHold seconds, or after maxSeconds whatever.
  "settleSpeed": 0.25,
  "settleHold": 1.5,
  "maxSeconds": 30,
  // Presentation (T121 playtest: "let people experience it first hand, then replay the moment from the third person train
  // view"): firstPersonSeconds in your own eyes riding the wreck; then replaySeconds of the chase view replaying it from
  // replayLeadSeconds before it came off; then cinematicSeconds of the camera circling the wreck. The run's end waits.
  // With a film, the first person is each player's own, up to and through their death (film.firstPerson*, below); this is
  // its length only while the film's still being shot, or without one.
  "firstPersonSeconds": 4,
  // GDD v1.4 App. D.12, E.5 ("each player's peak frame is captured as their auto-bookmark"): the build's per-player shot is the
  // first-person beat, so each crew member's still is taken this far into it, from their eye in the car they rode. Not in the
  // GDD; by eye on `dt screenshot --wreck`, where the cars are well over by 2 s.
  "bookmarkSeconds": 2,
  "replaySeconds": 9,
  "replayLeadSeconds": 3,
  "cinematicSeconds": 8,
  // GDD v1.4 App. E.6, the opera (content/audio/music): it starts on the replay's first frame, its hit on the replay's moment
  // of derailment (replayLeadSeconds in), and plays through the orbit. The host draws it from the shuffle bag, weighted by
  // the derail's speed: under lamentBelow (8 m/s) Lament tracks weigh `favoured`, over gallopAbove (16 m/s) Gallop and
  // Doom do, Swagger always weighs `swagger` (it "fits any derail"), anything else 1 (E.10's thresholds). The weighting
  // never overrides the bag's no-repeat rules. It fades out over fadeOutSeconds (E.6: "at most 1.5s") to the sequence's end.
  "music": { "lamentBelow": 8, "gallopAbove": 16, "favoured": 3, "swagger": 2, "fadeOutSeconds": 1.5 },
  // GDD v1.4 App. E.9, the Stranded outro (nobody died, so no opera): 1.5 s on the empty engineering-kit rack, then 6 s pulling
  // up and back over the stopped train to a high wide as its lamps go out one by one, the last car first and the engine last,
  // with the clerk on the radio. heightM and backM: where the wide ends, over and out from the middle of the train. From
  // skipAfterSeconds in, a majority (or the host) can skip it (E.9, E.10).
  "stranded": { "rackSeconds": 1.5, "pullBackSeconds": 6, "heightM": 42, "backM": 55, "skipAfterSeconds": 3 },
  // GDD v1.4 App. E.3-E.5 and E.10, the derailment film (note 177): after the first person and the replay, everyone's own
  // death. The host sends the wreck's start and the crew as they were; every client pre-simulates it (seconds, substeps)
  // with the crew ragdolled and flung (velocity × fling, an upward kick of kickMin-kickMax, a tumble up to spin rad/s,
  // capped at ejectCap; under minKickSpeed a tip-over throws them sideways anyway; a bystander further than bystander m from
  // every car gets nothing) and cuts it the same way: one shot each (shotSeconds, shrinking to fit shotCap, never under
  // shotMin) at baseSlow easing to peakSlow at their peak, the biggest flight last, then the settle and the cause card.
  // (freezeSeconds and establishingSeconds are E.5's first beats, which the first person and the replay stand in for.)
  // The director's calls of 5 Oct 2026 (notes 257, 258), inside E.10's ranges: a bigger fling (x1.0-2.0), kick (0-6 m/s)
  // and spin (0-8 rad/s; drawn from spinMin to spin), so nobody's upright at their peak unless something holds them; the
  // gunner in the gun's seat is thrown out of it with seatKick (m/s up, E.10's top kick), head over heels at the full spin,
  // from seatClear m back off the gun.
  // Each crewmate dies on their first hit of impactSpeed or more (m/s taken off their body inside one recorded frame by the
  // ground or a car), or crushed under a car (App. E.2 step 1, the director's decision); every hit of thudSpeed or more,
  // thudGap s apart, is a landing with a thud. Their first person plays the recording at firstPersonRate to firstPersonAfter
  // s past that death (firstPersonMin-firstPersonMax s in all), and the host kills them as it lands there.
  // Take 3 (the director, 5 Oct 2026): alive till the hit that kills them, braced (muscle: the brace's stiffness; reach: the
  // hands going out to meet what's coming), they take surviveHits hits before one of impactSpeed kills them; one of
  // certainDeathSpeed, or being crushed, kills at once; past giveUpSeconds of the recording, hits survived, any hit kills,
  // and after mostHits survived the next one kills whatever it is (never killed, they died in their last hit).
  // At the hit they go limp. Each player's shot is 4 s (shotSeconds and shotMin, the cap 8 of them), the throw into the
  // death and the limp aftermath; the first person runs firstPersonAfter (3.8) s past your own death, the eyes going limp
  // with the body (firstPersonMin-firstPersonMax: 4.5-9 s, the take-2 window plus 3), at firstPersonRate.
  // A player's shot shows the throw into their death and a little after (baseSlow 0.4x easing to peakSlow 0.15x, inside
  // E.10's 0.1-0.5x and 0.05-0.25x; E.5 had 0.25x and 0.1x, too little of the throw in 2 s), framed at shotFill of the
  // frame's height (E.4 O6: 25-60%), its field of view fovMin-fovMax degrees.
  "film": {
    "seconds": 6, "substeps": 4, "fling": 1.6, "kickMin": 3, "kickMax": 5, "spin": 7, "spinMin": 3.5, "ejectCap": 30, "minKickSpeed": 6,
    "bystander": 25, "baseSlow": 0.4, "peakSlow": 0.15, "freezeSeconds": 0.4, "establishingSeconds": 3, "shotSeconds": 4,
    "shotMin": 4, "shotCap": 32, "settleSeconds": 3, "causeSeconds": 2, "cameraRadius": 0.3, "minDistance": 2.5,
    "lensClearance": 1.5, "simRadius": 300,
    "seatKick": 6, "seatClear": 0.25, "surviveHits": 2, "mostHits": 3, "certainDeathSpeed": 16, "giveUpSeconds": 2.4, "muscle": 0.25, "reach": 0.03,
    "impactSpeed": 6, "thudSpeed": 2, "thudGap": 0.25,
    "firstPersonRate": 0.5, "firstPersonAfter": 3.8, "firstPersonMin": 4.5, "firstPersonMax": 9,
    "shotFill": 0.45, "fovMin": 22, "fovMax": 60
  }
}
