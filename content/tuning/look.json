// The art pass (GDD §25-28; the art & animation pipeline plan): how surfaces are finished, how the frame is graded, and
// the night's light and air. Each palette colour (Palette.cs) is a material: the texture it wears (content/art/textures,
// built by tools/art/textures.py), how much of the shader's own grime shows over it (broad soot fields and streaks
// running down, which also break up the tiling), and how hard a specular it throws back when untextured. A colour
// that's been tinted or dimmed takes the nearest material, the texture tinted by the difference.
// "If it looks like a pristine Substance demo, it is off target." (§27)
{
  // §27's texture density for the shader's grain: environment 128-256 px/m. One grain is one texel.
  "texelsPerMetre": 128,
  // Each material map's size on the GPU: the library's 512 (the 2008-2012 target, ARCHITECTURE §8 note 57).
  "layerSize": 512,
  // The bottoms of things are this much darker: the baked shadow, and the soot and wet that collect low.
  "baked": 0.35,
  // Each crewmate's helm and scarf are painted their own colour (by player id, in turn), so eight masked heads can still
  // be told apart on a roof: multipliers over the helm's pale neutral paint (tools/models/crewfigure.py).
  "crewColours": [
    [1.35, 0.36, 0.26], [0.3, 0.55, 1.75], [1.35, 1.05, 0.3], [0.25, 1.1, 1.15],
    [0.45, 1.15, 0.32], [1.1, 0.38, 1.35], [1.45, 0.62, 0.2], [1.05, 1.05, 1.05]
  ],
  // §27's material families. The kit's own pieces (the train, the track, the world) name their textures directly; these
  // are for everything still drawn as coloured boxes.
  "materials": {
    // Iron and steel: dark, oily, cold. The one surface with a harsh specular (§25).
    "IronGrey": { "wear": 0.6, "shine": 0.35, "texture": "iron_plate" },
    "SootBlack": { "wear": 0.4, "shine": 0.25, "texture": "iron_smokebox" },
    "Charcoal": { "wear": 0.5, "shine": 0.15, "texture": "stone_block", "tile": 2.5 },
    "GreaseSheen": { "wear": 0.3, "shine": 0.6, "texture": "tar" },
    // Brass and copper: muted warm metal, tarnished.
    "TarnishedBrass": { "wear": 0.4, "shine": 0.7, "texture": "brass" },
    // Painted metal: chipped, faded, practical.
    "RustRed": { "wear": 0.8, "shine": 0.05, "texture": "paint_oxide" },
    "BlueGrey": { "wear": 0.6, "shine": 0.1, "texture": "concrete_stain" },
    // Wood: dark, worn, rough grain.
    "DeepBrown": { "wear": 0.7, "shine": 0, "texture": "wood_sleeper" },
    "MuddyOlive": { "wear": 0.8, "shine": 0, "texture": "ground_grass", "tile": 3 },
    // The ground and what grows on it.
    "Ballast": { "wear": 0.6, "shine": 0, "texture": "ballast", "tile": 1.5 },
    "PineDark": { "wear": 0.5, "shine": 0, "texture": "pine_bark", "tile": 2 },
    // Flesh and corruption: waxy, bruised, damp. A dull sheen.
    "Corrupted": { "wear": 0.5, "shine": 0.2, "texture": "flesh" },
    // Light sources stay clean.
    "LampAmber": { "wear": 0, "shine": 0 },
    "FurnaceOrange": { "wear": 0, "shine": 0 },
    "SignalGreen": { "wear": 0, "shine": 0 },
    "SignalRed": { "wear": 0, "shine": 0 }
  },
  // The colour script as a grade (pipeline: "colour grade via 16^3 LUT"), display values in and out: shadows pushed
  // cold and lifted a touch off black (so the dark still reads, §32), highlights warm for the practical light, the
  // whole frame desaturated toward the sheet's palette.
  "grade": {
    "lift": [0.012, 0.016, 0.024],
    "gamma": [1.0, 1.0, 1.02],
    "gain": [1.0, 0.97, 0.92],
    "saturation": 0.78,
    "contrast": 1.1,
    "shadowTint": [0.92, 0.98, 1.1],
    "highlightTint": [1.08, 1.0, 0.86]
  },
  // The post stack, in the pipeline's order: bloom (half-res, one threshold, two blurs), grade, vignette, grain, then
  // ordered dither into a reduced colour depth. "ps2": true is the debug era mode for art-direction comparison.
  "post": {
    "bloomThreshold": 0.55,
    "bloomStrength": 0.7,
    "vignette": 0.42,
    "grain": 0.025,
    "colourLevels": 48,
    "ps2": false,
    "texturedWear": 0.45,
    "backdropFog": 0.1,
    "horizonGlow": 1.35,
    "backdropDegrees": 32,
    "skyZenith": [0.016, 0.018, 0.026],
    // Filtered materials, sharp at a distance (the PS2 comparison mode keeps its own positive bias, for the crawl).
    "mipBias": 0,
    // The filmic tonemap's exposure; the wide bloom's share of the glow; lens fringing toward the corners.
    "exposure": 1.0,
    "wideBloom": 0.5,
    "lensFringe": 0.006
  },
  // The night's light and air (§28: "cool ambient night, deep shadow pockets, headlamp and lantern cones").
  "atmosphere": {
    // Height fog: lies thick in the low ground and the valleys under bridges, thins going up, never goes.
    "fogHeightFalloff": 0.06,
    "fogFloor": 0.45,
    // Clearer near, thicker far, the same at the weather's 1/e distance (ARCHITECTURE §8).
    "fogCurve": 1.45,
    // Lighter and bluer than the ground: far things go pale into it, near things stay black (the sheet's depth).
    "fogColour": [0.085, 0.095, 0.115],
    "moonDirection": [-0.55, 0.32, -0.6],
    "moonColour": [0.5, 0.58, 0.76],
    "moonStrength": 0.7,
    "ambient": 0.1,
    "lampColour": [1.0, 0.74, 0.42],
    "lampIntensity": 3.2
  },
  // The consist's wear and tear (pipeline plan, consist kit: "3 damage states per car; scars persist between runs").
  // Read off each car's integrity, which the campaign keeps, so a car comes back scarred where it was (ARCHITECTURE §8).
  "damage": {
    // Below the first a car is damaged (plate torn back, claw gouges); below the second, wrecked (breached, smoking).
    "states": [0.66, 0.33],
    // The scar mask shows from here, and is at its worst by the second.
    "scarsFrom": 0.95,
    "scarsFull": 0.1
  }
}
