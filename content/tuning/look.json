// The art pass (GDD §25-28; the art & animation pipeline plan): how surfaces are finished, how the frame is graded, and
// the night's light and air. Each palette colour (Palette.cs) is a material: the texture it wears (content/art/textures,
// built by tools/art/textures.py), how much of the shader's own grime shows over it (broad soot fields and streaks
// running down, which also break up the tiling), and how hard a specular it throws back when untextured. A colour
// that's been tinted or dimmed takes the nearest material, the texture tinted by the difference.
// "If it looks like a pristine Substance demo, it is off target." (§27)
{
  // §27's texture density for the shader's grain: environment 128-256 px/m. One grain is one texel.
  "texelsPerMetre": 128,
  // Each material map's size on the GPU: the library's 512 (the 2008-2012 target, ARCHITECTURE §8 note 57).
  "layerSize": 512,
  // ...but the characters' and creatures' baked atlases, seen closest, keep up to this (in arrays of their own).
  "heroLayerSize": 1024,
  // ...and the few authored bigger still (the Car Hugger's, spread over most of a car: GDD §27's 256 px/m needs 2048),
  // this, in arrays of their own, so the other heroes don't grow with them.
  "bigHeroLayerSize": 2048,
  // Past this far from the eye (m) the creatures baked with a distance copy (tools/models overbake `lod`: the demo's six,
  // at GDD §27's full budgets) draw it, two fifths of their triangles: a headset draws each for two eyes and the shadows
  // (tuning/perf.json maxFrameTriangles; ARCHITECTURE §8 note 262). Inside it, as close as a creature gets to anyone, the
  // whole model.
  "creatureLodMetres": 14,
  // A figure with no distance copy of its own (the survivors, the crew: some 8,400 triangles each, and a walled town's
  // people and its watch are dozens of them) gets one made at load, its vertices clustered this far apart (m), never across
  // bones; drawn past this far (m), where a figure is a few pixels tall (ARCHITECTURE §8 note 479).
  "clusteredLodMetres": 40,
  "clusteredLodCell": 0.1,
  // The bottoms of things are this much darker: the baked shadow, and the soot and wet that collect low.
  "baked": 0.35,
  // Each crewmate's flying cap and scarf are dyed their own colour (by player id, in turn), so eight masked heads can still
  // be told apart on a roof: multipliers over the cap's pale neutral leather (tools/models/crewfigure.py).
  // The looks' names on the settings' OUTFIT (note 298), in the colours' order.
  "crewColourNames": ["RED", "BLUE", "OCHRE", "TEAL", "GREEN", "VIOLET", "ORANGE", "WHITE"],
  // The hat rack's hats (note 714; campaign.json hatRack), on OUTFIT's HAT row, in their order (HatKit draws them by it).
  "crewHats": ["STOVEPIPE", "FEZ", "STRAW BOATER", "DEERSTALKER"],
  "crewColours": [
    [1.35, 0.36, 0.26], [0.3, 0.55, 1.75], [1.35, 1.05, 0.3], [0.25, 1.1, 1.15],
    [0.45, 1.15, 0.32], [1.1, 0.38, 1.35], [1.45, 0.62, 0.2], [1.05, 1.05, 1.05]
  ],
  // Painted masks (GDD §29, §9's yard; ARCHITECTURE §8 note 731): each player paints their gas mask in the settings' or the
  // yard's PAINT YOUR MASK, the crew see it. The paints a coat and a stencil come in, by name, as multipliers over the pale
  // paint (tools/art plaster_ruin; Art.MaskKit), counted from 1 on the wire (0: unpainted). Strong, so a mask reads at 5 m by
  // a hand lamp; the dark ones are for a coat with a light stencil on it.
  "maskPaintNames": ["BONE", "SOOT", "SIGNAL RED", "OXBLOOD", "OCHRE", "LEAF GREEN", "SEA BLUE", "SLATE", "PLUM", "PITCH PINE"],
  "maskPaints": [
    [1.25, 1.18, 1.0], [0.1, 0.1, 0.11], [1.45, 0.2, 0.14], [0.6, 0.1, 0.1], [1.35, 0.92, 0.25],
    [0.4, 0.95, 0.3], [0.25, 0.55, 1.4], [0.55, 0.62, 0.7], [0.75, 0.3, 0.85], [0.62, 0.42, 0.24]
  ],
  // The stencils (Art.MaskKit.Known draws each by its key), in the menu's order; a crew's sigil is one of them too.
  "maskStencils": ["stripe", "cross", "teeth", "star", "number", "moustache", "heart", "crow", "bolt", "smile", "x-eyes", "anchor"],
  // A stencil's colour when none's picked (from 1: BONE), and the crew's sigil's, on the masks and the engine.
  "maskInk": 1,
  "sigilInk": 1,
  // §27's material families. The kit's own pieces (the train, the track, the world) name their textures directly; these
  // are for everything still drawn as coloured boxes.
  "materials": {
    // Iron and steel: dark, oily, cold. The one surface with a harsh specular (§25).
    "IronGrey": { "wear": 0.6, "shine": 0.35, "texture": "iron_plate" },
    "SootBlack": { "wear": 0.4, "shine": 0.25, "texture": "iron_smokebox" },
    "Charcoal": { "wear": 0.5, "shine": 0.15, "texture": "stone_block", "tile": 2.5 },
    "GreaseSheen": { "wear": 0.3, "shine": 0.6, "texture": "tar" },
    // Brass and copper: muted warm metal, tarnished.
    "TarnishedBrass": { "wear": 0.4, "shine": 0.7, "texture": "brass" },
    // Painted metal: chipped, faded, practical.
    "RustRed": { "wear": 0.8, "shine": 0.05, "texture": "paint_oxide" },
    "BlueGrey": { "wear": 0.6, "shine": 0.1, "texture": "concrete_stain" },
    // Wood: dark, worn, rough grain.
    "DeepBrown": { "wear": 0.7, "shine": 0, "texture": "wood_sleeper" },
    "MuddyOlive": { "wear": 0.8, "shine": 0, "texture": "ground_grass", "tile": 3 },
    // The ground and what grows on it.
    "Ballast": { "wear": 0.6, "shine": 0, "texture": "ballast", "tile": 1.5 },
    "PineDark": { "wear": 0.5, "shine": 0, "texture": "pine_bark", "tile": 2 },
    // Flesh and corruption: waxy, bruised, damp. A dull sheen.
    "Corrupted": { "wear": 0.5, "shine": 0.2, "texture": "flesh" },
    // Light sources stay clean.
    "LampAmber": { "wear": 0, "shine": 0 },
    "FurnaceOrange": { "wear": 0, "shine": 0 },
    "SignalGreen": { "wear": 0, "shine": 0 },
    "SignalRed": { "wear": 0, "shine": 0 }
  },
  // The colour script as a grade (pipeline: "colour grade via 16^3 LUT"), display values in and out: shadows pushed
  // cold and lifted a touch off black (so the dark still reads, §32), highlights warm for the practical light, the
  // whole frame desaturated toward the sheet's palette.
  "grade": {
    "lift": [0.012, 0.016, 0.024],
    "gamma": [1.0, 1.0, 1.02],
    "gain": [1.0, 0.97, 0.92],
    "saturation": 0.78,
    "contrast": 1.1,
    "shadowTint": [0.92, 0.98, 1.1],
    "highlightTint": [1.08, 1.0, 0.86]
  },
  // The post stack, in the pipeline's order: bloom (half-res, one threshold, two blurs), grade, vignette, grain, then
  // ordered dither into a reduced colour depth. "ps2": true is the debug era mode for art-direction comparison.
  "post": {
    "bloomThreshold": 0.55,
    "bloomStrength": 0.7,
    "vignette": 0.42,
    "grain": 0.025,
    "colourLevels": 48,
    "ps2": false,
    "texturedWear": 0.45,
    "backdropFog": 0.1,
    "horizonGlow": 1.35,
    "backdropDegrees": 32,
    "skyZenith": [0.016, 0.018, 0.026],
    // Filtered materials, sharp at a distance (the PS2 comparison mode keeps its own positive bias, for the crawl).
    "mipBias": 0,
    // The filmic tonemap's exposure; the wide bloom's share of the glow; lens fringing toward the corners.
    "exposure": 1.0,
    "wideBloom": 0.5,
    "lensFringe": 0.006,
    // Screen-space ambient occlusion (the 2008-2012 benchmarks' contact shadow): how much it darkens, how far round each
    // point it looks (m), its gain, and where it's faded out into the fog (m).
    "occlusion": 1.0,
    "occlusionRadius": 0.6,
    "occlusionIntensity": 2.0,
    "occlusionFar": 60,
    // The people (the townsfolk, the survivors: CreatureArt.Person; note 694): the light wrapped round them past where it
    // turns away (a face and a coat's folds turn from it softly, not flat), a rim of the night's air round their
    // silhouettes (they stand out of the fog), and the shader's grime kept off their baked textures (theirs is baked in).
    "figureWrap": 0.45,
    "figureRim": 0.6,
    "figureGrime": 0.1
  },
  // The night's light and air (§28: "cool ambient night, deep shadow pockets, headlamp and lantern cones").
  "atmosphere": {
    // Height fog: lies thick in the low ground and the valleys under bridges, thins going up, never goes.
    "fogHeightFalloff": 0.06,
    "fogFloor": 0.45,
    // Clearer near, thicker far, the same at the weather's 1/e distance (ARCHITECTURE §8).
    "fogCurve": 1.45,
    // Lighter and bluer than the ground: far things go pale into it, near things stay black (the sheet's depth).
    "fogColour": [0.085, 0.095, 0.115],
    "moonDirection": [-0.55, 0.32, -0.6],
    "moonColour": [0.5, 0.58, 0.76],
    "moonStrength": 0.7,
    "ambient": 0.1,
    "lampColour": [1.0, 0.74, 0.42],
    "lampIntensity": 3.2,
    // The light indoors (the director, 8 Oct: "it feels almost impossible to see anything ... we do need interior lighting
    // to be functional"; §28 "inside = warm, human, temporary safety"; note 475). Inside a room (a car, an open house, an
    // open barn or shed, a yard's shed) the moon is kept out: "fill" is what lights a corner no lamp reaches, lamplight off
    // the boards (it was the night's ambient times a warm tint, about 0.055, which left a room black). A house's candle and
    // lamp, and the hand lamp, reach across a room; each open barn or shed and each roofed length of a yard shed has a
    // hurricane lantern turned low, hung "shedLanternHeight" over its floor on a beam. The Gaunt's house stays dark: its dark is the tell.
    "interiors": {
      "fill": [0.16, 0.12, 0.08],
      "candle": 2.0,
      "candleRange": 9,
      "lamp": 2.0,
      "lampRange": 10,
      "handLamp": 2.2,
      "handLampRange": 10,
      "shedLantern": 1.1,
      "shedLanternRange": 10,
      "shedLanternHeight": 3.2,
      "shedLanternSpacing": 10,
      // Note 1005 (the director, 23 Oct: "Those basements should get pretty dark"): down in a house's basement the fill is
      // this share of a room's, and no candle's lit there: a hand lamp is what you see by.
      "cellarFill": 0.12
    },
    // The dawn (GDD §21, the run's race to it): over the last leadSeconds of the dawn clock the night goes over to a low
    // grey light coming up in the east, the fog paling, the dark pockets filling. The fog stays (it's the line's).
    "dawn": {
      "leadSeconds": 300,
      "fogColour": [0.24, 0.255, 0.3],
      "sunDirection": [0.85, 0.12, -0.3],
      "sunColour": [0.95, 0.68, 0.52],
      "sunStrength": 0.9,
      "ambient": 0.3,
      // The glow low on the sky on the sun's side as it comes up, under the grey (the sun never clears the fog).
      "horizonGlow": [0.28, 0.16, 0.11],
      // The Wakers' stir (note 599; wakers.md §2: "the horizon behind the train goes from black to a bruise to a thin cold
      // line"): over enemies.json wakers.stirSeconds before dawn, low on the sky behind the train, from a wide dim bruise
      // to a thin grey line, up to strength (the sky shader adds it).
      // And the hills move (note 962; GDD §8 "The hills move", note 599's not-yet): from hillsFrom of the way through the stir,
      // the far ridges toward it heave, slow swells rising and settling along the skyline, up to hills degrees by dawn.
      "stir": { "bruise": [0.16, 0.08, 0.14], "line": [0.50, 0.55, 0.62], "strength": 1.3, "hillsFrom": 0.35, "hills": 0.9 }
    },
    // The cold (the night's route weather cold, 0..1; GDD §26 "survival time outside is short"): a rime of frost comes on
    // the metal, the roofs and the glass from frostFrom and is full by frostFull; breath shows as vapour from breathFrom.
    "cold": {
      "frostFrom": 0.35,
      "frostFull": 0.85,
      "breathFrom": 0.15,
      // On the cab's glass (§22, §26 "frost on windows"; note 485): the frost creeps in from each pane's frame as the
      // frost comes on, this far at its full (m), never near the middle of the driver's view; and whoever's face is
      // within fogReach of a pane fogs it on each breath out, the fog going as they breathe in.
      "paneReach": 0.16,
      "paneColour": [0.5, 0.57, 0.64],
      "paneDensity": 0.9,
      "fogReach": 0.7,
      "fogColour": [0.42, 0.45, 0.48],
      "fogDensity": 0.8
    },
    // The Choir's cold, coming before it (App. A.7's arrival beat): from halfway through its gathering the night goes over
    // to these as it nears, all of it once it's here. The air paler and colder, the moon bluer, a rime of frost on the
    // metal, the roofs and the glass (added to the night's own cold's), under the glitter of frost in the air.
    "choirCold": {
      "fogColour": [0.1, 0.13, 0.17],
      "moonColour": [0.55, 0.68, 0.95],
      "rime": 0.8
    },
    // The wind (the route weather's wind, 0..1): calm's breeze to full's gale in m/s, blowing away from `from` (world
    // axes; -Z is up the line), rolling through in gusts. The foliage's cards and boughs bend with it.
    "wind": {
      "calm": 2,
      "full": 16,
      "from": [-0.7, 0, -0.4],
      "gusts": 0.7
    },
    // A town's flag in that wind (queue #405, note 674): its cloth (m); the wind (m/s) it starts lifting in and flies flat
    // by; how far its fly hangs down in none (rad); how far it snakes side to side, calm to full (rad, at the fly); how
    // fast the ripple runs out along it, calm to full (rad/s); how far it billows up and down in its own plane, flying (rad,
    // at the fly); how many waves are on it at once.
    "flag": {
      "length": 1.8, "height": 1.2,
      "liftFrom": 1.5, "liftFull": 10,
      "droop": 1.9,
      "ripple": 0.22, "rippleFull": 0.6, "flutter": 0.22,
      "pace": 2.2, "paceFull": 10,
      "waves": 1.6
    }
  },
  // The water (ARCHITECTURE §8 note 424): how each kind of it moves. Its current (m/s: a river's down its valley, the
  // tide's along Fundy's red shore) and how open it lies to the wind (0 a marsh's still pool, 1 the open Atlantic: its
  // swell and how hard the wind chops it); its murk (0 clear dark water, which gives back next to nothing but the sky,
  // 1 Fundy's, thick with the red mud it carries); its lap (m: how far out from the waterline its foam comes and goes).
  "water": {
    "kinds": {
      "sea": { "current": 0.1, "open": 1.0, "murk": 0.1 },
      "fundy": { "current": 0.9, "open": 0.75, "murk": 1.0 },
      "dyke": { "current": 0.5, "open": 0.55, "murk": 1.0 },
      "river": { "current": 0.8, "open": 0.3, "murk": 0.2 },
      "tidal": { "current": 0.9, "open": 0.5, "murk": 1.0 },
      "lake": { "current": 0, "open": 0.45, "murk": 0 },
      "marsh": { "current": 0, "open": 0.12, "murk": 0.3 }
    },
    "lapM": 5
  },
  // The consist's wear and tear (pipeline plan, consist kit: "3 damage states per car; scars persist between runs").
  // Read off each car's integrity, which the campaign keeps, so a car comes back scarred where it was (ARCHITECTURE §8).
  "damage": {
    // Below the first a car is damaged (plate torn back, claw gouges); below the second, wrecked (breached, smoking).
    "states": [0.66, 0.33],
    // The scar mask shows from here, and is at its worst by the second.
    "scarsFrom": 0.95,
    "scarsFull": 0.1,
    // A car being eaten (the bite's fraction, as "bite" below reads it) has its boards knocked out ahead of the mouth:
    // holed as a failing car is (note 1014: DamageKit.CarHoles) from the first, as a breaking one from the second, as one
    // come apart from the third, or as its failing stage has it, whichever's worse.
    "eatenHoles": [0.15, 0.35, 0.6]
  },
  // A car's cargo read from outside it (GDD Part Eleven question 7; note 949 rank 14; queue #727, note 1025): a crew on the
  // roofs or in the yard reads a loaded car at a glance. Presentation only; the director hasn't answered the inbox's
  // nathaniel3-gdd-cargo-visible yet, so "enabled" (default on) is the whole of it.
  "cargoOutside": {
    "enabled": true,
    // A loaded cargo car's shut side doors stand cracked this share of their slide (a crew sees in; nothing gets through).
    "crack": 0.14,
    // Its placards (powder, chemicals, medicine, the comet) and the stain are drawn this near the eye (m); the livestock's
    // breath out of the crack and their heads at it this near, the breath as much as the night's cold shows.
    "placardWithin": 160,
    "breathWithin": 45,
    // Its cargo's integrity (spec F.1) under "spoiledBelow": spoiled, a stain down the side under its doors; under
    // "lostBelow": lost, a side door hanging off its runner and no crack. What's heard through the slats goes with it, as
    // loud as the cargo's integrity, silent once lost.
    "spoiledBelow": 0.5,
    "lostBelow": 0.08
  },
  // A car eaten from its rear end by a Car Hugger (GDD v1.2 App. A.3 FEED; ARCHITECTURE §8 note 109), by how much of
  // what was left of it has been eaten (Vehicle.Eaten over eaten plus integrity: 1 is eaten through, when it's dropped).
  "bite": {
    // Eaten through, this fraction of the car's body is gone from the rear; below "floor" (m) nothing is, so it rolls.
    "depth": 0.45,
    "floor": 0.95,
    // Its head pushes in through the end this far (m) as it eats; the side walls its hands hold go at most "sideLead"
    // ahead of it. The rear platform goes over the first "platform" of the eating.
    "advance": 1.4,
    "sideLead": 1.0,
    "platform": 0.08
  },
  // GDD §28 "What you came for is lit" (the director's evening playtest, 13 Oct: "We could use a little bit more lighting
  // around some of the loot. It's sort of just hard to identify what we're even doing"; note 705). Warm lamp-amber pools a
  // few metres across, kept to the nearest (the renderer keeps the 32 nearest lights of all).
  "workLight": {
    // A gantry's work lamp, hung on the cable "hookAbove" m over the hook: what's on the hook is lit all the way down into
    // the car, and the car's floor under it.
    "hookIntensity": 2.2,
    "hookRange": 6.5,
    "hookAbove": 1.4,
    // Over the castings still stacked to load, "stackHeight" m up over the middle of the stack.
    "stackIntensity": 1.6,
    "stackRange": 7,
    "stackHeight": 3.2,
    // Round a crate or a find lying on the ground (not carried, not aboard): the nearest "groundCount" within
    // "groundWithin" m of the eye, each a low light "groundHeight" m over it.
    "groundIntensity": 1.1,
    "groundRange": 3.5,
    "groundHeight": 1.1,
    "groundWithin": 30,
    "groundCount": 6
  },
  // GDD §31 "Speed is felt" (the director's evening playtest, 13 Oct: "It says we're going 27 kilometers an hour ... when I
  // look out the front, it just feels so agonizingly slow"; note 709). Presentation only, aboard, never in a headset.
  // The dining car's bar (upgrades.md §8.5, note 959; the director, 13 Oct: "If you drink one of those drinks, though, your
  // vision should get blurry ... make you sort of tip over a bit. Of course, that wouldn't happen in VR"). Presentation
  // only: the drinker's own camera on this machine, never in a headset; the walk is straight. A drink blurs the view
  // ("blur", 0..1 of the composite's soft taps; "blurEach" more a drink after the first) for "seconds", "moreEach" longer a
  // drink after the first, easing off over its last "fadeSeconds"; and leans it, the horizon swaying "leanDegrees" one way
  // and the other ("leanEach" more a drink after the first) over "leanPeriod" s, slowly, as if the floor moved more than it
  // does. Counted up to "mostDrinks" drinks. DESIGN-TODO: the catalogue's "a minute, a little more with each" is the only number.
  // Note 974 (§8.5: "the crew see the drinker's head loll"): everyone else sees a drinker's head roll over to one side and
  // the other, "lollDegrees" (and "lollEach" more a drink after the first) over "lollPeriod" s, dropping forward as it goes
  // by "lollNod" of that, the shoulders swaying a little under it; for as long as the drinks count, easing off as they do.
  "tipsy": { "seconds": 60, "moreEach": 15, "blur": 0.5, "blurEach": 0.15, "leanDegrees": 4, "leanEach": 1.5, "leanPeriod": 7,
    "mostDrinks": 4, "fadeSeconds": 10, "lollDegrees": 16, "lollEach": 5, "lollPeriod": 3.4, "lollNod": 0.5 },
  "speedFeel": {
    // The view widens by up to "widen" degrees, at "fullAt" m/s, eased by (speed / fullAt) ^ "ease" (under 1: felt early).
    // Note 735 (the director, 14 Oct: "It still feels a bit slow"): 8 to 12. Note 842 (the director, 16 Oct: "the FOV is
    // adjusting a little bit ... maybe that's a miss. I would get rid of that"): off.
    "widen": 0,
    "fullAt": 20,
    "ease": 0.6,
    // A knock through the floor at each rail joint, "joint" m apart, under each bogie ("bogies" m apart): "jolt" m at full
    // speed, over "joltWidth" m of travel; and the car's sway, "sway" m side to side every "swayWave" m. Note 735 (the
    // director, 14 Oct: "it seems like the cab is shaking. I don't like that ... the train feels like it's sort of rocking"):
    // both off. A shaking view reads as the camera, not the train (GDD §31).
    "joint": 12.5,
    "bogies": 8.5,
    "jolt": 0,
    "joltWidth": 0.35,
    "sway": 0,
    "swayWave": 34
  }
}
