// Player movement and survival. Source: systems spec B.2. First pass.
{
  "run": 5.5,
  "walk": 2.4,
  "roofRun": 3.5,
  "roofWalkSafe": 1.8,
  "ladderClimb": 1.6,
  "carryHeavy": 2.8,
  // GDD v1.4 App. D.9 "solo remainer" (note 181): the last of the crew alive can climb a ladder carrying a body, at this
  // (a quarter of ladderClimb); anyone else carrying a body, the child or freight can't climb at all (C.4; a toy or a find in
  // the hands doesn't stop you since note 897: twoHanded).
  "soloBodyClimb": 0.4,
  // Note 897 (the director, the inbox, 20 Oct 2026: "We shouldn't be slowed carrying anything unless it's a two handed object"):
  // only a thing of these kinds in the hands (not put away in a slot) is carried two-handed: it holds you to carryHeavy, keeps
  // you off ladders (but for soloBodyClimb) and off a jump. A friend over the shoulder always is (rescue.carry). Freight, a
  // heavy crate's end, the child and a body; a toy or a find is one-handed. A find that should take two hands gets a kind of
  // its own and goes in the list. only: false is the rule before it: a toy and a find in the hands too (note 594).
  "twoHanded": { "only": true, "kinds": ["cargo", "heavy", "child", "ragdoll"] },
  // Pushing a gun along its roof rail (T93): the gun goes where you go, no faster than this. Note 664: on its own key, O.
  "pushGun": 1.2,
  // Note 664 (the director's playtest, 13 Oct: "we should have a crouch function"; D1's calls for it): held down (LeftCtrl),
  // the body's this tall (m; height's 1.8 standing), so it goes under what standing would hit, and a tunnel's mouth on a roof
  // (sight.json crouchClearsMouth); the eye's eyeDrop lower (the view, and what's looked at: train.json pick); the walk at
  // speedScale of a walk's pace, never a run, no jump; footsteps footstepGainDb quieter. Let go, they stand once there's the
  // headroom. A headset rider has no key: their head under headsetBelow (m over the feet) is a crouch.
  "crouch": { "height": 1.2, "eyeDrop": 0.55, "speedScale": 0.5, "footstepGainDb": -8, "headsetBelow": 1.2 },
  "jumpGap": 2.2,
  // How high a standing jump lifts your feet. Playtest (T90): the 0.48 m that a flat 2.2 m gap jump at roof run needs was
  // too weak to feel like a jump at all, and it went to 0.8 m. The director, 8 Oct 2026 (note 473): "our base jump is too
  // weak as well": 1.2 m, about a fifth longer in the air, so a roof-run jump carries about 3.4 m.
  "jumpHeight": 1.2,
  "health": 100,
  // T108 (GDD §1322: the tools on the train are the weapons): what every crewmate carries from the start of the night, and
  // after every respawn, slot by slot from 1. Tools: crowbar, shovel, wrench. Note 301: the wrench is the repair tool
  // (train.json repair), so everyone has one, in slot 2.
  "kit": ["crowbar", "wrench"],
  // What the bots go by (GDD v1.4 App. D.12: the incident report names everyone): a crew's names, in the order they board.
  "botNames": ["Dunmore", "Okafor", "Reyes", "Halloran", "Petrov", "Achebe", "Lindqvist", "Moreau"],
  "gravity": 9.81,
  "radius": 0.3,
  "height": 1.8,
  "stepUp": 0.35,
  // Spec B.3 landings (T90, playtest): hitting the ground moving over it faster than lethalAbove kills (three times run
  // speed); slower than that it hurts, from rollDamage just above rollAbove rising to damageAtLethal at the lethal edge.
  // Being pulled off (the Draggers) still goes by train.speedBands.jumpOffLethal.
  "landing": {
    "rollAbove": 1.5,
    "rollDamage": 10,
    "lethalAbove": 16.5,
    "damageAtLethal": 80,
    // Note 573 (the director, 9 Oct: off Stroud Bridge's deck, 8 m over the river, and lived): spec B.3 has no fall table, so
    // a fall hurts by its height (the speed it comes down at): from fallHurtFrom, rollDamage rising to death at fallLethalFrom
    // (7.5, so the bridge's 8 m is death however the tick falls).
    // From fallHurtFrom down it's the speed table alone: a car's roof is 4 m over the ballast and a jump's apex 1.2 more, so
    // the leap off the train stays B.3's; a 1.5 m step off a landing is nothing.
    "fallHurtFrom": 5.5,
    "fallLethalFrom": 7.5,
    // Note 717 (the director's 14 Oct playtest, line 7: "Whenever I step off the train, I get like a little vignette red flash
    // ... I shouldn't take damage unless I like fully jump as high as I can go off the top of the train"): off a train going
    // slower than standBelow (m/s), a stood train's footing is the ground's (note 573's off the ground): a crewmate's own walk
    // or run is no knock, only the drop is (a car's roof and a jump's apex over it, 5.2 m, is under fallHurtFrom).
    "standBelow": 0.5,
    // ARCHITECTURE §8 note 802 (the director, 15 Oct 2026, on hoisting a friend, note 726: "If we're hoisting a player and
    // dropping them lets make it so the player can only lose 10 health at most from a drop and then scale that based on
    // height. It's a silly gag not a big grief"): a landing on the ground after letting go of a crane's hook, or being shaken
    // off it, lift or no lift, knocks by the height fallen alone (m, by the speed it lands at): nothing from "from" or less
    // (a step down off a low hook), rising evenly to "maxKnock" at "fullAt" (the foundry's gantry tops a rider's feet out at
    // 6.35 m, so its top is the full knock) and no more however high. Never a death, and never below 1 health. The fall and
    // speed rules above don't count. A landing on a car's roof is no knock, as for any drop onto the train.
    "offTheHook": { "maxKnock": 10, "from": 1.0, "fullAt": 6.0 }
  },
  "ladder": {
    "grabRange": 0.7,
    // You can only grab a ladder moving past you slower than this: "if you could catch it".
    "grabMaxRelativeSpeed": 3.5,
    // Note 704 (the director's playtest: the cab's ladder "should actually go up to the roof"): walking into a hatch ladder
    // indoors (the cab's, a car's) takes hold of it only looking up it at least this far; level, you walk past it working.
    "hatchLookUpDegrees": 25
  },
  // A VR player's reaching hand (T29; the spec has no VR numbers). Reach is tested from the hand instead of the body:
  // a hand is on a grip (a lever, a handle, a ladder, a crate) within grab of it. The host believes a hand no farther
  // than arm across from the body, and from the feet (a headset player crouches for real) to overhead above them.
  "hand": {
    "arm": 0.8,
    "overhead": 2.3,
    "grab": 0.3
  },
  // The cold (spec B.2's exposure, GDD §22's deep cold) is out of gameplay since note 852 (the director, 16 Oct 2026): a
  // night's cold is the look's alone (look.json atmosphere.cold: the frost, the breath).
  // GDD §22 wind, spec B.2's "roof run: wind and balance penalty" (ARCHITECTURE §8 note 201). Up on a roof, the wind
  // (the route's conditions: the night's, ×1.5 on exposed track) pushes you sideways: drift m/s at wind 1 with the train
  // at its maxSpeed, still of that with it stopped (it's the wind across a moving train), in gusts that swing from one
  // side to the other over gustMetres of line. walking: walking or standing, this of what it is at a roof run (balance).
  // The roof handrails take it to train.json composition.rails.wind of that; a gun's seat is out of it. At the worst
  // (exposed track, full speed, running) about 0.45 m/s: walking against it holds you, and stood at the edge in a gust it
  // walks you to the lip (edge, below), not over it (T128). It's seen as the drift itself: no camera roll, which a headset
  // would feel in the stomach.
  "wind": {
    "drift": 0.3,
    "still": 0.4,
    "walking": 0.5,
    "gustMetres": 120
  },
  // T128 (build 1121: "far too easy to fall off the train"; ARCHITECTURE §8 note 273). Not in the spec. Measured by
  // FallTests' careless walker (a wandering aim, a glance aside every few seconds with the key held, half the cars at a
  // run, the gaps jumped, a normal night's wind): 54 falls in 20 minutes before, nearly all of them walking off a side
  // while looking somewhere else. A roof's edge (and a coupler plate's) now holds you when you're only walking: your feet
  // stop `lip` m short of where the footing ends. You go over the side if you mean to, walking at it within
  // stepOffDegrees of straight out; off a roof's end only by a jump, a ladder, or onto the train below it (the coupler
  // plate, a platform, the tender: any of it within catchDrop m under the edge). What still takes you off is real: a
  // creature's pull (the Draggers), a bend you were warned of taken too fast (sight.json throwOver), a jump that falls
  // short, and walking off on purpose. windOverLip: true is the old wind, which the lip doesn't hold.
  // The world is solid (the director, 6 Oct 2026; ARCHITECTURE §8 note 279): on foot on the land, nobody walks up ground
  // steeper than climbSlope (rise over run; 1.25 is about 51°). A cutting's walls (2:1), a ledge's upslope and a cliff
  // over the sea stop you; the line plan's walkable ground (§12.6, slope 1 with its noise) never does.
  "climbSlope": 1.25,
  // walkOff (note 717; the director's 14 Oct playtest, line 4: "I think we want to let people walk off the top of the cars"):
  // a roof's ends let a walker off as its sides do, walking at it within stepOffDegrees of straight off; the lip still holds a
  // glance aside, a turn with the key held, and the wind. false: off an end only by a jump, a ladder or the train below.
  "edge": {
    "lip": 0.3,
    "stepOffDegrees": 30,
    "catchDrop": 3.5,
    "windOverLip": false,
    "walkOff": true
  },
  // Spec E drop-out, GDD v1.4 App. D.2 (ARCHITECTURE §8 note 253): a player whose link drops mid-night leaves an inert body
  // (no bot takes over), and the host holds their place (id, name, a token issued at the welcome) for reserveSeconds.
  // Back in time with the token, they get their own crewmate back. reclaimBody: true, they stand up where their body
  // lies now, with whatever kit is still on it (it may have been carried, looted, or fallen off the train); dead when they
  // dropped, they're dead still, on the dead channel. false is D.2's letter: the body stays and they come back as a lobbied
  // player (the respawn queue, or with no Holdouts a drop-in). A body gone (the Gaunt has it) is always D.2's letter.
  // Past reserveSeconds the slot frees and a returning player is a new joiner.
  // greetSeconds: a joiner says hello (with the token, if it has one) before it's welcomed; one that says nothing in this
  // long stops holding up the others, and is welcomed only once it does (note 253). The client retries a dropped link `retries` times, retrySeconds apart, then offers RECONNECT.
  "rejoin": {
    "reserveSeconds": 180,
    "reclaimBody": true,
    "greetSeconds": 1,
    "retries": 5,
    "retrySeconds": 3,
    // The crew goes on together (ARCHITECTURE §8 note 606): told the host's going on from a delivered campaign night's town,
    // a joiner waits on its card and dials the host again, retrySeconds apart, for up to followSeconds while the host picks
    // the next night at its board; past that it's back to its menu.
    "followSeconds": 600
  },
  // The links in play (ARCHITECTURE §8 note 532). timeoutSeconds: silence from the other end for this long and the link's
  // gone (a joiner then redials, rejoin above; it was the transport's own 8 s, note 18, which a wifi blip could reach).
  // keepaliveSeconds: a ping at least this often, which is also how the round trip's measured. pumpMilliseconds: the app's
  // transports are kept by a thread of their own between the frames, waking at least this often, so a stalled frame loop
  // (a village loading, the film compiling) neither drops its links nor is dropped. A client paces itself to its host: the
  // host says in each snapshot how many of the client's inputs it's holding beyond the one it applied; over paceQueued
  // for paceSeconds and the client's clock stretches by paceSlow (its ticks take 5 % longer) until the host has caught up
  // (one or none held), so a host that's behind slows the night for everyone instead of throwing inputs away. A host whose
  // own frames can't hold the tick rate (its clock threw time away) is told YOUR MACHINE IS HOLDING THE CREW BACK, for
  // heldBackSeconds after the last time it did.
  "link": {
    "timeoutSeconds": 15,
    "keepaliveSeconds": 1,
    "pumpMilliseconds": 4,
    "paceQueued": 4,
    "paceSlow": 0.05,
    "paceSeconds": 1,
    "heldBackSeconds": 5,
    // Note 549: each client tells the host what share of its snapshots it isn't getting; one losing thinLossPct or more for
    // thinSeconds is sent every other snapshot (fewer, whole), held for thinHoldSeconds and let go once the loss has been under
    // half that for all of it (thinning cures the loss it's for, so without the hold it would come and go). The share counts a
    // snapshot that came stale as lost (a jittery link reads a few percent), so the threshold sits well above that. When strainCrew or more of the
    // crew report that much at once for strainSeconds, it's the host's own upload that can't carry them, and the host is told.
    "thinLossPct": 12,
    "thinSeconds": 2,
    "thinHoldSeconds": 20,
    "strainCrew": 2,
    "strainSeconds": 5
  },
  // The crew cap (GDD §1 "Players: 2–8", §15's largest crew; ARCHITECTURE §8 note 254). The host turns a joiner away once
  // the crew, living and dead, those waiting to board at a stop and the places held for the dropped (rejoin above) come to
  // `cap`: told CREW FULL (n/cap), the lobby listed FULL and its platform lobby shut, open again when a place frees. Bots
  // hold crewmates, so they count. A player coming back with a held place's token always gets in. A mod raises it with a
  // patch (`{"$patch": true, "crew": {"cap": 12}}`): everyone in a game runs the same content, so they agree on it. The net
  // budget (ARCHITECTURE §6) has headroom to 12; past that is untested. refuseLingerSeconds: how long the host keeps a
  // refused link open for the refusal to get there before it hangs up (the client hangs up itself on reading it).
  //
  // Sessions (GDD §33.1; ARCHITECTURE §8 note 724; the director, 14 Oct 2026, App. F.6). joinTakesBotSeat: a human joining a
  // night that bots crew, who'd otherwise wait for a stop, go into the Holdouts' queue or be turned away from a full crew,
  // takes a bot's place where it stands (its body, its slots and what it carries, its health, its post): a living bot's, the
  // director's census's least busy, else the newest, the one at the cab's controls last. The bot leaves. false: the old way.
  // kick: the host puts a player off from the roster (Q held, Shift and their number); in a public lobby (listed, no password)
  // anyone aboard can call the crew's vote on someone, open voteSeconds, carried by more than `majority` of the living humans
  // aboard (the one voted on not counted). Put off, a player's told THE CREW PUT YOU OFF AT THE NEXT STOP and can't come back
  // to that run (barred by their account or address, or by name on a LAN that has none). A private or friends-only run: the
  // host's kick only.
  //
  // A private run's wrong password (ARCHITECTURE §8 note 535; note 450's "not yet"): its refusal is held back
  // guessDelaySeconds, guessGrowth times longer for each wrong guess since from the same place (an address, or a platform
  // account), up to guessDelayMaxSeconds; a place with no wrong guess for guessForgetSeconds starts again from the first.
  // One guess from a place is judged at a time, so a mistyped password costs a second and a guesser a few a minute.
  "crew": {
    "cap": 8,
    "refuseLingerSeconds": 3,
    "guessDelaySeconds": 1,
    "guessGrowth": 2,
    "guessDelayMaxSeconds": 30,
    "guessForgetSeconds": 300,
    "joinTakesBotSeat": true,
    "kick": {
      "voteSeconds": 30,
      "majority": 0.5
    }
  },
  // Emotes (GDD §9: the yard's a safe space where "the crew wait for friends, hang out, dance"; ARCHITECTURE §8 note 298).
  // Seconds each lasts, unless its player moves first: the host keeps the event this long for the crew to see. cooldown:
  // how soon after one another can be picked. Presentation only: nothing in the sim acts on an emote.
  // GDD §12 "Ping the bots" (note 739; the director, 14 Oct 2026: "use my middle mouse button to create some sort of context
  // ping"): what's nearest the middle of the view within coneDegrees and range m is pinged; the crew see it seconds s, and a
  // bot that takes it keeps to it orderSeconds at most. One a pinger each cooldown s.
  "pings": {
    "range": 60,
    "coneDegrees": 12,
    "seconds": 20,
    "orderSeconds": 120,
    "cooldown": 0.5,
    // Note 739 part two: how far off a house of a stop's village can be pinged (m), the abandoned town. A village stands
    // well back from the yard (100 m and more), and a house is big enough to point at from there.
    "townRange": 150,
    // Note 739 part two: how long the crane's two keep to its loading (s), the castings lifted one at a time; orderSeconds
    // is the rest's.
    "craneOrderSeconds": 600,
    // Note 936: how far from where it stands a hand sent to the town by a ping goes to search its houses (m), past
    // facilities.json crew.villageReach: a house is pinged from as far off as townRange, and its rooms are further in.
    "townReach": 300
  },
  "emotes": {
    "dance": 8,
    "wave": 2.5,
    "point": 2.5,
    // Note 740 (GDD §17): "Aboard!", called back to the horn, a hand up and the crew told who said it.
    "aboard": 3,
    "cooldown": 0.5,
    // Emotes for two, and the edges (GDD §9; the director, 14 Oct 2026, App. F.6; ARCHITECTURE §8 note 722). A high five
    // (fist bump) is held up offered for highFive (fistBump) s; a crewmate within reach m of the offerer (feet to feet, on a
    // level), the two facing each other within facingDegrees, who picks it too answers it, and the hands meet: both are shown
    // met for met s from that tick. Unanswered, it hangs there till it runs out.
    "highFive": 3,
    "fistBump": 3,
    "met": 0.8,
    "reach": 1.5,
    "facingDegrees": 50,
    // Dancers within danceOffReach m of each other, facing each other within danceOffFacingDegrees, are a dance-off: the lead
    // goes round them by id every danceOffBeat s (from the host's tick), the rest answering.
    "danceOffReach": 3,
    "danceOffFacingDegrees": 70,
    "danceOffBeat": 2,
    // The sit and the lean are taken within edgeReach m of where a car's footing ends at its side (a roof's, a door landing's,
    // a running board's) or of a doorway; an edge is sat on where it drops more than edgeDrop m. From inside, in an open side
    // doorway, the edge sat on can be up to edgeReach + sillReach m out: across the sill and a cargo car's landing outside it.
    // Both are held till their crewmate moves, jumps or is moved.
    "edgeReach": 0.6,
    "edgeDrop": 0.5,
    "sillReach": 1.2,
    // A bot answers a high five or fist bump offered to it after botAnswer s (bots never offer).
    "botAnswer": 0.4,
    // The "more emotes" upgrade's (note 714): a bow, a salute, and the conga, which lasts while its line keeps going (each
    // in it follows whoever started before them; one who stops dancing, or steers off, drops out).
    "bow": 2.5,
    "salute": 2.5,
    "conga": 30
  },
  // The news (ARCHITECTURE §8 note 663; the director: "did a coupler break on its own or was that a creature?"): cars the
  // engine loses and its failing or breaking down, told to everyone as it happens, with what did it, on one line for
  // `seconds`. A crewmate's own cut is told only with the train running faster than `cutToldAbove` (m/s): cars set out at a
  // stand aren't news. The report reads the same events.
  "news": {
    "seconds": 5,
    "cutToldAbove": 1.5
  },
  // Incidents travel the train (GDD open question 2 and App. D.6; ARCHITECTURE §8 note 750; the social collision audit's R1,
  // the director, 14 Oct 2026: "looks good"). Roll call stays verbal, but an emergency is shown: a crewmate held, or killed,
  // further than beyondMetres from you (voice's reach, spec A.5's 26 m: nearer, you hear it) is a line under the news, who
  // and where, never what: "PRIYA - CAR 4 ROOF" for as long as they're held, "PRIYA IS GONE - CAR 4" for deathSeconds.
  // Each machine works it out for its own player from the snapshots. Never shown to the dead. Off: nothing shown.
  // deathsNear (note 938; the director's playtest of 20 Oct: "Where did he go? Is he dead? ... I don't see Dunmore"): a death
  // is told within voice's reach too, since a crewmate (a bot above all) can go quietly beside you; the roster (held Q) says
  // who's dead from then on. deathSeconds was 4, too short to catch at the controls.
  "crewNews": { "on": true, "beyondMetres": 26, "deathSeconds": 8, "deathsNear": true },
  // Horseplay (GDD §23.4; ARCHITECTURE §8 note 717). The director, 14 Oct 2026: "The griefer ideas are funny"; "if we're
  // going to allow shoving, then we need shoving to be in full effect, which means if you're standing on top of a car, you
  // can be shoved off of it. And at speed, it kills you"; and the lump of coal "is going to need to be able to work with the
  // current coal shoveling system". Nothing a crewmate does to another is damage: staggers, soot and knocks only, and a death
  // only through the world's own rules (the landing, by the train's speed or the height), so the report names who.
  // enabled: false turns the shove, the bonk and coal at the crew off for every lobby; crewmates stay solid to each other
  // either way. The lobby's CREW MISCHIEF switch (note 724, GDD §23.4) turns it off for one run: the host sets it on the host
  // screen or the fortress board, or in the yard from the night's menu. It starts on, but in a public run FEELING COMPETITIVE
  // with competitiveOff (strangers meet there; among friends and for laughs it's on).
  "horseplay": {
    "enabled": true,
    "competitiveOff": true,
    // Crewmates are solid to each other: two shoulders of `radius` (m) each, on the ground or in a car, out of each other at
    // `share` of the overlap a tick each, no faster than maxSpeed (m/s, over a run, so nobody runs through anybody): soft, so
    // whoever stands in a doorway is squeezed past, pushed along at half the pace of whoever walks into them (an edge holds
    // them as it holds the wind: walking into a friend never puts them off a roof; a shove does). Not on a ladder (a hatch's
    // comes up through a crowded roof), in a gun's seat or in the air.
    "crowd": { "radius": 0.25, "share": 0.75, "maxSpeed": 6.0 },
    // The shove (its own key, 5 since note 898): looking at a crewmate within `reach` (m, chest to chest) and coneDegrees of where you
    // face, hands off the shovel. They go off their feet the way you shoved, at `speed` (m/s) and `lift` (m/s) up, staggered
    // staggerSeconds (they can look and talk, nothing else), and you can't shove again for cooldownSeconds. On a roof, from
    // within a metre or so of its side, that's over the edge (the lip holds a walker, note 273, not a shove), and the landing
    // is spec B.3's: faster over the ground than landing.lethalAbove (16.5 m/s) kills, and the report says "Shoved off by Dave at
    // 58 km/h". The shove's own speed knocks nobody. A crewmate within chainReach (m) beyond the one shoved takes a bump: off
    // their feet at chainShare of the speed, staggered chainStaggerSeconds. Until they have footing again, a landing that kills
    // is the shove's.
    "shove": {
      "reach": 1.2,
      "coneDegrees": 45,
      "speed": 3.0,
      "lift": 1.5,
      "staggerSeconds": 0.6,
      "cooldownSeconds": 1.5,
      "chainReach": 0.8,
      "chainShare": 0.5,
      "chainStaggerSeconds": 0.3
    },
    // Coal off the shovel: with a shovelful on it (boiler.json scoopSeconds into a stroke at the firebox, or a hand at the coal
    // face), Throw throws the lump along the view at `speed` (m/s) and `lift` up, on top of the thrower's own motion; the fire
    // goes a unit short (out of the tender). A crewmate it hits (a ball of `radius` against their body) is staggered
    // staggerSeconds and sooty-faced for the night; a creature takes `blow` of a crowbar's blow (enemies.json melee). Gone
    // after lifeSeconds, or on whatever it hits.
    "coal": { "speed": 12, "lift": 1.0, "radius": 0.08, "staggerSeconds": 0.35, "blow": 0.25, "lifeSeconds": 3 },
    // A tool's swing that meets a crewmate before a creature: a clang, staggerSeconds of stagger, and no damage. The report
    // counts the bonks of anyone bonked reportFrom times or more ("Bonked 14 times, mostly by Priya").
    "bonk": { "staggerSeconds": 0.3, "reportFrom": 5 },
    // The director, 14 Oct 2026: "With shoving if a player ever shoves another player and that results in their death all the
    // monsters in the game should target more heavily the murderer player so they are heavily likely to die (even if they rescue
    // the player from a holdout)". A shove that kills marks the shover for the rest of the night (a Holdout's return, a rescue:
    // neither clears it), until the shover dies: the director, 14 Oct 2026, "Shovers mark should reset to normal targeting
    // after they are killed" (GDD §23.4, note 754). endsAtDeath: false keeps it through their death and return too. Every creature choosing whom to go for counts them targetWeight times
    // nearer and allowanceM (m) nearer again, so one that can reach them prefers them over someone closer; the Choir takes the
    // loudest still, the mark its tiebreak; the Moose hears a marked voice targetWeight times louder; the director sends its next
    // threat at their post, and what they do draws the dark targetWeight times harder; and while they're on foot the pressure
    // builds pressurePerSecond faster (enemies.json pressure's terms are of that order). The news and the report say so:
    // "Marked: Dave (shoved Priya off at 58 km/h)." No marker on anyone's HUD. enabled: false, no mark.
    "marked": { "enabled": true, "targetWeight": 6, "allowanceM": 20, "pressurePerSecond": 0.1, "endsAtDeath": true }
  },
  // Bringing them home (GDD §17, §23.5; ARCHITECTURE §8 note 723; the friendslop audit's pillar "nobody gets left", approved by
  // the director, 14 Oct 2026): the physical verbs that answer "the engine can leave without you".
  "rescue": {
    // The hand-up: a crewmate on a car (in its open door, on its end platform or its steps) holds Use looking at a friend on
    // foot beside it, within `reach` (m, from the helper's chest to any of the friend, shins to crown; the hands' reach) and
    // coneDegrees of their view, nothing of the car between; the car going at least fromSpeed (m/s; at a stand the steps are
    // there to climb), and the two moving within maxRelativeSpeed (m/s) of each other along the ground (a runner's sprint and a
    // little: a friend standing still isn't snatched off the ballast at speed). Held `seconds` with the friend in reach, they're
    // hauled up, landing in the car's frame landInboard (m) in from the helper, away from the side they came up (where the helper
    // stands if that isn't clear). While it's held, Use is the hand-up's: the door the helper stands in isn't worked. On a train
    // going reportFrom (m/s) or faster, the report says so: "Hauled aboard in car 3 at km 4. Hauled up by Dave at 40 km/h."
    "handUp": { "enabled": true, "reach": 1.6, "coneDegrees": 40, "maxRelativeSpeed": 7, "fromSpeed": 1.0, "seconds": 0.6, "landInboard": 0.45, "reportFrom": 2 },
    // Carrying a friend: empty-handed, a press of Use looking at a living crewmate on their feet in the same frame, within
    // `reach` (m, chest to chest) and coneDegrees of where you face, with nothing Use works in reach, held liftSeconds, puts them
    // over your shoulder (shoulderUp over your feet, shoulderBack behind; the body-carry's hold, App. C.4): you go at carryHeavy
    // and climb nothing, they look and talk, and their Jump wriggles free to your feet. Use puts them down at your feet. Throw,
    // with the crew mischief switch on, throws them along your view at throwSpeed and throwLift (m/s) up on your own motion: off
    // their feet as a shove puts them (the landing is the world's: the train's speed or the drop), and the report says "Thrown
    // off by Dave"; with the switch off, Throw puts them down. Safe from nothing: whatever grabs or knocks you drops them. Bots
    // can be carried, and never carry anyone.
    "carry": { "enabled": true, "reach": 1.2, "coneDegrees": 30, "liftSeconds": 1.0, "shoulderUp": 0.7, "shoulderBack": 0.15, "throwSpeed": 4, "throwLift": 1.5 },
    // A bandage on a friend: a healing find in your hands (loot.json healing) and Use held looking at a hurt crewmate within
    // `reach` (m, chest to chest) and coneDegrees: it goes on them, healing loot.json healing.onAFriend times as much.
    "bandage": { "enabled": true, "reach": 1.4, "coneDegrees": 40 }
  },
  // Voices as tools (GDD §12, §14, App. C.8; the friendslop audit's Friends goal; the director, 14 Oct 2026; ARCHITECTURE
  // §8 note 720).
  "voices": {
    // The speaking tube, a brass pipe from the cab (its left wall, a step behind the hatch ladder) to the guard van (its
    // front right corner): said within mouthReach (m, across the floor) of one mouthpiece, it comes out of the other's horn,
    // tinny, heard within heardWithin (m) of it. The near crew hear the speaker as ever. However long the train is.
    "tube": { "mouthReach": 1.0, "heardWithin": 10 },
    // Singing together (§14): two or more living crewmates within earshot (m) of each other whose voices (the intent's level,
    // 0-255) rise and fall together over windowSeconds: each over floor on average, each moving by at least swing (its spread,
    // so a held drone isn't a song), and the two in time (their correlation at least inTime). While a crew sings: with
    // feedsChoir false their voices don't feed the loudness meter (the director: "Singing does not fight the choir"); the
    // livestock aboard settle, their floor under the meter and the hounds' pull to them eased by calmsLivestock (a share);
    // and a Gaunt near them is talked down faster (enemies.json gaunt.singingTalks).
    "singing": { "windowSeconds": 4, "earshot": 12, "floor": 40, "swing": 12, "inTime": 0.6, "feedsChoir": false, "calmsLivestock": 0.6 },
    // Lamp signals (§12): a crewmate holding a hand lamp swings it across (STOP), raises and lowers it (GO) or circles it
    // (BACK UP); the crew see it for `seconds`, and another may follow after `cooldown`. The bot driver reads one shown within
    // seenWithin (m) of the cab or the van's rear: STOP, it brakes to a stand and stands up to standSeconds (or till GO);
    // GO, it releases and goes on; BACK UP, at a stand it sets back backMetres at backSpeed (m/s) and stands. A STOP shown
    // to a moving train that stands within stoppedWithin (s) is named in the incident report.
    "lampSignals": { "seconds": 3, "cooldown": 0.5, "seenWithin": 60, "standSeconds": 90, "backMetres": 40, "backSpeed": 1.5, "stoppedWithin": 40 },
    // A hand over the mouth (GDD App. C.8; note 749; the director, 14 Oct 2026: "A grab should allow players to still use the
    // radio but their voice should be muffle filtered as if the grab is covering their mouth partially"). While a crewmate is
    // held, each listener's client plays their voice in the air and on the radio muffled, not cut: gainDb quieter, and
    // through the sounds' own low-pass on their "covered" parameter (voice.json and voice-radio.json, 1.4 kHz). A creature
    // that does its own thing to the voice keeps it, alone: Tippy Toesie's hand (muffled) and a Soot Child's draining
    // (fading). Off: a held voice as it was.
    "covered": { "on": true, "gainDb": -6 },
    // The capture leveller (note 855; the director's playtest of 16 Oct evening, line 1: "my mic is way too low for her"). Out
    // of the box a microphone's speech sits anywhere from about -35 dBFS (a Windows headset, no boost) to -15 (a Linux
    // desktop's PulseAudio at 100%), and the mix is made for the loud end: a quiet mic's voice in the air was under the train's
    // bed outdoors at 8 m, where a loud one stood 18 dB over it. Each client levels its own mic before it's encoded: the
    // talker's level (each 20 ms frame's RMS while the voice activity hears talk, coming up to louder speech over riseSeconds
    // and down to quieter over fallSeconds, frames more than ignoreBelowDb under it left out) is brought to targetDb (dBFS),
    // lifted at most maxBoostDb and cut at most maxCutDb, a frame's peak held under ceiling (full scale 1). The settings' MIC
    // LEVEL trims after it. Off: each mic as it comes.
    "leveller": { "on": true, "targetDb": -14, "maxBoostDb": 24, "maxCutDb": 12, "riseSeconds": 0.15, "fallSeconds": 2.5, "ignoreBelowDb": 20, "ceiling": 0.95 },
    // A cab side door open (note 862; the director, 19 Oct 2026: "open cab door should let voices out a bit more but not
    // completely"): a voice between the cab and outside it, with either of its side doors open (note 856), comes through
    // occlusion of the cab's wall (mix.json's occlusionDb and occlusionLowpass; 1 the whole wall, 0 none): at 0.5, half the
    // wall's 12 dB and its low-pass up from 900 Hz to about 4.2 kHz. Off: an open door's as shut, for voice.
    "openCab": { "on": true, "occlusion": 0.5 }
  }
}
