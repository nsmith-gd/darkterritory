// Player movement and survival. Source: systems spec B.2. First pass.
{
  "run": 5.5,
  "walk": 2.4,
  "roofRun": 3.5,
  "roofWalkSafe": 1.8,
  "ladderClimb": 1.6,
  "carryHeavy": 2.8,
  // GDD v1.4 App. D.9 "solo remainer" (note 181): the last of the crew alive can climb a ladder carrying a body, at this
  // (a quarter of ladderClimb); anyone else carrying a body, a toy, a find or the child can't climb at all (C.4).
  "soloBodyClimb": 0.4,
  // Pushing a gun along its roof rail (T93): the gun goes where you go, no faster than this.
  "pushGun": 1.2,
  "jumpGap": 2.2,
  // How high a standing jump lifts your feet. Playtest (T90): the 0.48 m that a flat 2.2 m gap jump at roof run needs was
  // too weak to feel like a jump at all; at this height a roof-run jump carries about 2.8 m, clearing the gap easily.
  "jumpHeight": 0.8,
  "health": 100,
  // T108 (GDD §1322: the tools on the train are the weapons): what every crewmate carries from the start of the night, and
  // after every respawn, slot by slot from 1. Tools: crowbar, shovel, wrench.
  "kit": ["crowbar"],
  // What the bots go by (GDD v1.4 App. D.12: the incident report names everyone): a crew's names, in the order they board.
  "botNames": ["Dunmore", "Okafor", "Reyes", "Halloran", "Petrov", "Achebe", "Lindqvist", "Moreau"],
  "gravity": 9.81,
  "radius": 0.3,
  "height": 1.8,
  "stepUp": 0.35,
  // Spec B.3 landings (T90, playtest): hitting the ground moving over it faster than lethalAbove kills (three times run
  // speed); slower than that it hurts, from rollDamage just above rollAbove rising to damageAtLethal at the lethal edge.
  // Being pulled off (the Draggers) still goes by train.speedBands.jumpOffLethal.
  "landing": {
    "rollAbove": 1.5,
    "rollDamage": 10,
    "lethalAbove": 16.5,
    "damageAtLethal": 80
  },
  "ladder": {
    "grabRange": 0.7,
    // You can only grab a ladder moving past you slower than this: "if you could catch it".
    "grabMaxRelativeSpeed": 3.5
  },
  // A VR player's reaching hand (T29; the spec has no VR numbers). Reach is tested from the hand instead of the body:
  // a hand is on a grip (a lever, a handle, a ladder, a crate) within grab of it. The host believes a hand no farther
  // than arm across from the body, and from the feet (a headset player crouches for real) to overhead above them.
  "hand": {
    "arm": 0.8,
    "overhead": 2.3,
    "grab": 0.3
  },
  // Spec B.2: 600 s outside to onset, 1200 s to death, reset in 20 s near heat (from any point short of death). Cut from
  // 200 / 320 / 45 after the 100-night playtest, where cold was 73% of all deaths: it was attrition, not a decision.
  // Heat is the cab while the fire burns, or a shut car while the boiler has steam to heat it.
  "cold": {
    "onsetSeconds": 600,
    "deathSeconds": 1200,
    "recoverSecondsNearHeat": 20,
    // Not in the spec, which gives onset no effect: past it you move at this fraction of your speed.
    "onsetSpeedScale": 0.9,
    // Spec B.2: inside a car's walls with a door open (working a side door, say), out of the wind but not warm, the cold
    // comes on at this fraction of the rate outside.
    "indoorsRate": 0.25,
    // GDD §22 deep cold (note 183): each of linegen §14's cold steps where you are (the night's, high ground, exposed track)
    // makes it come on this much faster. A step-3 night on an exposed crest: about twice as fast.
    "perColdStep": 0.25
  },
  // The director's decision of 2026-10-06 (GDD App. F.1, "way too easy to fall off the train"; ARCHITECTURE §8 note 266):
  // on a car moving faster than guardAbove m/s, a walk never takes you off it. A step that would stops you at the edge and
  // slides you along it; the wind on a roof and a sidestep never do it. Off you go by a jump, a hit, a grab, or walking
  // forward off a side (a roof's edge, an open door) you're facing within facingDegrees; a car's end, the coupling gap, is
  // jumped or climbed down, never walked off. on: false is the old free edge.
  "edge": { "on": true, "guardAbove": 1.0, "facingDegrees": 60 },
  // GDD §22 wind, spec B.2's "roof run: wind and balance penalty" (ARCHITECTURE §8 note 201). Up on a roof, the wind
  // (the route's conditions: the night's, ×1.5 on exposed track) pushes you sideways: drift m/s at wind 1 with the train
  // at its maxSpeed, still of that with it stopped (it's the wind across a moving train), in gusts that swing from one
  // side to the other over gustMetres of line. walking: walking or standing, this of what it is at a roof run (balance).
  // The roof handrails take it to train.json composition.rails.wind of that; a gun's seat is out of it. At the worst
  // (exposed track, full speed, running) about 0.45 m/s: walking against it holds you, but stood at the edge in a gust
  // it walks you off. It's seen as the drift itself: no camera roll, which a headset would feel in the stomach.
  "wind": {
    "drift": 0.3,
    "still": 0.4,
    "walking": 0.5,
    "gustMetres": 120
  },
  // Spec E drop-out, GDD v1.4 App. D.2 (ARCHITECTURE §8 note 253): a player whose link drops mid-night leaves an inert body
  // (no bot takes over), and the host holds their place (id, name, a token issued at the welcome) for reserveSeconds.
  // Back in time with the token, they get their own crewmate back. reclaimBody: true, they stand up where their body
  // lies now, with whatever kit is still on it (it may have been carried, looted, or fallen off the train); dead when they
  // dropped, they're dead still, on the dead channel. false is D.2's letter: the body stays and they come back as a lobbied
  // player (the respawn queue, or with no Holdouts a drop-in). A body gone (the Gaunt has it) is always D.2's letter.
  // Past reserveSeconds the slot frees and a returning player is a new joiner.
  // greetSeconds: a joiner says hello (with the token, if it has one) before it's welcomed; one that says nothing in this
  // long stops holding up the others, and is welcomed only once it does (note 253). The client retries a dropped link `retries` times, retrySeconds apart, then offers RECONNECT.
  "rejoin": {
    "reserveSeconds": 180,
    "reclaimBody": true,
    "greetSeconds": 1,
    "retries": 5,
    "retrySeconds": 3
  },
  // The crew cap (GDD §1 "Players: 2–8", §15's largest crew; ARCHITECTURE §8 note 254). The host turns a joiner away once
  // the crew, living and dead, those waiting to board at a stop and the places held for the dropped (rejoin above) come to
  // `cap`: told CREW FULL (n/cap), the lobby listed FULL and its platform lobby shut, open again when a place frees. Bots
  // hold crewmates, so they count. A player coming back with a held place's token always gets in. A mod raises it with a
  // patch (`{"$patch": true, "crew": {"cap": 12}}`): everyone in a game runs the same content, so they agree on it. The net
  // budget (ARCHITECTURE §6) has headroom to 12; past that is untested. refuseLingerSeconds: how long the host keeps a
  // refused link open for the refusal to get there before it hangs up (the client hangs up itself on reading it).
  "crew": {
    "cap": 8,
    "refuseLingerSeconds": 3
  }
}
