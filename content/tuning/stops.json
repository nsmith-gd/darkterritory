// The yards and villages at each stop (docs/design/level-design.md: Example 1, Parts D and Z). First pass.
// Everything is laid out in the stop's rail frame: `s` metres along the main line from the start of the stop's level
// zone (route.json poiZoneHalfLength either side of its centre), `d` metres to the right (+) or left (−) of it.
{
  // What the sidings are sized in: a car and its coupling gap, and the engine. Must match train.json (carLength +
  // couplingGap, engineLength); StopGeneratorTests checks.
  "carPitch": 15.5,
  "engineLength": 20,

  // Yard track (P5, P6, P8). Every yard track is a spur off the main line at its own hand-thrown switch, nested so the
  // first switch leads to the outermost track and none cross: a ladder laid on the main line itself. A switch's points
  // are route.json junctions.pointsLength long.
  "track": {
    // Yard trackwork is tighter than a main-line turnout (route.json junctions.spurRadius): an industrial curve, so a
    // track's S-curve out holds only a couple of cars and its length is mostly its loading face (P16; GDD §17: most
    // facilities can't take the whole train).
    "turnoutRadius": 60,
    // The innermost track's centre from the main line, and the pitch out from there: a 12 m shed row with 4 m clear
    // each side (P5). A shed row stands between every pair of tracks and between the innermost track and the main.
    "innermost": 24,
    "pitch": 20,
    // The first switch is this far into the zone, the next ones this far apart along the main line.
    "firstToe": 40,
    "toeSpacing": 45,
    // A fan's tracks end in concentric curves away from the main line: the outermost track's radius and the angle.
    "fanRadius": [140, 180],
    "fanAngle": [0.25, 0.45],
    // A split yard's far-side spur has its switch this far along from the near side's first.
    "splitToe": [30, 90]
  },

  // Storage sheds in rows along the loading face (the straight past each track's curves).
  "shed": { "depth": 12, "gap": 3, "perRow": [2, 4], "minLength": 14, "trim": [6, 4] },
  // The hero (P7): a fan's chain of sheds laid tangent to the outermost track's curve, 11 m off it, on the far side.
  "hero": { "count": [3, 6], "length": [17, 23], "offset": 11 },
  // A crane runway reaches this far either side of its track (facilities.json crane.span reaches 9 m out), and bays
  // are this far apart along a shed. Bays are stocked at random until the yard holds the tier's `stock`.
  "crane": { "reach": 10, "bayEvery": 9, "bayInset": 2.8 },

  // Villages (P4, P11, P20).
  "village": {
    // GDD App. F.3 (the director, 7 Oct: "the villages don't have explorable interiors ... things that we can search
    // through in order to find things"; ARCHITECTURE §8 note 326): every village house stands open, a door in the face
    // toward the line (each of a pair's cottages its own), its finds inside; the L and cross houses one floor, their parts
    // open into each other. Off, they're shut, their finds put out on the step.
    "openHouses": true,
    // Note 417 (level-design I.4; the same notes of 7 Oct): a barn, an outbuilding and a dead town's goods shed stand open
    // too, as their walls with a wide door toward the line, a hayloft's or a workbench's find inside to search. Off, they're
    // shut boxes, their finds put out on the step.
    "openSheds": true,
    "yawJitter": 0.44,
    "roadReach": 18,
    "houseGap": 2.5,
    "outliers": [1, 2],
    "outlierFindBonus": 0.3,
    // Note 593 (the director, 9 Oct: "not every house certainly should have loot in it, but a good chunk of them should
    // have something here, something there, things that we can stash in our lockers"): a house the tier's `find` picks has a
    // find, a second at secondFindChance, a third besides at thirdFindChance. With the tiers' finds (0.9 to 0.65, from 0.45 to
    // 0.26) about three houses in four have something, one in ten two or three; the score's findOdds doubled with them (3 to 6),
    // so a village measures where D.1's bands were set.
    "secondFindChance": 0.45,
    "thirdFindChance": 0.15,
    "outbuildings": [1, 2],
    "wellChance": 0.5,
    // A village set back from the line (arrangement "setback") sits this much further out, within this range.
    "setbackExtra": 45,
    "setbackRange": [85, 135],
    "blocks": { "depth": [38, 48], "length": [40, 55], "twoColumns": 0.55, "keepFrontage": 1, "keepEdge": 0.7, "keepInner": 0.8 },
    "street": { "length": [120, 180], "bend": 40, "every": [13, 18], "offset": [10, 13], "skip": 0.22, "laneChance": 0.55, "lane": [40, 60] },
    "crossroads": { "out": [35, 60], "arm": [35, 60], "beyond": [40, 70], "houses": [7, 11], "radius": [9, 38] },
    "farmsteads": { "length": [160, 210], "farms": [3, 5], "drive": [14, 22], "wiggle": 55 },
    // A village's extent along the line (for road-bounded blocks), and a halt's platform beside the main line.
    "extent": [110, 170],
    "halt": { "length": 34, "offset": 4.6 }
  },

  // The yard's powerhouse (level-design P6, D.2 "power"): at the throat, where the switchman walks to restart it when
  // the power's low or dead. Its footprint [length, width], how far back from (−) and past (+) the first switch it
  // stands, and how far out from the main line. With `open` it stands open as a barn does (note 509, note 417's "not
  // yet"): walked into by its door toward the line, the restart held at its switchboard against the back wall, its
  // engine beside it; dark inside until the power runs. Off, it's a shut box restarted at its door, as before.
  "powerhouse": { "size": [9, 7], "throat": [-70, 10], "offset": [8, 40], "open": true },

  // Holdouts (GDD App. D.4, D.13; level-design H.1): a sealed place where a dead player waits to be freed, the only way
  // back into a run. Placement only; what happens there is holdouts.json.
  "holdouts": {
    // A facility's: this far from the consist's stopping position on the pad (the middle of its first track's loading
    // face). A second on a pad at least `secondPadScale` long along the line, and at every switchyard. GDD D.15 question 2,
    // answered (T121): "Big crews should get at least one ... our goal with holdouts is to get everyone back and reduce
    // downtime": a second at every facility (0 m), taking someone only with holdouts.json's secondCrew in the session.
    "facilityDistance": [60, 200],
    "secondPadScale": 0,
    // A halt's lockup, and a dead town's shelter: at most this far from the main line.
    "haltDistance": 40,
    "villageDistance": 80,
    // A village stop's Holdout is the halt's lockup at this chance, else a shelter in the village (ARCHITECTURE §8).
    "villageLockup": 0.5,
    // Its lamp is seen from the approach: the 1 km board at a facility, the whistle board at a halt or village (the Line
    // Plan's; not in this repo, so its distance is ours, ARCHITECTURE §8).
    "approach": { "facility": 1000, "halt": 400 },
    // "Must not share a walking route with the nearest loading module": at least this far from any loading container,
    // and at least this angle (degrees) between the walk to it and the walk to the nearest one, from the consist.
    "loadingClear": 30,
    "loadingAngle": 45,
    // Types (D.4): a prison car on a spare siding, at `prisonCar` chance at a facility (`preferred` where the kind
    // prefers one), else a barricaded shelter; a mine head's is always the portal lamp room.
    "prisonCar": 0.35,
    "preferred": 0.8,
    "prefers": ["switchyard", "wreckYard", "militaryDepot"],
    "shelters": [["signalBox", 0.4], ["lampRoom", 0.35], ["waterTower", 0.25]],
    // Footprints [length along, width across], and the prison car's spare siding (derelict track, its points lifted).
    "sizes": { "prisonCar": [14, 3.2], "signalBox": [6, 4], "lampRoom": [4.5, 4], "waterTower": [5, 5], "lockup": [6, 4] },
    "siding": 26,
    // A signal box or water tower stands this far from a track (main or yard): it was built to watch or water one.
    "byTrack": [5, 12],
    // A halt's lockup stands this far behind the platform's back edge.
    "lockupBehind": [2, 8],
    // Placement tries this many candidates, and walks the ground in cells this big (D.14 "recoverability").
    "candidates": 220,
    "walkCell": 3
  },

  // Where the outside creatures live (GDD B.6, B.8; level-design H.2). The layout says where; the director says when.
  "lairs": {
    // Ribbits' warrens: open ground in a yard or a village, clear of buildings and track, away from the train. The
    // count per zone is the tier's `warrens`.
    "warren": { "radius": 6, "clear": 6, "fromTrain": 40, "fromMain": 20 },
    // The Gaunt sleeps in the building furthest from the train (a village house before a yard shed).
    // Followers ride the facility's grounds: circles round its loading, at most this many.
    "followers": { "radius": 14, "most": 3 },
    // A child calls from the open this far beyond the stop's built edge, where the train can see it.
    "sootCall": [25, 60],
    // The Whistler carries its victim off to a nest this far out from the main line, away from the stop, and no further
    // along the line than whistlerNestAlong from where the train stands: it snatches from the train's gaps, and runs to a
    // nest within enemies.json whistler.nestSiteReach of its gap (ARCHITECTURE §8 note 314).
    "whistlerNest": [40, 90], "whistlerNestAlong": 50
  },

  // Blocked sidings (level-design D.1, D.2, P18; ARCHITECTURE §8 note 294): bad-order cars nobody moved, standing at a
  // siding's buffer stop with their handbrakes on, on its loading face. A blocked siding holds this many of them (at most what
  // its face takes); the crew pull them out and put them away before the siding's any use. Never the facility's own track,
  // and never at a switchyard (its sidings have its standing cars, facilities.json rakes). How many sidings: the tier's
  // `blocked`. In the world they're facilities.json `derelicts`.
  "derelict": { "cars": [1, 3] },
  // A dead town's railway side (linegen plan §11.3: "platforms, station building, goods shed, sidings with derelict stock";
  // ARCHITECTURE §8 note 302). The station building [length, width] stands `gap` behind the halt's platform, `fromLane`
  // metres along from the lane up to the village. The goods yard is out past the tier's rail buffer by `beyond` (its find is
  // loot, P13), `length` long, `margin` in from the zone's ends, its middle within `reach` of the halt along the line (it's
  // the station's goods yard; and a long walk along the town is the village's difficulty, P15): a siding with its points
  // lifted, `cars` derelicts on it ([length, width], `carGap` apart) from its buffer stop, and the goods shed [length,
  // width] beyond it, its workbench a find at `find`. With `station.open` the station stands open as the goods shed does
  // (note 493, note 417's "not yet"): its door toward the line and its booking office's counter at the back wall, the till
  // long since rifled. Nothing to find in it: it stands inside the rail buffer, where there's no loot (P13). Off, it's a
  // shut box, as before.
  "deadTown": {
    "station": { "size": [16, 7], "gap": 1.5, "fromLane": [4, 12], "open": true },
    "goods": { "beyond": [2, 12], "length": [70, 110], "margin": 20, "reach": 60, "cars": [1, 3], "car": [14, 3.2], "carGap": 1.2, "shed": [20, 9], "find": 0.6 }
  },

  // Measuring a stop (P15, level-design D.1): what the crew has to do to fill the empties it brought, weighted.
  "score": {
    "throw": 1, "coupling": 0.5, "reversal": 1.5, "blindMove": 2.5, "respot": 0.6, "handCar": 2.5,
    "metresPerPoint": 80, "blockedCrossing": 3,
    // A blocked siding cleared (D.1 "clearances ×5"): on top of its two more throws and a reversal.
    "clearance": 5,
    // The village's part: its round trip, the odds, the houses to search and how far out it is. It counts at
    // `villageWeight` where the stop also has a yard (the village is optional there).
    "villageMetresPerPoint": 50, "findOdds": 6, "perHouse": 0.15, "offsetPerPoint": 25, "villageWeight": 0.4,
    // Walking a route isn't a straight line.
    "walkFactor": 1.25,
    // What each yard container loads, in cars (facilities.json loadPerCasting, loadPerCrate × loot.json's crates per
    // stack on average, the heavy crate's loadPerCrate; StopGeneratorTests checks), and carrying: metres of crate
    // carrying per point, a heavy crate counting this many times over (it needs two).
    "craneBayLoad": 0.5, "crateStackLoad": 0.375, "strongroomLoad": 0.5,
    "carryMetresPerPoint": 60, "heavyCarry": 2,
    // Level-design D.1: low power costs this, dead power this (the cranes wait on a walk to the powerhouse and a
    // restart, counted in metres too); a hard pull out of the yard costs `hardPull` a % of grade, from `hardPullFrom` %.
    "lowPower": 2, "deadPower": 5, "hardPull": 0.9, "hardPullFrom": 2
  },
  // Generate, measure, keep or reroll (P15): a stop that's outside its band or fails an invariant is rebuilt from the
  // next attempt seed, up to this many, keeping the closest.
  "maxAttempts": 8,

  // The difficulty levers by route tier (level-design D.2). `empties`: the car-loads of room a stop is measured and
  // stocked for (spec F table: 3, 8, 15, 20 cars, once half empty from the fortress; since note 575 the train leaves empty,
  // run.json departureLoad, and the crew fill it over the night's stops). `faceCars`: cars that fit along a track's
  // loading face. `stock`: what the yard holds, in cars' worth of the empties (enough to fill the train, spread over every
  // shed: thinly beside each track in a big yard, which means more trips and more carrying). `blocked`: how many sidings have
  // derelicts standing on them (D.2: 0, 0–1, 1–2, 1–3, never all). `everyTrack` (the director, 8 Oct 2026: "Loot should
  // spawn in all yard lines in early game and mid game"; ARCHITECTURE §8 note 352): every yard track has something to load
  // beside its loading face (a crane bay of its own, or a container on its side of a shed it stands beside; one is added
  // where the dice left it bare). Early and mid game read as the first three tiers (each had a bare siding in about one yard
  // in thirteen); deep territory is left to its dice, though its bigger stock left none bare in 40 yards. Weighted choices are [name, weight] pairs.
  "tiers": {
    "local": {
      "power": [["live", 1.0]], "exitGrade": [0, 0.5],
      "warrens": [1, 1], "empties": 2, "villageChance": 0.6, "halts": [2, 3],
      "forms": [["spur", 0.55], ["ladder", 0.30], ["fan", 0.15]],
      "sidings": [1, 2], "blocked": [0, 0], "faceCars": [5, 7], "crane": 1.0, "runway": [45, 60], "stock": [1.3, 1.6], "everyTrack": true,
      "villages": [["street", 0.4], ["blocks", 0.35], ["crossroads", 0.25]],
      "arrangements": [["opposite", 0.8], ["along", 0.2]],
      "villageOffset": [30, 40], "crossingReach": 70, "crossingClear": true, "buffer": 20, "find": 0.9, "stub": [20, 30],
      "band": { "yard": [4, 20], "village": [10, 18] }
    },
    "frontier": {
      "power": [["live", 0.6], ["low", 0.4]], "exitGrade": [0, 1.5],
      "warrens": [1, 2], "empties": 4, "villageChance": 0.5, "halts": [1, 3],
      "forms": [["spur", 0.15], ["ladder", 0.45], ["fan", 0.40]],
      "sidings": [2, 3], "blocked": [0, 1], "faceCars": [3, 5], "crane": 0.75, "runway": [35, 50], "stock": [1.2, 1.5], "everyTrack": true,
      "villages": [["blocks", 0.35], ["street", 0.25], ["crossroads", 0.25], ["farmsteads", 0.15]],
      "arrangements": [["opposite", 0.55], ["setback", 0.25], ["along", 0.2]],
      "villageOffset": [32, 60], "crossingReach": 90, "crossingClear": false, "buffer": 24, "find": 0.8, "stub": [25, 45],
      "band": { "yard": [14, 38], "village": [14, 22] }
    },
    "deadLines": {
      "power": [["low", 0.5], ["dead", 0.5]], "exitGrade": [0.5, 2.5],
      "warrens": [2, 3], "empties": 8, "villageChance": 0.45, "halts": [1, 2],
      "forms": [["ladder", 0.40], ["fan", 0.40], ["split", 0.20]],
      "sidings": [2, 4], "blocked": [1, 2], "faceCars": [3, 5], "crane": 0.55, "runway": [28, 42], "stock": [1.1, 1.4], "everyTrack": true,
      "villages": [["blocks", 0.25], ["crossroads", 0.25], ["farmsteads", 0.3], ["street", 0.2]],
      "arrangements": [["opposite", 0.35], ["setback", 0.45], ["along", 0.2]],
      "villageOffset": [45, 90], "crossingReach": 110, "crossingClear": false, "buffer": 28, "find": 0.72, "stub": [35, 60],
      "band": { "yard": [28, 64], "village": [18, 28] }
    },
    "deepTerritory": {
      "power": [["low", 0.2], ["dead", 0.8]], "exitGrade": [1, 4],
      "warrens": [2, 4], "empties": 10, "villageChance": 0.4, "halts": [1, 2],
      "forms": [["ladder", 0.30], ["fan", 0.35], ["split", 0.35]],
      "sidings": [3, 5], "blocked": [1, 3], "faceCars": [2, 4], "crane": 0.3, "runway": [18, 28], "stock": [1.0, 1.3], "everyTrack": false,
      "villages": [["farmsteads", 0.45], ["crossroads", 0.3], ["blocks", 0.25]],
      "arrangements": [["setback", 0.6], ["along", 0.25], ["opposite", 0.15]],
      "villageOffset": [60, 110], "crossingReach": 130, "crossingClear": false, "buffer": 34, "find": 0.65, "stub": [45, 75],
      "band": { "yard": [34, 112], "village": [22, 36] }
    }
  }
}
