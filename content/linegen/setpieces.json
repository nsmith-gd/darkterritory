    { "id": "momentumBank", "kind": "momentum", "minD": 1.3, "fullD": 1.3, "lengthM": [400, 900], "cost": 4, "costScale": 0, "crunch": true,
      "tags": ["climb", "momentum"], "params": { "runUpM": [200, 450], "carryShare": [0.7], "gradeOverMain": [0.25, 1.0] }, "weight": 0 },
    { "id": "hardBend", "kind": "bend", "minD": 0, "fullD": 0, "lengthM": [250, 600], "cost": 2, "costScale": 0, "crunch": false,
