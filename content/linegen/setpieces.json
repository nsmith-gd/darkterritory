  // Plan §7.4: placed at least once a run where the tier allows. chain: pieces one after another, each inside the
  // last's demand window; "a+b" lays b on a's grade (a Blind Throat on a descent). weight: the chance a night tries it
  // (1, every night): on the 7 km night (note 554) the three that always fit took the room the land's own pieces needed,
  // three times a 24 km night's of them a kilometre, so they're tried on some nights.
  "signatures": [
    { "id": "houndsHill",          "minD": 1.0, "chain": ["climb"],                            "afterFacility": true,  "onDescent": false, "weight": 0.5 },
    { "id": "blindGrease",         "minD": 1.5, "chain": ["descent+blindThroat"],              "afterFacility": false, "onDescent": true,  "weight": 0.5 },
    { "id": "junctionAtTheBottom", "minD": 2.0, "chain": ["descent"],                          "afterFacility": false, "onDescent": true,  "weight": 0.3 },
    { "id": "dropIntoHighIron",    "minD": 2.0, "chain": ["theDrop", "trestle"],               "afterFacility": false, "onDescent": false, "weight": 1 },
    { "id": "theLongDark",         "minD": 2.5, "chain": ["climb+tunnel", "ledge"],            "afterFacility": false, "onDescent": false, "weight": 1 },
    { "id": "theGauntlet",         "minD": 3.0, "chain": ["momentumBank", "blindThroat", "tunnel"], "afterFacility": false, "onDescent": false, "weight": 1 }
  ]
