<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DarkTerritory</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ballast.Platform/Ballast.Platform.csproj" />
    <ProjectReference Include="../DarkTerritory.Game/DarkTerritory.Game.csproj" />
  </ItemGroup>
  <!-- A developer build (DevTools, Directory.Build.props; note 514): the developer tools, reached under #if DEVTOOLS, and the
       mark that says so on the assembly. A player's build has neither. -->
  <PropertyGroup Condition="'$(DevTools)' == 'true'">
    <DefineConstants>$(DefineConstants);DEVTOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(DevTools)' == 'true'">
    <ProjectReference Include="../DarkTerritory.Dev/DarkTerritory.Dev.csproj" />
    <AssemblyMetadata Include="DevTools" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- A shipped build carries the game's content beside it (DataFile looks there when there's no repository), and
         how to play. Development builds read content/ from the repository instead. -->
    <None Include="../../content/**" Link="content/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <None Include="../../tools/package/PLAYING.txt" Link="PLAYING.txt" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <!-- Valve's native Steam library, when the developer has put it there (external/steam/README.md). -->
    <None Include="../../external/steam/*.dll;../../external/steam/*.so;../../external/steam/*.dylib" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
