+/// <summary>
+/// A night's crew memory on this machine (GDD §9, §11; the director, 14 Oct 2026; ARCHITECTURE §8 note 721): when the crew
+/// photo's due and what it came to, the logbook on its shelf and the pages in it, and the night's page written into this
+/// player's profile from the report every machine was sent. The app drives it; the rendering is the app's.
+/// </summary>
+/// <param name="crew">The campaign's crew name, key and night number (the setup's: <see cref="SessionSetup.Crew"/>), or
+/// empty for a night that's no campaign's (no page is kept, and the book is empty).</param>
+public sealed class CrewMemory(PlayerProfile profile, MemoryTuning tuning, string crew, string crewKey, int night)
+{
+    readonly Dictionary<string, Still?> _photos = [];
+    double _photoDue = -1;
+    LogPage? _page;
+    IReadOnlyList<LogPage>? _pages;
+
+    public MemoryTuning Tuning { get; } = tuning;
+    /// <summary>The crew's name ("" on a quick night).</summary>
+    public string Crew { get; } = crew;
+    public string CrewKey { get; } = crewKey;
+    public int Night { get; } = night;
+    /// <summary>The logbook on its shelf, open or shut.</summary>
+    public LogbookReader Reader { get; } = new();
+    /// <summary>Tonight's crew photo, once taken on this machine.</summary>
+    public Still? Photo { get; private set; }
+    /// <summary>Where it's kept ("" until then, or when the disk wouldn't have it).</summary>
+    public string PhotoFile { get; private set; } = "";
+    /// <summary>When its flash went off (this machine's seconds), or −1.</summary>
+    public double FlashAt { get; private set; } = -1;
+    /// <summary>Tonight's page, once the report's in.</summary>
+    public LogPage? Page => _page;
+
+    /// <summary>The setup's campaign, or a quick night's nothing.</summary>
+    public static CrewMemory For(PlayerProfile profile, MemoryTuning tuning, SessionSetup? setup) =>
+        new(profile, tuning, setup?.Crew ?? "", setup?.CrewKey ?? "", setup?.Night ?? 0);
+
+    /// <summary>This crew's pages as this player's profile has them (tonight's among them once it's written); read once, kept as written.</summary>
+    public IReadOnlyList<LogPage> Pages() => _pages ??= LogbookReader.Of(profile.Load(), CrewKey)?.Pages ?? [];
+
+    /// <summary>
+    /// The crew photo's due now (note 721): the night delivered, the report in, the photo not yet taken here, and
+    /// <see cref="PhotoTuning.DelaySeconds"/> gone since this machine first saw the report.
+    /// </summary>
+    public bool PhotoDue(IPlaySession s, double now)
+    {
+        if (Photo is not null || s.World.Run?.Report is not { End: RunEnd.Delivered })
+            return false;
+        if (_photoDue < 0)
+            _photoDue = now + Tuning.Photo.DelaySeconds;
+        return now >= _photoDue;
+    }
+
+    /// <summary>Who's in it, and the slate's chalk.</summary>
+    public (IReadOnlyList<Sitter> Crew, IReadOnlyList<string> Chalk) Sitting(IPlaySession s) =>
+        (CrewPhoto.Sitters(s.World, s.CrewStates(1)), CrewPhoto.Chalk(CrewPhoto.RouteName(s.Route?.Name), Night, s.World.Run?.Report?.Net ?? 0));
+
+    /// <summary>The photo staged beside the engine as it stands now, on the yard's open side (<see cref="CrewPhoto.YardSide"/>).</summary>
+    public PhotoStaging Stage(IPlaySession s, IReadOnlyList<CarFrame> frames)
+    {
+        var (sitters, chalk) = Sitting(s);
+        int side = CrewPhoto.YardSide((s.World.Arrival ?? s.World.Town)?.Plan.Square.Side);
+        return CrewPhoto.Stage(frames[0], side, sitters, chalk, Tuning.Photo);
+    }
+
+    /// <summary>
+    /// The photo's been taken (the frame drawn from the staging's lens): kept small, written to the night's album folder with
+    /// its sidecar, the flash set off, and tonight's page written again with it.
+    /// </summary>
+    public void Took(IPlaySession s, byte[] rgba, int width, int height, BookmarkAlbum album, double now, DateTime date)
+    {
+        Photo = BookmarkStills.Shrink(rgba, width, height, Tuning.Photo.Width, Tuning.Photo.Height);
+        FlashAt = now;
+        var (sitters, chalk) = Sitting(s);
+        PhotoFile = album.KeepPhoto(Photo, CrewPhoto.Sidecar(sitters, chalk, Crew, Date(date)));
+        if (PhotoFile.Length > 0)
+            _photos[PhotoFile] = Photo;
+        if (_page is not null)
+            Remember(s, date);
+    }
+
+    /// <summary>The flash over the screen now: 1 as it goes off, fading to 0 over <see cref="PhotoTuning.FlashSeconds"/>.</summary>
+    public float Flash(double now) =>
+        FlashAt < 0 || now < FlashAt || Tuning.Photo.FlashSeconds <= 0 ? 0 : (float)Math.Clamp(1 - (now - FlashAt) / Tuning.Photo.FlashSeconds, 0, 1);
+
+    /// <summary>
+    /// Tonight's page in this crew's logbook in the player's profile (note 721), from the report and the commendations as this
+    /// machine has them now: written when the report comes in, again with the photo, and once more as the night's left (the
+    /// commendations given on the end card). A night that ended the campaign closes the crew onto the board of lost crews.
+    /// Nothing on a quick night. Returns the page.
+    /// </summary>
+    public LogPage? Remember(IPlaySession s, DateTime date)
+    {
+        if (CrewKey.Length == 0 || s.World.Run?.Report is not { } report)
+            return null;
+        var world = s.World;
+        var commended = world.Commendations.Where(c => c.Which < Commendations.StarterSet.Length)
+            .Select(c => (IncidentLog.NameOf(world, c.To), Commendations.StarterSet[c.Which], IncidentLog.NameOf(world, c.From)));
+        bool wakers = world.Enemies?.Wakers.Enabled ?? true;
+        _page = Logbook.Page(report, Night, RouteTitle(s), Date(date), commended, wakers, PhotoFile);
+        bool over = report.End == RunEnd.DawnMissed && world.DawnEndsCampaign;
+        _pages = LogbookReader.Of(profile.Log(CrewKey, Crew, _page, over), CrewKey)?.Pages ?? [];
+        return _page;
+    }
+
+    /// <summary>A page's photo, read back from where this machine kept it (cached), or null.</summary>
+    public Still? PhotoOf(LogPage page)
+    {
+        if (page.Photo.Length == 0)
+            return null;
+        if (!_photos.TryGetValue(page.Photo, out var still))
+            _photos[page.Photo] = still = BookmarkAlbum.ReadPhoto(page.Photo);
+        return still;
+    }
+
+    /// <summary>The page's line: "Frontier 7, Hollin Halt to Barrow Bay" (its tier and seed, the town it left and the terminus).</summary>
+    public static string RouteTitle(IPlaySession s)
+    {
+        string name = CrewPhoto.RouteName(s.Route?.Name);
+        string? from = s.World.Town?.Plan.Name, to = s.Route?.Plan?.Terminus.Name;
+        return from is { Length: > 0 } && to is { Length: > 0 } ? $"{name}, {from} to {to}" : to is { Length: > 0 } ? $"{name}, to {to}" : name;
+    }
+
+    /// <summary>The page's date line, by the player's own clock: "14 October 2026".</summary>
+    public static string Date(DateTime date) => date.ToString("d MMMM yyyy", CultureInfo.InvariantCulture);
+
+    /// <summary>The board of lost crews' cards from this player's profile (note 721), the last ended first.</summary>
+    public static IReadOnlyList<(string Title, string Text)> LostCrews(PlayerProfile.Data profile) =>
+        [.. Logbook.Lost(profile.Crews).Select(Logbook.Card)];
+}
diff --git a/src/DarkTerritory.Game/CrewPhoto.cs b/src/DarkTerritory.Game/CrewPhoto.cs
new file mode 100644
index 00000000..d3f4dc55
--- /dev/null
+++ b/src/DarkTerritory.Game/CrewPhoto.cs
@@ -0,0 +1,183 @@
+using System.Text;
+using Ballast;
+using Ballast.Render;
+using DarkTerritory.Sim;
+using DarkTerritory.Sim.Player;
+using DarkTerritory.Sim.Run;
+using DarkTerritory.Sim.Train;
+
+namespace DarkTerritory.Game;
+
+/// <summary>
+/// Crew memory's numbers (content/tuning/memory.json; GDD §9, §11, §3.1; the director, 14 Oct 2026; ARCHITECTURE §8 note
+/// 721): the crew photo's staging and the logbook's place and reach. Presentation only. The defaults are the file's.
+/// </summary>
+public sealed record MemoryTuning
+{
+    public const string File = "tuning/memory.json";
+    public PhotoTuning Photo { get; init; } = new();
+    public LogbookTuning Logbook { get; init; } = new();
+}
+
+/// <summary>The crew photo at the gate (memory.json <c>photo</c>; GDD §9 Arrival, note 721). Field docs live in the file.</summary>
+public sealed record PhotoTuning
+{
+    public int Width { get; init; } = 640;
+    public int Height { get; init; } = 360;
+    public float Fov { get; init; } = 40;
+    public double DelaySeconds { get; init; } = 1.2;
+    public double FlashSeconds { get; init; } = 0.6;
+    public double Ahead { get; init; } = 2.5;
+    public double Out { get; init; } = 3.0;
+    public double Spacing { get; init; } = 0.95;
+    public double CrateGap { get; init; } = 1.0;
+    public double CameraOut { get; init; } = 8.0;
+    public double CameraAhead { get; init; } = 3.0;
+    public double CameraHeight { get; init; } = 1.6;
+    public double LookHeight { get; init; } = 1.5;
+    public double SlateOut { get; init; } = 2.6;
+    public double SlateAside { get; init; } = 0.7;
+    public double EmoteAt { get; init; } = 0.8;
+    public float FlashRange { get; init; } = 18;
+    public float FlashStrength { get; init; } = 3.0f;
+}
+
+/// <summary>The logbook (memory.json <c>logbook</c>; GDD §11, note 721). Field docs live in the file.</summary>
+public sealed record LogbookTuning
+{
+    public string Place { get; init; } = "lockers";
+    public double Height { get; init; } = 1.25;
+    public double Reach { get; init; } = 1.9;
+    public double LookDegrees { get; init; } = 22;
+}
+
+/// <summary>Someone in the crew photo (note 721): who, alive or not, the emote they're holding, and a sooty face (note 717).</summary>
+public readonly record struct Sitter(byte Id, string Name, bool Alive, Emote Emote = Emote.None, bool Sooted = false, int? Looks = null);
+
+/// <summary>
+/// What's in the photo besides the crew (note 721): the crate at the line's end with the dead's caps on it (each in its
+/// crewmate's colours, by <see cref="Crewmate.Variant"/>), the slate on its easel with the night's tally chalked on it, and
+/// where the flash went off. World positions; yaws face the lens (0 faces world −Z, as a crewmate's).
+/// </summary>
+public sealed record PhotoProps(Double3 Crate, double CrateYaw, IReadOnlyList<int> Caps, Double3 Slate, double SlateYaw, IReadOnlyList<string> Chalk,
+    Double3 Flash, float FlashRange, float FlashStrength);
+
+/// <summary>The crew photo staged: the lens, the figures stood for it, and the props.</summary>
+public sealed record PhotoStaging(Camera Camera, IReadOnlyList<Crewmate> Crew, PhotoProps Props);
+
+/// <summary>
+/// The crew photo at the gate (GDD §9 Arrival; the director, 14 Oct 2026; ARCHITECTURE §8 note 721): on a delivered night,
+/// as the train stands in at the terminus, the town photographer's flash. The living stand in a line beside the engine in the
+/// yard, each in the emote they're holding (or stood), bots too; the dead are their caps on a crate at the line's end; the
+/// night's tally is chalked on a slate on an easel. Presentation only, staged on every machine from the replicated world
+/// alone (who, alive, their emote and soot; the engine where it stands), so every machine's photo is the same photo.
+/// <para>U1's yard photographer (docs/design/upgrades.md §4) takes a departure photo with the same call (<see cref="Stage"/>
+/// on the departure's engine) and keeps it with <see cref="BookmarkAlbum.KeepPhoto"/>.</para>
+/// </summary>
+public static class CrewPhoto
+{
+    /// <summary>
+    /// Who's in the photo, from the replicated crew: the living by id (each holding the emote they're at, sooty if sooted),
+    /// then the dead by id. Bots stand in like anyone.
+    /// </summary>
+    public static IReadOnlyList<Sitter> Sitters(World world, IEnumerable<(int Id, PlayerState State)> crew) =>
+        [.. crew.Where(c => c.Id is >= 0 and <= byte.MaxValue).DistinctBy(c => c.Id).OrderBy(c => c.State.Alive ? 0 : 1).ThenBy(c => c.Id).Select(c =>
+            new Sitter((byte)c.Id, IncidentLog.NameOf(world, c.Id), c.State.Alive,
+                c.State.Alive ? Art.CrewActs.EmoteOf(c.Id, c.State with { Velocity = default }, world).Kind : Emote.None,
+                c.State.Has(PlayerFlags.Sooted), world.OutfitOf(c.Id) is var outfit && outfit != c.Id ? outfit : null))];
+
+    /// <summary>
+    /// The slate's chalk (note 721): the line's name, the night's number, and the net. "FRONTIER 7" / "NIGHT 3" / "NET 1450".
+    /// </summary>
+    public static IReadOnlyList<string> Chalk(string route, int night, double net)
+    {
+        var lines = new List<string> { route.ToUpperInvariant() };
+        if (night > 0)
+            lines.Add($"NIGHT {night}");
+        lines.Add($"NET {net:0}");
+        return lines;
+    }
+
+    /// <summary>A route's name for the slate and the page: "frontier:7" or "frontier-7" as "Frontier 7".</summary>
+    public static string RouteName(string? route)
+    {
+        if (string.IsNullOrWhiteSpace(route))
+            return "The line";
+        string s = route.Replace(':', ' ').Replace('-', ' ').Trim();
+        // "deepTerritory 3": the tier as said.
+        s = Sim.Run.IncidentLog.Spoken(s);
+        return char.ToUpperInvariant(s[0]) + s[1..].ToLowerInvariant();
+    }
+
+    /// <summary>
+    /// The side of the track the photo's taken on (+1 the line's right, −1 its left): away from the town's square, whose side
+    /// of the yard has the platform's canopy and its posts between any lens and the engine; the yard's open on the other.
+    /// </summary>
+    public static int YardSide(int? squareSide) => squareSide is < 0 ? 1 : squareSide is > 0 ? -1 : 1;
+
+    /// <summary>
+    /// Stages the photo beside the engine (frame 0) on <paramref name="side"/> of the track (+1 its right, −1 its left:
+    /// <see cref="YardSide"/>). The living stand in a line, in <paramref name="crew"/>'s order from
+    /// the picture's left, facing the lens; the crate with the dead's caps at the line's right-hand end; the slate in front. Deterministic: the same
+    /// engine, crew and side give the same photo on every machine.
+    /// </summary>
+    public static PhotoStaging Stage(CarFrame engine, int side, IReadOnlyList<Sitter> crew, IReadOnlyList<string> chalk, PhotoTuning t)
+    {
+        side = side < 0 ? -1 : 1;
+        // Level along and across the engine, at rail height under its middle.
+        var forward = ((engine.Back * -1) with { Y = 0 }).Normalized;
+        var right = (engine.Right with { Y = 0 }).Normalized * side;
+        var ground = engine.Origin;
+        Double3 At(double along, double across, double up = 0) => ground + forward * along + right * across + Double3.Up * up;
+
+        var living = crew.Where(c => c.Alive).ToList();
+        var dead = crew.Where(c => !c.Alive).ToList();
+        double middle = t.Ahead;
+        var lens = At(middle + t.CameraAhead, t.Out + t.CameraOut, t.CameraHeight);
+        var camera = Camera.LookAt(lens, At(middle + t.CameraAhead * 0.25, t.Out, t.LookHeight), t.Fov);
+        // Across the picture, left to right, as the lens sees it: its right is the engine's front on the engine's right side,
+        // its back on the left.
+        Double3 Across(double x, double outward, double up = 0) => At(middle + side * x, outward, up);
+        var figures = new List<Crewmate>(living.Count);
+        for (int i = 0; i < living.Count; i++)
+        {
+            var feet = Across((i - (living.Count - 1) / 2.0) * t.Spacing, t.Out);
+            var c = living[i];
+            figures.Add(new Crewmate(c.Id, feet, Facing(feet, lens), true, Looks: c.Looks, Emote: c.Emote,
+                EmoteSeconds: c.Emote == Emote.None ? 0 : t.EmoteAt, Sooted: c.Sooted));
+        }
+        // The crate at the line's right-hand end, the slate on the left in front.
+        var crate = Across((Math.Max(1, living.Count) - 1) / 2.0 * t.Spacing + t.CrateGap, t.Out);
+        var slate = Across(-(Math.Max(1, living.Count) - 1) / 2.0 * t.Spacing - t.SlateAside, t.Out + t.SlateOut);
+        var props = new PhotoProps(crate, Facing(crate, lens), [.. dead.Select(d => d.Looks ?? d.Id)], slate, Facing(slate, lens), chalk,
+            lens, t.FlashRange, t.FlashStrength);
+        return new PhotoStaging(camera, figures, props);
+    }
+
+    /// <summary>The yaw that faces from <paramref name="from"/> to <paramref name="to"/>, level (0 faces world −Z).</summary>
+    static double Facing(Double3 from, Double3 to)
+    {
+        var d = to - from;
+        return Math.Atan2(-d.X, -d.Z);
+    }
+
+    /// <summary>
+    /// The photo's text sidecar (note 721), kept beside its PNG: what it is, who's in it from left to right, whose caps are
+    /// on the crate, and the slate.
+    /// </summary>
+    public static string Sidecar(IReadOnlyList<Sitter> crew, IReadOnlyList<string> chalk, string crewName, string date)
+    {
+        var text = new StringBuilder();
+        text.AppendLine($"DARK TERRITORY. THE CREW PHOTO AT THE GATE{(crewName.Length > 0 ? $": {crewName.ToUpperInvariant()}" : "")}. {date}.");
+        text.AppendLine();
+        text.AppendLine("ON THE SLATE: " + string.Join(" / ", chalk));
+        var living = crew.Where(c => c.Alive).ToList();
+        if (living.Count > 0)
+            text.AppendLine("STANDING, LEFT TO RIGHT: " + string.Join(", ", living.Select(c => c.Name + (c.Emote != Emote.None ? $" ({c.Emote.ToString().ToLowerInvariant()})" : "")
+                + (c.Sooted ? " (sooty)" : ""))));
+        var dead = crew.Where(c => !c.Alive).ToList();
+        if (dead.Count > 0)
+            text.AppendLine("CAPS ON THE CRATE: " + string.Join(", ", dead.Select(c => c.Name)));
+        return text.ToString();
+    }
+}
diff --git a/src/DarkTerritory.Game/GreyboxScene.Memory.cs b/src/DarkTerritory.Game/GreyboxScene.Memory.cs
new file mode 100644
index 00000000..896768eb
--- /dev/null
+++ b/src/DarkTerritory.Game/GreyboxScene.Memory.cs
@@ -0,0 +1,160 @@
+using System.Numerics;
+using Ballast;
+using Ballast.Render;
+using DarkTerritory.Game.Art;
+using DarkTerritory.Sim.Train;
+
+namespace DarkTerritory.Game;
+
+/// <summary>
+/// Crew memory in the scene (GDD §9, §11; the director, 14 Oct 2026; ARCHITECTURE §8 note 721): the crew photo's props (the
+/// crate with the dead's caps, the slate on its easel with the night's tally chalked on it, the photographer's flash) while
+/// the photo's drawn, and the logbook on its shelf in car one.
+/// </summary>
+public sealed partial class GreyboxScene
+{
+    /// <summary>The crew photo's props and flash (note 721), while it's drawn; null otherwise.</summary>
+    public PhotoProps? Photo { get; set; }
+
+    /// <summary>The logbook on its shelf (note 721, <see cref="LogbookReader.Shelf"/>): its car, where in it, which way it faces. Null: not drawn.</summary>
+    public (int Car, Double3 Local, double Yaw)? Logbook { get; set; }
+
+    MeshAsset? _crate, _cap, _easel, _book;
+    (string Key, MeshAsset Mesh)? _chalk;
+
+    void Memory(MeshBuilder mesh, IReadOnlyList<CarFrame> frames, Double3 eye)
+    {
+        if (Logbook is { } book && book.Car >= 0 && book.Car < frames.Count && (frames[book.Car].Origin - eye).Length < DrawDistance)
+        {
+            _book ??= Book(Look);
+            mesh.Append(_book, Matrix4x4.CreateRotationY((float)book.Yaw) * Matrix4x4.CreateTranslation(book.Local.RelativeTo(default)) * SceneArt.FrameMatrix(frames[book.Car], eye));
+        }
+        if (Photo is not { } p)
+            return;
+        // The flash: the photo is lit by it, the night round it as dark as ever.
+        mesh.PointLights.Add(new PointLight(V(p.Flash, eye), new Vector3(1, 0.97f, 0.9f) * p.FlashStrength, p.FlashRange));
+        _crate ??= Crate(Look);
+        var crate = Matrix4x4.CreateRotationY((float)p.CrateYaw) * Matrix4x4.CreateTranslation(V(p.Crate, eye));
+        mesh.Append(_crate, crate);
+        // The dead's caps on its lid, in a row of three a side to side, the next row behind; each in its crewmate's colours.
+        _cap ??= Cap(Look);
+        for (int i = 0; i < p.Caps.Count; i++)
+        {
+            int row = i / 3, inRow = Math.Min(3, p.Caps.Count - row * 3);
+            float x = ((i % 3) - (inRow - 1) / 2f) * 0.29f, z = -0.13f + row * 0.26f;
+            var tint = Look?.Tuning.CrewColour(p.Caps[i]) ?? Vector3.One;
+            mesh.Append(_cap, Matrix4x4.CreateScale(CapScale) * Matrix4x4.CreateRotationY(0.4f * ((i * 7 % 5) - 2) / 2) * Matrix4x4.CreateTranslation(x, CrateHeight + 0.002f, z) * crate, tint);
+        }
+        _easel ??= Easel(Look);
+        var easel = Matrix4x4.CreateRotationY((float)p.SlateYaw) * Matrix4x4.CreateTranslation(V(p.Slate, eye));
+        mesh.Append(_easel, easel);
+        string key = string.Join("\n", p.Chalk);
+        if (_chalk is not { } chalk || chalk.Key != key)
+            _chalk = chalk = (key, Chalk(Look, p.Chalk));
+        mesh.Append(chalk.Mesh, easel);
+    }
+
+    const float CrateHeight = 0.62f;
+    /// <summary>The caps a little larger than life: a photo's small, and they're what the crate's for.</summary>
+    const float CapScale = 1.3f;
+    static readonly Vector3 SlateCentre = new(0, 1.12f, -0.03f);
+    const float SlateW = 0.86f, SlateH = 0.62f;
+
+    /// <summary>A packing crate, planked: what the dead's caps are set on.</summary>
+    static MeshAsset Crate(Look? look)
+    {
+        var k = new Kit(look, 4410);
+        SquareKit.Timber(k);
+        k.Tint *= 1.25f;
+        k.Box(new Vector3(-0.46f, 0, -0.3f), new Vector3(0.46f, CrateHeight, 0.3f));
+        // The battens across its face and the dark seams between its planks.
+        k.Tint *= 0.7f;
+        foreach (float y in new[] { 0.1f, 0.5f })
+            k.Box(new Vector3(-0.47f, y, -0.315f), new Vector3(0.47f, y + 0.07f, -0.3f));
+        return k.Build("photo-crate");
+    }
+
+    /// <summary>A flat cap with its peak, as the crew wear them, small enough to sit three on a crate (its peak to −Z).</summary>
+    static MeshAsset Cap(Look? look)
+    {
+        var k = new Kit(look, 4420);
+        // White, the crewmate's colour multiplied in as it's drawn.
+        k.Use("cap", new Vector3(0.75f), 0.6f, 0.05f, tile: 1);
+        k.Tint = new Vector3(0.8f);
+        k.Cylinder(new Vector3(0, 0, 0.01f), new Vector3(0, 0.07f, 0.02f), 0.105f, 14, radiusB: 0.095f);
+        k.Quad(new Vector3(-0.085f, 0.012f, -0.06f), new Vector3(0.085f, 0.012f, -0.06f), new Vector3(0.07f, 0.004f, -0.16f), new Vector3(-0.07f, 0.004f, -0.16f), twoSided: true);
+        return k.Build("photo-cap");
+    }
+
+    /// <summary>The photographer's easel and its slate, framed in timber, a chalk ledge under it; the slate faces −Z.</summary>
+    static MeshAsset Easel(Look? look)
+    {
+        var k = new Kit(look, 4430);
+        SquareKit.Timber(k);
+        k.Tint *= 1.2f;
+        foreach (float side in new[] { -1f, 1f })
+            k.Cylinder(new Vector3(side * 0.36f, 0, -0.06f), new Vector3(side * 0.24f, 1.62f, 0.08f), 0.022f, 6);
+        k.Cylinder(new Vector3(0, 0, 0.58f), new Vector3(0, 1.55f, 0.04f), 0.022f, 6);
+        var c = SlateCentre;
+        float hw = SlateW / 2, hh = SlateH / 2;
+        k.Box(new Vector3(-hw - 0.05f, c.Y - hh - 0.06f, c.Z), new Vector3(hw + 0.05f, c.Y - hh, c.Z + 0.03f));
+        k.Box(new Vector3(-hw - 0.05f, c.Y + hh, c.Z), new Vector3(hw + 0.05f, c.Y + hh + 0.05f, c.Z + 0.03f));
+        foreach (float side in new[] { -1f, 1f })
+            k.Box(new Vector3(side * hw - (side > 0 ? 0 : 0.05f), c.Y - hh, c.Z), new Vector3(side * hw + (side > 0 ? 0.05f : 0), c.Y + hh, c.Z + 0.03f));
+        // The chalk ledge, out in front at the slate's foot.
+        k.Box(new Vector3(-hw, c.Y - hh - 0.08f, c.Z - 0.07f), new Vector3(hw, c.Y - hh - 0.05f, c.Z));
+        // The slate: blue-black, a little sheen.
+        k.Use("slate_board", new Vector3(0.05f, 0.055f, 0.06f), 0.4f, 0.15f, tile: 1);
+        k.Tint = new Vector3(0.05f, 0.055f, 0.06f);
+        k.Panel(c, -Vector3.UnitZ, Vector3.UnitY, SlateW, SlateH);
+        return k.Build("photo-easel");
+    }
+
+    /// <summary>The night's tally chalked on the slate (note 721), each line as large as fits it, centred.</summary>
+    static MeshAsset Chalk(Look? look, IReadOnlyList<string> lines)
+    {
+        var k = new Kit(look, 4440);
+        k.Use("chalk", new Vector3(0.92f, 0.92f, 0.88f), 0.9f, 0, tile: 1);
+        k.Tint = new Vector3(0.92f, 0.92f, 0.88f);
+        // A little glow of its own: chalk on slate reads in any light the flash leaves.
+        k.Emissive = 0.25f;
+        var font = BitmapFont.Default;
+        float inner = SlateW - 0.08f, room = SlateH - 0.08f;
+        int rows = Math.Max(1, lines.Count);
+        float widest = Math.Max(1, lines.Max(l => font.Measure(l)));
+        float px = MathF.Min(inner / widest, room / (rows * font.LineHeight));
+        float top = SlateCentre.Y + rows * font.LineHeight * px / 2;
+        for (int i = 0; i < lines.Count; i++)
+        {
+            float x = font.Measure(lines[i]) * px / 2;
+            k.With(Matrix4x4.CreateTranslation(0, 0, SlateCentre.Z), () => SquareKit.Ink(k, font, lines[i], x, top - i * font.LineHeight * px, px));
+        }
+        k.Emissive = 0;
+        return k.Build("photo-chalk");
+    }
+
+    /// <summary>
+    /// The logbook (note 721): a fat ledger bound in oxblood cloth, its pages' edge showing, lying shut on its little shelf,
+    /// the shelf's back to the wall (+Z) and its front to the aisle (−Z), two iron brackets under it.
+    /// </summary>
+    static MeshAsset Book(Look? look)
+    {
+        var k = new Kit(look, 4450);
+        SquareKit.Timber(k);
+        k.Tint *= 1.2f;
+        float back = (float)LogbookReader.ShelfDepth;
+        k.Box(new Vector3(-0.26f, -0.035f, -0.14f), new Vector3(0.26f, 0, back));
+        k.Use("rust_heavy", Palette.IronGrey, 0.8f, 0.3f);
+        foreach (float x in new[] { -0.19f, 0.19f })
